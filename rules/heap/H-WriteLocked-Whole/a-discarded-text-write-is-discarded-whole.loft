//
// A DISCARDED TEXT WRITE IS DISCARDED WHOLE (`@FR-H-WriteLocked-Whole`, with `@FR-H-Write-Else`,
// `@FR-H-TextReplace`).  An operation of several store steps changes nothing in a locked store,
// not only the step the lock was met at: a text replaced by a longer one (a release of the old
// block and a claim of a new) and a text appended to (a resize and a copy) leave the field as it
// was, and the guard's arm runs once for each.  The control writes the same on an unlocked
// record, where both land.  Values by hand: locked — arms "ST", the field still "abc" (3 bytes);
// unlocked — no arm, "a much longer textdef".
//
// A keyed filing (a claim, a key written, a placement in the table) is discarded as whole: the
// hash keeps its one entry and the new key reads null (loft#2549).
//
// @falsified-by: tests/falsified/a-discarded-text-write-is-discarded-whole.patch — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: the run's exit (the control halts on the locked filing) and the asserts.
//   ARMED: every run.
//   WITNESS: the control reports "write to a locked store" at the guarded keyed filing.
//   HOLDS: the two text tests, on both trees; the halting half (an unguarded locked write) is
//   tests/locked_writes.rs.

struct D { s: text, n: integer }

struct E { k: integer, v: integer }
struct H { hs: hash<E[k]> }

fn test_a_locked_keyed_filing_files_nothing() {
  h = H { hs: [E { k: 5, v: 50 }] };
  h#lock = true;
  out = "";
  h.hs += [E { k: 6, v: 60 }, E { k: 7, v: 70 }] else { out += "H" };
  r = "{out} {len(h.hs)} {h.hs[6] == null} {h.hs[5].v ?? -1}";
  assert(r == "H 1 true 50", "locked filing: {r}");
}

fn test_a_locked_text_replace_and_append_change_nothing() {
  d = D { s: "abc", n: 1 };
  d#lock = true;
  out = "";
  d.s = "a much longer text" else { out += "S" };
  d.s += "def" else { out += "T" };
  r = "{out} {d.s} {len(d.s)} {d.n}";
  assert(r == "ST abc 3 1", "locked: {r}");
}

fn test_control_an_unlocked_record_takes_both_writes() {
  u = D { s: "abc", n: 1 };
  out = "";
  u.s = "a much longer text" else { out += "S" };
  u.s += "def" else { out += "T" };
  r = "[{out}] {u.s}";
  assert(r == "[] a much longer textdef", "unlocked: {r}");
}
