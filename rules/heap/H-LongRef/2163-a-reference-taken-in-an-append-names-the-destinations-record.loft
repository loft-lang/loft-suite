//
// A REFERENCE TAKEN IN AN APPEND NAMES THE DESTINATION'S RECORD (`@FR-H-LongRef`, `@FR-H-RefSet`,
// loft#2163).  `nodes += [N { c: &nodes[len(nodes) - 1] }]` reads its destination, so the literal's
// reads go through a snapshot taken before the append (`I-Comp`).  The `&` was renamed onto the
// snapshot with them, so the field named the snapshot's COPY of the record; in a loop the
// snapshot is minted again on the next pass, which removes its records, and every reference but
// the last read null on the interpreter and the freed record on `--native`.  The index still
// reads the snapshot: `len(nodes)` inside the literal is the length before the append.
//
// And a struct-ENUM target is a record type too: `vector<Expr>` stayed inline when a
// `reference<Expr>` named it, so once growth moved the vector every stored reference read null —
// built through a local as well as through the literal.
//
// Axes it MOVES: the target type (struct, a struct with a text, struct-enum), the destination (a
// local, a struct field; a `&vector` parameter is the sibling cell), the index (constant, `len - 1` read from the
// snapshot), references per literal (one, two), the build (inside the literal, through a local,
// set after the append), and size (past the vector's first allocation).  A write
// through the target after the build checks the field names the place, not a copy.  Values
// hand-computed.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: 39ebf3bca — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the referenced values (`constant: null null` on the control).
// HOLDS: the last reference of each loop, whose snapshot is never minted again, read right on the control.

struct N { v: integer, c: reference<N>? }
struct T { name: text, c: reference<T>? }
struct H { list: vector<T> }
enum Expr { Lit { v: integer }, Neg { e: reference<Expr> } }

fn eval(e: Expr) -> integer {
  match e { Lit { v } => v, Neg { e } => -eval(e) }
}

fn test_a_constant_index() {
  a: vector<N> = [N { v: 11, c: null }];
  for i in 0..3 { a += [N { v: 20 + i, c: &a[0] }]; }
  assert(a[1].c.v == 11 && a[2].c.v == 11 && a[3].c.v == 11, "constant: {a[1].c.v} {a[2].c.v}");
}

fn test_the_index_reads_the_length_before_the_append() {
  b: vector<N> = [N { v: 11, c: null }];
  for _ in 0..3 { b += [N { v: len(b), c: &b[len(b) - 1] }]; }
  assert(b[1].v == 1 && b[1].c.v == 11, "pass 0: {b[1].v}:{b[1].c.v}");
  assert(b[2].v == 2 && b[2].c.v == 1, "pass 1: {b[2].v}:{b[2].c.v}");
  assert(b[3].v == 3 && b[3].c.v == 2, "pass 2: {b[3].v}:{b[3].c.v}");
}

fn test_two_references_in_one_literal_name_places() {
  c: vector<N> = [N { v: 11, c: null }, N { v: 12, c: null }];
  for i in 0..2 { c += [N { v: 40 + i, c: &c[0] }, N { v: 50 + i, c: &c[len(c) - 1] }]; }
  assert(c[2].c.v == 11 && c[3].c.v == 12 && c[4].c.v == 11 && c[5].c.v == 50,
    "two: {c[2].c.v} {c[3].c.v} {c[4].c.v} {c[5].c.v}");
  c[0].v = 13;
  assert(c[2].c.v == 13 && c[4].c.v == 13, "a write through the target: {c[2].c.v} {c[4].c.v}");
}

fn test_a_struct_enum_target() {
  nodes: vector<Expr> = [Lit { v: 1 }];
  for _ in 0..3 { nodes += [Neg { e: &nodes[len(nodes) - 1] }]; }
  assert(eval(nodes[0]) == 1 && eval(nodes[1]) == -1 && eval(nodes[2]) == 1 && eval(nodes[3]) == -1,
    "enum: {eval(nodes[1])} {eval(nodes[2])} {eval(nodes[3])}");
}

fn test_a_struct_enum_target_past_its_first_allocation() {
  e: vector<Expr> = [Lit { v: 2 }];
  for _ in 0..100 { e += [Neg { e: &e[len(e) - 1] }]; }
  assert(eval(e[1]) == -2 && eval(e[50]) == 2 && eval(e[99]) == -2 && eval(e[100]) == 2,
    "enum grown: {eval(e[1])} {eval(e[100])}");
  f: vector<Expr> = [Lit { v: 3 }];
  for _ in 0..100 { x = Neg { e: &f[len(f) - 1] }; f += [x]; }
  assert(eval(f[1]) == -3 && eval(f[100]) == 3, "enum through a local: {eval(f[1])} {eval(f[100])}");
}

fn test_a_struct_target_past_its_first_allocation() {
  a: vector<N> = [N { v: 0, c: null }];
  for i in 1..200 { a += [N { v: i, c: &a[len(a) - 1] }]; }
  bad = 0;
  for k in 1..len(a) { if a[k].c.v != k - 1 { bad += 1; } }
  assert(bad == 0, "struct grown: {bad} stale");
}

fn test_a_field_destination() {
  h = H { list: [T { name: "root", c: null }] };
  for i in 0..3 { h.list += [T { name: "f{i}", c: &h.list[len(h.list) - 1] }]; }
  assert(h.list[1].c.name == "root" && h.list[2].c.name == "f0" && h.list[3].c.name == "f1",
    "field: {h.list[1].c.name} {h.list[2].c.name} {h.list[3].c.name}");
}

fn main() {
  test_a_constant_index();
  test_the_index_reads_the_length_before_the_append();
  test_two_references_in_one_literal_name_places();
  test_a_struct_enum_target();
  test_a_struct_enum_target_past_its_first_allocation();
  test_a_struct_target_past_its_first_allocation();
  test_a_field_destination();
}
