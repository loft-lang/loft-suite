//
// `@FR-H-ShortRef` crossed with `@FR-B-Disturb`: a variable or a parameter may NAME string or
// vector content, or a record inline in a collection, and while it lives the store takes no
// addition and the collection no reordering — so each of B-Disturb's events, made while such
// a name lives, must answer what the binding rules say and not what the shared bytes happen
// to hold.  A struct element view across growths in a loop MATERIALISES (its bind-time value,
// its writes its own); a view of an element slot across a `sort` (B-Disturb's OVERWRITING
// event: the place itself does not end) re-reads the slot; a text and a vector bound from a
// field are copies untouched by an append to the field; a `text` parameter keeps the value it
// was handed when the callee appends to the field it was read from.
//
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.
// CHANNEL: the assertions and the leak gate.

struct Pt { x: integer, nm: text }
struct S { name: text, v: vector<integer>, pts: vector<Pt> }

fn app(s: S) { s.name += "!"; s.v += [9]; }
fn keep_text(t: text, s: S) -> text { s.name += "!"; "{t}/{s.name}" }

fn test_an_element_view_across_growths_in_a_loop() {
  s = S { name: "q", v: [], pts: [Pt { x: 1, nm: "a" }] };
  f = s.pts[0];
  for i in 0..20 { s.pts += [Pt { x: i + 10, nm: "n{i}" }]; }
  f.x += 5;
  assert(f.x == 6 && f.nm == "a" && s.pts[0].x == 1 && len(s.pts) == 21 && s.pts[20].nm == "n19",
         "materialised: {f.x}{f.nm} {s.pts[0].x} {len(s.pts)}");
}

fn test_a_view_of_a_slot_across_a_sort() {
  v = [Pt { x: 3, nm: "c" }, Pt { x: 1, nm: "a" }, Pt { x: 2, nm: "b" }];
  e = v[0];
  v.sort_by(|a| { a.x });
  assert(e.x == 1 && e.nm == "a" && v[2].nm == "c", "the slot re-read: {e.x}{e.nm}");
  e.x = 7;
  assert(v[0].x == 7 && len(v) == 3, "and written through: {v[0].x}");
}

fn test_copies_of_field_content_across_appends() {
  s = S { name: "ab", v: [1, 2], pts: [] };
  t = s.name;
  w = s.v;
  s.name += "cd";
  s.v += [3];
  app(s);
  assert(t == "ab" && len(w) == 2 && s.name == "abcd!" && len(s.v) == 4,
         "copies: {t} {len(w)} {s.name} {len(s.v)}");
}

fn test_parameters_naming_field_content() {
  s = S { name: "ab", v: [1, 2], pts: [] };
  r = keep_text(s.name, s);
  assert(r == "ab/ab!", "parameters: {r}");
}
