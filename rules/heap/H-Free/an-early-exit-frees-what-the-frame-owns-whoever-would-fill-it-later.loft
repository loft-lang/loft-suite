//
// AN EARLY EXIT FREES WHAT THE FRAME OWNS THERE, WHOEVER WOULD FILL IT LATER (`@FR-H-Free`).  A
// local a later bind makes an owner, a buffer an arm copy fills later, and a returned arm that may
// leave before its value is computed are each released on the exit taken.  Three sections, each
// with its cells and receipt.
//
// ── an-early-return-frees-a-local-a-later-bind-makes-an-owner ──
//
// @catches: LOFT_NO_LATE_OWNER_RESCAN — the switch decides the early return's frees from the local's deps where the return stands, before the bind that makes it an owner, and the store leaks on that path
//
// @FR-H-Free: every exit releases what the frame owns there.  `cond` takes a view of
// `mc.cond` on its first pass and `mc` is rebound on the next, so that bind is materialised
// and `cond` owns a copy — a fact the scope pass learns at the bind, below the early `return`
// in the loop.  Decided where the return stands, the return read `cond` as a view and skipped
// it while the frame's exit freed it: the store leaked on every early exit (the self-hosted
// elaborator's `tuple_match`).
//
// Axes this file MOVES:  where the loop leaves (early, after one pass, at the end); whether
//                        `cond` holds the view's copy or a fresh `v_if` when it leaves.
// Axes it HOLDS FIXED:   one record local rebound per pass; the view is a nullable field.
//
// @falsified-at: pending
//   CHANNEL: the VALUES (hand-computed) and the LEAK gate.
//   HOLDS: every cell, on every backend.
//
// ── an-early-return-frees-the-buffer-an-arm-copy-fills-later ──
//
// @catches: LOFT_ARM_COPY_FRESH_BUFFER — the arm copy takes a buffer the scan makes at the bind, missing from the frees of a return placed before it, and the entry-allocated store leaks
//
// @FR-H-Free: every exit releases what the frame owns.  A collection view materialised in a
// branch arm (`ops = match tail { TrBlock { block } => block[0].operators, _ => [] }` before
// `tail` is rebound) is refilled into a buffer allocated at function entry.  Made by the scan at
// the bind, the buffer was absent from the frees of the `return` placed before it: one store
// leaked per early exit.  The buffer the pass before the scan makes for the binding is in every
// exit's frees.
//
// Axes this file MOVES:  the exit (before the loop, inside it, the end).
// Axes it HOLDS FIXED:   the view is a `match` arm's collection field.
//
// @ARMED: LOFT_STRICT_STORES=1
// @falsified-at: pending
//   CHANNEL: the VALUES (hand-computed) and the strict-store leak gate.
//   HOLDS: every cell, on every backend.
//
// ── a-returned-arm-that-may-leave-early-frees-the-record-it-made ──
//
// @catches: LOFT_NO_RET_SRC_OWNS — the switch keeps every early-leaving arm's source a never-freed view, and a record the arm made leaks
//
// @FR-H-Free: every exit releases what the frame owns.  A `match` arm that can `return` before
// its value is computed is read into a local first and copied into the return buffer from
// there.  The local was never freed, as if it only viewed a record someone else releases;
// an arm ending in a call's fresh record owns it, and it leaked one record per pass (the
// self-hosted elaborator's `pattern_cond`, `v_if(lc.code, hc.code, …)` after `return null`).
//
// Axes this file MOVES:  how the arm ends (a fresh call, a local's field, a parameter's field,
//                        a whole owned local, a whole parameter, a nullable local, null, a
//                        struct literal — whose record is the literal buffer's, freed once).
// Axes it HOLDS FIXED:   each arm leaves early on the same test; the result is `Node?`.
//
// @ARMED: LOFT_REFREE_FAILS=1 LOFT_DOUBLE_FREE=1 — a literal arm's record freed by the return
//   source and by the literal's buffer is a re-free of an already-free slot, reported only so.
// @falsified-at: pending
//   CHANNEL: the VALUES (hand-computed) and the LEAK / double-free gate.
//   HOLDS: every cell, on every backend.

enum N { NB { b: boolean }, NI { i: integer, s: text }, NIf { a: N, c: N } }
struct MC { cond: N?, refused: boolean }

fn member_cond(k: integer, stop: integer) -> MC { MC { cond: NI { i: k, s: "c{k}" }, refused: k == stop } }
fn v_if(a: N, c: N) -> N { NIf { a: a, c: c } }
fn sz(n: N) -> integer { match n { NI { i, s } => i * 10 + len(s), NIf { a, c } => 1000 + sz(a) + sz(c), NB { b } => if b { 1 } else { 0 } } }

fn go(n: integer, stop: integer) -> integer {
  cond: N? = null;
  for pe in 1..n + 1 {
    mc = member_cond(pe, stop);
    if mc.refused { return -1; }
    if mc.cond != null {
      cond = if cond == null { mc.cond } else { v_if(cond!, mc.cond!) };
    }
  }
  if cond == null { 0 } else { sz(cond!) }
}

fn test_leaves_holding_the_copy() {
  assert(go(3, 2) == -1, "{go(3, 2)}");
}

fn test_leaves_holding_a_fresh_join() {
  assert(go(4, 3) == -1, "{go(4, 3)}");
}

fn test_runs_to_the_end() {
  assert(go(2, 0) == 1034 && go(3, 0) == 2066, "{go(2, 0)} {go(3, 0)}");
}

struct Op { operators: vector<Tr> }
enum Tr { TrBlock { block: vector<Op> }, TrInt { n: integer }, TrNull }

fn unspan(v: Tr) -> Tr { v }
fn depth_of(v: Tr, stop: boolean) -> integer {
  if stop {
    return -1;
  }
  tail = unspan(v);
  d = 0;
  while tail is TrBlock {
    ops = match tail { TrBlock { block } => block[0].operators, _ => [] };
    if len(ops) == 0 {
      return -2;
    }
    tail = unspan(ops[-1]);
    d += 1;
  }
  match tail { TrInt { n } => d * 100 + n, _ => -3 }
}

fn test_each_exit_frees_the_buffer() {
  inner = Tr::TrBlock { block: [Op { operators: [Tr::TrInt { n: 7 }] }] };
  outer = Tr::TrBlock { block: [Op { operators: [Tr::TrNull, inner] }] };
  empty = Tr::TrBlock { block: [Op { operators: [] }] };
  s = "";
  for _ in 0..2 { s += "{depth_of(outer, false)} {depth_of(outer, true)} {depth_of(empty, false)} {depth_of(Tr::TrInt { n: 4 }, false)} "; }
  assert(s == "207 -1 -2 4 207 -1 -2 4 ", s);
}

enum Node { NdNull, NdInt { n: integer }, NdBool { b: boolean }, NdIf { cond: Node, t: Node, f: Node } }
struct Ex { code: Node, tp: integer }
fn s3_v_if(a: Node, b: Node, c: Node) -> Node { NdIf { cond: a, t: b, f: c } }
fn mk(k: integer) -> Node { NdInt { n: k } }
fn s3_sz(n: Node) -> integer { match n { NdInt { n } => n, NdBool { b } => if b { 1 } else { 0 }, NdIf { cond, t, f } => 100 + s3_sz(cond) + s3_sz(t) + s3_sz(f), _ => 0 } }
// every arm but the first leaves early on k > 100; the arm's end is the axis
fn pc(p: Ex, q: Node, k: integer) -> Node? {
  match k % 7 {
    0 => null,
    1 => { if k > 100 { return null; } r = Ex { code: mk(k * 2), tp: 0 }; r.code },
    2 => { if k > 100 { return null; } s3_v_if(mk(k), mk(1), NdBool { b: false }) },
    3 => { if k > 100 { return null; } p.code },
    4 => { if k > 100 { return null; } o = mk(k + 1000); o },
    5 => { if k > 100 { return null; } q },
    _ => { if k > 100 { return null; } n: Node? = if k % 2 == 0 { mk(k) } else { null }; n }
  }
}

fn walk() -> text {
  p = Ex { code: mk(3), tp: 0 };
  q = mk(4);
  t = 0;
  out = "";
  for k in 0..14 { c = pc(p, q, k); if c != null { v = s3_sz(c!); t += v; out += "{v} "; } else { out += "- "; } }
  "{out}| {t} {s3_sz(p.code)} {s3_sz(q)}"
}

fn test_every_arm_ending() {
  r = walk();
  assert(r == "- 2 103 3 1004 4 6 - 16 110 3 1011 4 - | 2266 3 4", r);
}

fn test_the_early_exits() {
  p = Ex { code: mk(3), tp: 0 };
  q = mk(4);
  n = 0;
  for k in 101..115 { if pc(p, q, k) == null { n += 1; } }
  assert(n == 14 && s3_sz(p.code) == 3 && s3_sz(q) == 4, "{n}");
}

enum Lit { LNull, LInt { n: integer }, LIns { items: vector<Lit> } }
struct LEx { code: Lit, tp: integer }
fn lsz(n: Lit) -> integer { match n { LInt { n } => n, LIns { items } => { s = 100; for i in items { s += lsz(i); } s }, _ => 0 } }
fn lmk(k: integer) -> Lit { LInt { n: k } }
fn lit_arms(x: Lit, k: integer) -> Lit? {
  match x {
    LIns { items } => { if len(items) == 0 { return null; } items[0] = lmk(k); LIns { items: items } },
    LInt { n } => { if n > 100 { return null; } LInt { n: n + k } },
    _ => { r = LEx { code: lmk(k * 3), tp: 0 }; r.code }
  }
}

fn test_an_arm_ending_in_a_literal() {
  a = LIns { items: [lmk(1), lmk(2)] };
  b = LInt { n: 5 };
  c = LNull;
  s = 0;
  for k in 0..4 {
    p = lit_arms(a, k); if p != null { s += lsz(p!); }
    q = lit_arms(b, k); if q != null { s += lsz(q!); }
    r = lit_arms(c, k); if r != null { s += lsz(r!); }
  }
  assert(s == 458 && lsz(b) == 5, "{s}");
}
