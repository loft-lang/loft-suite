//
// `@FR-H-Handle` crossed with `@FR-H-Lease` — every `File` record that names an open handle
// `@FR-H-Handle-Copy` — a copy is legal: one handle, a position and a lease per copy.
// holds a lease on it, a record returns its lease once at its death, and the handle closes
// only when the LAST lease returns.  So a copy must keep reading after the record it was
// copied from has died, at its own position.  Walked over how the original dies while a copy
// lives — a local rebound, a holder struct rebound, a vector element removed (the view out of
// it materialises, `@FR-H-Materialise`, and takes a lease of its own), a vector element
// overwritten, a keyed record removed (both returned leases, unlike `@FR-H-Drop-Not`) — and
// over where the copy is made: a whole-value bind, a call that returns its parameter, a
// struct copy, and a copy made on every pass of a loop beside an original that lives on.
// Every file holds `abcdefghij`; a read takes three bytes.  The leak gate is the other half:
// a handle whose last lease never returned is an `open File handles×N` entry at exit.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.  The
//   control is a hand edit of one expected value, which fails that cell on both backends.
// CHANNEL: the assertion count, the exit code and the leak report, identically on both backends.
// ARMED: `LOFT_LEAK_CHECK=1` (the suite arms it on every run).
// HOLDS: panic is clean on both backends.

struct Holder { name: text, f: File }
struct KF { k: integer, f: File }

fn path(tag: text) -> text { "{temp_dir() ?? "/tmp"}/loft_suite_handle_lease_{tag}.txt" }

fn open(tag: text) -> File {
  p = path(tag);
  w = file(p);
  w.set_file_size(0);
  w += "abcdefghij";
  file(p)
}

fn rd(f: File) -> text { f#read(3) as text }
fn dup(f: File) -> File { f }

fn test_a_copy_outlives_its_rebound_local() {
  f = open("h1");
  a = rd(f);
  g = f;
  f = open("h1b");
  b = rd(g);
  c = rd(f);
  assert("{a} {b} {c}" == "abc def abc", "c1 {a} {b} {c}");
  assert((g#next ?? -1) == 6 && (f#next ?? -1) == 3, "c1 next {g#next ?? -1} {f#next ?? -1}");
}

fn test_a_struct_copy_outlives_its_rebound_holder() {
  h = Holder { name: "h", f: open("h2") };
  a = rd(h.f);
  k = h;
  h = Holder { name: "x", f: open("h2b") };
  b = rd(k.f);
  assert("{a} {b} {k.name} {h.name}" == "abc def h x", "c2 {a} {b} {k.name} {h.name}");
}

fn test_a_view_of_a_removed_element_keeps_reading() {
  v = [open("h3")];
  a = rd(v[0]);
  g = v[0];
  v.remove(0);
  b = rd(g);
  assert("{a} {b} {len(v)}" == "abc def 0", "c3 {a} {b} {len(v)}");
}

fn test_a_copy_outlives_an_overwritten_element() {
  v = [open("h4")];
  a = rd(v[0]);
  g = dup(v[0]);
  v[0] = open("h4b");
  b = rd(g);
  c = rd(v[0]);
  assert("{a} {b} {c} {len(v)}" == "abc def abc 1", "c4 {a} {b} {c} {len(v)}");
}

fn test_a_copy_outlives_a_removed_keyed_record() {
  h: hash<KF[k]> = [KF { k: 1, f: open("h5") }];
  a = "";
  g = open("h5-unused");
  for r in h { a = rd(r.f); g = dup(r.f); }
  h[1] = null;
  b = rd(g);
  assert("{a} {b} {len(h)}" == "abc def 0", "c5 {a} {b} {len(h)}");
}

fn test_a_copy_on_every_pass_beside_a_living_original() {
  f = open("h6");
  s = "";
  for _ in 0..3 { g = f; s += rd(g); }
  s += rd(f);
  assert(s == "abcabcabcabc", "c6 each copy starts at the original's own position: {s}");
}

fn test_a_returned_copy_outlives_its_rebound_source() {
  f = open("h7");
  a = rd(f);
  g = dup(f);
  f = open("h7b");
  b = rd(g);
  assert("{a} {b}" == "abc def", "c7 {a} {b}");
}
