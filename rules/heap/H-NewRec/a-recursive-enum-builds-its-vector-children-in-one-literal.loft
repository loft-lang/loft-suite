//
// A RECURSIVE ENUM BUILDS ITS VECTOR CHILDREN IN ONE LITERAL (`@FR-H-NewRec`).  H-NewRec: a
// fresh record inside a vector's store, its fields written before any read, the length grown
// by one — here a variant holds `vector<Node>` of its own type, and one nested literal builds
// the whole tree: each child record is minted inside its parent's `args` store as the literal
// descends.  The AST shape a parser builds in one expression (loft-lang/plans#202).
//
// Axes it MOVES: the depth (two levels, three), the arity (one child, two), the position of a
// leaf (first, last).  Values hand-computed: `total` sums the leaves, `count` the records.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed on 9121f1b50, interpret and native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the answer.
// HOLDS: `H-RefHome/a-generic-recursive-enum-links-its-nodes-through-locals`, the same tree through references.

enum Node {
  Leaf { v: integer },
  Call { name: text, args: vector<Node> },
}

fn total(n: Node) -> integer {
  match n {
    Leaf { v } => v,
    Call { name, args } => { s = 0; for a in args { s += total(a); } s },
  }
}

fn count(n: Node) -> integer {
  match n {
    Leaf { v } => 1,
    Call { name, args } => { c = 1; for a in args { c += count(a); } c },
  }
}

fn main() {
  n = Call { name: "f", args: [Leaf { v: 1 }, Call { name: "g", args: [Leaf { v: 2 }, Leaf { v: 3 }] }] };
  assert(total(n) == 6, "1 + (2 + 3): {total(n)}");
  assert(count(n) == 5, "two calls and three leaves: {count(n)}");
  deep = Call { name: "h", args: [Call { name: "g", args: [Call { name: "f", args: [Leaf { v: 4 }] }] }, Leaf { v: 5 }] };
  assert(total(deep) == 9, "4 through three levels, then 5: {total(deep)}");
  assert(count(deep) == 5, "three calls and two leaves: {count(deep)}");
}
