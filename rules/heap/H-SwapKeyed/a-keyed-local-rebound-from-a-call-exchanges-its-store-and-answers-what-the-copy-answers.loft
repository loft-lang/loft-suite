//
// A KEYED LOCAL REBOUND FROM A CALL EXCHANGES ITS STORE, AND ANSWERS WHAT THE COPY ANSWERS
// (`@FR-H-SwapKeyed`, with `@FR-H-SwapRebind`).  `h = build(…)` from a call that gave its collection
// up is an exchange of the two stores on both backends, without the reset, and every other name
// reads what a copy would have left.  Two sections, each with its cells and receipt.
//
// ── a-keyed-local-rebound-from-a-call-exchanges-its-store ──
//
// `@FR-H-SwapKeyed` — a keyed LOCAL rebound from a call that gave its collection up (`h =
// build(…)`, `OpReplaceKeyed`'s free-source form) is an EXCHANGE of the two stores on both
// backends: the local's store takes the callee's content, and the slot that ends up holding the
// local's old collection is released.  Walked at every keyed kind, rebound once, a thousand
// times in a loop, from a call handed the local itself (`h = grow(h, …)`), and with a copy taken
// before the rebind that must keep the old content (`@FR-B-Copy`).  The leak channel is the
// measurement: a released slot that is parked instead of freed stays live at exit.  The walk
// found no defect.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.  The
//   control is the hand patch below.
// ARMED: `LOFT_NATIVE_LEAK_CHECK=1`, which `scripts/falsify.sh` arms on every run of its own
//   accord; the interpreter's store census prints at exit unasked.
// HOLDS: exit, asserts and panic are unmoved on both trees.
//
// ── a-keyed-rebind-answers-what-the-copy-answers-beside-every-other-name ──
//
// `@FR-H-SwapKeyed` crossed with `@FR-H-SwapRebind` — a keyed LOCAL rebound from a call that gave
// its collection up is the exchange WITHOUT the reset, on both backends: the old collection
// leaves with the released slot and is freed with it.  What a program can see is only that the
// answer is the copy's: the new collection whole, nothing of the old, and every OTHER name
// unchanged.  `a-keyed-local-rebound-from-a-call-exchanges-its-store.loft` walks every keyed
// kind; this file crosses the exchange with what else holds or reads the old collection: a
// view of an old element held across the rebind (`@FR-H-Materialise` — reassigning the
// container disturbs it, so it reads its old value), a call that hands back another local's
// collection (not given up — that local keeps its own), elements that own text and vectors
// rebound five hundred times, a rebind to an empty collection, a rebind from a join, and a keyed
// FIELD (not a local — the copy path) with its neighbours.  Every cell checks value, length and
// absent keys, and the leak gate checks that each released slot was freed and not parked.
//
// @falsified-at: 9fb2a2898 — hand-measured, interpret and native: c1 and c1b fail (loft#2037).
//   A second control is a hand edit of one expected value, which fails that cell on both backends.
// CHANNEL: the assertion count, the exit code and the leak report, identically on both backends.
// ARMED: `LOFT_LEAK_CHECK=1` (the suite arms it on every run).
// HOLDS: panic is clean on both backends; the answers are the same under `LOFT_NO_STORE_SWAP=1`.
//   c1 and c1b are loft#2037's cells: on 9fb2a2898 both fail on both backends (the view read and
//   wrote the NEW collection, `501` and `7`), measured by hand.

struct E { k: integer, n: text, j: integer }

fn build_hash(a: integer, b: integer) -> hash<E[k]> {
  r: hash<E[k]> = [E { k: a, n: "x{a}", j: a }, E { k: b, n: "y{b}", j: b }];
  r
}

fn grow_hash(h: hash<E[k]>, a: integer) -> hash<E[k]> {
  h += [E { k: a, n: "z{a}", j: a }];
  h
}

fn total_hash(h: hash<E[k]>) -> integer {
  t = 0;
  for e in h {
    t += e.k;
  }
  t
}

fn walk_hash() {
  h: hash<E[k]> = [E { k: 1, n: "a", j: 1 }];
  g = h;
  h = build_hash(10, 20);
  assert(len(h) == 2 && total_hash(h) == 30 && len(g) == 1, "hash: rebound once");
  for i in 0..1000 {
    h = build_hash(i, i + 2);
  }
  assert(len(h) == 2 && total_hash(h) == 2000, "hash: rebound in a loop");
  s: hash<E[k]> = [E { k: 1, n: "a", j: 1 }, E { k: 6, n: "b", j: 6 }];
  s = grow_hash(s, 10);
  for i in 1..4 {
    s = grow_hash(s, i * 20);
  }
  assert(len(s) == 6 && total_hash(s) == 137, "hash: rebound from a call handed the local");
}

fn build_sorted(a: integer, b: integer) -> sorted<E[k]> {
  r: sorted<E[k]> = [E { k: a, n: "x{a}", j: a }, E { k: b, n: "y{b}", j: b }];
