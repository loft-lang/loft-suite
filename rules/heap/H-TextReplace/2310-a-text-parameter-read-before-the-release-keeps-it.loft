//
// `@FR-H-TextReplace` across frames, by PATH: a write through a parameter releases the text it
// replaces when no `text` parameter of the writer is read after a release on any path — and a
// read BEFORE every release on its path is no borrow kept past one.  The writer that appends
// its text parameter on one branch and replaces with it on the other (`put_text`, the @PLN91
// loft interpreter's text stack) has no path that reads the parameter after the replace, and so
// do a copy into a fresh element before the replace and a read in an earlier statement.  Each
// was declined when the parameter was counted by MENTION, and a loop over the writer kept every
// text it ever wrote (loft#2310).  A read AFTER the replace on its path stays declined (r_after),
// and so does one in a loop's next round; every value below is the same either way and is
// computed by hand, the census cells count the store's live records after 10 and after 1 000
// calls with the vector still alive.
//
// Expected, by hand: b_put over ["abc", "row of many", "x"] for k in 0..n leaves `st[0]` the
// text of round n - 1 and `len` sums to 3/11/1 per round; r_before and r_after both answer
// "second" in slot 0 and the appended "second" in slot 1; r_loop rewrites both slots.
//
// @falsified-at: 0e95172cd — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   CHANNEL: an assertion in the census, on BOTH backends.
//   ARMED: nothing beyond the run itself — the census is `store_memory()`'s live-record count.
//   WITNESS: `c_put grows: 15 -> 1005` (`13 -> 1003` on the C backend).
//   HOLDS: every value cell, on both trees.  The declines (r_after, r_loop) are not observable
//     here: `@FR-F-ParamText` copies at the call a text argument that views a store the callee
//     writes, so their values are right whether or not the release is admitted — the value
//     cells pin the values, and the walk in `scopes/text_replace.rs` keeps them declined.

fn census_records() -> integer {
  cr_t = store_memory();
  cr_i = cr_t.find("records ");
  if !cr_i { return -1 }
  cr_j = cr_i + 8;
  cr_n = 0;
  while cr_j < len(cr_t) && cr_t[cr_j] >= '0' && cr_t[cr_j] <= '9' {
    cr_n = cr_n * 10 + (cr_t[cr_j] as integer - '0' as integer);
    cr_j += 1;
  }
  cr_n
}

// The issue's shape: the parameter is the replace's value on one branch, an appended element on
// the other.
fn put_text(stack: vector<text?>, sp: integer, v: text?) {
  if sp < len(stack) {
    stack[sp] = v;
  } else {
    stack += [v];
  }
}

// Read (copied into a fresh element) BEFORE the replace, in the same body.
fn copy_then_replace(stack: vector<text?>, v: text?) {
  stack += [v];
  stack[0] = v;
}

// Read AFTER the replace: declined, as it was.
fn replace_then_copy(stack: vector<text?>, v: text?) {
  stack[0] = v;
  stack += [v];
}

// The replace inside a loop whose next round reads the parameter as an argument: declined.
fn loop_read(stack: vector<text?>, v: text?) {
  for i in 0..2 {
    stack[i] = v;
    assert(len(v ?? "") > 0, "loop round {i}");
  }
}

fn b_put(n: integer) -> integer {
  src: vector<text> = ["abc", "row of many", "x"];
  st: vector<text?> = [];
  total = 0;
  for k in 0..n {
    put_text(st, 0, "{src[k % 3]} #{k}");
    total += len(st[0] ?? "");
  }
  assert(st[0] == "{src[(n - 1) % 3]} #{n - 1}", "b_put last: {st[0] ?? "null"}");
  assert(len(st) == 1, "b_put length: {len(st)}");
  total
}

fn c_put(n: integer) -> integer {
  st: vector<text?> = ["start"];
  for k in 0..n {
    put_text(st, 0, "round {k} text, long enough");
  }
  assert(st[0] == "round {n - 1} text, long enough", "c_put {st[0] ?? "null"}");
  census_records()
}

fn c_copy_first(n: integer) -> integer {
  st: vector<text?> = ["start"];
  for k in 0..n {
    copy_then_replace(st, "round {k} text, long enough");
    st = [st[0]];
  }
  assert(st[0] == "round {n - 1} text, long enough", "c_copy_first {st[0] ?? "null"}");
  census_records()
}

fn r_before() -> text {
  st: vector<text?> = ["first"];
  copy_then_replace(st, "second");
  "{st[0] ?? "null"}|{st[1] ?? "null"}"
}

fn r_after() -> text {
  st: vector<text?> = ["first"];
  replace_then_copy(st, "second");
  "{st[0] ?? "null"}|{st[1] ?? "null"}"
}

fn r_loop() -> text {
  st: vector<text?> = ["one", "two"];
  loop_read(st, "both");
  "{st[0] ?? "null"}|{st[1] ?? "null"}"
}

fn main() {
  // 3 + 11 + 1 = 15 per three rounds, plus the " #k" suffix of each round.
  assert(b_put(3) == 3 + 3 + 11 + 3 + 1 + 3, "b_put 3: {b_put(3)}");
  assert(r_before() == "second|second", "r_before {r_before()}");
  assert(r_after() == "second|second", "r_after {r_after()}");
  assert(r_loop() == "both|both", "r_loop {r_loop()}");
  assert(census_records() >= 0, "the census answers");
  assert(c_put(1000) == c_put(10), "c_put grows: {c_put(10)} -> {c_put(1000)}");
  assert(c_copy_first(1000) == c_copy_first(10), "c_copy_first grows: {c_copy_first(10)} -> {c_copy_first(1000)}");
}
