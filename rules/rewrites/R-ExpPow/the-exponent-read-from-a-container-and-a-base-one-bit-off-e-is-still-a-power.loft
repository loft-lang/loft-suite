//
// THE EXPONENT MAY COME FROM A CONTAINER OR A LOOP, AND A BASE ONE BIT OFF `E` IS STILL A
// GENERAL POWER (`@FR-R-ExpPow`).  The rewrite reads only the BASE of `pow`: a base that is the
// constant `E` or a literal with exactly its bits makes the call the platform's `exp`, whatever
// the exponent's spelling — a vector element, a struct field, a loop variable — and whether the
// call sits in a loop body.  A base that is not exactly `E` (the next double above it, or `-E`)
// must stay `pow`: folding it to `exp` would answer a different number.
//
// Axes this file MOVES:  the exponent's source (vector element, struct field, loop variable,
//                        reverse-loop variable), the call's context (loop body, comparison
//                        operand, interpolation), the base (E, the double above E, -E, the
//                        literal 2.718281828459045 spelled in a comparison), the exponent
//                        (0.0, 0.5, -1.0, 2.0, 3.0, 10.0, -1.0 to 1.0 in a loop).
// Axes it HOLDS FIXED:   `float` only (the existing cell has the `single` forms).
// Over the existing cell it ADDS: exponents read from containers/loops, and the decline
//                        boundary of the base (the existing cell's only decline is base 2.0).
//
// Expected values by hand (the reference's `exp`, correctly rounded; each is the shortest
// text that reads back to the double):
//   exp(0) = 1;  exp(0.5) = sqrt(E) = 1.6487212707001282;  exp(-1) = 1/E = 0.36787944117144233;
//   exp(2) = E^2 = 7.38905609893065;  exp(3) = 20.085536923187668;  exp(10) = 22026.465794806718.
//   Decline: the double above E is 2.7182818284590455 (E = 2.718281828459045, spacing 2^-51 =
//   4.44e-16).  pow(that, 1.0) is that base itself, 2.7182818284590455, whereas exp(1.0) is E;
//   the two differ, so a fold on a near-E base is caught.  pow(-E, 2.0) = (-E)*(-E), a square
//   correctly rounded, 7.3890560989306495 — one bit below exp(2) = 7.38905609893065, so a fold
//   of the negative base is caught too.
//
// @falsified-at: the switch off (`LOFT_NO_EXP_POW=1`, the general pow) — interpret and native-c
//   `ladder 3` answered 7.3890560989306495 for exp(2) = 7.38905609893065 -> ok.  Reach: `loft
//   introspect` of `ladder`, `from_field` and main's loops shows `OpMathFuncFloat(10, ..)` with
//   the rule and `t_5float_pow(OpMathEFloat(), ..)` without; `near_e` (`OpPowFloat` on the
//   literal 2.7182818284590455) and `neg_e` (`t_5float_pow(-E, ..)`) are the same both ways.

struct Rate { k: float }

fn ladder(xs: vector<float>) -> vector<float> {
  out: vector<float> = [];
  for x in xs { out += [pow(E, x) ?? 0.0]; }
  out
}

fn from_field(r: Rate) -> float? { E.pow(r.k) }

fn near_e(x: float) -> float? { pow(2.7182818284590455, x) }

fn neg_e(x: float) -> float? { pow(-E, x) }

fn main() {
  xs: vector<float> = [0.0, 0.5, -1.0, 2.0, 3.0, 10.0];
  want: vector<float> = [1.0, 1.6487212707001282, 0.36787944117144233, 7.38905609893065, 20.085536923187668, 22026.465794806718];
  got = ladder(xs);
  assert(len(got) == 6, "length {len(got)}");
  for i in 0..6 { assert(got[i] == want[i], "ladder {i}: {got[i]} wanted {want[i]}"); }
  one: vector<float> = [2.0];
  g1 = ladder(one);
  assert(len(g1) == 1 && g1[0] == 7.38905609893065, "one: {g1[0]}");
  none: vector<float> = [];
  g0 = ladder(none);
  assert(len(g0) == 0, "empty: {len(g0)}");
  r = Rate { k: 3.0 };
  f = from_field(r);
  assert((f ?? 0.0) == 20.085536923187668, "field: {f}");
  // the exponent is a loop variable (forward and reverse)
  lw: vector<float> = [1.0, 2.718281828459045, 7.38905609893065];
  for k in 0..3 {
    v = pow(E, k as float) ?? 0.0;
    assert(v == lw[k], "loop var {k}: {v}");
  }
  for j in rev(0..3) {
    v = pow(E, (j as float) - 1.0) ?? 0.0;
    assert(v == (if j == 0 { 0.36787944117144233 } else if j == 1 { 1.0 } else { 2.718281828459045 }), "reverse loop var {j}: {v}");
  }
  // decline boundary: the base is not exactly E
  a = near_e(1.0) ?? 0.0;
  assert(a == 2.7182818284590455, "base above E stays pow: {a}");
  b = neg_e(2.0) ?? 0.0;
  assert(b == 7.3890560989306495, "negative base stays pow: {b}");
  e2 = pow(E, 2.0) ?? 0.0;
  assert(b != e2, "-E squared is not exp(2): {b} vs {e2}");
  e1 = pow(E, 1.0) ?? 0.0;
  assert(e1 == 2.718281828459045, "exact base folds: {e1}");
}
