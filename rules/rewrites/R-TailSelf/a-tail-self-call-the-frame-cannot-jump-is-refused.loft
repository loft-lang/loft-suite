//
// A TAIL SELF-CALL THE FRAME CANNOT JUMP IS REFUSED (`@FR-R-TailSelf`'s refusal, @C155).  A
// self-call in tail position is a jump that reuses the frame; where the frame cannot be reused
// — an argument for a store-held parameter that MAKES a value (a literal) or names a local the
// jump releases, a text parameter handed anything but itself (a text's assignment owns, so it
// has no pointer move), a parameter the body REBINDS (the frame then owns its store, and the
// epilogue would free it under the temporary that read it — a use after free the strict-store
// check caught), where a call only shares a pointer — the program is refused at the call, naming
// the variable and the cure.  A generic is refused per INSTANCE: `swap<text>` where `swap<S>`
// jumps.  Left a call it would stop at 10 000 frames: a limit that holds for
// small inputs and fails for large ones is never shipped silently.  One function per shape; a
// self-call that is an operand is not in tail position and draws no refusal (the limits cell).
//
// @falsified-at: 591763c7a — every function here compiles there and stops at 10 000 frames.
// CHANNEL: expect — each function's refusal.
// ARMED: no instrument.
// WITNESS: a build admitting one of these compiles its function and leaves its claim unanswered.
// HOLDS: `a-parameter-passed-through-is-the-pointer-the-call-binds` — the arguments the clause
//   takes; `a-result-held-in-a-store-is-delivered-as-the-call-would` — the results it delivers.

struct Rec { n: integer }

// @EXPECT_ERROR: `swap<text>` calls itself in tail position
fn swap<T>(n: integer, a: T, b: T) -> T { if n == 0 { a } else { swap(n - 1, b, a) } }

// @EXPECT_ERROR: parameter `acc` (a `text`) can only be passed through as itself
fn fresh_arg(n: integer, acc: text) -> integer { if n == 0 { len(acc) } else { fresh_arg(n - 1, acc + "x") } }

// @EXPECT_ERROR: argument for parameter `v` (a `vector<integer>`) makes a value
fn literal_arg(v: vector<integer>, n: integer) -> integer { if n == 0 { len(v) } else { literal_arg([n], n - 1) } }

// @EXPECT_ERROR: argument for parameter `v` (a `vector<integer>`) makes a value
fn local_arg(v: vector<integer>, n: integer) -> integer { w = [n]; if n == 0 { len(v) } else { local_arg(w, n - 1) } }

// @EXPECT_ERROR: parameter `p` (a `Rec`) is rebound in the body
fn rebound(p: Rec, n: integer) -> integer { if n == 0 { p.n } else { p = Rec { n: p.n + 1 }; rebound(p, n - 1) } }

fn main() {
  println("{swap(1, Rec { n: 1 }, Rec { n: 2 }).n} {swap(1, \"a\", \"b\")} {fresh_arg(2, \"\")} {literal_arg([1], 2)} {local_arg([1], 2)} {rebound(Rec { n: 0 }, 3)}");
}
