//
// A SELF-CALL OUTSIDE TAIL POSITION, OR BESIDE A STORE, STAYS A CALL (`@FR-R-TailSelf`'s
// limits).  A self-call that is an operand (`fib`), or sits inside the tail call's own
// argument (`nested`), is not in tail position and keeps its frame; a function whose frame
// owns a store — a `text` local (`named`), a vector parameter (`vsum`) — is outside the first
// clause (the heap clause is loft-lang/plans#202 P5b), so its self-call stays a call even in
// tail position; a mutual recursion is not a SELF-call (`is_even`/`is_odd`).  Each answers the
// recursion's value at a depth a call reaches.
//
// @falsified-at: none — the limit cells of a rule that holds: every shape here is a call on
//   every build, and the values pin that the pass leaves them right.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the value.
// HOLDS: `a-self-call-in-tail-position-runs-to-any-depth` beside it.

fn fib(n: integer) -> integer { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }
fn nested(n: integer, acc: integer) -> integer { if n == 0 { acc } else { nested(n - 1, acc + nested(0, 1)) } }
fn named(n: integer, acc: integer) -> integer { s = "x"; if n == 0 { acc + len(s) } else { named(n - 1, acc + 1) } }
fn vsum(v: vector<integer>, i: integer, acc: integer) -> integer { if i == len(v) { acc } else { vsum(v, i + 1, acc + v[i]) } }
fn is_even(n: integer) -> boolean { if n == 0 { true } else { is_odd(n - 1) } }
fn is_odd(n: integer) -> boolean { if n == 0 { false } else { is_even(n - 1) } }

fn main() {
  assert(fib(20) == 6765, "an operand: {fib(20)}");
  assert(nested(3, 0) == 3, "inside the tail call's argument: {nested(3, 0)}");
  assert(named(3, 0) == 4, "a text local: {named(3, 0)}");
  assert(vsum([1, 2, 3], 0, 0) == 6, "a vector parameter: {vsum([1, 2, 3], 0, 0)}");
  assert(is_even(10) && !is_even(7), "a mutual recursion: {is_even(10)} {is_even(7)}");
}
