//
// A SELF-CALL OUTSIDE TAIL POSITION STAYS A CALL (`@FR-R-TailSelf`'s limits).  A self-call
// that is an operand (`fib`), or sits inside the tail call's own argument (`nested`), is not in
// tail position and keeps its frame — and draws no refusal; a mutual recursion is not a
// SELF-call (`is_even`/`is_odd`).  Each answers the recursion's value at a depth a call
// reaches.  A tail self-call whose frame cannot be reused stays a call with a warning, never silently
// (`a-tail-self-call-the-frame-cannot-jump-warns` beside this one).
//
// @falsified-at: none — the limit cells of a rule that holds: every shape here is a call on
//   every build, and the values pin that the pass leaves them right.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the value.
// HOLDS: `a-self-call-in-tail-position-runs-to-any-depth` and the refusal cell beside it.

fn fib(n: integer) -> integer { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }
fn nested(n: integer, acc: integer) -> integer { if n == 0 { acc } else { nested(n - 1, acc + nested(0, 1)) } }
fn is_even(n: integer) -> boolean { if n == 0 { true } else { is_odd(n - 1) } }
fn is_odd(n: integer) -> boolean { if n == 0 { false } else { is_even(n - 1) } }

fn main() {
  assert(fib(20) == 6765, "an operand: {fib(20)}");
  assert(nested(3, 0) == 3, "inside the tail call's argument: {nested(3, 0)}");
  assert(is_even(10) && !is_even(7), "a mutual recursion: {is_even(10)} {is_even(7)}");
}
