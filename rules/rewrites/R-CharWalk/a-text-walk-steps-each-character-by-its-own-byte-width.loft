//
// A TEXT WALK STEPS EACH CHARACTER BY ITS OWN BYTE WIDTH WHICHEVER ARM TAKES THE STEP
// (`@FR-R-CharWalk`).  `for c in T` over a text variable takes an ASCII byte other than NUL in
// one move (`c` is the byte, `c#next` steps by one) and every other byte through the step as
// written; where the body never writes T the null test is asked once before the loop.  The
// answer must be the step-as-written's: each character in order, at its byte offset
// `c#index`, the offset advancing by the character's UTF-8 width (1, 2, 3, 4), an embedded
// NUL read as the null character one byte wide, nothing for the empty text, and a text the
// body grows walked as it was given.
//
// Axes this file MOVES:  the bytes (ASCII, the 0x01 and 0x7F ends of the fast range, the
//                        2-byte 0x80 just outside it, '€', '😀', an embedded NUL), the text's
//                        length (0, 1, many), the body (a trace of offsets, compares against
//                        literals, a nested walk of the same text, a body that appends to T).
// Axes it HOLDS FIXED:   the walked source is a text parameter or an owned local.
//
// Expected values by hand (UTF-8 widths: ASCII 1, 'é' 2, '€' 3, '😀' 4):
//   trace("Tri9")        T@0;r@1;i@2;9@3;
//   trace("q€é😀z")      q@0 (1 byte) → '€' @1 (3) → 'é' @4 (2) → '😀' @6 (4) → z @10:
//                        q@0;€@1;é@4;😀@6;z@10;
//   trace("a\0b")        a@0, the NUL is the null character N one byte wide @1, b@2: a@0;N@1;b@2;
//   trace("")            nothing: ""
//   edges                bytes 0x01, 0x7F, then U+0080 and U+00FF (2 bytes each): code points
//                        and offsets 1@0;127@1;128@2;255@4;
//   classify("Hi, 4 U!") H and U are upper (2), i lower (1), 4 a digit (1), ',' ' ' ' ' '!' other
//                        (4): 2*1000 + 1*100 + 1*10 + 4 = 2114
//   weighted("xyz")      sum c#index * code point = 0*120 + 1*121 + 2*122 = 365
//   codepoints("aé€😀b") 97 + 233 + 8364 + 128512 + 98 = 137304; "Az" 65 + 122 = 187
//   same_pairs("abca")   a×a 2*2 = 4, b×b 1, c×c 1 = 6
//   grown("abc")         the walk takes the text once: 3 rounds, each appends one 'z' (n < 4
//                        holds for n = 1, 2, 3): "abczzz" is 6 bytes: 3*100 + 6 = 306
//
// @EXPECT_WARNING: Warning[loop-source-written]
// @falsified-at: none — a coverage cell for a rewrite already correct on main; reach shown by
//   the rewrite census (`--native-c --native-emit` with `LOFT_REWRITE_CENSUS`): `R-CharWalk`
//   fires for this cell and not with `LOFT_NO_CHAR_WALK=1`.

fn trace(s: text) -> text {
  out = "";
  for c in s {
    if c == null { out += "N"; } else { out += "{c}"; }
    out += "@{c#index};";
  }
  out
}

fn classify(s: text) -> integer {
  up = 0;
  low = 0;
  dig = 0;
  other = 0;
  for c in s {
    if c >= 'A' && c <= 'Z' { up += 1; }
    else if c >= 'a' && c <= 'z' { low += 1; }
    else if c >= '0' && c <= '9' { dig += 1; }
    else { other += 1; }
  }
  up * 1000 + low * 100 + dig * 10 + other
}

fn weighted(s: text) -> integer {
  t = 0;
  for c in s { t += c#index * (c as integer); }
  t
}

fn codepoints(s: text) -> integer {
  t = 0;
  for c in s { t += c as integer; }
  t
}

fn same_pairs(s: text) -> integer {
  n = 0;
  for a in s { for b in s { if a == b { n += 1; } } }
  n
}

fn grown() -> integer {
  t = "abc";
  n = 0;
  for c in t {
    n += 1;
    if n < 4 { t += "z"; }
  }
  n * 100 + size(t)
}

fn edges() -> text {
  t = "{1 as character}{127 as character}{128 as character}{255 as character}";
  out = "";
  for c in t { out += "{c as integer}@{c#index};"; }
  out
}

fn main() {
  a = trace("Tri9");
  assert(a == "T@0;r@1;i@2;9@3;" && len(a) == 16, "ascii: {a}");
  b = trace("q€é😀z");
  assert(b == "q@0;€@1;é@4;😀@6;z@10;", "widths: {b}");
  n = trace("a\0b");
  assert(n == "a@0;N@1;b@2;", "nul: {n}");
  e = trace("");
  assert(e == "" && len(e) == 0, "empty: {e}");
  g = edges();
  assert(g == "1@0;127@1;128@2;255@4;", "edges: {g}");
  k = classify("Hi, 4 U!");
  assert(k == 2114, "classify: {k}");
  w = weighted("xyz");
  assert(w == 365, "weighted: {w}");
  c1 = codepoints("aé€😀b");
  c2 = codepoints("Az");
  assert(c1 == 137304 && c2 == 187, "codepoints: {c1} {c2}");
  p = same_pairs("abca");
  assert(p == 6, "same pairs: {p}");
  r = grown();
  assert(r == 306, "grown: {r}");
}
