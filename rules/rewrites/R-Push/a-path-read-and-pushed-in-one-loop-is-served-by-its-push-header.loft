//
// A PATH READ AND PUSHED IN ONE LOOP IS SERVED BY ITS PUSH HEADER (`@FR-R-Push` crossed with
// `@FR-R-Header`, and `@FR-R-State`).  R-Push's holder is R-Header's triple plus the capacity,
// and R-State asks that a loop hold AT MOST ONE holder per path: a path the loop both READS
// and PUSHES takes the push header and leaves the read list, a nested loop reading the same
// path re-uses the enclosing frame's holder, and a view of a held path copies the holder.  A
// second holder for the pushed path would be a plain header frozen at the loop's entry: its
// length and record go stale at the first push, so a read of the new tail answers null and a
// read after a growth reads the record the growth left behind.  Each cell reads the pushed
// path every way a body can — an index of the new tail, `len` inside the loop, a nested loop
// over the whole path, a view taken inside the loop — next to a read-only path that keeps
// its plain header.
//
// Axes it MOVES: the pushed path (a local, a field path), where it is re-read (same body, a
// nested loop, a view), growth (inside the first claim, past it), the read-only partner
// (absent, beside).  Values hand-computed in each cell's comment.
//
// Firing read off `--native-emit`: one `__ph_` push header per pushed path per frame and a
// `__vh_` header for the read-only `v`, no `__vh_` for a pushed path; `scripts/emission_audit.py`
// clean.  Cross-backend; `LOFT_HOIST_VERIFY=1` (every push and every held read re-derives its
// header) and `LOFT_NO_PUSH_HOIST=1` / `LOFT_NO_VECTOR_HOIST=1` answer the same.
//
// @falsified-at: none — a conformance guard of the hoist state; no build known to hold two
//   holders for one path.  The cells are what a second plain holder would fail: its length
//   frozen at entry, `w[len(w) - 1]` answers null in a1 and every nested sum stops at the
//   entry length.
// CHANNEL: the asserts.
// ARMED: LOFT_HOIST_VERIFY=1 on --native.
// WITNESS: each message prints the sum or the length the loop saw.
// HOLDS: the interpreter (no hoist) is the oracle of every cell.

struct Acc { w: vector<integer>, k: integer }

// a1 — v = [1,2,3] read-only; w = [10,20] pushed x + len(w), then summed by a nested loop
// and read through a view.  i=0: push 1+2=3 → w=[10,20,3], s=33, last 3, len 3 → 39;
// i=1: push 2+3=5, s=38, +5+4 → 47; i=2: push 3+4=7, s=45, +7+5 → 57; i=3: push 1+5=6,
// s=51, +6+6 → 63.  acc = 39+47+57+63 = 206.
fn test_a_pushed_path_is_read_by_a_nested_loop_and_a_view() {
  v: vector<integer> = [1, 2, 3];
  w: vector<integer> = [10, 20];
  acc = 0;
  for i in 0..4 {
    x = v[i % 3] ?? 0;
    w += [x + len(w)];
    s = 0;
    for j in 0..len(w) { s += w[j] ?? 0; }
    d = &w;
    acc += s + (d[len(d) - 1] ?? 0) + len(d);
  }
  assert(len(w) == 6, "a1 len {len(w)}");
  assert(w[2] == 3 && w[3] == 5 && w[4] == 7 && w[5] == 6, "a1 tail {w}");
  assert(acc == 206, "a1 acc {acc}");
}

// a2 — forty pushes, past the first claim and two growths: t sums w[i / 2] = 2·(i/2) and
// len(w) = i + 1 per pass.  Σ 2·⌊i/2⌋ over 0..40 = 2·2·(0+…+19) = 760; Σ (i+1) = 820.
fn test_a_growth_moves_the_record_the_reads_follow() {
  w: vector<integer> = [];
  t = 0;
  for i in 0..40 {
    w += [i * 2];
    t += w[i / 2] ?? -1000;
    t += len(w);
  }
  assert(len(w) == 40 && w[39] == 78 && w[0] == 0, "a2 len {len(w)} last {w[39]}");
  assert(t == 1580, "a2 t {t}");
}

// a3 — a FIELD path pushed, re-read whole by a nested loop each pass.  a.k = 3:
// i=0 push 0 → [5,0] sum 5; i=1 push 3 → [5,0,3] sum 8; i=2 push 6 → [5,0,3,6] sum 14.
// tot = 27.
fn test_a_pushed_field_path_is_reread_by_a_nested_loop() {
  a = Acc { w: [5], k: 3 };
  tot = 0;
  for i in 0..3 {
    a.w += [a.k * i];
    for j in 0..len(a.w) { tot += a.w[j] ?? 0; }
  }
  assert(len(a.w) == 4 && a.w[3] == 6, "a3 {a.w}");
  assert(tot == 27, "a3 tot {tot}");
}

// a4 — the read-only path is read in an outer AND a nested loop while another path grows:
// the nested loop re-uses the outer frame's header for `v`.  v = [2,4,6]; per pass i the
// nested loop adds v[0]+v[1]+v[2] = 12 and the outer reads v[i % 3]; w gets i * 12.
// s = 4·12 + (2+4+6+2) = 62; w = [0,12,24,36], Σw = 72.
fn test_a_read_only_path_keeps_one_header_across_a_nested_loop() {
  v: vector<integer> = [2, 4, 6];
  w: vector<integer> = [];
  s = 0;
  for i in 0..4 {
    s += v[i % 3] ?? 0;
    inner = 0;
    for j in 0..len(v) { inner += v[j] ?? 0; }
    s += inner;
    w += [i * inner];
  }
  sw = 0;
  for x in w { sw += x; }
  assert(s == 62 && len(w) == 4 && sw == 72, "a4 s {s} w {w}");
}

// a5 — a view of the pushed path taken BEFORE the loop is rebound at no point, so it reads
// the same vector the push grows: each pass reads the view's length and its last element.
// Pass i pushes i+1 onto [9]: len(d) = i+2, last = i+1, t = Σ (2i+3) over 0..5 = 35.
fn test_a_view_of_the_pushed_path_sees_every_push() {
  w: vector<integer> = [9];
  d = &w;
  t = 0;
  for i in 0..5 {
    w += [i + 1];
    t += len(d) + (d[len(d) - 1] ?? 0);
  }
  assert(t == 35 && len(w) == 6 && len(d) == 6, "a5 t {t} len {len(w)}");
}

fn main() {
  test_a_pushed_path_is_read_by_a_nested_loop_and_a_view();
  test_a_growth_moves_the_record_the_reads_follow();
  test_a_pushed_field_path_is_reread_by_a_nested_loop();
  test_a_read_only_path_keeps_one_header_across_a_nested_loop();
  test_a_view_of_the_pushed_path_sees_every_push();
}
