//
// A FRONT PUSH MOVES THE OLD NODE WHOLE, A RECORD'S OR A VARIANT'S (`@FR-R-Demote`).  `h = N { …,
// next: h }` and `o.next = N { …, next: o.next }` move the old node into a fresh child of the
// destination's store instead of copying it, and keep everything it owns; for a struct-enum whose
// variant holds the enum out of line (`e = A { …, next: e }`) the old record moves whole the same
// way.  Each section keeps its own cases and receipt.
//
// ── a-front-push-moves-the-old-node-and-keeps-what-it-owns ──
//
// `@FR-R-Demote` — `h = N { …, next: h }` and `o.next = N { …, next: o.next }` MOVE the old node
// into a fresh child of the destination's store instead of copying the list: the program sees the
// value the copy would build.  The old node's text and vector move with it, so the literal's
// writes into the destination's record release nothing the child now holds; an absent
// destination takes the literal as built.  2,000 pushes check the list end to end.
//
// @falsified-at: none — a conformance guard: the copy it replaces gave the same values; it
//   holds the move to them.  The emitted C carries `loft_demote_rec` at each push (4 sites).
// Hand-computed.  CHANNEL: the asserts, the leak gate and the strict store checks.
// @ARMED: LOFT_STRICT_STORES=1
// `walk` drains its own parameter through a link (`cur = &n; cur = &cur.next`): that rebinds the
// callee's name only (`@FR-F-ParamRebind`), and releasing the displaced store freed `main`'s list
// before its next read — reported here by the strict checks.
// HOLDS: every assertion and the leak gate on all three backends, with `OpDemoteRec` and with
//   the five-op form it replaces (`LOFT_NO_DIRECT_DEMOTE=1`).
//
// ── a-variant-pushed-at-the-front-moves-the-old-record-whole ──
//
// `@FR-R-Demote`, the VARIANT clause — `e = A { …, next: e }` for a struct-enum whose variant
// holds the enum itself out of line MOVES the old record into a fresh child of `e`'s store and
// writes the variant's fields and tag into `e`'s record, where the copy built the variant in a
// store of its own, copied the whole list in and back.  The old record may be ANY variant, a
// larger one too: every record of the enum is the enum's size, and the move takes all of it.
// A field that reads the destination elsewhere declines the move and answers the copy's value;
// a rebuild over the whole list releases it.  The literal is built in `e` itself
// (`@FR-R-InPlaceLiteral`'s variant clause).
//
// @falsified-at: a build of this tree whose variant clause moved the old record as the
//   LITERAL's variant (`tp` of `A`, the struct clause's choice) — the `B` under an `A` lost its
//   tail: "A4 B1.0.0" (interpret), "A4 B1.3.47244640258" (native-c) -> ok.
// CHANNEL: the asserts and the leak gate.
// HOLDS: every assertion and the leak gate on all three backends, with the clause and without
//   it (`LOFT_NO_DEMOTE=1`, `LOFT_NO_VARIANT_INPLACE=1`).

struct N { v: integer, name: text, tags: vector<integer>, next: N? }

fn walk(n: N?) -> text {
  out = "";
  cur = &n;
  while cur != null { out += "{cur.v}{cur.name}{len(cur.tags)} "; cur = &cur.next; }
  out
}

fn test_a_front_push_moves_the_old_node_and_keeps_what_it_owns() {
  h = N { v: 1, name: "a", tags: [1] };
  h = N { v: 2, name: "bb", tags: [1, 2], next: h };
  h = N { v: 3, name: "ccc", tags: [], next: h };
  assert(walk(h) == "3ccc0 2bb2 1a1 ", "front pushes: {walk(h)}");
  h.next = N { v: 9, name: "z", tags: [7, 7, 7], next: h.next };
  assert(walk(h) == "3ccc0 9z3 2bb2 1a1 ", "a push after the head: {walk(h)}");
  e: N? = null;
  e = N { v: 5, name: "e", tags: [5], next: e };
  assert(walk(e) == "5e1 ", "an absent destination: {walk(e)}");
  l = N { v: 0, name: "", tags: [] };
  for i in 1..2000 { l = N { v: i, name: "{i % 10}", tags: [i], next: l }; }
  s = 0;
  n = 0;
  c = &l;
  while c != null { s += c.v + len(c.tags) + len(c.name); n += 1; c = &c.next; }
  assert(n == 2000 && s == 1999000 + 1999 + 1999, "2,000 pushes: {n} {s}");
  println("demote ok");
}

enum E {
  Nil,
  A { x: integer, next: E },
  B { a: integer, b: integer, c: integer, next: E },
  T { s: text, tags: vector<integer>, next: E }
}

fn show(e: E) -> text {
  out = "";
  cur = e;
  more = true;
  while more {
    match cur {
      A { x, next } => { out += "A{x} "; cur = next; }
      B { a, b, c, next } => { out += "B{a}.{b}.{c} "; cur = next; }
      T { s, tags, next } => { out += "T{s}{len(tags)} "; cur = next; }
      Nil => { more = false; }
    }
  }
  out
}

fn depth(e: E) -> integer {
  match e {
    A { x, next } => 1 + depth(next),
    B { a, b, c, next } => 1 + depth(next),
    T { s, tags, next } => 1 + depth(next),
    Nil => 0
  }
}

fn test_a_variant_pushed_at_the_front_moves_the_old_record_whole() {
  e = Nil;
  e = B { a: 1, b: 2, c: 3, next: e };
  e = A { x: 4, next: e };
  e = T { s: "tt", tags: [1, 2], next: e };
  e = A { x: 5, next: e };
  assert(show(e) == "A5 Ttt2 A4 B1.2.3 ", "pushes over every variant: {show(e)}");
  e = A { x: depth(e), next: e };
  assert(show(e) == "A4 A5 Ttt2 A4 B1.2.3 ", "a field that reads the list: {show(e)}");
  e = B { a: 7, b: 8, c: 9, next: Nil };
  assert(show(e) == "B7.8.9 ", "a rebuild over the list: {show(e)}");
  l = Nil;
  for i in 0..2000 { l = A { x: i, next: l }; }
  s = 0;
  n = 0;
  cur = l;
  more = true;
  while more {
    match cur {
      A { x, next } => { s += x; n += 1; cur = next; }
      _ => { more = false; }
    }
  }
  assert(n == 2000 && s == 1999000, "2,000 pushes: {n} {s}");
  println("variant demote ok");
}
