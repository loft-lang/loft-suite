//
// `@FR-R-SliceInto` crossed with `@FR-Slice-Value`: a scalar vector slice appended to a place —
// `x += v[a..b]`, a literal's vector field — is one clamped block copy onto the place, with no
// temporary vector, and must append exactly Slice-Value's fresh sub-collection: clamped bounds,
// negative bounds from the end, empty for a fully out-of-range or reversed range, `..=`
// inclusive; a slice of the place's OWN vector appended to it reads the elements as they were
// before the append; and the appends accumulate per pass of a loop.
//
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.
// CHANNEL: the assertions and the leak gate.

struct R { items: vector<integer>, k: integer }

fn digits(v: vector<integer>) -> integer { s = 0; for x in v { s = s * 10 + x; } s * 10 + len(v) }

fn test_appends_of_every_bound_shape() {
  v = [1, 2, 3, 4, 5];
  x: vector<integer> = [];
  x += v[1..3];
  x += v[-2..];
  x += v[..=0];
  x += v[3..99];
  x += v[7..9];
  x += v[4..1];
  assert(digits(x) == 23451457 && len(v) == 5, "appended: {digits(x)}");
}

fn test_a_literal_field_a_self_slice_and_a_loop() {
  v = [1, 2, 3, 4, 5];
  r = R { items: v[2..], k: 1 };
  assert(digits(r.items) == 3453, "a literal's field: {digits(r.items)}");
  w = [7, 8, 9];
  w += w[0..2];
  w += w[-1..];
  assert(digits(w) == 7897886, "a slice of the place itself: {digits(w)}");
  acc: vector<integer> = [];
  for i in 0..4 { acc += v[i..i + 2]; }
  assert(digits(acc) == 122334458 && len(acc) == 8, "per pass: {digits(acc)}");
}
