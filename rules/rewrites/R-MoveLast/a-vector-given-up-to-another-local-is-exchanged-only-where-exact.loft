//
// A VECTOR GIVEN UP TO ANOTHER LOCAL IS EXCHANGED ONLY WHERE EXACT (`@FR-R-MoveLast` crossed with
// `@FR-H-SwapIn`).  R-MoveLast's LOCAL CLAUSE gives `y` up to `x` at `x = y` when `y` was built
// afresh just before, is written there only and read only by the rebind — "the free-source copy,
// which exchanges the two stores where it can (@FR-H-SwapIn)".  H-SwapIn makes the exchange EXACT
// only for a type that keeps every pointer as a record number in its own store (scalars, texts,
// inline records, vectors of those) and keeps the copy for a stored reference and a keyed
// collection.  Either way the answer is B-Copy's: `x` holds what `y` held, x's old contents are
// gone (the leak gate reads it), a later write to either is its own, a reference into `y` taken
// before the rebind still reads `y`'s record, and a `y` read after the rebind keeps the copy.
//
// Values hand-computed:
//   ints(3): y = [0, 1, 4] → "3 0 4 -1" (x[3] is past the end)
//   texts(2): y = [t0, t1], then x += [z] → "3 t0 z"
//   recs(3): y = [R{0,r0}, R{1,r1}, R{2,r2}] → "3 r0 2"
//   nested(3): y = [[0,1], [1,2], [2,3]] → "3 2 3"
//   refs(3): elements name `base`; base.v = 41 after → "3 41 2"
//   hashes(3): y keys 0..2 → "3 h1 true" (x's key 99 is gone)
//   held(3): y = [5, 15, 25], h.r = y[1]; x[1].v = 77 after → "3 77 15"
//   read_after(2): y = [0, 1], then y += [100] → "2 3 100"
//
// Axes it MOVES: the element (integer, text, record owning a text, a vector, a record holding a
//   reference), the collection (vector, hash), a reference INTO y held across the rebind, a read
//   or growth of y after it, a write to x after it.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed, interpret and
//   native, and the same under LOFT_NO_TAKE_LOCAL=1, LOFT_NO_STORE_SWAP=1, LOFT_POISON=1 and
//   LOFT_STRICT_STORES=1.  Fires: LOFT_REWRITE_CENSUS_FN counts `R-MoveLast/local` in `n_texts`,
//   `n_recs`, `n_nested`, `n_refs`; LOFT_TRACE_STORE_SWAP=1 names the exchange for texts, recs and
//   nested only (refs and held keep the copy).
// CHANNEL: the asserts and the leak gate.
// ARMED: no instrument (the switches above, by hand).
// WITNESS: each message prints the length and the elements read.
// HOLDS: `a-field-store-lands-in-the-record-bound-at-the-store` beside it.

struct R { k: integer, t: text }
struct T { v: integer }
struct RR { r: reference<T>, k: integer }
struct E { k: integer, t: text }
struct Hold { r: reference<T> }

fn ints(n: integer) -> text {
  x: vector<integer> = [9, 9, 9, 9];
  y: vector<integer> = [];
  for i in 0..n { y += [i * i]; }
  x = y;
  "{len(x)} {x[0] ?? -1} {x[n - 1] ?? -1} {x[3] ?? -1}"
}

fn texts(n: integer) -> text {
  x: vector<text> = ["old", "old2"];
  y: vector<text> = [];
  for i in 0..n { y += ["t{i}"]; }
  x = y;
  x += ["z"];
  "{len(x)} {x[0]} {x[len(x) - 1]}"
}

fn recs(n: integer) -> text {
  x: vector<R> = [R { k: 1, t: "a" }];
  y: vector<R> = [];
  for i in 0..n { y += [R { k: i, t: "r{i}" }]; }
  x = y;
  "{len(x)} {x[0].t} {x[n - 1].k}"
}

fn nested(n: integer) -> text {
  x: vector<vector<integer>> = [[1]];
  y: vector<vector<integer>> = [];
  for i in 0..n { y += [[i, i + 1]]; }
  x = y;
  "{len(x)} {len(x[0])} {x[n - 1][1]}"
}

fn refs(n: integer) -> text {
  base = T { v: 40 };
  x: vector<RR> = [];
  y: vector<RR> = [];
  for i in 0..n { y += [RR { r: base, k: i }]; }
  x = y;
  base.v = 41;
  "{len(x)} {x[0].r.v} {x[n - 1].k}"
}

fn hashes(n: integer) -> text {
  x: hash<E[k]> = [];
  x += [E { k: 99, t: "old" }];
  y: hash<E[k]> = [];
  for i in 0..n { y += [E { k: i, t: "h{i}" }]; }
  x = y;
  "{len(x)} {x[1].t} {x[99] == null}"
}

fn held(n: integer) -> text {
  x: vector<T> = [T { v: 1 }];
  y: vector<T> = [];
  for i in 0..n { y += [T { v: i * 10 + 5 }]; }
  h = Hold { r: y[1] };
  x = y;
  x[1].v = 77;
  "{len(x)} {x[1].v} {h.r.v}"
}

fn read_after(n: integer) -> text {
  x: vector<integer> = [5];
  y: vector<integer> = [];
  for i in 0..n { y += [i]; }
  x = y;
  y += [100];
  "{len(x)} {len(y)} {y[n]}"
}

fn test_an_exact_type_is_given_up_whole() {
  s = "{ints(3)} | {texts(2)} | {recs(3)} | {nested(3)}";
  assert(s == "3 0 4 -1 | 3 t0 z | 3 r0 2 | 3 2 3", "exact: {s}");
}

fn test_a_reference_or_a_keyed_collection_keeps_the_copy() {
  s = "{refs(3)} | {hashes(3)} | {held(3)}";
  assert(s == "3 41 2 | 3 h1 true | 3 77 15", "copies: {s}");
}

fn test_a_source_read_after_the_rebind_keeps_the_copy() {
  s = read_after(2);
  assert(s == "2 3 100", "read after: {s}");
}

fn main() {
  test_an_exact_type_is_given_up_whole();
  test_a_reference_or_a_keyed_collection_keeps_the_copy();
  test_a_source_read_after_the_rebind_keeps_the_copy();
}
