//
// A STORE A REBIND HANDS BACK IS REFILLED BY THE NEXT CALL (`@FR-R-RefillBuffer` crossed with
// `@FR-R-RebindBuffer`).  R-RebindBuffer adopts `c = f(a, c)`'s fresh result and hands `c`'s
// previous store to the call's hidden buffer, and "at its release b PARKS the store it holds
// where the exchange would have parked its released one ((R-RefillBuffer)'s spare)";
// R-RefillBuffer's callee then mints with `OpDatabaseRefill`, taking that kept store as it
// stands and emptying each vector field in place for its literal.  The two stores take turns
// by name: the store the callee refills held the value TWO calls back, so anything the refill
// fails to overwrite reads that value.  Each cell makes the two-back value distinctive and the
// new value differ from it in every element, length included.
//
// Axes it MOVES: the trip count (0, 1, 2, an odd and an even run), the result's vector length
// against the kept one (equal, longer, shorter), a scalar field beside the vector, a second
// local reading the rebound one after the loop.  Values hand-computed in each cell's comment.
//
// Firing read under `LOFT_TRACE_REBIND_BUFFER=1` (it names each DECLINE: the rebinds inside the
// loops are absent from it, the ones outside say "not inside a loop") and off `--native-emit`
// (the `__rbb_c` hand-off and `cr_park_or_free` at the rebind, `OpDatabaseRefill` and the
// vector field's `clear_vector` at `step`'s and `wobble`'s mint).  Native only — the interpreter
// exchanges and is the oracle; `LOFT_NO_REBIND_BUFFER=1` and `LOFT_NO_REFILL_BUFFER=1` answer
// the same, and so do `LOFT_POISON=1` and `LOFT_STRICT_STORES=1`.
//
// @falsified-at: none — a conformance guard; a refill that keeps the parked vector's length
//   answers m2's shrinking steps with the two-back tail.
// CHANNEL: the asserts.
// ARMED: LOFT_POISON=1, LOFT_STRICT_STORES=1.
// WITNESS: each message prints the vector.
// HOLDS: the interpreter is the oracle.

struct M { k: integer, m: vector<integer> }

/// m[0] = c.m[1] + a.m[0], m[1] = 2·c.m[0]; k counts calls.  The result is a local filled
/// AFTER its literal, reading the parameter as it goes — the shape `(R-Rebind)` declines
/// (it would fill the argument it is about to read), so the rebind is R-RebindBuffer's.
fn step(a: const M, c: const M) -> M {
  r = M { k: c.k + 1, m: [0, 0] };
  r.m[0] = (c.m[1] ?? 0) + (a.m[0] ?? 0);
  r.m[1] = (c.m[0] ?? 0) * 2;
  r
}

/// The length alternates with c.k: an even k answers three elements, an odd one one.
fn wobble(c: const M) -> M {
  r = M { k: 0, m: [] };
  if c.k % 2 == 0 {
    for j in 0..3 { r.m += [c.k * 10 + j]; }
  } else {
    r.m += [-c.k];
  }
  r.k = c.k + 1;
  r
}

fn run(n: integer) -> M {
  a = M { k: 0, m: [1, 0] };
  c = M { k: 0, m: [0, 0] };
  for _ in 0..n { c = step(a, c); }
  c
}

// m1 — step from (0, 0) with a = [1, 0]: (1,0) (1,2) (3,2) (3,6) (7,6) (7,14) (15,14).
fn test_a_two_store_rotation_through_the_refill() {
  r0 = run(0);
  r1 = run(1);
  r2 = run(2);
  r3 = run(3);
  r7 = run(7);
  assert(r0.k == 0 && r0.m[0] == 0 && r0.m[1] == 0, "m1 n=0 {r0.m}");
  assert(r1.k == 1 && r1.m[0] == 1 && r1.m[1] == 0, "m1 n=1 {r1.m}");
  assert(r2.k == 2 && r2.m[0] == 1 && r2.m[1] == 2, "m1 n=2 {r2.m}");
  assert(r3.k == 3 && r3.m[0] == 3 && r3.m[1] == 2, "m1 n=3 {r3.m}");
  assert(r7.k == 7 && r7.m[0] == 15 && r7.m[1] == 14 && len(r7.m) == 2, "m1 n=7 {r7.m}");
}

// m2 — the length alternates 3, 1, 3, 1: k = 0 → [0,1,2]; 1 → [-1]; 2 → [20,21,22]; 3 → [-3];
// 4 → [40,41,42].  The refilled store held the value two calls back, of the SAME length, so
// a shrink that kept its length shows its tail, and a growth that kept stale capacity would too.
fn test_a_refilled_vector_shorter_and_longer_than_it_was() {
  c = M { k: 0, m: [] };
  lens = 0;
  for _ in 0..5 { c = wobble(c); lens = lens * 10 + len(c.m); }
  assert(lens == 31313 && c.k == 5 && c.m[0] == 40 && c.m[2] == 42, "m2 {lens} {c.m}");
  c = wobble(c);
  assert(len(c.m) == 1 && c.m[0] == -5 && c.k == 6, "m2 then {c.m}");
}

// m3 — a second local bound from the rebound one after the loop keeps its value through more
// rebinds (B-Copy): snap = c after 2 steps (1, 2); four more steps → (7, 6); snap stays (1, 2).
fn test_a_copy_taken_between_rebinds() {
  a = M { k: 0, m: [1, 0] };
  c = M { k: 0, m: [0, 0] };
  for _ in 0..2 { c = step(a, c); }
  snap = c;
  for _ in 0..3 { c = step(a, c); }
  assert(snap.m[0] == 1 && snap.m[1] == 2 && snap.k == 2, "m3 snap {snap.m}");
  assert(c.m[0] == 7 && c.m[1] == 6 && c.k == 5, "m3 c {c.m}");
}

fn main() {
  test_a_two_store_rotation_through_the_refill();
  test_a_refilled_vector_shorter_and_longer_than_it_was();
  test_a_copy_taken_between_rebinds();
}
