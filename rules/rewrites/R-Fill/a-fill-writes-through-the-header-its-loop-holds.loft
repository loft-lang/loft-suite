//
// A FILL WRITES THROUGH THE HEADER ITS LOOP HOLDS (`@FR-R-Fill` crossed with `@FR-R-Header`).
// R-Fill takes `for i in lo..hi { v[base + i] = c }` over a vector "reached by a pure path a
// header is held for": the range test and the slice fill read THAT header's length and
// record.  So the fill is only as right as the holder it is handed — a header held by an
// enclosing loop (R-Header's nested-loop clause), a push header the enclosing loop keeps
// current while it grows the vector, a parameter's header (the function clause), a field path
// two deep.  Each cell puts the held header somewhere else and asks the fill for a range the
// current length decides: a stale length would drop writes the vector now has room for, or
// write past the length the vector really has.
//
// Axes it MOVES: who holds the header (the fill loop itself, an enclosing reading loop, an
// enclosing PUSHING loop, a parameter), the path (local, field path two deep), the range
// against the length (in range, past the end, starting below zero).  Values hand-computed
// in each cell's comment; a write past the end is dropped, a negative index counts from the
// end, as for the plain element store.
//
// Firing read under `LOFT_TRACE_FILL=1` (each fill admitted or declined, with the check) and
// `--native-emit` (`fill_hoisted` on the held header).  Cross-backend; `LOFT_HOIST_VERIFY=1`
// (the fill re-derives its header) and `LOFT_NO_FILL_HOIST=1` answer the same.
//
// @falsified-at: none — a conformance guard; a fill reading the entry length of a vector its
//   enclosing loop grows would leave f1's later rows 0.
// CHANNEL: the asserts.
// ARMED: LOFT_HOIST_VERIFY=1 on --native.
// WITNESS: each message prints the vector or its sum.
// HOLDS: the interpreter (no fill) is the oracle.

struct Cv { w: integer, data: vector<integer> }
struct Pane { pad: integer, c: Cv }

fn zeros(n: integer) -> vector<integer> { [for _i in 0..n { 0 }] }
fn total(v: const vector<integer>) -> integer { s = 0; for x in v { s += x; } s }

/// The function clause: a parameter's header, bound at entry.
fn paint(v: vector<integer>, lo: integer, hi: integer, c: integer) {
  for i in lo..hi { v[i] = c; }
}

// f1 — the enclosing loop PUSHES three zeros per row, then the fill writes that row: the
// fill's range lies past the length the vector had at the outer loop's entry (0), and past
// the first claim by row 3.  v = [1,1,1, 2,2,2, 3,3,3, 4,4,4]: Σ 30, len 12.
fn test_a_fill_under_a_pushing_loop_reads_the_current_push_header() {
  v: vector<integer> = [];
  for r in 0..4 {
    for _ in 0..3 { v += [0]; }
    for i in 0..3 { v[r * 3 + i] = r + 1; }
  }
  assert(len(v) == 12 && total(v) == 30, "f1 {v}");
  assert(v[2] == 1 && v[3] == 2 && v[11] == 4, "f1 rows {v}");
}

// f2 — the parameter's header: paint(1, 4, 5) → [0,5,5,5,0,0]; paint(4, 9, 2) writes 4 and 5
// and drops 6..8 → [0,5,5,5,2,2], Σ 19, len stays 6.
fn test_a_fill_through_a_parameters_header() {
  v = zeros(6);
  paint(v, 1, 4, 5);
  paint(v, 4, 9, 2);
  assert(len(v) == 6 && total(v) == 19 && v[3] == 5 && v[5] == 2, "f2 {v}");
}

// f3 — an enclosing READING loop holds the header; the inner fill writes through it and the
// outer loop reads what it wrote.  r=0: s += v[0] = 0, fill 0..4 with 7, s += v[0] = 7;
// r=1: s += v[1] = 7, fill 4..8 with 8, s += v[4] = 8 → s = 22; Σ v = 4·7 + 4·8 = 60.
fn test_a_fill_inside_a_loop_that_reads_the_same_path() {
  v = zeros(8);
  s = 0;
  for r in 0..2 {
    s += v[r] ?? 0;
    for i in 0..4 { v[r * 4 + i] = r + 7; }
    s += v[r * 4] ?? 0;
  }
  assert(s == 22 && total(v) == 60, "f3 s {s} v {v}");
}

// f4 — a field path two deep with an invariant base below zero: base = -2 over 0..4 writes
// -2 (index 3), -1 (index 4), 0 and 1 — the fill declines a negative index and the loop
// answers: [6,6,0,6,6], Σ 24.
fn test_a_fill_over_a_field_path_from_a_negative_base() {
  p = Pane { pad: 0, c: Cv { w: 5, data: zeros(5) } };
  base = -2;
  for i in 0..4 { p.c.data[base + i] = 6; }
  assert(total(p.c.data) == 24 && p.c.data[2] == 0 && p.c.data[3] == 6, "f4 {p.c.data}");
}

// f5 — a field path two deep, the base read off the record (an invariant scalar), rows
// filled by an outer loop over the height: 3 rows of w = 4, row y gets y + 1 on columns
// 1..3 → per row (y + 1)·2, Σ 2 + 4 + 6 = 12.
fn test_rows_filled_over_a_field_path() {
  p = Pane { pad: 9, c: Cv { w: 4, data: zeros(12) } };
  for y in 0..3 {
    for x in 1..3 { p.c.data[y * p.c.w + x] = y + 1; }
  }
  assert(total(p.c.data) == 12 && p.c.data[5] == 2 && p.c.data[8] == 0, "f5 {p.c.data}");
}

fn main() {
  test_a_fill_under_a_pushing_loop_reads_the_current_push_header();
  test_a_fill_through_a_parameters_header();
  test_a_fill_inside_a_loop_that_reads_the_same_path();
  test_a_fill_over_a_field_path_from_a_negative_base();
  test_rows_filled_over_a_field_path();
}
