//
// `@FR-R-InPlaceLiteral` — a record literal written into a field is built IN that field unless
// one of its values reads the place it overwrites.  A collection field is primed: its header is
// zeroed and its items are pushed straight into the field.  The push ops name the field as
// their RECEIVER, and that receiver was counted as a read of the place, so every literal with
// a vector-literal field declined.  It was built apart and copied in, and its first-pass
// attempt left an `_elm_N` declared that nothing used.  Only what the ITEMS read decides, so
// the decline still happens where an item reads the place, and the cells check both sides by
// value.
//
// m1 to m10 hold items that read nothing, or read the place's SCALARS, or another local; m3
// and m6 read the place's own vector or build a comprehension, which must decline.  m12
// rebuilds the field in a loop, the shape loft#2569 made lose its pushes on the compiled
// backends once the literal is built in place.
// @falsified-at: 2026-11-19 on loft30-gate d693191cf with this change — the receiver masked in
//   EVERY position (not only the write slot): m3 answered `[0,null] 3` on all three backends;
//   the write slot masked but before loft#2569: m12 answered `null` on --native-c and --native.
struct R { n: integer }
struct Vf { v: vector<integer>, n: integer = 0 }
struct VBox { inner: Vf }
struct Deep { mid: VBox }
struct VSc { els: vector<Vf> }
struct Tf { t: vector<text>, k: integer = 0 }
struct TBox { inner: Tf }
struct Rv { rs: vector<R>, k: integer = 0 }
struct RBox { inner: Rv }
fn mk() -> VBox { VBox { inner: Vf { v: [5, 6], n: 1 } } }
fn m1() -> text { b = mk(); b.inner = Vf { v: [7, 8, 9], n: 3 }; "{b.inner.v} {b.inner.n}" }
fn m2() -> text { b = mk(); b.inner = Vf { v: [b.inner.n, 8], n: 3 }; "{b.inner.v} {b.inner.n}" }
fn m3() -> text { b = mk(); b.inner = Vf { v: [len(b.inner.v), b.inner.v[0]], n: 3 }; "{b.inner.v} {b.inner.n}" }
fn m4() -> text { b = mk(); b.inner = Vf { v: [], n: 3 }; "{b.inner.v} {b.inner.n}" }
fn m5() -> text { d = Deep { mid: mk() }; d.mid.inner = Vf { v: [4], n: 2 }; "{d.mid.inner.v} {d.mid.inner.n}" }
fn m6() -> text { b = mk(); b.inner = Vf { v: [for x in 0..3 { x * 2 }], n: 3 }; "{b.inner.v}" }
fn m7(n: integer) -> text { t = TBox { inner: Tf { t: ["old"] } }; t.inner = Tf { t: ["a{n}", "b"], k: 1 }; "{t.inner.t} {t.inner.k}" }
fn m8() -> text { b = mk(); o = [1, 2]; b.inner = Vf { v: [o[0], o[1]], n: 4 }; "{b.inner.v} {b.inner.n}" }
fn m9() -> text { s = VSc { els: [Vf { v: [1] }, Vf { v: [2] }] }; s.els[1] = Vf { v: [3, 3], n: 9 }; "{s.els[0].v} {s.els[1].v} {s.els[1].n}" }
fn m10() -> text { r = RBox { inner: Rv { rs: [R { n: 0 }] } }; r.inner = Rv { rs: [R { n: 1 }, R { n: 2 }], k: 5 }; "{len(r.inner.rs)} {r.inner.rs[1].n} {r.inner.k}" }
fn m11(b: VBox) { b.inner = Vf { v: [7, 8, 9], n: 3 }; }
fn m12() -> integer { b = mk(); t = 0; for i in 0..2000 { b.inner = Vf { v: [i, i + 1], n: i }; t += b.inner.v[1] - b.inner.n; } t }
fn main() {
  assert(m1() == "[7,8,9] 3", "m1 plain items: {m1()}");
  assert(m2() == "[1,8] 3", "m2 an item reads a scalar of the place: {m2()}");
  assert(m3() == "[2,5] 3", "m3 an item reads the place's own vector: {m3()}");
  assert(m4() == "[] 3", "m4 an empty field: {m4()}");
  assert(m5() == "[4] 2", "m5 a nested place: {m5()}");
  assert(m6() == "[0,2,4]", "m6 a comprehension field: {m6()}");
  assert(m7(3) == "[\"a3\",\"b\"] 1", "m7 a text vector field: {m7(3)}");
  assert(m8() == "[1,2] 4", "m8 items read another local: {m8()}");
  assert(m9() == "[1] [3,3] 9", "m9 an element place: {m9()}");
  assert(m10() == "2 2 5", "m10 a vector of records field: {m10()}");
  b = mk(); m11(b); assert("{b.inner.v} {b.inner.n}" == "[7,8,9] 3", "m11 through a parameter: {b.inner.v}");
  assert(m12() == 2000, "m12 rebuilt in a loop: {m12()}");
}
