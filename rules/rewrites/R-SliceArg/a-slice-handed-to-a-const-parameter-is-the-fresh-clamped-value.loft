//
// `@FR-R-SliceArg` crossed with `@FR-Slice-Value`: a slice used as an argument for a `const`
// parameter is materialised into a CARRIER store kept across uses instead of a store minted
// per call — and the callee must still see exactly Slice-Value's fresh sub-collection: bounds
// clamped, a negative bound counted from the end, a fully out-of-range or reversed range
// empty, `..=` inclusive, and the subject evaluated once.  Each shape is handed over straight
// and per pass of a loop (where the carrier is reused), and the source is unchanged after.
//
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.
// CHANNEL: the assertions and the leak gate.

fn digits(v: const vector<integer>) -> integer { s = 0; for x in v { s = s * 10 + x; } s * 10 + len(v) }
fn src(log: vector<integer>) -> vector<integer> { log += [1]; [1, 2, 3, 4, 5] }

fn test_every_bound_shape() {
  v = [1, 2, 3, 4, 5];
  assert(digits(v[1..3]) == 232 && digits(v[-2..]) == 452 && digits(v[..=1]) == 122, "plain: {digits(v[1..3])}");
  assert(digits(v[3..99]) == 452 && digits(v[-99..2]) == 122 && digits(v[7..9]) == 0 && digits(v[4..1]) == 0, "clamped: {digits(v[3..99])}");
  assert(len(v) == 5 && v[0] == 1, "the source: {len(v)}");
}

fn test_a_carrier_reused_per_pass_and_a_subject_evaluated_once() {
  v = [1, 2, 3, 4, 5];
  t = 0;
  for i in 0..5 { t = t * 1000 + digits(v[i..i + 2]); }
  assert(t == 122232342452051, "per pass: {t}");
  log: vector<integer> = [];
  assert(digits(src(log)[1..4]) == 2343 && len(log) == 1, "once: {len(log)}");
}
