//
// A SLICE ARGUMENT SHARES NO CARRIER WITH THE SLICE IN USE BESIDE IT (`@FR-R-SliceArg`, the
// carrier clause with the range clause).  A slice handed to a `const` parameter is copied into
// a CARRIER store kept across uses: "a variable that still holds its carrier when the site runs
// again keeps it; when every carrier is in use the store is minted as before".  So what the
// callee sees must still be its OWN slice when a second slice is in use at the same moment —
// two slices of one call, a recursion whose frames each hold a slice at the same site — and a
// carrier reused by the next pass must have its old length reset, not kept, when the next
// slice is shorter or empty.  The range clause (`text_from_bytes(v[a..b])` read as
// `text_from_byte_range`) decodes the span where it lies: clamped bounds, a bound that splits a
// character answering the empty text, a window appended per pass.  The neighbouring cell hands
// ONE integer slice per call to `digits`; this one hands several at once and re-enters the
// site.
//
// Axes this file MOVES (over the existing cell):  how many slices are in use at once (one,
// two, three in a call; a recursion with a slice live in every frame), the element type
// (u8 values past 127; the bytes of a text with 1-, 2-, 3- and 4-byte characters), the
// consumer (`digits`, a checksum, `text_from_bytes`), the lengths a carrier is reused across
// (5, 3, 0, 1).
// Axes it HOLDS FIXED:  the slice is of a local vector, bounds read from variables or literals.
//
// Expected values by hand.  digits(w) = (the digits of w read as a decimal) · 10 + len(w).
//   v = [1,2,3,4,5]:  two(v[0..2], v[2..5]) = digits [1,2] = 122, digits [3,4,5] = 3453 →
//   122·1000 + 3453 = 125453.  three(v[0..1], v[1..3], v[3..5]) = 11, 232, 452 →
//   11·10^6 + 232·1000 + 452 = 11232452.
//   rec(v, 2) = digits(v[0..2])·100 + rec(v[2..], 1);  digits [1,2] = 122 → 12200;
//   rec([3,4,5], 1) = digits([3])·100 + rec([4,5], 0) = 31·100 + 452 = 3552;  total 15752.
//   Reuse across lengths, windows (0,5) (0,3) (2,2) (4,5):  digits [1,2,3,4,5] = 123455;
//   [1,2,3] = 1233; [] = 0; [5] = 51 → "123455|1233|0|51|".
//   checksum(w) = (Σ w_i = s·3 + w_i, from 0)·10 + len;  u = [250,1,2,3,255]: u[1..4] = 1 → 5 →
//   18 → 183; u[-1..] = 255 → 2551; u[..2] = 250 → 751 → 7512.
//   "añb€c😀" is a(0) ñ(1,2) b(3) €(4,5,6) c(7) 😀(8..11), 12 bytes in 6 characters:
//   read 3..8 = "b€c" (5 bytes);  1..3 = "ñ" (2);  4..6 splits € → "" (0);  -4..12 is 8..12 =
//   "😀" (4);  0..99 clamps to all 12 (6 characters);  6..2 reversed → "".
//   One-byte windows k..k+1 over 0..12 decode only the ASCII bytes a, b, c → "abc".
//   Growing prefixes 0..k for k in 1..4 appended with "|": "a|" then "|" (a + half of ñ is not
//   UTF-8) then "añ|" → "a||añ|".
//
// @falsified-at: none — a coverage cell for a rewrite already correct on main; reach shown by
//   the emitted C taking `loft_slice_take` and calling `text_from_byte_range` (`--native-emit`),
//   both gone under `LOFT_NO_SLICE_ARG_POOL=1` / `LOFT_NO_SLICE_TEXT=1`.

fn digits(v: const vector<integer>) -> integer { s = 0; for x in v { s = s * 10 + x; } s * 10 + len(v) }
fn two(a: const vector<integer>, b: const vector<integer>) -> integer { digits(a) * 1000 + digits(b) }
fn three(a: const vector<integer>, b: const vector<integer>, c: const vector<integer>) -> integer {
  digits(a) * 1000000 + digits(b) * 1000 + digits(c)
}
fn rec(v: const vector<integer>, n: integer) -> integer {
  if n == 0 { return digits(v); }
  digits(v[0..n]) * 100 + rec(v[n..], n - 1)
}
fn checksum(w: const vector<u8>) -> integer { s = 0; for x in w { s = s * 3 + x; } s * 10 + len(w) }

fn bytes_of(t: text) -> vector<u8> {
  v: vector<u8> = [];
  for i in 0..size(t) { v += [t.byte_at(i) as u8? ?? 0]; }
  v
}

fn read(v: const vector<u8>, a: integer, b: integer) -> text {
  t = text_from_bytes(v[a..b]);
  "{t}/{size(t)}"
}

fn test_several_slices_live_at_once() {
  v = [1, 2, 3, 4, 5];
  assert(two(v[0..2], v[2..5]) == 125453, "two: {two(v[0..2], v[2..5])}");
  assert(three(v[0..1], v[1..3], v[3..5]) == 11232452, "three: {three(v[0..1], v[1..3], v[3..5])}");
  assert(rec(v, 2) == 15752, "a slice live in every frame: {rec(v, 2)}");
  assert(len(v) == 5 && v[4] == 5, "the source: {len(v)}");
}

fn test_a_carrier_reused_across_lengths() {
  v = [1, 2, 3, 4, 5];
  los = [0, 0, 2, 4];
  his = [5, 3, 2, 5];
  out = "";
  for k in 0..4 { out += "{digits(v[los[k]!..his[k]!])}|"; }
  assert(out == "123455|1233|0|51|", "lengths 5, 3, 0, 1: {out}");
}

fn test_byte_values_past_127() {
  u: vector<u8> = [250, 1, 2, 3, 255];
  a = checksum(u[1..4]);
  b = checksum(u[-1..]);
  c = checksum(u[..2]);
  assert(a == 183 && b == 2551 && c == 7512, "u8: {a} {b} {c}");
}

fn test_the_range_clause_over_every_width() {
  m = bytes_of("añb€c😀");
  assert(len(m) == 12, "twelve bytes: {len(m)}");
  assert(read(m, 3, 8) == "b€c/5", "ascii and a euro sign: {read(m, 3, 8)}");
  assert(read(m, 1, 3) == "ñ/2", "two bytes: {read(m, 1, 3)}");
  assert(read(m, 4, 6) == "/0", "a split character: {read(m, 4, 6)}");
  assert(read(m, -4, 12) == "😀/4", "four bytes from the end: {read(m, -4, 12)}");
  whole = read(m, 0, 99);
  assert(whole == "añb€c😀/12", "clamped: {whole}");
  assert(read(m, 6, 2) == "/0", "reversed: {read(m, 6, 2)}");
  ascii = "";
  for k in 0..12 { ascii += text_from_bytes(m[k..k + 1]); }
  assert(ascii == "abc" && len(ascii) == 3, "one-byte windows: {ascii}");
  acc = "";
  for k in 1..4 { acc += text_from_bytes(m[0..k]) + "|"; }
  assert(acc == "a||añ|", "growing prefixes: {acc}");
}

fn main() {
  test_several_slices_live_at_once();
  test_a_carrier_reused_across_lengths();
  test_byte_values_past_127();
  test_the_range_clause_over_every_width();
}
