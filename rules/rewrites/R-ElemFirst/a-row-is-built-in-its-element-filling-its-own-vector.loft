//
// A ROW IS BUILT IN ITS ELEMENT, FILLING ITS OWN VECTOR (`@FR-R-ElemFirst`).  A comprehension's row,
// and a row built element-first, is written straight into the element it becomes; it fills its own
// vector and opens no window on the outer one.  Each section keeps its own cases and receipt.
//
// ── a-comprehension-row-is-built-in-its-element ──
//
// `@FR-R-ElemFirst`'s comprehension clause — a row built by a comprehension and appended as a
// whole element of a vector of vectors (`[for y { [for x { … }] }]`) is built in that element,
// instead of in a loop-buffer store and copied across.  The rule is an IR rewrite every backend
// runs (`opt::elem_first`), so the oracle is the hand-computed values.  What can go wrong is an
// element minted twice or not finished (a wrong length), a row written into a store whose
// buffer moved while it grew (c5 forces growth past every first claim), a pair inside a pair
// (c6), and a body that reads the vector being built (c3: its rows depend on how many rows
// exist).  `LOFT_NO_ELEMENT_FIRST=1` and `LOFT_HOIST_VERIFY=1` answer the same.
// c3 and c7 are the STATEMENT spelling (`rows += [[…]]`), which lowers without a copy and so
// never reaches the clause: they hold the values of the neighbouring path.  A comprehension's
// body cannot name the vector it is bound to, so the clause's "names the destination" decline
// is defensive for this spelling.
//
// @falsified-by: tests/falsified/a-comprehension-row-is-built-in-its-element.patch — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   The IR rewrite keeping the append's own mint (`opt::elem_first::statement`), so the row's
//   element is minted at the declaration AND at the append.
//   CHANNEL: an assertion, on both backends (the rewrite is the IR's, so both run it).
//   WITNESS: `assertion failed: c1 row lengths`.
//   HOLDS: leak, panic and free-refusal are clean on both trees and both backends.
//
// ── a-row-built-in-its-element-fills-its-own-vector-and-no-window-on-the-outer ──
//
// A ROW BUILT IN ITS ELEMENT FILLS ITS OWN VECTOR, AND NO WINDOW IS HELD ON THE OUTER
// (`@FR-R-ElemFirst` crossed with `@FR-R-PushFill`).  R-ElemFirst's COMPREHENSION clause builds
// `[for y { [for x { … }] }]`'s row inside the element it lands in, and gates it on the row's
// block LOOPING: "a body that loops again holds no push window on `out` (R-PushFill), the one
// raw address into `out`'s store the row's growth could leave stale".  The row's own pushes are
// R-PushFill's — a reservation of the trip count, a window, or for a simple invariant ONE fill
// of the tail — into a vector whose record now lives in the outer vector's store, which every
// row's growth extends.  The cells fill rows by each of R-PushFill's forms, at trip counts
// that cross the first claim and that are empty, so a row's window or fill addressing a store
// that a sibling row's growth moved answers a wrong element, and an outer window frozen
// across a row's growth answers a short outer length.
//
// Axes it MOVES: the row's form (a fill of one invariant, a window of a computed value, a
// reservation with a nested branch), the row's length (0, 1, 3, 30 — past the first claim,
// varying per row), the element (integer, float, u8), the outer trip count.  Values
// hand-computed in each cell's comment.
//
// Firing read off `--native-emit` and `LOFT_TRACE_PUSH_FILL=1` (the rows' `push_fill` /
// `__pw_` window in the element; no `__pw_` on the outer vector).  Cross-backend;
// `LOFT_HOIST_VERIFY=1`, `LOFT_NO_ELEMENT_FIRST=1`, `LOFT_NO_PUSH_FILL=1` and
// `LOFT_NO_PUSH_WINDOW=1` answer the same.
//
// @falsified-at: none — a conformance guard; a row filled through an address taken before a
//   sibling's growth reads 0s in r2's long rows.
// CHANNEL: the asserts.
// ARMED: LOFT_HOIST_VERIFY=1 on --native.
// WITNESS: each message prints the lengths and sums.
// HOLDS: the interpreter is the oracle.

fn c1() {
  g = [for y in 0..4 { [for x in 0..3 { x * 10 + y }] }];
  assert(len(g) == 4, "c1 rows {len(g)}");
  assert(len(g[0]?) == 3 && len(g[3]?) == 3, "c1 row lengths");
  assert(g[0]?[0]? == 0 && g[1]?[2]? == 21 && g[3]?[1]? == 13 && g[2]?[0]? == 2, "c1 values");
  println("c1 {g[1]?} {g[3]?}");
}

// Rows of varying length, the first empty.
fn c2() {
  g = [for y in 0..4 { [for x in 0..y { x + 100 * y }] }];
  assert(len(g[0]?) == 0 && len(g[1]?) == 1 && len(g[2]?) == 2 && len(g[3]?) == 3, "c2 lengths");
  assert(g[1]?[0]? == 100 && g[2]?[1]? == 201 && g[3]?[2]? == 302, "c2 values");
  println("c2 {g[2]?} {g[3]?}");
}

// The body reads the vector it is appended to: row y has y elements.
fn c3() {
  rows: vector<vector<integer>> = [];
  for _ in 0..4 { rows += [[for x in 0..len(rows) { x }]]; }
  assert(len(rows) == 4 && len(rows[0]?) == 0 && len(rows[3]?) == 3 && rows[3]?[2]? == 2, "c3");
  println("c3 {rows[2]?} {rows[3]?}");
}

// Text elements.
fn c4() {
  g = [for y in 0..3 { [for x in 0..2 { "t{x}{y}" }] }];
  assert(len(g) == 3 && g[0]?[1]? == "t10" && g[2]?[0]? == "t02" && g[2]?[1]? == "t12", "c4");
  println("c4 {g[2]?}");
}

// Long rows, many of them: the store the rows live in grows while a row is built.
// Sum over y < 300, x < 50 of (x + y) = 300 * 1225 + 50 * 44850 = 367500 + 2242500 = 2610000.
fn c5() {
  g = [for y in 0..300 { [for x in 0..50 { x + y }] }];
  t = 0;
  for r in g { for v in r { t += v; } }
  assert(len(g) == 300 && len(g[299]?) == 50 && g[299]?[49]? == 348 && t == 2610000, "c5 {t}");
  println("c5 {t}");
}

// Three levels: a pair inside a pair.  Element (z, y, x) is 100z + 10y + x.
fn c6() {
  g = [for z in 0..2 { [for y in 0..3 { [for x in 0..2 { 100 * z + 10 * y + x }] }] }];
  assert(len(g) == 2 && len(g[1]?) == 3 && len(g[1]?[2]?) == 2, "c6 shape");
  assert(g[0]?[0]?[0]? == 0 && g[1]?[2]?[1]? == 121 && g[0]?[1]?[1]? == 11 && g[1]?[0]?[0]? == 100, "c6 values");
  println("c6 {g[1]?[2]?}");
}

// The statement spelling of the same build.
fn c7() {
  rows: vector<vector<integer>> = [];
  for y in 0..3 { rows += [[for x in 0..2 { x * y }]]; }
  assert(len(rows) == 3 && rows[2]?[1]? == 2 && rows[1]?[0]? == 0 && len(rows[0]?) == 2, "c7");
  println("c7 {rows[2]?}");
}

fn test_a_comprehension_row_is_built_in_its_element() {
  c1(); c2(); c3(); c4(); c5(); c6(); c7();
  println("done");
}

fn rsum(v: const vector<integer>) -> integer { s = 0; for x in v { s += x; } s }

// r1 — rows that are ONE fill of an invariant: row y is y + 1 copies of 7 + y.  Over 0..4:
// lengths 1..4, Σ per row (y + 1)(7 + y) = 7 + 16 + 27 + 40 = 90.
fn test_rows_filled_with_one_invariant() {
  g = [for y in 0..4 { [for _x in 0..y + 1 { 7 + y }] }];
  t = 0;
  for r in g { t += rsum(r); }
  assert(len(g) == 4 && len(g[3]) == 4 && g[2][1] == 9 && t == 90, "r1 {t}");
}

// r2 — rows of 30 computed values (past every first claim), the outer past its own: 15 rows,
// row y = [x·y for x in 0..30] → Σ = y·435 → Σ over 0..15 = 435·105 = 45675.
fn test_long_rows_past_their_first_claim() {
  g = [for y in 0..15 { [for x in 0..30 { x * y }] }];
  t = 0;
  for r in g { t += rsum(r); }
  assert(len(g) == 15 && len(g[14]) == 30 && g[14][29] == 406 && t == 45675, "r2 {t}");
}

// r3 — empty rows between full ones: row y has length y % 3 (0, 1, 2, 0, 1, 2), values y.
// Σ = 1·1 + 2·2 + 1·4 + 2·5 = 19; lengths 0,1,2,0,1,2.
fn test_empty_rows_between_full_ones() {
  g = [for y in 0..6 { [for _x in 0..y % 3 { y }] }];
  shape = 0;
  t = 0;
  for r in g { shape = shape * 10 + len(r); t += rsum(r); }
  assert(shape == 12012 && t == 19, "r3 {shape} {t}");
}

// r4 — float rows of a fill: row y is 3 copies of y · 0.5 → Σ per row 1.5y → over 0..8 =
// 1.5 · 28 = 42.
fn test_float_rows() {
  g = [for y in 0..8 { [for _x in 0..3 { (y as float) * 0.5 }] }];
  t = 0.0;
  for r in g { for x in r { t += x; } }
  assert(len(g) == 8 && t == 42.0 && g[7][2] == 3.5, "r4 {t}");
}

// r5 — u8 rows (a byte at its bias): row y = [(x + y) as u8 for x in 0..20] → Σ per row
// 190 + 20y → over 0..5: 950 + 200 = 1150.
fn test_byte_rows() {
  g = [for y in 0..5 { [for x in 0..20 { ((x + y) & 255) as u8 }] }];
  t = 0;
  for r in g { for b in r { t += b as integer; } }
  assert(len(g) == 5 && t == 1150 && (g[4][19] as integer) == 23, "r5 {t}");
}

