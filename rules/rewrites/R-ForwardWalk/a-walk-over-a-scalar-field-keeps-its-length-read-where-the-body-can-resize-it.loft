// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A WALK OVER A SCALAR OR TEXT FIELD IS COUNTED WHERE THE BODY CANNOT RESIZE IT, AND KEEPS ITS
// LENGTH READ WHERE IT CAN (`@FR-R-ForwardWalk`, field clause).  `for x in b.xs` becomes the
// counted range's loop only when the body names the walked vector as a direct argument of an
// element read or of `len`, and only when nothing in the body — a `#remove`, a call that is
// handed the record whole, an aliased `&` parameter — can change its length.  The answer must
// be what the re-reading walk answers: every element the walk reaches, including ones a body
// appended, and not one the body removed.
//
// Axes this file MOVES:  the element type (integer, text, float), the walk's source (a field
//                        of a record local, of a `&` parameter, of a record inside a
//                        record), the body (element read + `x#index`, a write to ANOTHER
//                        field, `len(b.xs)`, an element write, `#remove`, a whole-record
//                        call, an aliased `&` record, a nested walk of the same field), the
//                        length (0, 1, 3, 6).
// Axes it HOLDS FIXED:   forward direction, one walk per function.
// Over the existing cell it ADDS: scalar and text elements (the existing cell walks struct
//                        elements only), the `#remove` and aliased-`&` declines on a
//                        field, `x#index`, a nested walk of one field, and a walk through a
//                        record inside a record.
//
// Expected values by hand (Bag.xs = [4, 5, 6] unless said):
//   index_sum: 4*1 + 5*2 + 6*3 = 32;  empty 0;  [9] -> 9*1 = 9.
//   into_tot: tot 100 + 4 + 5 + 6 = 115.
//   join_names: ["ab", "", "é€"] -> "ab/" + "/" + "é€/" = "ab//é€/".
//   drop_even: [2, 3, 4, 6, 7, 8] — each even removed steps the index back, so consecutive 4, 6
//     both go: leaves [3, 7], length 2.
//   bump: xs [1, 2, 3], body sums x + len and writes xs[2] = 50 each round:
//     round 1 x=1: s = 1 + 3 = 4;  round 2 x=2: s = 4 + 2 + 3 = 9;  round 3 x=50 (the write
//     already landed): s = 9 + 50 + 3 = 62.
//   pairs over [1, 2, 3]: (1+2+3) * (1+2+3) = 36.
//   deep: (4 + 100) + (5 + 100) + (6 + 100) = 315.
//   cross(a, b) with a.xs and b.xs the SAME vector [1, 2]: the body pushes 10 + len(b.xs)
//     while len(b.xs) < 5, so the walk reads on: x = 1 (push 12), 2 (push 13), 12 (push 14),
//     13, 14: k = 1 + 2 + 12 + 13 + 14 = 42 and the vector ends at length 5.
//   vcross(v, v) on a `&vector<integer>` alias: the same 42, length 5, last element 14.
//   handed: x = 7, then trim clears the vector: k = 7 (a counted loop of the old length 3
//     would read on past it).
//   into_dims: d.w 1 + 4 + 5 + 6 = 16, d.h stays 9.
//   float_sum: 0.5 + 0.25 + 2.0 = 2.75 (all exact in binary).
//   first_big: first x > 4 is 5 -> 50;  none above 9 -> -1.
//
// @falsified-at: none — a coverage cell for a rewrite already correct on main; reach shown by
//   `LOFT_TRACE_FORWARD_WALK=1`: counted are `index_sum`, `bump`, `pairs` (inner walk),
//   `into_dims`, `float_sum`, `first_big`; declined are `into_tot`, `drop_even`, `pairs`
//   (outer walk), `cross`, `vcross`, `handed`; `LOFT_NO_FORWARD_WALK=1` makes the counted ones
//   silent.  The `cross`/`vcross` aliasing case is the planted defect of the rule's own
//   record (the `&`-parameter clause dropped answers 2 rounds for 5).

struct Dims { w: integer, h: integer }
struct Bag { xs: vector<integer>, names: vector<text>, ws: vector<float>, tot: integer }
struct Pair { bag: Bag, k: integer }

fn mk(v: vector<integer>) -> Bag { Bag { xs: v, names: [], ws: [], tot: 0 } }

fn index_sum(b: Bag) -> integer {
  t = 0;
  for x in b.xs { t += x * (x#index + 1); }
  t
}

fn into_tot(b: Bag) { for x in b.xs { b.tot += x; } }

fn join_names(b: Bag) -> text {
  out = "";
  for n in b.names { out += n + "/"; }
  out
}

fn drop_even(b: Bag) -> integer {
  for x in b.xs if x % 2 == 0 { x#remove; }
  len(b.xs)
}

fn bump(b: Bag) -> integer {
  s = 0;
  for x in b.xs { s += x + len(b.xs); b.xs[2] = 50; }
  s
}

fn pairs(b: Bag) -> integer {
  t = 0;
  for x in b.xs { for y in b.xs { t += x * y; } }
  t
}

fn deep(p: Pair) -> integer {
  t = 0;
  for x in p.bag.xs { t += x + p.k; }
  t
}

fn cross(a: Bag, b: Bag) -> integer {
  k = 0;
  for x in a.xs { k += x; if len(b.xs) < 5 { b.xs += [10 + len(b.xs)]; } }
  k
}

fn vcross(a: vector<integer>, b: &vector<integer>) -> integer {
  k = 0;
  for x in a { k += x; if len(b) < 5 { b += [10 + len(b)]; } }
  k
}

fn trim(b: Bag) { if len(b.xs) > 1 { b.xs.clear(); } }

fn handed(b: Bag) -> integer {
  k = 0;
  for x in b.xs { k += x; trim(b); }
  k
}

fn into_dims(b: Bag, d: Dims) { for x in b.xs { d.w += x; } }

fn float_sum(b: Bag) -> float {
  t = 0.0;
  for w in b.ws { t += w; }
  t
}

fn first_big(b: Bag, lim: integer) -> integer {
  for x in b.xs { if x > lim { return x * 10; } }
  -1
}

fn main() {
  a = mk([4, 5, 6]);
  assert(index_sum(a) == 32, "index_sum {index_sum(a)}");
  assert(index_sum(mk([])) == 0, "index_sum empty");
  assert(index_sum(mk([9])) == 9, "index_sum one {index_sum(mk([9]))}");
  b = mk([4, 5, 6]);
  b.tot = 100;
  into_tot(b);
  assert(b.tot == 115 && len(b.xs) == 3, "into_tot {b.tot}");
  n = mk([]);
  n.names = ["ab", "", "é€"];
  jn = join_names(n);
  assert(jn == "ab//é€/", "join_names {jn}");
  d = mk([2, 3, 4, 6, 7, 8]);
  dl = drop_even(d);
  assert(dl == 2 && d.xs[0] == 3 && d.xs[1] == 7 && len(d.xs) == 2, "drop_even {dl} {d.xs[0]}");
  u = mk([1, 2, 3]);
  bp = bump(u);
  assert(bp == 62 && u.xs[2] == 50, "bump {bp}");
  pr = pairs(mk([1, 2, 3]));
  assert(pr == 36, "pairs {pr}");
  dp = deep(Pair { bag: mk([4, 5, 6]), k: 100 });
  assert(dp == 315, "deep {dp}");
  w = mk([1, 2]);
  cr = cross(w, w);
  assert(cr == 42 && len(w.xs) == 5, "cross {cr} {len(w.xs)}");
  vw: vector<integer> = [1, 2];
  vc = vcross(vw, vw);
  assert(vc == 42 && len(vw) == 5 && vw[4] == 14, "vcross {vc} {len(vw)}");
  h = mk([7, 8, 9]);
  hd = handed(h);
  assert(hd == 7 && len(h.xs) == 0, "handed {hd}");
  dm = Dims { w: 1, h: 9 };
  into_dims(a, dm);
  assert(dm.w == 16 && dm.h == 9, "into_dims {dm.w} {dm.h}");
  f = mk([]);
  f.ws = [0.5, 0.25, 2.0];
  fs = float_sum(f);
  assert(fs == 2.75, "float_sum {fs}");
  assert(first_big(a, 4) == 50 && first_big(a, 9) == -1, "first_big {first_big(a, 4)} {first_big(a, 9)}");
}
