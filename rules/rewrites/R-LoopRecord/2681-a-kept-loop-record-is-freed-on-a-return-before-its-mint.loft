//
// A KEPT LOOP RECORD IS FREED ON A RETURN BEFORE ITS MINT (`@FR-R-LoopRecord`, `@FR-H-FreeAll`,
// loft#2681).  A record local minted by a literal in a loop body is declared before the loop,
// kept across the passes and freed once after the loop.  A `return` that the source wrote where
// the local was not declared yet — at the head of a later pass, in an outer loop of the nest —
// holds the record kept from an earlier pass, and the free after the loop never runs on that
// path.  It leaked one store per call, on both backends, while every value stayed right.
//
// Axes this file MOVES:  the exit (`return`, `break`, `continue`), before or after the mint, on
//                        the first pass or a later one; `for` and `while`; a plain record and one
//                        with a vector field (the refill clause); the exit in the inner body, in
//                        the outer body before the inner loop and after it; a `return` in
//                        expression position.
// Axes it HOLDS FIXED:   one record local per loop; the record's value read as a scalar.
//
// Values by hand: the passes that reach the use add their value (`i`, or `o * 10 + i` in the
// nest, inner and outer loops of three).  Exit at `i == 2` of `0..5`: `return`/`break` before
// the mint 0+1 = 1, after it 0+1+2 = 3, `continue` before it 0+1+3+4 = 8; at `i == 0`, 0.  Nest:
// a return at o 1, i 1 = 0+1+2 + 10 = 13; at the head of o 2 = 3 + 33 = 36; after the inner loop
// of o 1 = 36.
//
// CHANNEL: the leak gate (`LOFT_LEAK_CHECK`, which the suite runner sets): `1 store(s) not freed`
// in every `return` function below the controls; the assertions hold either way.
// Measured by hand: on main ebff34f71 12 of 102 cells of the matrix leak one store, alike on
// --interpret and --native (`LOFT_NATIVE_LEAK_CHECK`); none with `LOFT_NO_LOOP_RECORD=1`.
// The store records see it too: on the tree before the fix `LOFT_OWN_ORACLE=check-records` reports
// `store-leak … a path reaches a return with the store live, held by r` in every `return`
// function (`scripts/own_sweep.py --cell` reads CAUGHT), and nothing after it (CLEAN).
//
// @falsified-by: tests/falsified/2681-a-kept-loop-record-is-freed-on-a-return-before-its-mint.patch — interpret exit 1 -> 0, interpret leaked kt=100 S2681×1 -> clean, native exit 1 -> 0, native leaked kt=100 S2681×1 -> clean
//   ARMED: LOFT_LEAK_CHECK=1, which the suite runner sets.

struct S2681 { a: integer }
struct Pv2681 { v: vector<integer> }

fn head2681() -> integer {
  acc = 0;
  for i in 0..5 {
    if i == 2 { return acc; }
    r = S2681 { a: i };
    acc += r.a;
  }
  acc
}

fn first_pass2681() -> integer {
  acc = 0;
  for i in 0..5 {
    if i == 0 { return acc; }
    r = S2681 { a: i };
    acc += r.a;
  }
  acc
}

fn while2681() -> integer {
  acc = 0;
  i = 0;
  while i < 5 {
    if i == 2 { return acc; }
    r = S2681 { a: i };
    acc += r.a;
    i += 1;
  }
  acc
}

fn refill2681() -> integer {
  acc = 0;
  for i in 0..5 {
    if i == 2 { return acc; }
    r = Pv2681 { v: [i] };
    acc += r.v[0] ?? -1;
  }
  acc
}

fn nest_inner2681() -> integer {
  acc = 0;
  for o in 0..3 {
    for i in 0..3 {
      if o == 1 && i == 1 { return acc; }
      r = S2681 { a: o * 10 + i };
      acc += r.a;
    }
  }
  acc
}

fn nest_outer2681() -> integer {
  acc = 0;
  for o in 0..3 {
    if o == 2 { return acc; }
    for i in 0..3 {
      r = Pv2681 { v: [o * 10 + i] };
      acc += r.v[0] ?? -1;
    }
  }
  acc
}

fn nest_after2681() -> integer {
  acc = 0;
  for o in 0..3 {
    for i in 0..3 {
      r = S2681 { a: o * 10 + i };
      acc += r.a;
    }
    if o == 1 { return acc; }
  }
  acc
}

fn expression2681() -> integer {
  acc = 0;
  for i in 0..5 {
    // The `match` spelling: the `if` one types the join `integer?` (loft#2682).
    acc += match i { 2 => return acc, _ => 0 };
    r = S2681 { a: i };
    acc += r.a;
  }
  acc
}

fn break2681() -> integer {
  acc = 0;
  for i in 0..5 {
    if i == 2 { break; }
    r = S2681 { a: i };
    acc += r.a;
  }
  acc
}

fn continue2681() -> integer {
  acc = 0;
  for i in 0..5 {
    if i == 2 { continue; }
    r = S2681 { a: i };
    acc += r.a;
  }
  acc
}

fn after2681() -> integer {
  acc = 0;
  for i in 0..5 {
    r = S2681 { a: i };
    acc += r.a;
    if i == 2 { return acc; }
  }
  acc
}

fn test_a_return_at_the_head_of_a_later_pass() {
  assert(head2681() == 1, "for: {head2681()}");
}

fn test_a_return_on_the_first_pass() {
  assert(first_pass2681() == 0, "first pass: {first_pass2681()}");
}

fn test_a_return_in_a_while() {
  assert(while2681() == 1, "while: {while2681()}");
}

fn test_a_return_before_a_refilled_record() {
  assert(refill2681() == 1, "refill: {refill2681()}");
}

fn test_a_return_in_the_inner_loop() {
  assert(nest_inner2681() == 13, "inner: {nest_inner2681()}");
}

fn test_a_return_in_the_outer_loop_before_the_inner() {
  assert(nest_outer2681() == 36, "outer: {nest_outer2681()}");
}

fn test_a_return_in_the_outer_loop_after_the_inner() {
  assert(nest_after2681() == 36, "after: {nest_after2681()}");
}

fn test_a_return_in_expression_position() {
  assert(expression2681() == 1, "expression: {expression2681()}");
}

fn test_the_exits_that_never_leaked() {
  assert(break2681() == 1, "break: {break2681()}");
  assert(continue2681() == 8, "continue: {continue2681()}");
  assert(after2681() == 3, "after the mint: {after2681()}");
}
