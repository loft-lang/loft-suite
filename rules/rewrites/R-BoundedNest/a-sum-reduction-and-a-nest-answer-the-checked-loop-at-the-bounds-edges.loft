//
// A SUM REDUCTION AND A NEST ANSWER THE CHECKED LOOP AT THE BOUNDS' EDGES
// (`@FR-R-BoundedNest`).  The rule runs an integer accumulate with plain operators only where a
// guard taken at the loop's entry proves that no operation can fault, and otherwise leaves the
// checked loop to answer.  Its reduction clause (`acc = acc + v[i]` over an integer vector, also
// the stdlib `sum`'s loop) is one kernel call that adds blocks of 1024 elements plain while every
// element lies in [-2^40, 2^40) and the running total stays more than 2^50 from the i64 edge,
// and resumes the checked loop at the first block that fails.  Whatever mix of blocks, edges
// and nulls the data holds, the answer must be the checked loop's: the exact sum, or null where
// a prefix leaves the type or an element is null.
//
// Axes this file MOVES:  the vector's length against the 1024-element block (0, 3, 1023, 1024,
//                        1025, 2500), where the first element outside the plain bound sits (none,
//                        element 1500 of 2500, exactly 2^40, exactly 2^40 - 1), the start of the
//                        accumulator (0, 7, 9223372036854775800, the edge less ten), the sign
//                        (all negative, alternating), a stored null, the loop's shape (index
//                        loop, `for x in v`, operands the other way round, a second statement,
//                        floats); then a nest with a negative coefficient, a counter named
//                        twice, and products at the edge of the type.
// Axes it HOLDS FIXED:   `integer` accumulators and `vector<integer>` sources.
// Over the existing cell it ADDS: the reduction clause (the existing cell holds only the nest),
//                        block-size boundaries, the bound's edges, the accumulator's start, the
//                        loops that decline; and for the nest a negative offset, an index chain
//                        naming the counter twice, and a product exactly at, and one over, the
//                        edge of the type.
//
// Expected values by hand (n(v) below is the vector of length n with v[i] = i + 1).
//   s1  n = 2500: 2500·2501/2 = 3126250.   s2  n = 1023: 1023·1024/2 = 523776; n = 1024:
//   524800; n = 1025: 525825; n = 3: 6; n = 0: 0.   s3  element 1500 of 2500 replaced by 2^41
//   = 2199023255552 (it was 1501): 3126250 − 1501 + 2199023255552 = 2199026380301.
//   s4  stored null at element 700 (written as the overflow `max + 1`, which is the null): null.   s5  start 9223372036854775800 with [5, 3]: 5 fits
//   (…805), then +3 passes the maximum 9223372036854775807: null;  start max − 10 with [5, 5]:
//   exactly 9223372036854775807, not null.   s6  −(i + 1) for 2500: −3126250.   s7  alternating
//   v[i] = i for even i, −i for odd i, over 2500: pairs (2k) + (−(2k+1)) = −1 each, 1250 pairs:
//   −1250.   s8  start 7 over n(2500): 7 + 3126250 = 3126257.   s9  [2^40, −2^40, 5]: 5;
//   [2^40 − 1] three times: 3·1099511627775 = 3298534883325.   s10  empty with start 5: 5.
//   s11  `for x in v { acc += x }` over n(2500): 3126250; `acc = v[i] + acc`: the same.
//   s12  a body of two statements (sum and count) over n(2500): 3126250 and 2500.
//   s13  floats [0.5, 0.25, 2.0, 1.25]: 4.0.
//   nests, v = [7, −3, 5, 11], w = [2, −1]:  taps(v, w, 3, 2) = (14 + 3) + (−6 − 5) + (10 − 11)
//   = 5;  taps(v, w, 4, 2) adds i = 3: 22 + (v[4] = null → 0)·(−1) = 22: 27.
//   back(v, 4): v[3 − j] for j in 0..4 = 11 + 5 − 3 + 7 = 20; back(v, 5): j = 4 reads v[−1],
//   the LAST element, 11: 31.  twice(v, 3): v[i + i + j] summed over j in 0..2: i = 0: 7 − 3 = 4;
//   i = 1: 5 + 11 = 16; i = 2: v[4], v[5] both absent, 0: 20.
//   edge(3037000499) = 3037000499² = 9223372030926249001 (below the maximum);
//   edge(3037000500) = 9223372037000250000, above it: null.  stored null in a nest: [2, null, 4]
//   with w = [1, 1, 1]: 2 + 0 + 4 = 6 (a stored null discharges to 0).
//
// @falsified-at: none — a coverage cell for a rewrite already correct on main; reach shown by
//   `LOFT_REWRITE_CENSUS_FN=<file> loft --native-c` (ir R-BoundedNest/kernel in `add_up` and
//   `reduce_start`, the two index loops of the exact `acc = acc + v[i]` shape; `reduce_flip`,
//   `reduce_each` and `reduce_two` keep their loops and must answer the same; the kernel is
//   gone with `LOFT_NO_LOOP_KERNELS=1` and `loft introspect` shows `vector_sum_int` calls).  The main
//   nest clause (`taps`, `back`, `twice`, `edge`) is emitted by the rustc writer only, so on
//   the interpreter and the C backend these cells check the checked loop's answers; their
//   guard runs on `--native`, which is not built here.

fn nvec(n: integer) -> vector<integer> {
  v: vector<integer> = [];
  for i in 0..n { v += [i + 1]; }
  v
}

fn add_up(v: vector<integer>, start: integer) -> integer {
  acc = start;
  for i in 0..len(v) { acc = acc + v[i]; }
  acc
}

fn reduce_flip(v: vector<integer>, start: integer) -> integer {
  acc = start;
  for i in 0..len(v) { acc = v[i] + acc; }
  acc
}

fn reduce_each(v: vector<integer>) -> integer {
  acc = 0;
  for x in v { acc += x; }
  acc
}

fn reduce_start(v: vector<integer>) -> integer {
  acc = 7;
  for i in 0..len(v) { acc = acc + v[i]; }
  acc
}

fn reduce_two(v: vector<integer>) -> text {
  acc = 0;
  cnt = 0;
  for i in 0..len(v) { acc = acc + v[i]; cnt += 1; }
  "{acc}/{cnt}"
}

fn reduce_float(v: vector<float>) -> float {
  acc = 0.0;
  for i in 0..len(v) { acc = acc + v[i]; }
  acc
}

fn taps(v: vector<integer>, w: vector<integer>, n: integer, m: integer) -> integer {
  acc = 0;
  for i in 0..n { for j in 0..m { acc = acc + v[i + j]? * w[j]?; } }
  acc
}

fn back(v: vector<integer>, m: integer) -> integer {
  acc = 0;
  for _i in 0..1 { for j in 0..m { acc = acc + v[3 - j]?; } }
  acc
}

fn twice(v: vector<integer>, n: integer) -> integer {
  acc = 0;
  for i in 0..n { for j in 0..2 { acc = acc + v[i + i + j]?; } }
  acc
}

fn main() {
  v = nvec(2500);
  assert(add_up(v, 0) == 3126250, "s1 {add_up(v, 0)}");
  assert(add_up(nvec(1023), 0) == 523776 && add_up(nvec(1024), 0) == 524800 && add_up(nvec(1025), 0) == 525825, "s2 {add_up(nvec(1023), 0)} {add_up(nvec(1024), 0)} {add_up(nvec(1025), 0)}");
  assert(add_up(nvec(3), 0) == 6 && add_up(nvec(0), 0) == 0, "s2 short {add_up(nvec(3), 0)} {add_up(nvec(0), 0)}");
  big = nvec(2500);
  big[1500] = 2199023255552;
  assert(add_up(big, 0) == 2199026380301 && len(big) == 2500, "s3 {add_up(big, 0)}");
  nul = nvec(2500);
  top = 9223372036854775807;
  nul[700] = top + 1;
  s4 = add_up(nul, 0);
  assert(s4 == null, "s4 {s4}");
  s5a = add_up([5, 3], 9223372036854775800);
  assert(s5a == null, "s5 past the maximum {s5a}");
  s5b = add_up([5, 5], 9223372036854775797);
  assert(s5b == 9223372036854775807, "s5 exactly the maximum {s5b}");
  neg = nvec(2500);
  for i in 0..2500 { neg[i] = -(i + 1); }
  assert(add_up(neg, 0) == -3126250, "s6 {add_up(neg, 0)}");
  alt = nvec(2500);
  for i in 0..2500 { alt[i] = if i % 2 == 0 { i } else { -i }; }
  assert(add_up(alt, 0) == -1250, "s7 {add_up(alt, 0)}");
  assert(reduce_start(v) == 3126257, "s8 {reduce_start(v)}");
  assert(add_up([1099511627776, -1099511627776, 5], 0) == 5, "s9 at 2^40 {add_up([1099511627776, -1099511627776, 5], 0)}");
  assert(add_up([1099511627775, 1099511627775, 1099511627775], 0) == 3298534883325, "s9 below 2^40");
  assert(add_up(nvec(0), 5) == 5, "s10 {add_up(nvec(0), 5)}");
  assert(reduce_each(v) == 3126250 && reduce_flip(v, 0) == 3126250, "s11 {reduce_each(v)} {reduce_flip(v, 0)}");
  assert(reduce_two(v) == "3126250/2500", "s12 {reduce_two(v)}");
  assert(reduce_float([0.5, 0.25, 2.0, 1.25]) == 4.0, "s13 {reduce_float([0.5, 0.25, 2.0, 1.25])}");

  tv = [7, -3, 5, 11];
  tw = [2, -1];
  assert(taps(tv, tw, 3, 2) == 5, "taps {taps(tv, tw, 3, 2)}");
  assert(taps(tv, tw, 4, 2) == 27, "taps reading past the end {taps(tv, tw, 4, 2)}");
  assert(back(tv, 4) == 20 && back(tv, 5) == 31, "back {back(tv, 4)} {back(tv, 5)}");
  assert(twice(tv, 3) == 20, "twice {twice(tv, 3)}");
  e1 = taps([3037000499], [3037000499], 1, 1);
  assert(e1 == 9223372030926249001, "edge {e1}");
  e2 = taps([3037000500], [3037000500], 1, 1);
  assert(e2 == null, "over the edge {e2}");
  sn = [2, 0, 4];
  sn[1] = top + 1;
  assert(taps(sn, [1, 1, 1], 1, 3) == 6, "stored null in a nest {taps(sn, [1, 1, 1], 1, 3)}");
}
