//
// `@FR-R-Scalar` crossed with `@FR-R-Invariant`: in one loop an integer chain over a value the
// loop never writes (`m * 3 - 1`) is memoised at its first use (R-Invariant), and a record's
// scalar fields are hoisted unless the body's write set reaches them (R-Scalar) — and the body
// calls an admitted in-place callee that writes `V.f`.  Keys carry the TYPE, so the callee's
// write stales `a.f` whichever record it is handed: with a different record the loop's sum
// is the constant per pass, with the SAME record it reads each pass's new value, and the
// memo is the same on every pass either way; a memo that is null makes every pass null.
//
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.
// CHANNEL: the assertions and the leak gate.

struct V { f: integer, g: integer }

fn bump(w: V) { w.f += 1; }

fn run(a: V, b: V, n: integer, m: integer) -> integer {
  s = 0;
  for i in 0..n { s += a.f * 10 + a.g + (m * 3 - 1); bump(b); }
  s
}

fn test_another_record_and_the_same_record() {
  a = V { f: 1, g: 2 };
  b = V { f: 0, g: 0 };
  assert(run(a, b, 4, 5) == 104 && b.f == 4 && a.f == 1, "another record: {run(V { f: 1, g: 2 }, V { f: 0, g: 0 }, 4, 5)}");
  c = V { f: 1, g: 2 };
  assert(run(c, c, 4, 5) == 164 && c.f == 5, "the same record: {c.f}");
}

fn test_a_null_memo() {
  a = V { f: 1, g: 2 };
  assert(run(a, a, 3, 4611686018427387904) == null && a.f == 4, "a null memo: {a.f}");
  assert(run(a, a, 0, 4611686018427387904) == 0 && a.f == 4, "no pass evaluates nothing");
}
