//
// `@FR-R-Place` crossed with `@FR-B-Copy`: a call whose result has ONE owning destination is
// handed a return buffer claimed in that destination's store — the place itself where it
// exists (the "buffer IS the place" clause) — so the later store moves nothing, and the program
// still sees every copy B-Copy owes: a bind of the placed field is its own vector, an argument
// that reaches the destination (`h.v = grow(h.v, …)`) reads the old value, a local bound from a
// call and then stored is independent of the field, a result placed into an appended element's
// field per call (admitted) holds the callee's value, and a result READ after its store
// (declined: B-Copy would show) keeps the copy, so its growth does not reach the element.
// The twin `a-placed-result-answers-the-same-with-the-placement-switched-off.loft` runs the same
// cells with the rewrite switched off.
//
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.
// CHANNEL: the assertions and the leak gate.

struct Paint { pk: integer, spec: vector<integer> }
struct H { v: vector<integer>, tag: integer }
struct Op { kind: integer, paint: Paint }
struct Sk { ops: vector<Op> }

fn mkv(n: integer) -> vector<integer> { r: vector<integer> = []; for i in 0..n { r += [i * 10]; } r }
fn grow(v: vector<integer>, k: integer) -> vector<integer> { r: vector<integer> = []; for x in v { r += [x + k]; } r += [k]; r }
fn paint(k: integer) -> Paint { Paint { pk: k, spec: [k, k * 2] } }
fn digits(v: vector<integer>) -> integer { s = 0; for x in v { s = s * 100 + x; } s }

fn add(sk: Sk, k: integer) -> integer { p = paint(k); sk.ops += [Op { kind: k, paint: p }]; 1 }
fn add_then_grow(sk: Sk, k: integer) -> integer {
  p = paint(k);
  sk.ops += [Op { kind: k, paint: p }];
  p.spec += [9];
  len(p.spec) * 10 + len(sk.ops[len(sk.ops) - 1].paint.spec)
}

fn test_the_copies_b_copy_owes() {
  h = H { v: [], tag: 1 };
  h.v = mkv(3);
  w = h.v;
  w += [99];
  w[0] = 7;
  assert(digits(h.v) == 1020 && len(h.v) == 3 && digits(w) == 7102099, "a bind of the field: {digits(h.v)} {digits(w)}");
  h.v = grow(h.v, 5);
  assert(digits(h.v) == 5152505 && len(h.v) == 4, "an argument reaching the place: {digits(h.v)}");
  r = mkv(2);
  h.v = r;
  r += [1];
  r[1] = 3;
  assert(digits(h.v) == 10 && len(h.v) == 2 && digits(r) == 301, "a local stored then grown: {digits(h.v)} {digits(r)}");
}

fn test_a_result_placed_into_an_appended_element() {
  sk = Sk { ops: [] };
  n = 0;
  for i in 0..4 { n += add(sk, i + 1); }
  t = 0;
  for o in sk.ops { t = t * 100 + o.paint.pk * 10 + len(o.paint.spec); }
  assert(n == 4 && len(sk.ops) == 4 && t == 12223242 && digits(sk.ops[3].paint.spec) == 408, "placed: {t}");
  k = add_then_grow(sk, 6);
  assert(k == 32 && len(sk.ops) == 5 && digits(sk.ops[4].paint.spec) == 612, "a result read after its store keeps the copy: {k}");
}
