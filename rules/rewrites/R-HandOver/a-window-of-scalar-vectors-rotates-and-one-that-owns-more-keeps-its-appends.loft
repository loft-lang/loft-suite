//
// A WINDOW OF SCALAR VECTORS ROTATES, AND ONE THAT OWNS MORE, READS ITS ELEMENTS, OR IS NOT AT
// ITS SIZE KEEPS ITS APPENDS (`@FR-R-HandOver`, rotate clause).  `h.es += [e]; S; if K <
// len(h.es) { drop_old(h, len(h.es) - K) }` is decided at run time before the append: where
// the vector holds exactly K elements of a type that owns plain vectors and nothing else, the
// copy goes into the oldest element's blocks and the slots rotate left; otherwise the
// statements run as written.  Either way the window must hold the K newest entries, in order,
// with the cursor the drop leaves.
//
// Axes this file MOVES:  the element's owners (a vector of integers; a text and a vector; a
//                        vector of records that each own a text), the window size K (1, 2,
//                        3), what the new entry's vector holds against the oldest element's
//                        (longer, shorter, empty, empty against empty), what S reads (nothing;
//                        an element of the window), the window's length at the push (exactly K
//                        or longer), the cursor (moved back before a push).
// Axes it HOLDS FIXED:   the pair sits in a function taking the history record, entries are
//                        built in the store (not held apart).
// Over the existing cell it ADDS: element types the rotate admits without `@FR-R-Apart` (a
//                        scalar vector), the element types it declines, an S that reads, a
//                        window already past K, and K = 1 with empty/non-empty transitions.
//
// Expected values by hand.  An entry prints `len(xs):sum(xs):tag`; mk(k, n) has xs = k*100 + j
// for j in 0..n and tag k.
//   c1  K=3, k = 1..8 with n = (2k) % 5 = 2, 4, 1, 3, 0, 2, 4, 1: the window holds k = 6, 7, 8:
//       [600, 601] -> 2:1201:6;  [700..703] -> 4:2806:7;  [800] -> 1:800:8; cursor 3.
//   c2  K=2 over (text, vector), k = 1..5, name "n{k}", xs = k*10 + j for j in 0..k: k=4 holds
//       [40, 41, 42, 43] = 166, k=5 [50..54] = 260: "n4:4:166 n5:5:260"; cursor 2.
//   c3  K=2 (one element k * 100 each), S reads the window's first element between append and
//       drop: after push 3 the vector is [1, 2, 3], first tag 1 -> last = 1; after push 4 it
//       is [2, 3, 4], first tag 2 -> last = 2; window tags 3, 4: "2 2 [1:300:3 1:400:4]".
//   c4  five entries appended directly (tags 1..5, cursor 5), then one push at K=3: the
//       vector holds 6, the drop takes 3, keeping tags 4, 5, 6 with xs of n = k % 3 + 1:
//       k=4 [400, 401] = 801;  k=5 [500, 501, 502] = 1503;  k=6 [600] = 600; cursor 6 - 3 = 3.
//   c5  K=1, n = (k % 2) * 3 for k = 1..4: k=1 [100, 101, 102] = 303 (3:303:1), k=2 empty
//       (0:0:2), k=3 [300, 301, 302] = 903 (3:903:3), k=4 empty (0:0:4).
//   c6  K=3 with the cursor moved back: pushes k = 1..4 of one element k * 100 leave tags 2, 3, 4
//       (cursor 3); cursor set to 1, push 5 truncates to [tag 2] and appends: "2 2 [1:200:2
//       1:500:5]"; push 6 -> [2, 5, 6] cursor 3; push 7 -> drop 1 -> tags 5, 6, 7 = 500, 600, 700.
//   c7  K=2 over records that each own a text: pushes k = 1..4 of [Q "a{k}", Q "b{k}"]: the
//       window holds k = 3, 4: "a3b3|a4b4".
//
// @falsified-at: none — a coverage cell for a rewrite already correct on main; reach shown by
//   `LOFT_TRACE_HAND_OVER=1` naming push3a / push1a (the sites admitted) and not push2b,
//   push2r, push2c; LOFT_NO_HAND_OVER=1 must answer the same (rustc-native and C).

struct A { xs: vector<integer>, tag: integer }
struct TA { es: vector<A>, cur: integer, last: integer }
struct B { name: text, xs: vector<integer> }
struct TB { es: vector<B>, cur: integer }
struct Q { s: text }
struct R { qs: vector<Q>, tag: integer }
struct TR { es: vector<R>, cur: integer }

fn mka(k: integer, n: integer) -> A {
  e = A { xs: [], tag: k };
  for j in 0..n { e.xs += [k * 100 + j]; }
  e
}

fn show_a(t: const TA) -> text {
  s = "";
  for e in t.es {
    sum = 0;
    for x in e.xs { sum += x; }
    if len(s) > 0 { s += " "; }
    s += "{len(e.xs)}:{sum}:{e.tag}";
  }
  "{len(t.es)} {t.cur} [{s}]"
}

fn trunc_a(h: TA, n: integer) {
  if n >= len(h.es) { return; }
  nv: vector<A> = [];
  for i in 0..n { nv += [h.es[i]?]; }
  h.es = nv;
}

fn drop_a(h: TA, n: integer) {
  if n <= 0 || n > len(h.es) { return; }
  nv: vector<A> = [];
  for i in n..len(h.es) { nv += [h.es[i]?]; }
  h.es = nv;
  h.cur = h.cur - n;
  if h.cur < 0 { h.cur = 0; }
}

fn push3a(h: TA, e: A) {
  trunc_a(h, h.cur);
  h.es += [e];
  h.cur = h.cur + 1;
  if len(h.es) > 3 { drop_a(h, len(h.es) - 3); }
}

fn push1a(h: TA, e: A) {
  trunc_a(h, h.cur);
  h.es += [e];
  h.cur = h.cur + 1;
  if len(h.es) > 1 { drop_a(h, len(h.es) - 1); }
}

fn push2c(h: TA, e: A) {
  trunc_a(h, h.cur);
  h.es += [e];
  h.cur = h.cur + 1;
  h.last = h.es[0].tag ?? -1;
  if len(h.es) > 2 { drop_a(h, len(h.es) - 2); }
}

fn trunc_b(h: TB, n: integer) {
  if n >= len(h.es) { return; }
  nv: vector<B> = [];
  for i in 0..n { nv += [h.es[i]?]; }
  h.es = nv;
}

fn drop_b(h: TB, n: integer) {
  if n <= 0 || n > len(h.es) { return; }
  nv: vector<B> = [];
  for i in n..len(h.es) { nv += [h.es[i]?]; }
  h.es = nv;
  h.cur = h.cur - n;
  if h.cur < 0 { h.cur = 0; }
}

fn push2b(h: TB, e: B) {
  trunc_b(h, h.cur);
  h.es += [e];
  h.cur = h.cur + 1;
  if len(h.es) > 2 { drop_b(h, len(h.es) - 2); }
}

fn trunc_r(h: TR, n: integer) {
  if n >= len(h.es) { return; }
  nv: vector<R> = [];
  for i in 0..n { nv += [h.es[i]?]; }
  h.es = nv;
}

fn drop_r(h: TR, n: integer) {
  if n <= 0 || n > len(h.es) { return; }
  nv: vector<R> = [];
  for i in n..len(h.es) { nv += [h.es[i]?]; }
  h.es = nv;
  h.cur = h.cur - n;
  if h.cur < 0 { h.cur = 0; }
}

fn push2r(h: TR, e: R) {
  trunc_r(h, h.cur);
  h.es += [e];
  h.cur = h.cur + 1;
  if len(h.es) > 2 { drop_r(h, len(h.es) - 2); }
}

fn main() {
  t = TA { es: [], cur: 0, last: 0 };
  for k in 1..9 { push3a(t, mka(k, (2 * k) % 5)); }
  r = show_a(t);
  assert(r == "3 3 [2:1201:6 4:2806:7 1:800:8]", "c1: {r}");

  tb = TB { es: [], cur: 0 };
  for k in 1..6 {
    e = B { name: "n{k}", xs: [] };
    for j in 0..k { e.xs += [k * 10 + j]; }
    push2b(tb, e);
  }
  sb = "";
  for e in tb.es {
    sum = 0;
    for x in e.xs { sum += x; }
    if len(sb) > 0 { sb += " "; }
    sb += "{e.name}:{len(e.xs)}:{sum}";
  }
  assert(sb == "n4:4:166 n5:5:260" && len(tb.es) == 2 && tb.cur == 2, "c2: {sb} {tb.cur}");

  tc = TA { es: [], cur: 0, last: 0 };
  for k in 1..5 { push2c(tc, mka(k, 1)); }
  rc = show_a(tc);
  assert(tc.last == 2 && rc == "2 2 [1:300:3 1:400:4]", "c3: last {tc.last} {rc}");

  td = TA { es: [], cur: 5, last: 0 };
  for k in 1..6 { td.es += [mka(k, k % 3 + 1)]; }
  push3a(td, mka(6, 6 % 3 + 1));
  rd = show_a(td);
  assert(rd == "3 3 [2:801:4 3:1503:5 1:600:6]", "c4: {rd}");

  te = TA { es: [], cur: 0, last: 0 };
  push1a(te, mka(1, 3));
  r1 = show_a(te);
  push1a(te, mka(2, 0));
  r2 = show_a(te);
  push1a(te, mka(3, 3));
  r3 = show_a(te);
  push1a(te, mka(4, 0));
  r4 = show_a(te);
  assert(r1 == "1 1 [3:303:1]" && r2 == "1 1 [0:0:2]" && r3 == "1 1 [3:903:3]" && r4 == "1 1 [0:0:4]", "c5: {r1} {r2} {r3} {r4}");

  tf = TA { es: [], cur: 0, last: 0 };
  for k in 1..5 { push3a(tf, mka(k, 1)); }
  tf.cur = 1;
  push3a(tf, mka(5, 1));
  rf = show_a(tf);
  assert(rf == "2 2 [1:200:2 1:500:5]", "c6 truncated: {rf}");
  push3a(tf, mka(6, 1));
  push3a(tf, mka(7, 1));
  rg = show_a(tf);
  assert(rg == "3 3 [1:500:5 1:600:6 1:700:7]", "c6: {rg}");

  tr = TR { es: [], cur: 0 };
  for k in 1..5 { push2r(tr, R { qs: [Q { s: "a{k}" }, Q { s: "b{k}" }], tag: k }); }
  sr = "";
  for e in tr.es {
    if len(sr) > 0 { sr += "|"; }
    for q in e.qs { sr += q.s; }
  }
  assert(sr == "a3b3|a4b4" && len(tr.es) == 2 && tr.cur == 2, "c7: {sr} {tr.cur}");
}
