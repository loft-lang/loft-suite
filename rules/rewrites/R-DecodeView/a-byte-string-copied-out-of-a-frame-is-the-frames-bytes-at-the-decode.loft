//
// A BYTE STRING COPIED OUT OF A FRAME IS THE FRAME'S BYTES AT THE DECODE (`@FR-R-DecodeView` crossed
// with `@FR-R-ByteCopy`).  R-DecodeView lets a `vector<u8>` field whose value at construction is "a
// span B[a..b] of a byte vector B — … copied by (R-ByteCopy)'s vector clause" hold the SPAN instead
// of an owned copy, when the frame B is not written until the field's last read and the field is
// read only as a value; otherwise the field stays owned.  R-ByteCopy is the decoder's
// `for k in 0..arg { bs += [bytes[at + k] ?? 0] }`, one slice append behind its guard.  Every road
// answers the bytes the frame held at the decode: decoded byte strings never read (the span road on
// `--native-release`), read as a length, an equality with a literal and a fold (the owned road),
// read after the frame is written, and copied into an owned slot before the frame is written.
//
// The decoder is loft's `tests/scripts/a-decoded-text-is-read-where-it-lies.loft` `read_v` (tag 1 an
// integer, 2 a text, 3 a byte string, 4 a map; a length byte, then the bytes).
//
// Values hand-computed over frame3() = { "op": "apply", "raw": b"hi", "k": b"xyz" }:
//   count_entries → 3 (two byte strings decoded, none read)
//   bytes_eq("raw") → 2 / [104,105] equal / fold 104·7 + 105 = 833 → "2/true/833"
//   bytes_eq("k")   → 3 / false / ((120·7 + 121)·7 + 122) = 6849 → "3/false/6849"
//   bytes_scribble("k"): the frame's last byte set to 33 after the decode → "3/120/122"
//   bytes_copied("k"): own = the byte string, then the frame's last byte set to 34 → "3/122"
//   a truncated frame (the byte string's length past the end) → "?" (no value decoded)
//
// Axes it MOVES: the byte string's use (none, length, equality, fold, element reads, a copy into an
//   owned slot), the frame written after the decode or not, a well-formed and a truncated frame.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed, interpret,
//   native and (by hand) --native-release, and the same under LOFT_NO_DECODE_VIEW=1 and
//   LOFT_NO_BYTE_COPY=1.  Fires on --native-release only (the suite's lanes do not reach it):
//   LOFT_TRACE_DECODE_VIEW=1 says `n_count_entries: a root over `frame``; `n_bytes_eq` and
//   `n_bytes_copied` decline "a read of a decoded byte string", `n_bytes_scribble` "an element
//   address of the frame outside a read" — today every byte-string READ keeps the field owned,
//   narrower than the rule's (4); the span road is reached by the unread byte strings only.
// CHANNEL: the asserts.
// ARMED: no instrument (the switches above, by hand).
// WITNESS: each message prints the bytes read.
// HOLDS: loft `tests/scripts/a-decoded-text-is-read-where-it-lies.loft` (the text fields).

enum Val {
  VNull,
  VInt { value: integer },
  VText { value: text },
  VBytes { value: vector<u8> },
  VMap { entries: vector<Entry> },
}

struct Entry {
  key: Val,
  value: Val,
}

struct Dec {
  value: Val,
  next: integer,
  ok: boolean,
}

fn read_v(bytes: vector<u8>, pos: integer, depth: integer) -> Dec {
  n = len(bytes);
  if pos + 1 >= n || depth > 8 { return Dec { value: VNull, next: pos, ok: false }; }
  tag = bytes[pos] ?? 0;
  arg = bytes[pos + 1] ?? 0;
  at = pos + 2;
  if tag == 1 { return Dec { value: VInt { value: arg - 100 }, next: at, ok: true }; }
  if tag == 3 {
    if at + arg > n { return Dec { value: VNull, next: pos, ok: false }; }
    bs: vector<u8> = [];
    for k in 0..arg { bs += [bytes[at + k] ?? 0]; }
    return Dec { value: VBytes { value: bs }, next: at + arg, ok: true };
  }
  if tag == 2 {
    if at + arg > n { return Dec { value: VNull, next: pos, ok: false }; }
    tb: vector<u8> = [];
    for k in 0..arg { tb += [bytes[at + k] ?? 0]; }
    return Dec { value: VText { value: text_from_bytes(tb) }, next: at + arg, ok: true };
  }
  if tag == 4 {
    entries: vector<Entry> = [];
    p = at;
    mok = true;
    for _ in 0..arg {
      if mok {
        kd = read_v(bytes, p, depth + 1);
        if kd.ok {
          vd = read_v(bytes, kd.next, depth + 1);
          if vd.ok {
            kv = kd.value;
            vv = vd.value;
            entries += [Entry { key: kv, value: vv }];
            p = vd.next;
          } else { mok = false; }
        } else { mok = false; }
      }
    }
    if !mok { return Dec { value: VNull, next: pos, ok: false }; }
    return Dec { value: VMap { entries: entries }, next: p, ok: true };
  }
  return Dec { value: VNull, next: pos, ok: false };
}

fn dec(bytes: vector<u8>) -> Dec { read_v(bytes, 0, 0) }

/// The entry of map `m` under text key `key`, or null.
fn get(m: Val, key: text) -> Val {
  match m {
    VMap { entries } => {
      for e in entries {
        match e.key { VText { value } => { if value == key { return e.value; } }, _ => {} }
      }
    },
    _ => {}
  }
  return VNull;
}

fn tb(t: text) -> vector<u8> {
  b: vector<u8> = [];
  for i in 0..size(t) { b += [(t.byte_at(i) & 255) as u8]; }
  b
}

/// map of 3: "op" -> text "apply", "raw" -> bytes "hi", "k" -> bytes "xyz"
fn frame3() -> vector<u8> {
  f: vector<u8> = [4, 3];
  f += [2, 2];
  f += tb("op");
  f += [2, 5];
  f += tb("apply");
  f += [2, 3];
  f += tb("raw");
  f += [3, 2];
  f += tb("hi");
  f += [2, 1];
  f += tb("k");
  f += [3, 3];
  f += tb("xyz");
  f
}

fn count_entries(frame: vector<u8>) -> integer {
  d = dec(frame);
  match d.value { VMap { entries } => { return len(entries); }, _ => {} }
  return -1;
}

fn bytes_eq(frame: vector<u8>, key: text) -> text {
  d = dec(frame);
  match get(d.value, key) {
    VBytes { value } => {
      s = 0;
      for b in value { s = s * 7 + b; }
      return "{len(value)}/{value == [104, 105]}/{s}";
    },
    _ => {}
  }
  return "?";
}

fn bytes_scribble(frame: vector<u8>, key: text) -> text {
  d = dec(frame);
  frame[len(frame) - 1] = 33;
  match get(d.value, key) {
    VBytes { value } => { return "{len(value)}/{value[0] ?? -1}/{value[len(value) - 1] ?? -1}"; },
    _ => {}
  }
  return "?";
}

fn bytes_copied(frame: vector<u8>, key: text) -> text {
  d = dec(frame);
  own: vector<u8> = [];
  match get(d.value, key) { VBytes { value } => { own = value; }, _ => {} }
  frame[len(frame) - 1] = 34;
  "{len(own)}/{own[len(own) - 1] ?? -1}"
}

fn test_unread_byte_strings_are_counted() {
  n = count_entries(frame3());
  assert(n == 3, "count: {n}");
}

fn test_a_read_byte_string_is_the_frames_bytes() {
  f = frame3();
  a = bytes_eq(f, "raw");
  b = bytes_eq(f, "k");
  assert(a == "2/true/833" && b == "3/false/6849", "reads: {a} {b}");
}

fn test_a_later_write_to_the_frame_is_not_seen() {
  g = frame3();
  h = frame3();
  a = bytes_scribble(g, "k");
  b = bytes_copied(h, "k");
  assert(a == "3/120/122" && b == "3/122", "after a write: {a} {b}");
}

fn test_a_truncated_byte_string_decodes_nothing() {
  t: vector<u8> = [3, 9, 1, 2];
  a = bytes_eq(t, "raw");
  assert(a == "?", "truncated: {a}");
}

fn main() {
  test_unread_byte_strings_are_counted();
  test_a_read_byte_string_is_the_frames_bytes();
  test_a_later_write_to_the_frame_is_not_seen();
  test_a_truncated_byte_string_decodes_nothing();
}
