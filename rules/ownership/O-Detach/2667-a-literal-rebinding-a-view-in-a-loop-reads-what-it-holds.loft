//
// loft#2667 (`@FR-O-Detach`, `@FR-B-Scope`) — A LITERAL REBINDING A VIEW IN A LOOP READS WHAT
// IT HOLDS.  `cond = tests[2]!` binds a VIEW of the element (`(B-View)`); `cond = Pair { c: …,
// t: cond }` then rebinds the NAME (the element is untouched) to a literal built in the
// compiler's construction temporary and bound.  That temporary is one per site, so on the next
// turn of a loop `cond` names the record the previous turn built there — and the literal's
// `OpDatabase` re-initialised that record IN PLACE before its initialisers ran, so every read
// of `cond` (or of a view of it) read the cleared record: `(0 null)` for `(0 (1 3))`, on both
// backends, silently.  `(B-Scope)`: a rebind of a live binding reads the value it holds; the
// re-init is the temporary's DETACH, which `(O-Detach)` sequences after those reads.  The
// literal now lets the temporary's record go without releasing it, builds in a fresh one, and
// releases the record it let go of after the last initialiser — by store identity.
//
// @falsified-at: f4758287d — interpret and native, 17 of 23 tests fail on a wrong value -> 0
//   (a release build of that ref, `--tests`, run by hand)
// CHANNEL: the VALUE — the build carrying the defect is leak-free and frees nothing twice, so a
//   run scored on store lifetimes alone learns nothing; every expected value is hand-computed.
//   The fix is scored for leaks as well (`LOFT_STRICT_STORES=1`, `LOFT_NATIVE_LEAK_CHECK=1`):
//   a cure that let the record go without releasing it answers right and leaks one per turn.
// HOLDS: every cell, on every backend.
// Axes this file MOVES:  the record kind (a struct-enum, a plain struct, a nullable struct); the
//                        first bind (a vector element, a struct field, a parameter, a call, a
//                        literal); the loop (`while`, `for`, an inner loop under the bind's, a
//                        function returning the view); the passes (one, two, three); where the
//                        old value is read (an out-of-line field at depth 1 and 2, the first
//                        field, two fields, a scalar and a text field, an embedded record, a
//                        collection built in its field or copied, through a call, through a view
//                        bound before the literal); a rebind back to a view between turns.
// Axes it HOLDS FIXED:   the rebind is a whole-value literal of the binding's own type; the view
//                        is a local of the frame that rebinds it.  The literal, call and
//                        parameter first binds, the one-pass loop, the rebind back to a view and
//                        the body local bound afresh each pass are the controls that were clean.

enum N {
  Leaf { n: integer },
  Pair { c: N, t: N },
  Nul
}

fn show(n: N) -> text {
  match n {
    Leaf { n: x } => "{x}",
    Pair { c, t } => "({show(c)} {show(t)})",
    Nul => "null"
  }
}

fn depth(n: N) -> integer {
  match n {
    Pair { c, t } => 1 + depth(t),
    _ => 0
  }
}

struct H { f: N }

struct S { n: integer, s: text }

struct Ws { a: S, b: integer }

struct Sv { n: integer, items: vector<integer> }

fn three() -> vector<N> { [Leaf { n: 1 }, Leaf { n: 2 }, Leaf { n: 3 }] }

fn leaf3() -> N { Leaf { n: 3 } }

fn test_an_element_view_two_while_passes() {
  tests = three();
  cond = tests[2]!;
  k = 1;
  while k >= 0 {
    cond = Pair { c: Leaf { n: k }, t: cond };
    k -= 1;
  }
  assert(show(cond) == "(0 (1 3))", show(cond));
  assert(show(tests[2]!) == "3", show(tests[2]!));
}

fn test_a_field_view() {
  h = H { f: Leaf { n: 3 } };
  cond = h.f;
  k = 1;
  while k >= 0 {
    cond = Pair { c: Leaf { n: k }, t: cond };
    k -= 1;
  }
  assert(show(cond) == "(0 (1 3))", show(cond));
  assert(show(h.f) == "3", show(h.f));
}

fn test_a_for_loop() {
  tests = three();
  cond = tests[2]!;
  for k in 0..2 { cond = Pair { c: Leaf { n: k }, t: cond }; }
  assert(show(cond) == "(1 (0 3))", show(cond));
}

fn test_three_passes() {
  tests = three();
  cond = tests[2]!;
  for k in 0..3 { cond = Pair { c: Leaf { n: k }, t: cond }; }
  assert(show(cond) == "(2 (1 (0 3)))", show(cond));
}

fn test_the_old_value_at_depth_two() {
  tests = three();
  cond = tests[2]!;
  for k in 0..2 { cond = Pair { c: Leaf { n: k }, t: Pair { c: Leaf { n: 7 }, t: cond } }; }
  assert(show(cond) == "(1 (7 (0 (7 3))))", show(cond));
}

fn test_the_old_value_in_the_first_field() {
  tests = three();
  cond = tests[2]!;
  for k in 0..2 { cond = Pair { c: cond, t: Leaf { n: k } }; }
  assert(show(cond) == "((3 0) 1)", show(cond));
}

fn test_the_old_value_in_both_fields() {
  tests = three();
  cond = tests[2]!;
  for _k in 0..2 { cond = Pair { c: cond, t: cond }; }
  assert(show(cond) == "((3 3) (3 3))", show(cond));
}

fn test_a_view_of_a_pair() {
  tests = [Leaf { n: 1 }, Pair { c: Leaf { n: 2 }, t: Leaf { n: 4 } }];
  cond = tests[1]!;
  for k in 0..2 { cond = Pair { c: Leaf { n: k }, t: cond }; }
  assert(show(cond) == "(1 (0 (2 4)))", show(cond));
  assert(show(tests[1]!) == "(2 4)", show(tests[1]!));
}

fn test_read_through_a_call() {
  tests = three();
  cond = tests[2]!;
  for _k in 0..3 { cond = Pair { c: Leaf { n: depth(cond) }, t: cond }; }
  assert(show(cond) == "(2 (1 (0 3)))", show(cond));
}

fn chain(tests: vector<N>) -> N {
  cond = tests[2]!;
  for k in 0..2 { cond = Pair { c: Leaf { n: k }, t: cond }; }
  cond
}

fn test_a_function_returns_the_rebound_view() {
  tests = three();
  r = chain(tests);
  assert(show(r) == "(1 (0 3))", show(r));
  assert(show(tests[2]!) == "3", show(tests[2]!));
}

// Back to a view between turns: the temporary still holds the record the second turn built.
fn test_rebound_to_a_view_between_turns() {
  tests = three();
  cond = tests[2]!;
  for k in 0..3 {
    cond = Pair { c: Leaf { n: k }, t: cond };
    if k == 1 { cond = tests[0]!; }
  }
  assert(show(cond) == "(2 1)", show(cond));
}

// 5 + 3 and "a" + "bbb"; the element keeps its own.
fn test_a_struct_scalar_and_text_field() {
  vs = [S { n: 5, s: "a" }];
  s = vs[0];
  k = 0;
  while k < 3 {
    s = S { n: s.n + 1, s: "{s.s}b" };
    k += 1;
  }
  assert("{s.n} {s.s}" == "8 abbb", "{s.n} {s.s}");
  assert("{vs[0].n} {vs[0].s}" == "5 a", "{vs[0].n} {vs[0].s}");
}

fn test_a_nullable_struct() {
  vs = [S { n: 5, s: "a" }];
  s: S? = vs[0];
  k = 0;
  while k < 3 {
    s = S { n: s!.n + 1, s: "{s!.s}b" };
    k += 1;
  }
  assert("{s!.n} {s!.s}" == "8 abbb", "{s!.n} {s!.s}");
}

fn test_an_embedded_record() {
  ws = [Ws { a: S { n: 5, s: "a" }, b: 0 }];
  w = ws[0];
  k = 0;
  while k < 3 {
    w = Ws { a: w.a, b: k };
    k += 1;
  }
  assert("{w.a.n} {w.a.s} {w.b}" == "5 a 2", "{w.a.n} {w.a.s} {w.b}");
}

fn test_a_collection_built_in_its_field() {
  vs = [Sv { n: 5, items: [1, 2] }];
  s = vs[0];
  k = 0;
  while k < 2 {
    s = Sv { n: k, items: [for x in s.items { x * 10 }] };
    k += 1;
  }
  assert("{s.n} {s.items}" == "1 [100,200]", "{s.n} {s.items}");
  assert("{vs[0].items}" == "[1,2]", "{vs[0].items}");
}

fn test_a_collection_copied_into_its_field() {
  vs = [Sv { n: 5, items: [1, 2] }];
  s = vs[0];
  k = 0;
  while k < 2 {
    s = Sv { n: k, items: s.items };
    k += 1;
  }
  assert("{s.n} {s.items}" == "1 [1,2]", "{s.n} {s.items}");
}

// A view of the binding bound before the literal reads the same record.
fn test_a_view_of_the_binding_read_by_the_literal() {
  ws = [Ws { a: S { n: 5, s: "a" }, b: 0 }];
  w = ws[0];
  k = 0;
  while k < 3 {
    a = w.a;
    w = Ws { a: S { n: a.n + 1, s: a.s }, b: k };
    k += 1;
  }
  assert("{w.a.n} {w.b} {ws[0].a.n}" == "8 2 5", "{w.a.n} {w.b} {ws[0].a.n}");
}

// Control: one pass — the temporary holds nothing yet.
fn test_one_pass() {
  tests = three();
  cond = tests[2]!;
  for k in 0..1 { cond = Pair { c: Leaf { n: k }, t: cond }; }
  assert(show(cond) == "(0 3)", show(cond));
}

// Control: the first bind from a literal — the binding owns its store.
fn test_the_first_bind_from_a_literal() {
  cond = Leaf { n: 3 };
  k = 1;
  while k >= 0 {
    cond = Pair { c: Leaf { n: k }, t: cond };
    k -= 1;
  }
  assert(show(cond) == "(0 (1 3))", show(cond));
}

// Control: the first bind from a call.
fn test_the_first_bind_from_a_call() {
  cond = leaf3();
  k = 1;
  while k >= 0 {
    cond = Pair { c: Leaf { n: k }, t: cond };
    k -= 1;
  }
  assert(show(cond) == "(0 (1 3))", show(cond));
}

fn chain_param(c0: N) -> text {
  cond = c0;
  for k in 0..2 { cond = Pair { c: Leaf { n: k }, t: cond }; }
  show(cond)
}

// Control: the first bind from a parameter.
fn test_the_first_bind_from_a_parameter() {
  tests = three();
  r = chain_param(tests[2]!);
  assert(r == "(1 (0 3))", r);
  assert(show(tests[2]!) == "3", show(tests[2]!));
}

// The view bound in an outer loop's body, rebound in an inner loop.
fn test_an_inner_loop_rebinds_an_outer_body_local() {
  tests = three();
  out = "";
  for j in 0..2 {
    cond = tests[j]!;
    for k in 0..2 { cond = Pair { c: Leaf { n: k }, t: cond }; }
    out += show(cond);
  }
  assert(out == "(1 (0 1))(1 (0 2))", out);
}

// Control: the view bound afresh in the same loop body before every rebind.
fn test_a_body_local_bound_each_pass() {
  tests = three();
  b = "";
  for j in 0..2 {
    c2 = tests[2]!;
    c2 = Pair { c: Leaf { n: j }, t: c2 };
    b += show(c2);
  }
  assert(b == "(0 3)(1 3)", b);
}
