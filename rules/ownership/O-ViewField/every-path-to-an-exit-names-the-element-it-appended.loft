//
// EVERY PATH TO AN EXIT NAMES THE ELEMENT IT APPENDED (`@FR-O-ViewField` crossed with
// `@FR-O-Complete`).  O-ViewField's callee half "is a fact at each EXIT, on EVERY path to it
// (O-Complete)": the last change to the container was the append of an element whose field
// copied the value; "where the paths appended DIFFERENT elements it is the field of the
// container's LAST element"; an exit that writes the field not at all delivers a null view
// that reads as the empty vector.  O-Complete: per binding, per path, complete — every arm.
// The loft guard `164-view-field.loft` measures two-arm `if`s and early returns; this one moves
// the PATH SHAPE: a three-arm `match` each appending its own element, a loop that appends on
// every pass before the exit, an exit inside the loop, and a `match` arm that appends nothing.
// Every site reads the result only as a length and a `const` argument, the shape the view
// admits; the answer must be the value a copy holds, whichever path ran.
//
// Axes it MOVES: the path shape (`match` arms, loop passes, an exit inside a loop, an arm with
// no append), the path taken (each).  Values hand-computed: `pc_pts(n)` is (0,0) … (n-1, 2n-2),
// whose sum is 3·n(n-1)/2.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed on 18594597b, interpret and native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the result's length and sum.
// HOLDS: loft `tests/scripts/164-view-field.loft`.

struct PcPt { px: integer = 0, py: integer = 0 }
struct PcOp { pts: vector<PcPt>, ow: integer = 0 }
struct PcSc { ops: vector<PcOp>, seen: integer = 0 }
struct PcMark { matched: boolean = false, mpts: vector<PcPt> }

fn pc_pts(n: integer) -> vector<PcPt> {
  o: vector<PcPt> = [];
  for i in 0..n { o += [PcPt { px: i, py: i * 2 }]; }
  o
}

fn pc_sum(v: const vector<PcPt>) -> integer { t = 0; for p in v { t += p.px + p.py; } t }

fn pc_match(sc: PcSc, c: integer) -> PcMark {
  match c {
    0 => {
      a = pc_pts(2);
      sc.ops += [PcOp { pts: a, ow: 0 }];
      PcMark { matched: true, mpts: a }
    },
    1 => {
      b = pc_pts(3);
      sc.ops += [PcOp { pts: b, ow: 1 }];
      PcMark { matched: true, mpts: b }
    },
    2 => {
      d = pc_pts(4);
      sc.ops += [PcOp { pts: d, ow: 2 }];
      PcMark { matched: true, mpts: d }
    },
    _ => PcMark { matched: false, mpts: [] }
  }
}

fn pc_loop(sc: PcSc, n: integer) -> PcMark {
  last = pc_pts(0);
  for i in 1..n + 1 {
    last = pc_pts(i);
    sc.ops += [PcOp { pts: last, ow: i }];
  }
  PcMark { matched: true, mpts: last }
}

fn pc_exit_in_loop(sc: PcSc, stop: integer) -> PcMark {
  for i in 1..6 {
    p = pc_pts(i);
    sc.ops += [PcOp { pts: p, ow: i }];
    if i == stop { return PcMark { matched: true, mpts: p }; }
  }
  PcMark { matched: false, mpts: [] }
}

fn test_every_match_arm_names_its_own_element() {
  t = "";
  for c in 0..4 {
    sc = PcSc { ops: [] };
    m = pc_match(sc, c);
    t += "{len(m.mpts)}:{pc_sum(m.mpts)}:{len(sc.ops)} ";
  }
  assert(t == "2:3:1 3:9:1 4:18:1 0:0:0 ", "match arms: {t}");
}

fn test_a_loop_names_the_last_pass() {
  sc = PcSc { ops: [] };
  m = pc_loop(sc, 3);
  assert(len(m.mpts) == 3 && pc_sum(m.mpts) == 9 && len(sc.ops) == 3, "loop: {len(m.mpts)} {pc_sum(m.mpts)} {len(sc.ops)}");
  sc0 = PcSc { ops: [] };
  m0 = pc_loop(sc0, 0);
  assert(len(m0.mpts) == 0 && pc_sum(m0.mpts) == 0 && len(sc0.ops) == 0, "a loop that never ran: {len(m0.mpts)}");
}

fn test_an_exit_inside_a_loop_names_its_pass() {
  sc = PcSc { ops: [] };
  m = pc_exit_in_loop(sc, 2);
  assert(len(m.mpts) == 2 && pc_sum(m.mpts) == 3 && len(sc.ops) == 2, "exit at pass 2: {len(m.mpts)} {pc_sum(m.mpts)}");
  sc9 = PcSc { ops: [] };
  m9 = pc_exit_in_loop(sc9, 9);
  assert(len(m9.mpts) == 0 && len(sc9.ops) == 5, "no exit in the loop: {len(m9.mpts)} {len(sc9.ops)}");
}

fn main() {
  test_every_match_arm_names_its_own_element();
  test_a_loop_names_the_last_pass();
  test_an_exit_inside_a_loop_names_its_pass();
}
