// @catches: LOFT_NO_PROMOTED_RETURN_IDENTITY_FREE — the switch withholds the free of `w` at the exit that copies it into the renamed buffer, which is the leak this program checks.
//
// AN EXIT AHEAD OF THE BIND THE RENAMED BUFFER VIEWS FREES ITS COPY (`@FR-O-Buffer`,
// `@FR-H-FreeAll`, loft#2684).  `walk` returns `done` at a mid-body `return`, so the hidden return
// buffer is renamed onto `done`; `later`, which makes `w`, is declared BELOW `walk`, so pass 1
// cannot type `w` and its `return w` is no candidate there.  On pass 2 `w` is a copy when
// `later` answers its argument, and `return w` copies it into the buffer.  The returned argument
// `done` names `w` in its deps — from `done = wrap(w)`, which comes later — and the exit withheld
// `w`'s free on that account: one record leaked per call that left early.
//
// Axes this file MOVES:  what the early exit returns (`w`, a literal, the parameter); which
//                        exit a call takes (early, the mid `return done`, the tail); the record
//                        (plain, with a vector field); the tail (a call of `done`, `done`); the
//                        callee declared below `walk` and the twin declared above it.
// Axes it HOLDS FIXED:   one renamed local, bound once.
//
// Values by hand: `later(v)` is `v` unless `v.k > 100` (1) or `v.k == 50` (51); `wrap(n)` doubles
// a `k` above 5.  Arguments 0, 50, 3, 7 (no stop), 7 (stop), 200 (no stop):
//   early `w`:      0 51 3 28 14 1   (tail `wrap(done)`)  and  0 51 3 14 14 1  (tail `done`)
//   early literal: -1 -1 3 28 14 1   early parameter:  0 50 3 28 14 1
// A record with a vector field answers `k * 1000 + len(vs)`, `vs` holding one element.
//
// CHANNEL: the leak gate (`LOFT_LEAK_CHECK`, which the suite runner sets).
// Measured by hand: on main ebff34f71 the two early-`w` tests leak, on --interpret and --native
// alike (a store per call that left early, the vector field's with it); the other tests are
// clean.
//
// @falsified-by: tests/falsified/2684-an-exit-ahead-of-the-bind-the-renamed-buffer-views-frees-its-copy.patch — interpret exit 1 -> 0, interpret leaked kt=100 N2684×4 -> clean, native exit 1 -> 0, native leaked kt=100 N2684×4 -> clean
//   ARMED: LOFT_LEAK_CHECK=1, which the suite runner sets.

struct N2684 { k: integer }
struct V2684 { k: integer, vs: vector<integer> }

fn wrap2684(n: N2684) -> N2684 { if n.k > 5 { N2684 { k: n.k * 2 } } else { n } }
fn wrapv2684(n: V2684) -> V2684 { if n.k > 5 { V2684 { k: n.k * 2, vs: [n.k * 2] } } else { n } }

fn walk_w2684(v: N2684, stop: boolean) -> N2684 {
  w = later2684(v);
  if w.k == 0 || w.k == 51 {
    return w;
  }
  done = wrap2684(w);
  if stop {
    return done;
  }
  wrap2684(done)
}

fn walk_w_done2684(v: N2684, stop: boolean) -> N2684 {
  w = later2684(v);
  if w.k == 0 || w.k == 51 {
    return w;
  }
  done = wrap2684(w);
  if stop {
    return done;
  }
  done
}

fn walk_lit2684(v: N2684, stop: boolean) -> N2684 {
  w = later2684(v);
  if w.k == 0 || w.k == 51 {
    return N2684 { k: -1 };
  }
  done = wrap2684(w);
  if stop {
    return done;
  }
  wrap2684(done)
}

fn walk_param2684(v: N2684, stop: boolean) -> N2684 {
  w = later2684(v);
  if w.k == 0 || w.k == 51 {
    return v;
  }
  done = wrap2684(w);
  if stop {
    return done;
  }
  wrap2684(done)
}

fn walk_vec2684(v: V2684, stop: boolean) -> V2684 {
  w = laterv2684(v);
  if w.k == 0 || w.k == 51 {
    return w;
  }
  done = wrapv2684(w);
  if stop {
    return done;
  }
  wrapv2684(done)
}

fn later2684(v: N2684) -> N2684 { if v.k > 100 { N2684 { k: 1 } } else if v.k == 50 { N2684 { k: v.k + 1 } } else { v } }
fn laterv2684(v: V2684) -> V2684 { if v.k > 100 { V2684 { k: 1, vs: [1] } } else if v.k == 50 { V2684 { k: v.k + 1, vs: [51] } } else { v } }

fn n2684(k: integer) -> N2684 { N2684 { k: k } }
fn v2684(k: integer) -> V2684 { V2684 { k: k, vs: [k] } }
fn sv2684(r: V2684) -> integer { r.k * 1000 + len(r.vs) }

fn above_later2684(v: N2684) -> N2684 { if v.k > 100 { N2684 { k: 1 } } else if v.k == 50 { N2684 { k: v.k + 1 } } else { v } }
fn walk_above2684(v: N2684, stop: boolean) -> N2684 {
  w = above_later2684(v);
  if w.k == 0 || w.k == 51 {
    return w;
  }
  done = wrap2684(w);
  if stop {
    return done;
  }
  wrap2684(done)
}

fn test_an_early_exit_returning_the_copied_local() {
  got = "{walk_w2684(n2684(0), true).k} {walk_w2684(n2684(50), true).k} {walk_w2684(n2684(3), true).k} {walk_w2684(n2684(7), false).k} {walk_w2684(n2684(7), true).k} {walk_w2684(n2684(200), false).k}";
  assert(got == "0 51 3 28 14 1", "w: {got}");
  got2 = "{walk_w_done2684(n2684(0), true).k} {walk_w_done2684(n2684(50), true).k} {walk_w_done2684(n2684(7), false).k}";
  assert(got2 == "0 51 14", "w, tail done: {got2}");
}

fn test_a_record_with_a_vector_field() {
  got = "{sv2684(walk_vec2684(v2684(0), true))} {sv2684(walk_vec2684(v2684(50), true))} {sv2684(walk_vec2684(v2684(7), false))}";
  assert(got == "1 51001 28001", "vector field: {got}");
}

fn test_the_early_exits_that_return_no_copy() {
  got = "{walk_lit2684(n2684(0), true).k} {walk_lit2684(n2684(50), true).k} {walk_lit2684(n2684(7), false).k}";
  assert(got == "-1 -1 28", "literal: {got}");
  got2 = "{walk_param2684(n2684(0), true).k} {walk_param2684(n2684(50), true).k} {walk_param2684(n2684(7), false).k}";
  assert(got2 == "0 50 28", "parameter: {got2}");
}

fn test_the_twin_declared_above() {
  got = "{walk_above2684(n2684(0), true).k} {walk_above2684(n2684(50), true).k} {walk_above2684(n2684(7), false).k}";
  assert(got == "0 51 28", "above: {got}");
}
