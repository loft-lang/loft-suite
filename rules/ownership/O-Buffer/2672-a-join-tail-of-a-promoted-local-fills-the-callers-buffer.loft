//
// loft#2672 — `@FR-O-Buffer`: a hidden return buffer is the caller's store.  A `-> vector<T>`
// function whose returned local `r` is renamed onto that buffer and bound from a call
// (`r = other(v)`) must have the call fill the buffer.  With a JOIN tail (`if … { r } else { v }`)
// the call kept a buffer of its own, `r` was re-pointed at it, and the store the caller handed in
// was freed by nobody: one store per call, both backends.  A single tail (`r`) and an early
// return were clean.
//
// Every value by hand: `other(v)` is `[v[0] + 100]` for two or more elements, else `[]`;
// `dbl(v)` doubles each element.
//
// Axes this file MOVES:  the tail (an `if` join with a parameter, a literal or `r` on the other
//                        arm, a `match` join, the arms swapped); the bind source (a call, a call
//                        on a call's result); the element (integer, a record); a loop of calls;
//                        backends.
// Axes it HOLDS FIXED:   one renamed local; one bind of it.
//
// @falsified-at: ebff34f71e — interpret leaked kt=20 main_vector<integer>×15, kt=101 main_vector<P>×2 -> clean, native leaked kt=20 main_vector<integer>×15, kt=101 main_vector<P>×2 -> clean
// CHANNEL: the leak check — the displaced store was released by nobody.
//   ARMED: `LOFT_LEAK_CHECK=1`, which the suite runner arms for every cell.
//   HOLDS: every assertion is green on both trees; only the leak moves.

struct P { a: integer }

fn other(v: vector<integer>) -> vector<integer> { if len(v) > 1 { [v[0] + 100] } else { [] } }
fn dbl(v: vector<integer>) -> vector<integer> { o: vector<integer> = []; for x in v { o += [x * 2]; } o }
fn other_p(v: vector<P>) -> vector<P> { if len(v) > 1 { [P { a: v[0].a + 100 }] } else { [] } }

fn with_param(v: vector<integer>) -> vector<integer> { r = other(v); if len(r) > 0 { r } else { v } }
fn with_literal(v: vector<integer>) -> vector<integer> { r = other(v); if len(r) > 0 { r } else { [7] } }
fn with_itself(v: vector<integer>) -> vector<integer> { r = other(v); if len(r) > 0 { r } else { r } }
fn swapped(v: vector<integer>) -> vector<integer> { r = other(v); if len(r) > 0 { v } else { r } }
fn by_match(v: vector<integer>) -> vector<integer> { r = other(v); match len(r) { 0 => v, _ => r } }
fn from_a_local(v: vector<integer>) -> vector<integer> { w = dbl(v); r = other(w); if len(r) > 5 { r } else { w } }
fn records(v: vector<P>) -> vector<P> { r = other_p(v); if len(r) > 0 { r } else { v } }

fn main() {
  assert("{with_param([1, 2, 3])} {with_param([5])}" == "[101] [5]", "with_param");
  assert("{with_literal([1, 2, 3])} {with_literal([5])}" == "[101] [7]", "with_literal");
  assert("{with_itself([1, 2, 3])} {with_itself([5])}" == "[101] []", "with_itself");
  assert("{swapped([1, 2, 3])} {swapped([5])}" == "[1,2,3] []", "swapped");
  assert("{by_match([1, 2, 3])} {by_match([5])}" == "[101] [5]", "by_match");
  // from_a_local: `w = dbl([i, 2, 3])`, so `w[0]` is `2 * i`: 0 + 2 + 4 + 6 + 8 = 20.
  t = 0;
  for i in 0..5 { t += from_a_local([i, 2, 3])[0] ?? -1; }
  assert(t == 20, "from_a_local: {t}");
  x = records([P { a: 1 }, P { a: 2 }]);
  y = records([P { a: 5 }]);
  assert(len(x) == 1 && x[0].a == 101 && len(y) == 1 && y[0].a == 5, "records");
}
