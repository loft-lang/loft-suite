// @catches: LOFT_NO_OWNER_WITNESS — the pre-witness form releases the wrong store: the interpreter frees the tuple a view pointed into (the copy-over test reads the filler's 2 where the member holds 50), and `--native` copies where the view must write through (the write-through test reads 50 where it wrote 55).
//
// @FR-O-Witness with the view taken from a TUPLE member.
// A record local whose assignments mix a store of its own (a copy of `a`) and a VIEW
// (`c.1`) carries an owner witness: it releases the store the local minted, by store
// identity, and never the store a view points into.  The rule's earlier cells took every
// view from a vector element or a field, so the container KIND sat at one value; this cell
// and its keyed siblings (hash, sorted, index, spatial) move it.
//
// A tuple with a heap member is a `__tuple<…>` record of its own, so a view of `c.1` points
// into the tuple's store.  A release of the wrong store frees that tuple: the filler
// `junk()`, built right after the copy-over, then takes the store, and a read of the
// original sees 1, 2 where it holds 30, 50.  Every test runs its case twice, so a store
// freed in the first round and reused in the second shows.  The interpreter and `--native`
// pass with no leak under LOFT_STRICT_STORES=1 and no fault under LOFT_POISON=1.
//
// Held FIXED, so NOT measured here: the member type (a two-integer struct), a tuple in a
// local or a parameter (no global), no closure capture.

struct E { k: integer, v: integer }

fn mkt() -> (E, E, integer) { (E { k: 3, v: 30 }, E { k: 5, v: 50 }, 7) }

// A same-shape tuple built after the copy-over: one freed too early hands its store to this.
fn junk() -> (E, E, integer) { (E { k: 3, v: 1 }, E { k: 5, v: 2 }, 9) }

// copy -> view of a member -> filler, write through the view: 55*1e6 + 55*1e4 + 11*100 + 22
fn write_through() -> integer {
  c = mkt();
  a = E { k: 1, v: 11 };
  x: E? = a;
  assert(x.v == a.v, "the copy holds its source");
  x = c.1;
  filler = E { k: 2, v: 22 };
  x.v = 55;
  (x.v * 1000000 + c.1.v * 10000 + a.v * 100 + filler.v)?
}

// SHARP copy -> view -> copy -> write: c.1 50, a 11, b 12, s 7
fn copy_over_view() -> integer {
  c = mkt();
  a = E { k: 1, v: 11 };
  b = E { k: 2, v: 12 };
  s: E? = a;
  assert(s.v == a.v, "the copy holds its source");
  s = c.1;
  assert(s.v == 50, "the view sees the member");
  s = b;
  s.v = 7;
  j = junk();
  assert(j.1.v == 2, "the filler is its own tuple");
  (c.1.v * 1000000 + a.v * 10000 + b.v * 100 + s.v)?
}

// a tuple PARAMETER, the view on one arm: 30 taken, 11 skipped
fn view_on_one_arm(c: (E, E, integer), take: boolean) -> integer {
  a = E { k: 1, v: 11 };
  cur: E? = a;
  assert(cur.v == a.v, "the copy holds its source");
  if take { cur = c.0; }
  (cur.v)?
}

// copy, view, view — two hundred rounds: (11 + 30 + 50) * 200
fn alternate() -> integer {
  c = mkt();
  a = E { k: 1, v: 11 };
  t = 0;
  for _r in 0..200 {
    cur: E? = a;
    t += cur.v ?? 0;
    cur = c.0;
    t += cur.v ?? 0;
    cur = c.1;
    t += cur.v ?? 0;
  }
  t
}

// a tuple literal built in the frame, view first, then a copy: c.0 stays 30, a 11, s 9
fn view_then_copy() -> integer {
  c = (E { k: 3, v: 30 }, E { k: 5, v: 50 });
  a = E { k: 1, v: 11 };
  s: E? = c.0;
  assert(s.v == 30, "the view sees the member");
  s = a;
  s.v = 9;
  j = junk();
  assert(j.1.v == 2, "the filler is its own tuple");
  (c.0.v * 10000 + a.v * 100 + s.v)?
}

fn test_a_write_through_the_view_reaches_the_member() {
  for _rep in 0..2 {
    assert(write_through() == 55551122, "got {write_through()}");
  }
}

fn test_a_copy_over_a_view_is_a_store_of_its_own() {
  for _rep in 0..2 {
    assert(copy_over_view() == 50111207, "got {copy_over_view()}");
  }
}

fn test_a_view_on_one_arm_is_right_when_taken() {
  for _rep in 0..2 {
    assert(view_on_one_arm(mkt(), true) == 30, "got {view_on_one_arm(mkt(), true)}");
  }
}

fn test_a_view_on_one_arm_is_right_when_skipped() {
  for _rep in 0..2 {
    assert(view_on_one_arm(mkt(), false) == 11, "got {view_on_one_arm(mkt(), false)}");
  }
}

fn test_copies_and_views_alternate_two_hundred_times() {
  for _rep in 0..2 {
    assert(alternate() == 18200, "got {alternate()}");
  }
}

fn test_a_view_first_then_a_copy_leaves_the_member() {
  for _rep in 0..2 {
    assert(view_then_copy() == 301109, "got {view_then_copy()}");
  }
}
