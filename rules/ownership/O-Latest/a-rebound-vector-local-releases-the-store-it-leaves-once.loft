//
// A REBOUND VECTOR LOCAL RELEASES THE STORE IT LEAVES ONCE (`@FR-O-Latest`, `@FR-H-FreeTwice`).  A
// vector local owns what its latest assignment gave it: rebound from a call while a closure holds
// it, or rebound through a forwarding fn-ref whose declared return names a buffer, the store it
// leaves is released once and the one it takes is its own.  Each section keeps its own cases and
// receipt.
//
// ── a-captured-vector-from-a-call-frees-the-store-its-rebind-leaves ──
//
// loft#1862, the vector half — a vector local bound from a CALL, captured, and rebound.
//
// `c = mk(5)` lowers to `c = n_mk(5, __ref_1)`: the callee fills a hidden return buffer, and
// that buffer is the store a closure built over `c` holds (`formal/ownership.md` `@FR-O-Latest`).
// The capture's build-time backing was recorded only for a view-shaped right-hand side, so a
// call left none and the type dep answered instead — the buffer of the LAST call.  After a
// rebind (`c = mk(9)`, through `__ref_2`) the frame freed the build-time buffer and gave up the
// new one, which no record had adopted: one store per rebind, on both backends.  The values
// were right throughout, so this is a LEAK guard: run it under `LOFT_STRICT_STORES=1`, where
// the leak fails the run (the nightly poison sweep's leg; the plain suite counts leaks too).
//
// Values by hand: mk(n) is `[n]`; add(v, d) adds d to each element; each cell answers
// `f() * 100 + tot(c)`, the build-time total (5) beside what `c` holds after the rebind.
//
// @falsified-at: 04b8e5bc9 — under LOFT_STRICT_STORES=1: interpret exit 1 -> 0, interpret
//   leaked kt=19 main_vector<integer>×9 -> clean, native the same.  CHANNEL: leak (strict
//   stores turns it into the exit).  ARMED: LOFT_STRICT_STORES=1.  HOLDS: every value
//   assertion passes on both trees — the values were right before the fix.
// @falsified-by: tests/falsified/a-captured-vector-from-a-call-frees-the-store-its-rebind-leaves.patch
//
// ── a-vector-local-a-forwarding-fn-ref-may-rebind-is-released-once ──
//
// `@FR-O-Latest` with `@FR-H-FreeTwice` — A VECTOR LOCAL A FORWARDING FN-REF MAY REBIND IS
// RELEASED ONCE.  `x: vector<integer> = [5, 6]` fills a literal backing; `x = fwd(q)`, with `fwd`
// a lambda that forwards to another, has a declared return that borrows `q`, so `x`'s scope-end
// free is `OpFreeRefIfDistinct(x, q)`.  The rebind's displaced free already declined while `x`
// still named the backing; the scope-end free did not, so where no rebind ran (a loop of zero
// passes, an `if` not taken) `x` and the backing both freed the literal's store: "a store was
// freed twice", both backends.  A plain lambda, a named forwarder, a record, text and a hash
// local never took that free.
//
// Expected values by hand: `x * 100`-style sums, with `[5, 6]` kept: 0 passes → 0·100 + 2·10 + 5
// = 25; one pass of `fwd(none)` → [7, 8]: 8·100 + 20 + 7 = 827; of `fwd(some)` with some = [3, 4]
// → 400 + 20 + 3 = 423.
//
// @falsified-at: `LOFT_NO_VIEW_TEMP_SCOPE_END_GUARD=1` — interpret and native-c abort with "a
//   store was freed twice" in `zero_passes_null`, `zero_passes_some` and `branch_not_taken`.
// CHANNEL: the strict-store gate (the abort), both backends; the values by assertion.
// HOLDS: `one_pass`, `plain_lambda` and `record_twin` under the switch.

fn mk(n: integer) -> vector<integer> { r: vector<integer> = []; r += [n]; r }
fn add(v: vector<integer>, d: integer) -> vector<integer> {
  r: vector<integer> = [];
  for e in v { r += [e + d]; }
  r
}
fn tot(c: vector<integer>) -> integer { t = 0; for e in c { t += e; } t }

fn once() -> integer { c = mk(5); f = fn() -> integer { tot(c) }; c = mk(9); f() * 100 + tot(c) }
fn twice() -> integer { c = mk(5); f = fn() -> integer { tot(c) }; c = mk(9); c = mk(7); f() * 100 + tot(c) }
fn self_reading() -> integer { c = mk(5); f = fn() -> integer { tot(c) }; c = add(c, 4); f() * 100 + tot(c) }
fn emptied() -> integer { c = mk(5); f = fn() -> integer { tot(c) }; c = []; f() * 100 + tot(c) }
fn every_pass() -> integer {
  s = 0;
  for _i in 0..3 { c = mk(5); f = fn() -> integer { tot(c) }; c = mk(9); s += f() * 100 + tot(c); }
  s
}
fn escaping() -> fn() -> integer { c = mk(5); f = fn() -> integer { tot(c) }; c = mk(9); f }

fn test_a_captured_vector_from_a_call_frees_the_store_its_rebind_leaves() {
  assert(once() == 509, "once: {once()}");
  assert(twice() == 507, "twice: {twice()}");
  assert(self_reading() == 509, "self-reading: {self_reading()}");
  assert(emptied() == 500, "emptied: {emptied()}");
  assert(every_pass() == 1527, "every pass: {every_pass()}");
  g = escaping();
  assert(g() == 5, "escaping: {g()}");
}

struct P { n: integer }

fn run(n: integer) -> integer {
  inner = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  fwd = fn(q: vector<integer>?) -> vector<integer> { inner(q) };
  none: vector<integer>? = null;
  x: vector<integer> = [5, 6];
  y = 0;
  for _ in 0..n { x = fwd(none); y += x[1]; }
  y * 100 + len(x) * 10 + x[0]
}

fn run_some(n: integer) -> integer {
  inner = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  fwd = fn(q: vector<integer>?) -> vector<integer> { inner(q) };
  some: vector<integer>? = [3, 4];
  x: vector<integer> = [5, 6];
  y = 0;
  for _ in 0..n { x = fwd(some); y += x[1]; }
  y * 100 + len(x) * 10 + x[0]
}

fn branch(c: boolean) -> integer {
  inner = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  fwd = fn(q: vector<integer>?) -> vector<integer> { inner(q) };
  none: vector<integer>? = null;
  x: vector<integer> = [5, 6];
  y = 0;
  if c { x = fwd(none); y += x[1]; }
  y * 100 + len(x) * 10 + x[0]
}

fn test_zero_passes_null() { assert(run(0) == 25, "zero passes, null: {run(0)}"); }
fn test_zero_passes_some() { assert(run_some(0) == 25, "zero passes, some: {run_some(0)}"); }
fn test_branch_not_taken() { assert(branch(false) == 25, "branch not taken: {branch(false)}"); }

fn test_one_pass() {
  assert(run(1) == 827, "one pass, null: {run(1)}");
  assert(run_some(1) == 423, "one pass, some: {run_some(1)}");
  assert(branch(true) == 827, "branch taken: {branch(true)}");
}

fn test_plain_lambda() {
  lam = fn(q: vector<integer>?) -> vector<integer> { q ?? [7, 8] };
  none: vector<integer>? = null;
  x: vector<integer> = [5, 6];
  for _ in 0..0 { x = lam(none); }
  assert(len(x) == 2 && x[0] == 5, "a plain lambda keeps the literal: {len(x)}");
}

fn test_record_twin() {
  mkr = fn(q: P?) -> P { q ?? P { n: 7 } };
  fwdr = fn(q: P?) -> P { mkr(q) };
  none: P? = null;
  x: P = P { n: 5 };
  for _ in 0..0 { x = fwdr(none); }
  assert(x.n == 5, "a record local keeps its literal: {x.n}");
}
