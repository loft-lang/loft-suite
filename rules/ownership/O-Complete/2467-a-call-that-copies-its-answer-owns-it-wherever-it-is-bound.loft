//
// A CALL THAT COPIES ITS ANSWER OWNS WHAT IT ANSWERS, WHEREVER IT IS BOUND (`@FR-O-Complete`,
// `@FR-F-Ret`, loft#2467).  A function answering its argument on one path and a record it minted on
// another is copied into the caller, so each binding of its answer — an arm of a branch, an element
// of a comprehension — owns that copy and frees it once.  Each section keeps its own cases and
// receipt.
//
// ── 2467-a-branch-of-calls-that-copy-their-answer-owns-what-they-answer ──
//
// A BRANCH OF CALLS THAT COPY THEIR ANSWER OWNS WHAT THEY ANSWER (`@FR-O-Complete`,
// `@FR-F-Ret`).  `base` answers a field of its argument or the argument itself, and both arms
// are copied into its return buffer, so every call of it answers a fresh record.  Its signature
// kept naming the parameter the copy was made FROM, so a local bound from a branch of two such
// calls read as a borrow of the argument, and the record the taken arm minted was freed by
// nobody — one per evaluation, on both backends.
//
// Axes it MOVES: the branch (`if`, `match`), the arm taken, the scrutinee (a temporary, a
// local), the caller's place in the file.  Controls: a direct bind (always owned), a callee that
// genuinely borrows on a mid-body `return`, and the branch in a loop — each must free exactly
// what it owns and read the caller's record intact afterwards.
//
// Values hand-computed: every path reads the innermost `B { n: 5 }`, or 7 for the rebound one.
//
// @falsified-at: dbf8b05ae — interpret leaked kt=100 T×5 -> clean, native exit 1 -> 0, native leaked kt=100 T×5 -> clean
// CHANNEL: the store-leak check at exit (the harness runs cells under `LOFT_STRICT_STORES=1`).
// ARMED: no instrument.
// WITNESS: the leak names `T`.
// HOLDS: every value, and no leak, on both backends.
//
// ── 2467-a-comprehension-of-a-call-owns-each-answer ──
//
// A COMPREHENSION OF A CALL OWNS EACH ANSWER (`@FR-O-Complete`, `@FR-F-Ret`).  `f` answers its
// argument on one arm and the record `g` minted on the other, and its signature names only the
// argument.  `[for a in xs { f(a) }]` bound each answer to the comprehension's slot as that
// borrow — its braces' block hid the call from the single bind's lowering — and the record `g`
// minted was copied into the vector and freed by nobody, one per element.  `v += [f(a)]` binds
// the same call to an owned temp and was always clean.
//
// Axes it MOVES: the callee (a tail call that mints, a literal arm that mints, a recursive
// rebuild), the element arm taken.  Controls: the append spelling, and the elements whose answer
// is the argument itself — the source vector must read intact afterwards.
//
// Values hand-computed: 6 and 8 through `f`, 1 through `j`, and `bare` rebuilds the call
// around 6.
//
// @falsified-at: dbf8b05ae — interpret leaked kt=100 Node×3, kt=101 NdInt×1 -> clean, native exit 1 -> 0, native leaked kt=100 Node×3, kt=101 NdInt×1 -> clean
// CHANNEL: the store-leak check at exit (the harness runs cells under `LOFT_STRICT_STORES=1`).
// ARMED: no instrument.
// WITNESS: the leak names `Node` and `NdInt`.
// HOLDS: every value, and no leak, on both backends.

fn test_a_branch_of_calls_that_copy_their_answer_owns_what_they_answer() {
  t = T::Opt { inner: T::Opt { inner: T::B { n: 5 } } };
  c = take(t) == 0;
  r_if = if c { base(t) } else { base(t) };
  r_match = match base(t) { Opt { inner } => base(inner), _ => base(t) };
  u = base(t);
  r_local = match u { Opt { inner } => base(inner), _ => base(t) };
  flat = T::B { n: 5 };
  r_wild = match base(flat) { Opt { inner } => base(inner), _ => base(flat) };
  r_rebound = if c { base(t) } else { base(t) };
  k = take(base(r_rebound));
  r_rebound = T::B { n: 7 };
  assert(take(base(r_if)) == 5 && take(r_match) == 5 && take(r_local) == 5, "the branch binds");
  assert(take(r_wild) == 5 && k == 5 && take(r_rebound) == 7, "the wild arm and a rebind");
  // Controls.
  x = base(t);
  a = pick(t, true);
  b = pick(t, false);
  r_pick = if c { pick(t, true) } else { pick(t, false) };
  s = 0;
  for i in 0..100 {
    rl = if i % 2 == 0 { base(t) } else { base(base(t)) };
    s += take(base(rl)) + take(rl);
  }
  assert(take(base(x)) == 5 && take(base(base(a))) == 5 && take(base(b)) == 5, "controls");
  assert(take(base(base(r_pick))) == 5 && s == 50 * 5 + 100 * 5 && take(base(base(t))) == 5, "the caller's record");
}

enum T { A, B { n: integer }, Opt { inner: T } }
fn base(t: T) -> T { match t { Opt { inner } => inner, _ => t } }
fn take(t: T) -> integer { match t { B { n } => n, _ => 0 } }
// Borrows `t` on its mid-body return: that answer is the caller's record and must stay one.
fn pick(t: T, early: boolean) -> T {
  if early {
    return t;
  }
  match t { Opt { inner } => inner, _ => t }
}

fn test_a_comprehension_of_a_call_owns_each_answer() {
  xs = [Node::NdInt { n: 6 }, Node::NdSpan { inner: Node::NdSpan { inner: Node::NdInt { n: 8 } } }];
  w = [for a in xs { f(a) }];
  ys = [Node::NdInt { n: 7 }];
  lit = [for y in ys { j(y, false) }];
  call = Node::NdSpan { inner: Node::NdCall { d: 1, args: [Node::NdSpan { inner: Node::NdInt { n: 6 } }] } };
  b = bare(call);
  assert(val(w[0]!) == 6 && val(w[1]!) == 8 && val(lit[0]!) == 1 && val(b) == 6, "the elements");
  // Controls: the append spelling, and the sources read intact.
  v: vector<Node> = [];
  for a in xs {
    v += [f(a)];
  }
  assert(val(v[0]!) == 6 && val(v[1]!) == 8, "append");
  assert(val(xs[0]!) == 6 && val(xs[1]!) == 8 && val(ys[0]!) == 7 && val(call) == 6, "the sources");
}

enum Node { NdNull, NdInt { n: integer }, NdSpan { inner: Node }, NdCall { d: integer, args: vector<Node> } }
fn val(n: Node) -> integer { match n { NdInt { n } => n, NdSpan { inner } => val(inner), NdCall { args } => val(args[0]!), _ => -1 } }
fn g(n: Node) -> Node { match n { NdSpan { inner } => inner, _ => n } }
fn f(n: Node) -> Node { match n { NdSpan { inner } => g(inner), _ => n } }
fn j(n: Node, keep: boolean) -> Node { if keep { n } else { Node::NdInt { n: 1 } } }
fn bare(n: Node) -> Node { match n { NdSpan { inner } => bare(inner), NdCall { d, args } => Node::NdCall { d: d, args: [for a in args { bare(a) }] }, _ => n } }
