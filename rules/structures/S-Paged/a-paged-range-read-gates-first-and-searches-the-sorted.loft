//
// `@FR-S-Paged` crossed with `@FR-S-Gate` and `@FR-S-Vector`: a paged range read of a persisted
// `sorted` first applies S-Gate to the image's sidecar — a missing sidecar, one that does not
// parse, and a different layout identity (another element type) are each REFUSED, the answer a
// count of 0 and nothing loaded — and refuses an image without the S-Frame signature.  An image
// that passes is served by binary search over the sorted's inline elements (S-Vector): exactly
// the records whose key lies in [lo, hi], in key order, at either edge of the range, with
// negative keys, an empty range, and an `i16` key whose elements are two bytes narrower.
// Restoring the image makes it readable again.
//
// CHANNEL: the assertions and the leak gate.
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.

struct T { k: integer, v: text }
struct U { k: integer, v: text, extra: integer }
struct N { k: i16, n: integer }

fn walk(s: sorted<T[k]>) -> text { r = ""; for e in s { r += "{e.k}{e.v},"; } r }

fn src() -> sorted<T[k]> {
  [T { k: 5, v: "e" }, T { k: -3, v: "m" }, T { k: 12, v: "l" }, T { k: 0, v: "z" }, T { k: 7, v: "s" }]
}

fn range(path: text, lo: integer, hi: integer) -> text {
  a: sorted<T[k]> = [];
  n = store_load_range(a, path, lo, hi);
  "{n}:{len(a)}:{walk(a)}"
}

fn scratch() -> text {
  dir = "{temp_dir() ?? "/tmp"}/loft_suite_paged_{now()}_{ticks()}";
  assert(mkdir(dir) == FileResult.Ok, "make {dir}");
  dir
}

fn clean(dir: text) {
  for f in list_dir(dir) ?? [] { assert(delete("{dir}/{f}") == FileResult.Ok, "remove {f}"); }
  assert(rmdir(dir) == FileResult.Ok, "remove {dir}");
}

fn test_a_range_is_a_binary_search_over_the_keys() {
  dir = scratch();
  path = "{dir}/s.store";
  assert(store_persist_copy(src(), path), "write");
  assert(range(path, 0, 7) == "3:3:0z,5e,7s,", range(path, 0, 7));
  assert(range(path, -3, -3) == "1:1:-3m,", range(path, -3, -3));
  assert(range(path, 8, 11) == "0:0:", range(path, 8, 11));
  assert(range(path, -100, 100) == "5:5:-3m,0z,5e,7s,12l,", range(path, -100, 100));
  assert(range(path, 12, 1000) == "1:1:12l,", range(path, 12, 1000));
  clean(dir);
}

fn test_a_narrow_key() {
  dir = scratch();
  path = "{dir}/n.store";
  s: sorted<N[k]> = [N { k: -300, n: 1 }, N { k: 32000, n: 2 }, N { k: -1, n: 3 }, N { k: 40, n: 4 }];
  assert(store_persist_copy(s, path), "write");
  a: sorted<N[k]> = [];
  got = store_load_range(a, path, -300, 40);
  w = "";
  for e in a { w += "{e.k}:{e.n},"; }
  assert(got == 3 && w == "-300:1,-1:3,40:4,", "i16: {got} {w}");
  clean(dir);
}

fn test_the_gate_refuses_before_reading() {
  dir = scratch();
  path = "{dir}/s.store";
  side = "{path}.dschema";
  assert(store_persist_copy(src(), path), "write");
  u: sorted<U[k]> = [];
  assert(store_load_range(u, path, 0, 100) == 0 && len(u) == 0, "another identity");
  assert(delete(side) == FileResult.Ok, "remove the sidecar");
  assert(range(path, 0, 7) == "0:0:", "no sidecar: {range(path, 0, 7)}");
  assert(store_persist_copy(src(), path), "write again");
  junk: vector<u8> = [1, 2, 3, 4];
  assert(write_bytes(side, junk), "a sidecar that does not parse");
  assert(range(path, 0, 7) == "0:0:", "junk sidecar: {range(path, 0, 7)}");
  assert(store_persist_copy(src(), path), "write a third time");
  img = read_bytes(path) ?? [];
  bad = img;
  bad[0] = 0;
  assert(write_bytes(path, bad), "no signature");
  assert(range(path, 0, 7) == "0:0:", "no signature: {range(path, 0, 7)}");
  assert(write_bytes(path, img), "restore");
  assert(range(path, 0, 7) == "3:3:0z,5e,7s,", "restored: {range(path, 0, 7)}");
  clean(dir);
}
