//
// `@FR-S-TreeKey` crossed with `@FR-Col-Axis`: a spatial record's key interleaves its axes bit
// by bit, most significant first, axis 0 first, each axis the 64-bit value its DECLARED type
// decodes with the top bit flipped — so a walk is the Morton order of the VALUES (negative
// before positive), a biased narrow axis orders by its decoded value and not by the stored
// offset, and every point the walk yields is found by a lookup.
//
// Orders worked by hand: (3,0) (0,3) (2,1) (1,2) interleave in their low two bits to 1010,
// 0101, 1001, 0110, so the walk is (0,3) (1,2) (2,1) (3,0).  (-1,-1) (-1,0) (0,-1) (0,0):
// the flipped top bits are x 0,0,1,1 then y 0,1,0,1.  A `limit(1000, 1100)` x: (1000,16) and
// (1008,0) first differ at x bit 4 (1008 has it), which outranks y bit 4 — so (1000,16) walks
// first; the stored offsets 0 and 8 would put (1008,0) first.  An `i8`/`i16` pair:
// (-128,0) (-5,300) (5,-300): x=5 has the flipped top bit, and the two negatives first differ
// at y bit 8.
//
// CHANNEL: the assertions and the leak gate.
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.

type Yr = integer limit(1000, 1100) size(1);

struct P { const x: integer, const y: integer, n: integer }
struct Q { const x: Yr, const y: integer, n: integer }
struct T { const x: i8, const y: i16, n: integer }

fn test_the_low_bits_interleave() {
  a: spatial<P[x, y]> = [P { x: 3, y: 0, n: 1 }, P { x: 0, y: 3, n: 2 }, P { x: 2, y: 1, n: 3 }, P { x: 1, y: 2, n: 4 }];
  s = "";
  for e in a { s += "{e.n}"; }
  assert(s == "2431" && len(a) == 4, "walk: {s}");
}

fn test_negative_before_positive() {
  b: spatial<P[x, y]> = [P { x: 0, y: 0, n: 1 }, P { x: -1, y: 0, n: 2 }, P { x: 0, y: -1, n: 3 }, P { x: -1, y: -1, n: 4 }];
  s = "";
  for e in b { s += "{e.n}"; }
  assert(s == "4231", "walk: {s}");
}

fn test_a_biased_axis_orders_by_its_value() {
  c: spatial<Q[x, y]> = [Q { x: 1008, y: 0, n: 1 }, Q { x: 1000, y: 16, n: 2 }];
  s = "";
  for e in c { g = c[e.x, e.y]; s += "{e.x},{e.y}:{g.n ?? -1};"; }
  assert(s == "1000,16:2;1008,0:1;", "walk: {s}");
}

fn test_narrow_signed_axes() {
  d: spatial<T[x, y]> = [T { x: 5, y: -300, n: 1 }, T { x: -5, y: 300, n: 2 }, T { x: -128, y: 0, n: 3 }];
  s = "";
  for e in d { g = d[e.x, e.y]; s += "{e.n}{g.n ?? -1};"; }
  assert(s == "33;22;11;", "walk: {s}");
}
