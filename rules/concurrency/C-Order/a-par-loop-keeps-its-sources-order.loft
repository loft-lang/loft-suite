//
// A PAR LOOP KEEPS ITS SOURCE'S ORDER (`@FR-C-Order`).  Workers run in any order, but the results
// are consumed in the order of the source they came from: a `par` loop over a vector, a sorted, an
// index and a range yields in that kind's order, and a hash in its own walk order.  Two sections,
// each with its cells and receipt.
//
// ── a-par-loop-consumes-results-in-its-sources-order ──
//
// A PAR LOOP CONSUMES RESULTS IN ITS SOURCE'S ORDER (`@FR-C-Order`, with `@FR-C-Det` making the
// thread count irrelevant): the body sees `worker(x)` in the order `flatten(src)` produced the
// elements — the written order of a vector, ascending for a range, character order for a text,
// yield order for an iterator, key order for a `sorted` and an `index` — for every N.  The one
// exception the rule names is a HASH, flattened by its bucket walk: its par order is not
// promised, so only the MULTISET of results is asserted there, beside the sequential `for x in
// h`, which IS key-ordered.
//
// Values hand-computed: squares of [5, 1, 4, 2] → 25;1;16;4; · of 2..7 → 4;9;16;25;36; ·
//   "bca" as integers → 98;99;97; · gen(5) yields 0,3,6,9,12 → 0;9;36;81;144; · sorted by k
//   [30 c, 10 a, 20 b] → a10;b20;c30; · index by k [3 z, 1 x, 2 y] → x1;y2;z3; · hash by k
//   {7 p, 1 q, 4 r, 9 s}: par yields some order of p7 q1 r4 s9; sequential → q1;r4;p7;s9;.
//
// Axes it MOVES: the source kind (vector, range, text, iterator, sorted, index, hash), the
//   thread count (1, 3, 8), and a source whose written order is not its sorted order.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed on 18594597b,
//   interpret and native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints N and the consumed sequence.
// HOLDS: every hash element is consumed exactly once under par.
//
// ── a-par-walk-keeps-every-kinds-order-but-a-hashs ──
//
// `@FR-C-Order` crossed with `@FR-Col-Order`: a `par` loop consumes its results in the order of
// its source's SEQUENTIAL walk (Col-Order) for every kind but a hash — a vector in index order,
// a `sorted` and an `index` in key order, a descending key and a two-field key included — and
// a hash in its bucket walk, which is not key order, so only the multiset is fixed there while
// the sequential walk of the same hash stays key-ordered (a text key, and after a removal and
// a re-add).  Each walk is taken at 1, 3 and 8 workers.
//
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.
// CHANNEL: the assertions and the leak gate.

struct CKv { k: integer, v: text }

fn sq(x: integer) -> integer { x * x }
fn tag(e: CKv) -> text { "{e.v}{e.k}" }
fn code(c: character) -> integer { c as integer }
fn gen(n: integer) -> iterator<integer> {
  for i in 0..n { yield i * 3; }
}

fn test_ordered_sources_keep_their_order_for_every_n() {
  for n in [1, 3, 8] {
    a = "";
    for x in [5, 1, 4, 2] par(r = sq(x), n) { a += "{r};"; }
    b = "";
    for x in 2..7 par(r = sq(x), n) { b += "{r};"; }
    c = "";
    for ch in "bca" par(r = code(ch), n) { c += "{r};"; }
    d = "";
    for x in gen(5) par(r = sq(x), n) { d += "{r};"; }
    s = "{a}|{b}|{c}|{d}";
    assert(s == "25;1;16;4;|4;9;16;25;36;|98;99;97;|0;9;36;81;144;", "N={n}: {s}");
  }
}

fn test_keyed_ordered_sources_keep_key_order_for_every_n() {
  for n in [1, 3, 8] {
    so: sorted<CKv[k]> = [CKv { k: 30, v: "c" }, CKv { k: 10, v: "a" }, CKv { k: 20, v: "b" }];
    e = "";
    for x in so par(r = tag(x), n) { e += "{r};"; }
    ix: index<CKv[k]> = [CKv { k: 3, v: "z" }, CKv { k: 1, v: "x" }, CKv { k: 2, v: "y" }];
    f = "";
    for x in ix par(r = tag(x), n) { f += "{r};"; }
    s = "{e}|{f}";
    assert(s == "a10;b20;c30;|x1;y2;z3;", "N={n}: {s}");
  }
}

fn test_a_hash_under_par_consumes_each_element_once() {
  for n in [1, 3, 8] {
    h: hash<CKv[k]> = [CKv { k: 7, v: "p" }, CKv { k: 1, v: "q" }, CKv { k: 4, v: "r" }, CKv { k: 9, v: "s" }];
    o = ";";
    cnt = 0;
    for x in h par(r = tag(x), n) {
      o += "{r};";
      cnt += 1;
    }
    all = o.contains(";p7;") && o.contains(";q1;") && o.contains(";r4;") && o.contains(";s9;");
    assert(cnt == 4 && len(o) == 13 && all, "N={n}: {o} ({cnt})");
    q = "";
    for x in h { q += tag(x) + ";"; }
    assert(q == "q1;r4;p7;s9;", "the sequential hash walk is key-ordered: {q}");
  }
}


struct Kv { k: integer, v: text }
struct Tk { name: text, n: integer }
struct Two { a: integer, b: integer }

fn s2_tag(e: Kv) -> text { "{e.v}{e.k}" }
fn ttag(e: Tk) -> text { "{e.name}{e.n}" }
fn two(e: Two) -> text { "{e.a}.{e.b}" }

fn test_ordered_kinds_keep_their_sequential_order_under_par() {
  for n in [1, 3, 8] {
    v = [Kv { k: 3, v: "c" }, Kv { k: 1, v: "a" }, Kv { k: 2, v: "b" }];
    a = "";
    for x in v par(r = s2_tag(x), n) { a += "{r};"; }
    d: sorted<Kv[-k]> = [Kv { k: 10, v: "x" }, Kv { k: 30, v: "z" }, Kv { k: 20, v: "y" }];
    b = "";
    for x in d par(r = s2_tag(x), n) { b += "{r};"; }
    sb = "";
    for x in d { sb += "{s2_tag(x)};"; }
    ix: index<Two[a, -b]> = [Two { a: 2, b: 1 }, Two { a: 1, b: 5 }, Two { a: 2, b: 9 }, Two { a: 1, b: 7 }];
    c = "";
    for x in ix par(r = two(x), n) { c += "{r};"; }
    s = "{a}|{b}|{c}";
    assert(s == "c3;a1;b2;|z30;y20;x10;|1.7;1.5;2.9;2.1;", "N={n}: {s}");
    assert(b == sb, "par and sequential agree on a sorted: {b} {sb}");
  }
}

fn test_a_hash_keeps_its_multiset_under_par_and_key_order_without() {
  for n in [1, 3, 8] {
    h: hash<Tk[name]> = [Tk { name: "pear", n: 1 }, Tk { name: "apple", n: 2 }, Tk { name: "fig", n: 3 }, Tk { name: "", n: 4 }];
    h["fig"] = null;
    h += [Tk { name: "kiwi", n: 5 }];
    o = ";";
    cnt = 0;
    for x in h par(r = ttag(x), n) { o += "{r};"; cnt += 1; }
    all = o.contains(";pear1;") && o.contains(";apple2;") && o.contains(";4;") && o.contains(";kiwi5;") && !o.contains("fig");
    assert(cnt == 4 && len(o) == 22 && all, "N={n}: the multiset {o} ({cnt})");
    q = "";
    for x in h { q += "{ttag(x)};"; }
    assert(q == "4;apple2;kiwi5;pear1;", "the sequential walk is key-ordered: {q}");
  }
}
