//
// loft#2305 — `(N-Join)`: a value-`if` or `match` is optional iff one of its arms is.  An arm
// that calls a function declared BELOW the caller is not: the first pass cannot type that call
// yet and spelled it as a `null`, every join read it as a `null` arm, and the first pass keeps
// an inferred local's type — so `ok` below was `boolean?` and its return warned.  The `null`
// arms beside them still widen.  Armed with the deny switch a library's CI runs under.
// @ARMED: LOFT_DENY_WARNINGS=1
// @falsified-at: 9e6425727 — interpret exit 1 -> 0, native exit 1 -> 0 (the false warnings)
enum Shape { Dot, Box { side: integer }, Other }

fn then_arm(x: integer) -> boolean {
  ok = if x > 0 { below(x) } else { false };
  ok
}

fn else_arm(x: integer) -> boolean {
  ok = if x > 0 { false } else { below(-x) };
  ok
}

fn else_if_arm(x: integer) -> integer {
  n = if x > 5 { 1 } else if x > 0 { below_i(x) } else { 0 };
  n
}

fn enum_arm(s: Shape) -> boolean {
  ok = match s {
    Dot => true,
    Box { side } => below(side),
    _ => false,
  };
  ok
}

fn scalar_arm(x: integer) -> integer {
  n = match x {
    1 => below_i(x),
    _ => 0,
  };
  n
}

fn null_arms(x: integer) -> integer? {
  n = match x {
    1 => below_i(x),
    2 => null,
    _ => 7,
  };
  n
}

fn below(x: integer) -> boolean { x > 1 }
fn below_i(x: integer) -> integer { x * 3 }

fn test_an_arm_calling_a_function_declared_below_is_no_null_arm() {
  assert(then_arm(2) && !then_arm(1) && !then_arm(0), "then: {then_arm(2)} {then_arm(1)} {then_arm(0)}");
  assert(!else_arm(1) && else_arm(-2), "else: {else_arm(1)} {else_arm(-2)}");
  assert(else_if_arm(9) == 1 && else_if_arm(2) == 6 && else_if_arm(0) == 0, "else if: {else_if_arm(9)} {else_if_arm(2)} {else_if_arm(0)}");
  assert(enum_arm(Dot) && enum_arm(Box { side: 3 }) && !enum_arm(Other), "enum match");
  assert(scalar_arm(1) == 3 && scalar_arm(4) == 0, "scalar match: {scalar_arm(1)} {scalar_arm(4)}");
  assert(null_arms(1) == 3 && null_arms(2) == null && null_arms(5) == 7, "a null arm still widens: {null_arms(1)} {null_arms(2)} {null_arms(5)}");
}
