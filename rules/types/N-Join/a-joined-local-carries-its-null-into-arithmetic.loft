//
// A JOINED LOCAL CARRIES ITS NULL INTO ARITHMETIC (`@FR-N-Join`, `@FR-N-Prop`, `@FR-N-Opt`,
// `@FR-H-Index`).  An inferred local joined across a branch with an indexed read is `τ?`, and
// the operator on it propagates the null to one discharge.  Axes moved: the element type
// (integer, text, a struct read through a field), the index (in range, past the end, negative
// inside `[-len, -1]` — which counts from the end — and below `-len`), the branch taken or
// not, and a loop that rebinds the joined local every pass.
//
// @falsified-at: none — a conformance guard at a rule pairing no guard named together
//   (the documented-pairs measure, 2026-10-17); every cell answered right on both backends.
// CHANNEL: the asserts, and the suite's leak gate.
// HOLDS: every cell on both backends.

struct P { x: integer }

fn at(v: vector<integer>, i: integer) -> integer {
  // N-Join x N-Prop: `a` inferred, joined with v[i] (integer?) -> integer?; `a + 1` carries it
  a = 2;
  if i != 99 { a = v[i]; }
  (a + 1) ?? -1
}

fn test_join_then_arith() {
  v = [10, 20];
  assert(at(v, 99) == 3, "the branch not taken keeps 2: 2+1");
  assert(at(v, 1) == 21, "in range: 20+1");
  assert(at(v, 5) == -1, "out of range: null+1 discharged");
  // (H-Index): a negative index in [-len, -1] counts from the end; below -len it misses
  assert(at(v, -1) == 21, "v[-1] is the last element: 20+1");
  assert(at(v, -2) == 11, "v[-2] is the first: 10+1");
  assert(at(v, -3) == -1, "v[-3] is below -len: null+1 discharged");
}

fn test_join_over_text() {
  // N-Join x N-Opt on text: inferred t joins "x" with a miss; `?` gives ""
  names = ["ann", "bo"];
  t = "x";
  i = 3;
  if i > 0 { t = names[i]; }
  assert((t ?? "none") == "none", "joined text miss");
  assert(len(t?) == 0, "joined text default length");
  i = 1;
  u = "x";
  if i > 0 { u = names[i]; }
  assert((u ?? "none") == "bo" && len(u ?? "") == 2, "joined text hit");
}

fn test_join_over_struct() {
  // N-Join x N-Opt on a struct element read by a plain index
  ps = [P { x: 5 }, P { x: 7 }];
  i = 9;
  q = ps[0];
  if i > 0 { q = ps[i]; }
  assert((q.x ?? -1) == -1, "struct miss through the join reads null x");
  i = 1;
  r = ps[0];
  if i > 0 { r = ps[i]; }
  assert((r.x ?? -1) == 7, "struct hit");
}

fn test_join_in_loop_accumulates() {
  // the joined local is rebound in every pass; hand-computed: indices 0,2,4,6 over [1,2,3,4,5]
  // -> 1,3,5,miss  => sum of (a ?? 100) = 1+3+5+100 = 109
  v = [1, 2, 3, 4, 5];
  s = 0;
  for k in 0..4 {
    a = 0;
    if k >= 0 { a = v[k * 2]; }
    s += a ?? 100;
  }
  assert(s == 109, "loop sum {s}");
}

fn test_prop_chain_of_ops() {
  // N-Prop: null rides through three operators and abs
  v = [3];
  i = 4;
  n = v[i];
  assert(((n * 2 + 1 - 3) ?? -9) == -9, "null through a chain of ops");
  assert((abs(n) ?? -9) == -9, "abs of null");
  i = 0;
  m = v[i];
  assert(((m * 2 + 1 - 3) ?? -9) == 4, "3*2+1-3 = 4");
}
