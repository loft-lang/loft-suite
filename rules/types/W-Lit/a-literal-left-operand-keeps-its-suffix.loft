//
// `@FR-W-Lit` — a literal LEFT operand is read before the other operand's type is known, so past
// i32 it is refused under the regime even beside a `u32`, and the refusal names its `l` cure.
// @falsified-at: none — the refusal held before the right-operand clause; the guard keeps it.

fn main() {
  c: u32 = 7;
  // @EXPECT_ERROR: write `4278190080l` for a 64-bit literal
  d = 0xFF000000 | c;
  println("{d}");
}
