//
// `@FR-T-Recursive` — a struct whose recursion runs through non-null struct fields alone has no
// finite value: every one contains another.  It is refused at its declaration, naming the field
// and the cure `τ?`.
//
// @EXPECT_ERROR: `Bad.next: Bad` makes every Bad contain another Bad — make it `Bad?`

struct Bad { key: integer, next: Bad }

fn main() { }
