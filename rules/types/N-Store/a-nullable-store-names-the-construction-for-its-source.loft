//
// A NULLABLE STORE NAMES THE CONSTRUCTION FOR ITS SOURCE (`@FR-N-Store`).  The warning on a `τ?`
// stored into a `τ` slot says what to write instead, chosen by where the null comes from, so the
// better construction is the one it leads with (WARNING_FIXES.md): an unproven index — a shape
// `(N-Index)` proves, or `!`; a keyed lookup — handle the miss; a branch answering `null` —
// declare the slot `τ?`, or halt there; a function that may answer null — decide what null
// means; a nullable local — test it first, or `!`.  It led with `?`, which hides a null that is
// a bug, for every source alike.
//
// @falsified-at: 0e95172cd — interpret and native expectations FAIL/5 -> 0/5 (main's warning
//   led with `?` for every source); `make falsify` reads INERT, as it scores no warning.
// CHANNEL: the expected warnings.
// ARMED: no instrument.
// WITNESS: each warning names its construction.
// HOLDS: every cell on both backends.
// @EXPECT_WARNING: an index loft cannot prove in range may be past the end
// @EXPECT_WARNING: a lookup by key can miss
// @EXPECT_WARNING: a branch here answers `null`: if that is a real answer, declare the return value `float?`
// @EXPECT_WARNING: `maybe` may answer null
// @EXPECT_WARNING: `got` is `integer?`: test it first

struct K { id: integer, v: integer }
struct H { all: hash<K[id]> }

fn by_index(v: vector<integer>, i: integer) -> integer {
  r: integer = v[i];
  r
}

fn by_key(h: H) -> integer {
  k: K = h.all[3];
  k.v
}

fn half(n: integer) -> float {
  if n > 0 { n as float / 2.0 } else { null }
}

fn maybe(n: integer) -> integer? {
  if n > 0 { n } else { null }
}

fn called(n: integer) -> integer {
  r: integer = maybe(n);
  r
}

fn local(n: integer) -> integer {
  got = maybe(n);
  r: integer = got;
  r
}

fn main() {
  h = H { all: [K { id: 3, v: 30 }] };
  assert(by_index([5, 6], 1) == 6 && by_key(h) == 30 && half(4) == 2.0 && called(2) == 2 && local(7) == 7,
    "the values pass through: {by_index([5, 6], 1)} {by_key(h)} {half(4)} {called(2)} {local(7)}");
}
