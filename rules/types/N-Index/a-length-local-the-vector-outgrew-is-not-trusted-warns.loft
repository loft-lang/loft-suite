//
// A LENGTH LOCAL THE PROGRAM CAN INVALIDATE IS NOT TRUSTED (`@FR-N-Index`, `@FR-N-Store`).  The
// shapes beside the trusted ones: the vector written after the length was taken (before the
// read, after it inside a loop that reads it again, and anywhere in a loop around the length —
// whose next turn runs it after), the local assigned again, another vector's length, the bare
// length (always past the end), and another vector's loop counter.  Each read is `integer?`, so storing it undischarged is (N-Store)'s
// warning, named by its local.
//
// @falsified-at: none — a conformance guard: main trusts none of these shapes either, and the
//   cell pins that the new length-local and counter leaves did not widen to them.
// CHANNEL: the expected warnings.
// ARMED: no instrument.
// WITNESS: each warning names its local.
// HOLDS: every cell on both backends.
// @EXPECT_WARNING: stored into the local `grown` of the non-null type `integer`
// @EXPECT_WARNING: stored into the local `shrunk` of the non-null type `integer`
// @EXPECT_WARNING: stored into the local `again` of the non-null type `integer`
// @EXPECT_WARNING: stored into the local `turn` of the non-null type `integer`
// @EXPECT_WARNING: stored into the local `foreign` of the non-null type `integer`
// @EXPECT_WARNING: stored into the local `past` of the non-null type `integer`
// @EXPECT_WARNING: stored into the local `counted` of the non-null type `integer`

fn grows(v: vector<integer>) -> integer {
  n = len(v);
  v += [9];
  grown: integer = v[n - 1];
  grown
}

fn shrinks(v: vector<integer>) -> integer {
  n = len(v);
  s = 0;
  for i in 0..2 {
    shrunk: integer = v[n - 1];
    s += shrunk + i;
    v.remove(0);
  }
  s
}

fn reassigned(v: vector<integer>) -> integer {
  n = len(v);
  n = n - 1;
  again: integer = v[n - 1];
  again
}

fn in_a_loop(v: vector<integer>) -> integer {
  s = 0;
  for i in 0..2 {
    v += [i];
    n = len(v);
    turn: integer = v[n - 1];
    s += turn;
  }
  s
}

fn other(v: vector<integer>, w: vector<integer>) -> integer {
  n = len(w);
  foreign: integer = v[n - 1];
  foreign
}

fn bare(v: vector<integer>) -> integer {
  n = len(v);
  past: integer = v[n];
  past
}

fn other_counter(v: vector<integer>, w: vector<integer>) -> integer {
  s = 0;
  for x in w {
    counted: integer = v[x#index];
    s += counted;
  }
  s
}

fn main() {
  assert(grows([1, 2]) == 2, "the old last: the vector grew past n");
  assert(reassigned([4, 5, 6]) == 5, "n - 1 - 1");
  assert(in_a_loop([3]) == 1, "the last appended: 0, then 1");
  assert(other([1, 2, 3], [0, 0]) == 2, "w's length on v");
  assert(other_counter([5, 6], [0, 0]) == 11, "w's counter on v");
}
