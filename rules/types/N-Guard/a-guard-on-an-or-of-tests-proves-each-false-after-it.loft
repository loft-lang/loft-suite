//
// A GUARD ON AN `||` OF TESTS PROVES EACH FALSE AFTER IT (`@FR-N-Guard`).  `if a || b { return
// … }` falls through only where every disjunct failed, so each proves its else side for the rest
// of the block: `p == null` proves `p` present, `i >= len(v)` proves `v[i]` in bounds, exactly
// as the one-test guard does.  Main read only a single-test guard, and its warning told an
// author who had tested `body` in such a guard to test `body`.  An `&&` guard proves no
// disjunct (`not_proven`), which still warns.
//
// Values hand-computed.
//
// @falsified-at: 0e95172cd — under LOFT_DENY_WARNINGS, FAIL (3 unexpected warnings: `body` in
//   `guarded`, `a` and `b` in `both`) -> ok; `make falsify` reads INERT, as it scores no warning.
// CHANNEL: the expected warning, and no other (`LOFT_DENY_WARNINGS`).
// ARMED: no instrument.
// WITNESS: the warning is the one in `not_proven`.
// HOLDS: every cell on both backends.
// @EXPECT_WARNING: stored into parameter 1 of `unproven` of the non-null type `integer`

fn need(n: integer) -> integer {
  n + 1
}

fn unproven(n: integer) -> integer {
  n + 1
}

fn guarded(k: integer, body: integer?) -> integer {
  if k > 5 || body == null { return -1; }
  need(body)
}

fn both(a: integer?, b: integer?) -> integer {
  if a == null || b == null { return 0; }
  need(a) + need(b)
}

fn idx(v: vector<integer>, i: integer) -> integer {
  if i < 0 || i >= len(v) { return -1; }
  r: integer = v[i];
  r
}

fn not_proven(k: integer, body: integer?) -> integer {
  if k > 5 && body == null { return -1; }
  unproven(body)
}

fn main() {
  assert(guarded(1, 4) == 5 && guarded(9, 4) == -1 && guarded(1, null) == -1, "4 + 1; k > 5; absent");
  assert(both(1, 2) == 5 && both(null, 2) == 0, "2 + 3; one absent");
  assert(idx([7], 0) == 7 && idx([7], 3) == -1, "in bounds; past the end");
  assert(not_proven(1, 3) == 4, "3 + 1");
}
