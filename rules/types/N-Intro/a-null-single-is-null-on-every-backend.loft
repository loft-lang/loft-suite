//
// A NULL SINGLE IS NULL ON EVERY BACKEND (`@FR-N-Intro`): `null` introduced at a `single?`
// is the single's null — it compares null, coalesces to its default, and a present value is
// untouched.  Each backend writes that null with an operator of its own (`OpConvSingleFromNull`).
//
// Values hand-computed: null ?? 2.5 = 2.5; 1.5 ?? 2.5 = 1.5; 2.5 + 1.5 = 4.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none yet — the C backend refused the program ("operator OpConvSingleFromNull")
//   on the build that had lost the operator's arm; `make falsify` records the receipt.
// CHANNEL: the asserts (and the refusal).
// ARMED: no instrument.
// WITNESS: the message prints both values.
// HOLDS: a present single is not touched by the coalesce.

fn pick(some: boolean) -> single? {
  if some { 1.5f } else { null }
}

fn test_a_null_single_coalesces() {
  a = pick(false);
  b = pick(true);
  assert(a == null, "a null single is null");
  x = a ?? 2.5f;
  y = b ?? 2.5f;
  assert(x + y == 4.0f, "coalesced: {x} {y}");
}

fn main() {
  test_a_null_single_coalesces();
}
