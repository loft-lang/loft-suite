//
// EVERY SHAPE TAKES THE SAME ROAD IN BOTH SPELLINGS (`@FR-N-Road` crossed with `@FR-N-Shape`).
// N-Shape: a question about a type's SHAPE — which storage, which definition, whether it reaches a
// store, what it borrows — answers identically for τ and τ?.  N-Road: a question about the
// LOWERING of a value — which delivery, which ownership mechanism, whether a temporary stands
// between it and its destination — answers identically too, and "the dense spelling is NOT the
// oracle": F-Ret and the store-lifetime rules are.  The N-Road and N-Shape cells beside this one
// each hold one shape (a record, a literal) and move the road; this one crosses the SHAPE (a
// vector, a keyed `hash`, a struct, a struct-enum, a text) with the ROAD (a call result bound,
// the same call in a loop rebinding one local, a write through the result, the subject of a
// `??`), each in the dense and the nullable spelling, and every pair must answer the value
// F-Ret gives — fresh, independent — with the leak gate reading both.
//
// Axes it MOVES: the shape (five), the road (bind, loop rebind, write-through, `??` subject), the
// spelling (τ, τ?).  Values hand-computed.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed on 18594597b, interpret and native.
// CHANNEL: the asserts and the leak gate.
// ARMED: no instrument.
// WITNESS: each message prints the dense and the nullable answer side by side.
// HOLDS: the N-Road and N-Shape cells beside it.

struct NrE { k: integer, v: integer }
struct NrS { a: integer, xs: vector<integer> }
enum NrSh { NrCi { r: integer }, NrSq { w: integer } }

fn nr_v(n: integer) -> vector<integer> { [n, n + 1] }
fn nr_vn(n: integer) -> vector<integer>? { [n, n + 1] }
fn nr_h(n: integer) -> hash<NrE[k]> { h: hash<NrE[k]> = [NrE { k: n, v: n * 10 }]; h }
fn nr_hn(n: integer) -> hash<NrE[k]>? { h: hash<NrE[k]> = [NrE { k: n, v: n * 10 }]; h }
fn nr_s(n: integer) -> NrS { NrS { a: n, xs: [n] } }
fn nr_sn(n: integer) -> NrS? { NrS { a: n, xs: [n] } }
fn nr_e(n: integer) -> NrSh { if n > 2 { NrSq { w: n } } else { NrCi { r: n } } }
fn nr_en(n: integer) -> NrSh? { if n > 2 { NrSq { w: n } } else { NrCi { r: n } } }
fn nr_t(n: integer) -> text { "t{n}" }
fn nr_tn(n: integer) -> text? { "t{n}" }

fn nr_shape(e: NrSh?) -> integer {
  match e { NrCi { r } => r, NrSq { w } => w * 100, _ => -1 }
}

fn test_a_loop_rebinding_one_local() {
  dv = 0;
  nv = 0;
  for i in 0..4 {
    a = nr_v(i);
    b = nr_vn(i);
    dv += a[1];
    nv += (b ?? [0, -100])[1];
  }
  // (0+1) + (1+1) + (2+1) + (3+1) = 10
  assert(dv == 10 && nv == 10, "vector: {dv} {nv}");
  dh = 0;
  nh = 0;
  for i in 1..4 {
    h = nr_h(i);
    g = nr_hn(i);
    dh += h[i].v ?? -1000;
    nh += (g ?? nr_h(0))[i].v ?? -1000;
  }
  assert(dh == 60 && nh == 60, "hash: {dh} {nh}");
}

fn test_a_write_through_the_result_is_independent() {
  a = nr_s(3);
  b = nr_sn(3);
  a.xs += [9];
  if b != null { b.xs += [9]; }
  a2 = nr_s(3);
  b2 = nr_sn(3);
  assert(len(a.xs) == 2 && len(a2.xs) == 1, "dense struct: {len(a.xs)} {len(a2.xs)}");
  assert(len((b ?? nr_s(0)).xs) == 2 && len((b2 ?? nr_s(0)).xs) == 1, "nullable struct");
}

fn test_a_struct_enum_and_a_text() {
  t = "{nr_shape(nr_e(1))} {nr_shape(nr_en(1))} {nr_shape(nr_e(5))} {nr_shape(nr_en(5))}";
  assert(t == "1 1 500 500", "struct-enum: {t}");
  x = nr_t(4);
  y = nr_tn(4) ?? "";
  x += "!";
  y += "!";
  assert(x == "t4!" && y == "t4!" && nr_t(4) == "t4", "text: {x} {y}");
}

fn test_the_subject_of_a_coalesce() {
  a = nr_vn(7) ?? [];
  b = nr_v(7);
  a[0] = 70;
  assert(len(a) == 2 && a[0] == 70 && b[0] == 7, "vector ??: {a} {b}");
  s = nr_sn(8) ?? nr_s(0);
  s.a += 1;
  assert(s.a == 9 && nr_s(8).a == 8, "struct ??: {s.a}");
}

fn main() {
  test_a_loop_rebinding_one_local();
  test_a_write_through_the_result_is_independent();
  test_a_struct_enum_and_a_text();
  test_the_subject_of_a_coalesce();
}
