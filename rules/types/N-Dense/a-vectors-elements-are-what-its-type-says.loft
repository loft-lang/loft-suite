//
// A VECTOR'S ELEMENTS ARE WHAT ITS TYPE SAYS (`@FR-N-Dense`, `@FR-N-Store`, `@FR-N-Index`).  A
// `vector<integer?>` holds a written null and reads it back as null; a `vector<integer>` read by a
// plain variable index is `integer?` only because the index can miss, and a present element reads its
// value.  (Storing a null INTO a dense vector is `(N-Store)`'s warning, pinned by its own cells.)
//
// @falsified-at: none — a conformance guard for a rule no test named; every cell answered as the
//   rule says on both backends on the tree it landed on.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message names the element read.
// HOLDS: every cell on both backends.

fn test_a_nullable_vector_holds_a_null() {
  v: vector<integer?> = [1, null, 3];
  assert(len(v) == 3 && v[1] == null && (v[2] ?? -1) == 3, "len 3, v[1] null, v[2] 3");
  v += [null];
  assert(len(v) == 4 && v[3] == null, "an appended null is an element: len {len(v)}");
}

fn test_a_dense_vector_reads_present_values() {
  v = [10, 20, 30];
  s = 0;
  for x in v { s += x; }
  assert(s == 60 && len(v) == 3, "a for over a dense vector sees no null: {s}");
  i = 4;
  assert((v[i] ?? -1) == -1, "only the read that can miss is absent");
}
