//
// A NULLABLE NARROW VALUE SPENDS ITS TOP CODE ON NULL IN EVERY PLACE (`@FR-N-Reserve`; loft#1249, loft#1640,
// loft#1692, loft#1796, loft#2074).  The sentinel of a nullable narrow type is not a value: a sentinel
// stored, an element read in a loop and a tuple member all read it as null.  Each section keeps its own
// cases and receipt.
//
// ── 1249-a-nullable-narrow-sentinel-is-not-a-value ──
//
// A nullable narrow integer's null sentinel is a value OF THE TYPE, so it is excluded from
// that type's range wherever the value is KEPT — local, field, element, parameter, return
// (loft#1249, @FR-N-Reserve).
//
// `formal/types.md` § Representation always said so: a narrow `Integer`'s `τ?` null is "the
// in-band sentinel = its top stored value (`u8` → `255`); **excluded from `τ?`'s non-null
// range**", reserved "ONLY in the `τ?` form".  Only the STORE layer implemented it.  A local
// is a full i64 slot that never packs, so `255` survived there and died the moment it reached
// a packed position — the same declaration answering two things depending on where the value
// was kept, with no diagnostic on either side, and an ordinary in-range `250 + 5` destroyed
// on the way from one to the other.
//
// TWO CURES WERE BUILT AND MEASURED WRONG BEFORE THIS ONE, and both are cells here now,
// because each looked obviously right and each passed a full green `make ci`:
//
//   Bounding the CAST.  `(mat as u8?) ?? 0` is the shipped idiom for "narrow this, or 0" and
//     never keeps a `u8?` at all; the bound turned its legal `255` into the default, in
//     published `hex_field`.  What spends the sentinel is a SLOT — a place a value is kept —
//     and an expression in flight is not one.  `test_a_cast_is_not_a_slot` is that cure's
//     falsifier.
//
//   Bounding the STORE SEAM by the target's `Optional`.  An element write on a NON-nullable
//     `vector<u8>` presents its target as `u8?`, because `(N-Domain)` makes an index
//     expression nullable for the MISS — so the guard bounded a slot that cannot hold null
//     and wrote the sentinel into it, which the store flattened to `0`.
//     `test_a_non_null_element_is_not_a_nullable_slot` is that cure's falsifier, and
//     `target_holds_null` is the one home that separates the two meanings.
//
// @falsified-at: 95a7f949 — interpret exit 1 -> 0, interpret 3 assertion failures -> 0,
//   native exit 1 -> 0, native 1 assertion failures -> 0.  On that build every nullable narrow
//   LOCAL keeps the sentinel as an ordinary number while its field twin reads null.  The
//   two-cure cells above pass on that build TOO, which is the point of them: they fail on the
//   builds where those cures were live, not on the one this fixes.
//   HOLDS: leak, panic, free-refusal, expectations are equal on both trees. Falsify prints
//   only the channels that MOVE and requires HERE to be clean, so each of those is clean on
//   both. The native side was not scored in this sweep.
//
// Since loft#1796 the CONSTANT spelling of each cell below (`x: u8? = 255`, `S { au: 255 }`,
// `[255]`, `takes(255)`, a `255` return tail, `n[0] = 255`) is refused at compile time — a
// constant a nullable narrow slot cannot hold could only ever be stored as null — and that
// refusal is pinned by tests/parse_errors.rs
// `a_constant_a_nullable_narrow_slot_cannot_hold_is_refused_in_every_position`.  So the value
// reaches each slot through `rt`, which the compiler cannot fold: what this file pins is the
// RUN-TIME answer, and there the sentinel still reads null in every position.
//
// ── 1692-a-loop-variable-reads-a-nullable-narrow-element-as-null ──
//
// loft#1692 (`@FR-N-Reserve`, `@FR-L-Narrow-Enc`, `@FR-I-Next`) — A LOOP VARIABLE READS A NULLABLE
// NARROW ELEMENT AS NULL.  `for x in v` over a vector of `u8?`, `i16?`, `u16?` read each element
// without its declared nullability — `get_val(vtp, false, …)` — so a null element came back as
// its stored code: `255` for `u8?`, `-32768` for `i16?`, `2` for `u16?`.  `x ?? d` never
// discharged and `!x` never fired, while `v[i]`, a copy and a struct field decoded the same
// element as null.  The loop now passes the element's declared nullability, as the indexed read
// does.
//
// The cells cross the widths the reserve applies to (`u8?`, `i8?`, `u16?`, `i16?`, `u32?`) with
// the loop forms that build the element read (a plain loop, `rev`, a vector field, a loop that
// uses `#index`) and the uses (`??`, `!x`, a copy, a format), and pin `(N-Reserve)`'s edge: a
// `255` written into a `u8?` slot IS its null.  Controls: a non-null narrow vector, an `integer?`
// vector, and the indexed read.  Every value is worked out by hand in the cell.
//
// @falsified-at: 23d256c5c — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// @falsified-by: tests/falsified/1692-a-loop-variable-reads-a-nullable-narrow-element-as-null.patch — the same channels.
// CHANNEL: the asserts — the control tree answers every nullable-narrow loop cell with the
//   stored code.
// WITNESS: `u8?: 259 0` (a null read as 255, no null seen).
// HOLDS: the controls, on both trees.
//
// The `(N-Reserve)` cell's `255` arrives through `rt`: since loft#1796 a CONSTANT 255 into a
// `u8?` element is refused at compile time (tests/scripts/1796-…-element.loft), so the cell
// keeps its subject — a 255 that reaches the slot at RUN TIME reads null — by a value the
// compiler cannot fold.
//
// ── a-nullable-narrow-tuple-member-spends-its-top-code-in-every-place ──
//
// A NULLABLE NARROW TUPLE MEMBER SPENDS ITS TOP CODE IN EVERY PLACE (`@FR-N-Reserve` crossed with
// `@FR-L-Tuple`).  N-Reserve: a `u8?` ranges over 0..=254 "in a local, a field, an element, a
// parameter and a return alike — and in a TUPLE MEMBER … `layout.md` `(L-Tuple)` makes a member a
// field, and since loft#1640 it is bounded like one"; a RUN-TIME value outside the usable range
// reads null, and "`e as u8?` yields `255` … assign the same cast into a `u8?` and it is null".
// So a tuple member typed `u8?` given the in-flight 255 holds null whichever way the tuple is
// made — a member assignment, a literal bound to a declared tuple local, a literal returned
// through a declared tuple return, a literal stored as a vector element — and a dense `u8`
// member's unfitting value takes its default.  254 fits everywhere.
//
// Axes it MOVES: how the member is written (member assignment, literal into a local, literal
// returned, literal as a vector element), the value (254, 255 in flight), the nullability.
// Values hand-computed; -1 stands for null.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: 18594597b (loft#2074) — the two literal cells and the tuple-value cell read 255
//   for the u8? member (u.0 == null false), both backends; the others answered as hand-computed.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the members, -1 for null.
// HOLDS: `a-constant-a-nullable-narrow-tuple-member-cannot-hold-is-refused` beside it.

struct S1249 {
  au: u8?,    nu: u8,
  ai: i8?,    ni: i8,
  aw: u16?,   nw: u16,
  as_: i16?,  ns: i16,
  a4: i32?,                    // four bytes — reserves nothing
  al: integer limit(0,255)?,   // widens to two bytes — has a spare code, reserves nothing
  ev: vector<u8>,              // a NON-nullable element, for the second cure's falsifier
}

fn takes(x: u8?) -> integer { x ?? 99 }
fn gives() -> u8? { rt(255) }
// A value the compiler cannot fold, so it reaches the slot at run time.
fn rt(n: integer) -> integer { n }

fn test_the_sentinel_is_absent_from_every_position() {
  // The LOCAL is the position that disagreed: a full i64 slot that never packs.
  x: u8? = rt(255);
  assert(x == null, "255 is the null of a u8?, in a local too, got {x}");
  assert((x ?? 99) == 99, "and `??` recovers from it like any other null, got {x ?? 99}");

  // …the three packed positions, which already agreed with each other.
  s = S1249 { au: rt(255), nu: 1, ai: 1, ni: 1, aw: 1, nw: 1, as_: 1, ns: 1, a4: 1, al: 1, ev: [1] };
  assert(s.au == null, "255 is the null of a u8? field, got {s.au}");
  v: vector<u8?> = [rt(255)];
  assert(v[0] == null, "255 is the null of a u8? element, got {v[0]}");

  // …and the two call boundaries.
  assert(takes(rt(255)) == 99, "255 into a u8? parameter arrives null, got {takes(rt(255))}");
  assert(gives() == null, "255 returned as a u8? is null, got {gives()}");

  // Not only a literal: ordinary in-range arithmetic whose result IS the sentinel.
  n = 250;
  c: u8? = n + 5;
  assert(c == null, "a computed 255 is the null of a u8?, got {c}");
  s.au = n + 5;
  assert(s.au == null, "…and the field agrees, got {s.au}");

  // One below it is an ordinary value, so the reservation is one code and not a clamp.
  d: u8? = 254;
  e: u8? = n + 4;
  assert(d == 254, "254 is a u8? value, got {d}");
  assert(e == 254, "…computed as well as written, got {e}");
}

fn test_every_reserving_width_reserves_its_own_edge() {
  // Which edge follows the SIGN: an unsigned narrow gives up its top code, a signed one its
  // bottom.  The opposite edge stays a value, which separates this from "clamp the range".
  a: u8? = rt(255);     assert(a == null,    "u8? gives up 255, got {a}");
  b: u8? = 0;       assert(b == 0,       "…and keeps 0, got {b}");
  c: i8? = rt(-128);    assert(c == null,    "i8? gives up -128, got {c}");
  d: i8? = 127;     assert(d == 127,     "…and keeps 127, got {d}");
  e: u16? = rt(65535);  assert(e == null,    "u16? gives up 65535, got {e}");
  f: i16? = rt(-32768); assert(f == null,    "i16? gives up -32768, got {f}");
  g: i16? = 32767;  assert(g == 32767,   "…and keeps 32767, got {g}");

  s = S1249 { au: rt(255), nu: 1, ai: rt(-128), ni: 1, aw: rt(65535), nw: 1, as_: rt(-32768), ns: 1,
              a4: 1, al: 1, ev: [1] };
  assert(s.au == null, "u8? field gives up 255, got {s.au}");
  assert(s.ai == null, "i8? field gives up -128, got {s.ai}");
  assert(s.aw == null, "u16? field gives up 65535, got {s.aw}");
  assert(s.as_ == null, "i16? field gives up -32768, got {s.as_}");
}

fn test_a_non_nullable_narrow_reserves_nothing() {
  // The "ONLY in the `τ?` form" half.  A non-null narrow uses the FULL width — there is no
  // null to encode — so every edge above is an ordinary value here.
  a: u8 = 255;     assert(a == 255,   "255 is a real u8, got {a}");
  b: i8 = -128;    assert(b == -128,  "-128 is a real i8, got {b}");
  c: u16 = 65535;  assert(c == 65535, "65535 is a real u16, got {c}");
  d: i16 = -32768; assert(d == -32768, "-32768 is a real i16, got {d}");
  s = S1249 { au: 1, nu: 255, ai: 1, ni: -128, aw: 1, nw: 65535, as_: 1, ns: -32768,
              a4: 1, al: 1, ev: [1] };
  assert(s.nu == 255, "a u8 field holds 255, got {s.nu}");
  assert(s.ni == -128, "an i8 field holds -128, got {s.ni}");
  assert(s.nw == 65535, "a u16 field holds 65535, got {s.nw}");
  assert(s.ns == -32768, "an i16 field holds -32768, got {s.ns}");
  w: vector<u8> = [255];
  assert(w[0] == 255, "a u8 element holds 255, got {w[0]}");
}

fn test_a_width_with_a_spare_code_reserves_nothing() {
  // The reservation is not "nullable narrow" but "nullable AND the range exactly fills a
  // fixed 1- or 2-byte width".  Two widths escape it and keep their whole range: `i32?` is
  // four bytes, and `integer limit(0,255)?` WIDENS to two rather than reserving — the same
  // RANGE as `u8?`, deliberately answering differently.
  a: i32? = 2147483647;
  assert(a == 2147483647, "an i32? keeps its top value, got {a}");
  b: integer limit(0,255)? = 255;
  assert(b == 255, "a limit(0,255)? keeps 255 — it widened rather than reserving, got {b}");
  s = S1249 { au: 1, nu: 1, ai: 1, ni: 1, aw: 1, nw: 1, as_: 1, ns: 1,
              a4: 2147483647, al: 255, ev: [1] };
  assert(s.a4 == 2147483647, "an i32? field keeps its top value, got {s.a4}");
  assert(s.al == 255, "a limit(0,255)? field keeps 255, got {s.al}");
}

fn test_a_cast_is_not_a_slot() {
  // The FIRST rejected cure's falsifier.  A cast produces a value in flight; nothing keeps a
  // `u8?`, so nothing spends the sentinel.  `(mat as u8?) ?? 0` is the shipped "narrow, or 0"
  // idiom — published `hex_field` writes exactly this — and bounding the cast turned its
  // legal `255` into the default.
  n = 250;
  assert((255 as u8?) == 255, "a cast in flight keeps 255, got {255 as u8?}");
  assert(((n + 5) as u8?) == 255, "…computed as well as written, got {(n + 5) as u8?}");
  assert((((n + 5) as u8?) ?? 0) == 255, "and a discharged one keeps it, got {((n + 5) as u8?) ?? 0}");
  assert((((n + 60) as u8?) ?? 0) == 0, "while a genuinely out-of-range one is the default");

  // …and the SLOT the same value lands in is where the reservation IS spent.
  x: u8? = rt(255) as u8?;
  assert(x == null, "kept in a u8? slot, the cast's 255 is null, got {x}");
  assert(takes(rt(255) as u8?) == 99, "a u8? PARAMETER is a slot too, got {takes(rt(255) as u8?)}");

  // The non-null spellings reserve nothing, in flight or kept.
  assert((255 as u8) == 255, "255 as u8 is 255 — a non-null narrow reserves nothing");
  assert((255 as u8 ?? 0) == 255, "255 as u8 ?? 0 discharges to a non-null u8, got {255 as u8 ?? 0}");
}

fn test_a_non_null_element_is_not_a_nullable_slot() {
  // The SECOND rejected cure's falsifier, and the harder one.  `(N-Domain)` makes `v[i]`
  // nullable for the out-of-bounds MISS, so an element WRITE on a non-nullable `vector<u8>`
  // presents its target as `u8?` — "this read may miss" wearing the spelling of "this slot
  // holds null".  Bounding that by the usable range wrote the sentinel into a slot that
  // cannot hold one, and the store flattened it to `0`.
  s = S1249 { au: 1, nu: 1, ai: 1, ni: 1, aw: 1, nw: 1, as_: 1, ns: 1,
              a4: 1, al: 1, ev: [1, 2, 3] };
  i = 1;
  s.ev[i] = 255;
  assert((s.ev[i] ?? -1) == 255, "a non-null vector<u8> element holds 255, got {s.ev[i] ?? -1}");

  // Through a FUNCTION, which is the shape `hex_field` writes and the one that failed: the
  // value is not provably in range there, so the guard is actually emitted.
  mat = 250;
  s.ev[i] = (mat + 5 as u8?) ?? 0;
  assert((s.ev[i] ?? -1) == 255, "…written through the narrow-or-0 idiom, got {s.ev[i] ?? -1}");

  // The nullable-element vector is the other side, and it DOES spend the sentinel.
  n: vector<u8?> = [1];
  n[0] = rt(255);
  assert(n[0] == null, "a vector<u8?> element does reserve 255, got {n[0]}");
}

// The `?? 0` is load-bearing, not noise: `@FR-N-Store` asks an element PLACE's slot type, so a
// nullable `u8?` into this non-null `u8` element is refused at a VARIABLE index just as it always
// was at a literal one (loft#1660).  This is the cure the published `assets` took for the same
// shape.  The cell's subject is WHERE the write lands — whether 255 survives a `&vector<u8>`
// parameter — so it discharges the cast and keeps the element-write shape, rather than dropping
// the `?`, which would quietly make the line a different question.
fn amp_write(px: &vector<u8>, i: integer, a: integer) { px[i] = (a as u8?) ?? 0; }

fn test_a_ref_parameter_is_still_its_referent() {
  // The cell the published `assets` library supplied and this guard did not have.  A write
  // through a `&vector<u8>` PARAMETER presents `parent_tp` as `&vector<u8>`, and a
  // discriminator that asks "is this a collection?" without peeling the `&` answers NO — then
  // falls back to the target's own wrapper, which for an element write is the out-of-bounds
  // one.  So a fully-opaque alpha of `255` went into a non-null `vector<u8>` and came back
  // `null`, and every proxy test that counts opaque texels failed.
  //
  // `AssignPlace::parent_tp`'s own doc names this shape — "`&S` for the same write inside a
  // `&`-parameter" — which is where the peel should have come from rather than from a
  // library gate.
  px: vector<u8> = [0, 0, 0, 0];
  amp_write(px, 3, 255);
  assert((px[3] ?? -1) == 255, "255 through a `&vector<u8>` parameter stays 255, got {px[3] ?? -1}");
  amp_write(px, 2, 254);
  assert((px[2] ?? -1) == 254, "…and so does 254, got {px[2] ?? -1}");
}

struct H { v: vector<u8?> }

// A value the compiler cannot fold, so it reaches the slot at run time.

fn test_a_loop_variable_reads_a_nullable_narrow_element_as_null() {
  a: vector<u8?> = [1, null, 3];
  s1 = 0;
  n1 = 0;
  for x in a { s1 += x ?? 7; if !x { n1 += 1; } }
  assert(s1 == 11 && n1 == 1, "u8?: {s1} {n1}");
  b: vector<i8?> = [-1, null, 3];
  s2 = 0;
  for x in b { s2 += x ?? 7; }
  c: vector<u16?> = [1, null, 3];
  s3 = 0;
  for x in c { s3 += x ?? 7; }
  d: vector<i16?> = [1, null, -3];
  s4 = 0;
  for x in d { s4 += x ?? 7; }
  e: vector<u32?> = [1, null, 3];
  s5 = 0;
  for x in e { s5 += x ?? 7; }
  assert(s2 == 9 && s3 == 11 && s4 == 5 && s5 == 11, "i8? u16? i16? u32?: {s2} {s3} {s4} {s5}");
  // reversed: 3, null, 1 — the first null seen at #index 1
  r6 = "";
  for x in rev(a) { r6 += "{x} "; }
  assert(r6 == "3 null 1 ", "rev: {r6}");
  h = H { v: [null, 2] };
  s7 = 0;
  for x in h.v { s7 += x ?? 40; }
  assert(s7 == 42, "a vector field: {s7}");
  at = -1;
  for x in a { if !x { at = x#index; } }
  assert(at == 1, "the null found by index: {at}");
  // a copy of the loop variable keeps the null
  copies: vector<u8?> = [];
  for x in a { y: u8? = x; copies += [y]; }
  assert(!copies[1] && (copies[2] ?? 0) == 3, "a copy of the loop variable: {copies}");
  // (N-Reserve): 255 is the null of a u8?, so a 255 written into the slot at run time reads null
  w: vector<u8?> = [rt(255), 254];
  n8 = 0;
  for x in w { if !x { n8 += 1; } }
  assert(n8 == 1 && (w[1] ?? 0) == 254, "the reserved code is the null: {n8}");
  // controls: non-null narrow, integer?, indexed
  p: vector<u8> = [1, 255, 3];
  s9 = 0;
  for x in p { s9 += x; }
  q: vector<integer?> = [1, null, 3];
  s10 = 0;
  for x in q { s10 += x ?? 7; }
  s11 = 0;
  for i in 0..3 { s11 += a[i] ?? 7; }
  assert(s9 == 259 && s10 == 11 && s11 == 11, "controls: {s9} {s10} {s11}");
  println("a loop variable reads a nullable narrow element as null: every cell holds");
}

fn tr_mk(n: integer) -> (u8?, integer) { (n as u8?, n) }

fn test_a_member_assignment_lands_null() {
  m = 255;
  x: (u8?, integer) = (5, 1);
  x.0 = m as u8?;
  assert(x.0 == null && x.1 == 1, "member assignment: {x.0 ?? -1}");
}

fn test_a_literal_stored_as_an_element_lands_null() {
  n = 254;
  m = 255;
  v: vector<(u8?, integer)> = [(n as u8?, 3), (m as u8?, 4)];
  assert(len(v) == 2 && (v[0].0 ?? -1) == 254 && v[1].0 == null && v[1].1 == 4, "element: {v[0].0 ?? -1} {v[1].0 ?? -1}");
}

fn test_a_dense_narrow_member_takes_its_default() {
  w: (u8, integer) = (250, 1);
  w.0 += 10;
  assert(w.0 == 0 && w.1 == 1, "dense member: {w.0}");
}

fn test_a_fitting_value_is_kept_everywhere() {
  n = 254;
  t: (u8?, integer) = (n as u8?, 1);
  r = tr_mk(254);
  assert((t.0 ?? -1) == 254 && (r.0 ?? -1) == 254 && r.1 == 254, "254: {t.0 ?? -1} {r.0 ?? -1}");
}

fn test_a_literal_bound_to_a_declared_tuple_lands_null() {
  m = 255;
  u: (u8?, integer) = (m as u8?, 2);
  assert(u.0 == null && u.1 == 2, "literal into a local: {u.0 ?? -1}");
}

fn test_a_literal_returned_through_a_declared_tuple_lands_null() {
  s = tr_mk(255);
  assert(s.0 == null && s.1 == 255, "literal returned: {s.0 ?? -1}");
}

// loft#2074's sibling — a tuple VALUE converted member by member into a `u8?` member.
fn test_a_tuple_value_widened_into_a_nullable_narrow_member_lands_null() {
  m = 255;
  wv: (integer?, integer) = (m, 1);
  a: (u8?, integer) = wv;
  n = 254;
  wf: (integer?, integer) = (n, 2);
  b: (u8?, integer) = wf;
  assert(a.0 == null && a.1 == 1 && (b.0 ?? -1) == 254, "tuple value: {a.0 ?? -1} {b.0 ?? -1}");
}

