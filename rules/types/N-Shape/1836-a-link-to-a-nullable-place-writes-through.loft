//
// A LINK TO A NULLABLE PLACE WRITES THROUGH (`@FR-N-Shape`).  A `&` link to a keyed or nullable
// text and to a nullable vector writes through to its place, on both backends.  Each section keeps its
// own cases and receipt.
//
// ── 1836-a-keyed-or-nullable-text-link-writes-through-on-both-backends ──
//
// loft#1836 (parts C and D) — `(B-Ref-Write)`: writing a `&τ` local writes its SOURCE, and
// `--native` broke it for two τ the interpreter already got right.
//
// D, a keyed collection: `c = &n; c = [..]` lowers to `Set(c, Null)` and then inserts.  The
//   interpreter's `gen_keyed_null` clears the store the slot already names; native gated that
//   clear on the local OWNING its store, which a link does not, so it reset `c` to a NULL
//   DbRef and the first insert panicked (plain hash).  On a `hash?` source the inserts went
//   to a fresh store, the source read stale, and that store leaked.
// C, a `&text?` local: native's `&text` predicate did not peel `?` (`@FR-N-Shape`), so the
//   append through the link's raw pointer was emitted outside its `unsafe` block, and rustc
//   refused the program (E0133).
//
// Every cell asserts the value its hand-computed twin gives on the variable itself; the copy
// and owner cells are the controls (a copy must NOT write the source).
//
// @falsified-at: ac8478561 — native exit 1 -> 0; interpret INERT (expected for a
//   backend-divergence guard — only one side can move).
// @falsified-by: tests/falsified/1836-a-keyed-or-nullable-text-link-writes-through-on-both-backends.patch
//   CHANNEL: native COMPILE (E0133 at the two `&text?` appends), then — run cell by cell on the
//   control's binary with those removed — PANIC and the asserted VALUES, and a LEAK.
//   ARMED: LOFT_NATIVE_LEAK_CHECK=1 for the leak cells (kn_lit, kn_null); the exit and value
//   channels need no instrument.
//   WITNESS: k_lit, k_keys, k_sorted and k_loop panic on the NULL DbRef, k_index in the
//   allocator; kn_lit answers 1 and kn_null 0, each leaking one `hash<Ek[k]>` store.
//   HOLDS: k_var and k_empty (a variable or `[]` source), k_copy, k_own, and every cell on
//   --interpret answer the same on both trees; no leak on either backend here.
//
// ── 1836-a-link-to-a-nullable-vector-writes-through ──
//
// loft#1836 — writing a `&τ` variable writes the SOURCE (`(B-Ref-Write)`), for every τ
// (`(B-Ref-Uniform)`), and a `&τ?` link is its `&τ` twin over a nullable slot (D-bind-17).  For
// τ = `vector<T>?` three spellings broke: `c = &n; c = a` re-pointed the link at a copy and
// left `n` alone, into a null source too; the annotated `c: &vector<T>? = n` kept a `RefVar`
// its bind never builds (a garbage length on the interpreter, a rustc type error on native);
// and `p = [1, 2, 3]` through a `&vector<T>?` PARAMETER appended instead of replacing.  Each
// was a shape test asking `Vector` without peeling `?` (`@FR-N-Shape`).  The same matrix over
// every nullable heap τ found two more: a STRUCT-ENUM local `&` (null or not) was dropped and the
// bind copied (the local-link lowering's source list, and native's record-link arms, left it
// out), and a list literal through a `&hash<…>` (param or annotated, `?` or not) was built into
// the link against its `&` type and refused as a retype.  The non-null twins, a literal and an
// append through the local link, a struct `S?` and a `text?` link are the controls.  (The keyed
// LOCAL link's literal write and the `text?` link on native are loft#1836's native half.)
//
// @falsified-at: 22ebfad8 → here (exit 1 → 0, both backends): on the control the file is
//   refused at compile (`f_hash`'s literal, "cannot change type from &hash<Ek[k]>? to
//   vector<Ek>").  Cell by cell (tmp matrix, both backends): the vector? local and null-source
//   links answered 2 and 0, the annotated link a garbage 35 on the interpreter and rustc E0308
//   on native, the parameter literal 4, and the struct-enum links left the source at 7.
//   CHANNEL: COMPILE, then the asserted VALUES (exit).
//   WITNESS: `cannot change type from &hash<Ek[k]>? to vector<Ek>`; with the cell removed, `local 2` (want 1).
//   HOLDS: the non-null vector twin, the literal and append through a local link, the vector?
//   parameter's variable and append writes, the struct `S?` and the `text?` link answer the same
//   on both trees.

struct Ek { k: integer }

fn k_lit() -> integer { n: hash<Ek[k]> = [Ek { k: 7 }]; c = &n; c = [Ek { k: 2 }, Ek { k: 3 }]; len(n) * 100 + len(c) }
fn k_var() -> integer {
  a: hash<Ek[k]> = [Ek { k: 1 }, Ek { k: 4 }, Ek { k: 5 }];
  n: hash<Ek[k]> = [Ek { k: 7 }];
  c = &n;
  c = a;
  len(n) * 100 + len(a)
}
fn k_empty() -> integer { n: hash<Ek[k]> = [Ek { k: 7 }, Ek { k: 8 }]; c = &n; c = []; len(n) }
fn k_keys() -> integer {
  n: hash<Ek[k]> = [Ek { k: 7 }];
  c = &n;
  c = [Ek { k: 2 }, Ek { k: 3 }];
  r = 0;
  if n[2] != null { r += 1; }
  if n[7] == null { r += 10; }
  r
}
fn kn_lit() -> integer { n: hash<Ek[k]>? = [Ek { k: 7 }]; c = &n; c = [Ek { k: 2 }, Ek { k: 3 }]; len(n ?? []) }
fn kn_null() -> integer { n: hash<Ek[k]>? = null; c = &n; c = [Ek { k: 2 }, Ek { k: 3 }]; len(n ?? []) }
fn k_sorted() -> integer {
  n: sorted<Ek[-k]> = [Ek { k: 7 }];
  c = &n;
  c = [Ek { k: 2 }, Ek { k: 3 }, Ek { k: 9 }];
  r = 0;
  for e in n { r = r * 10 + e.k; }
  r
}
fn k_index() -> integer {
  n: index<Ek[k]> = [Ek { k: 7 }];
  c = &n;
  c = [Ek { k: 2 }, Ek { k: 3 }];
  r = 0;
  for e in n { r = r * 10 + e.k; }
  r
}
fn k_loop() -> integer {
  n: hash<Ek[k]> = [Ek { k: 7 }];
  c = &n;
  t = 0;
  for i in 0..3 {
    c = [Ek { k: i }, Ek { k: i + 10 }];
    t += len(n);
  }
  t * 100 + len(n)
}
// Controls: a copy is its own store, and an owner's rebuild is its own.
// Each control's first write is never read, which the lint rightly says; a LINK's is (loft#1836).
// #warn Dead assignment — 'c' is overwritten before being read
// #warn Dead assignment — 'n' is overwritten before being read
fn k_copy() -> integer { n: hash<Ek[k]> = [Ek { k: 7 }]; c = n; c = [Ek { k: 2 }, Ek { k: 3 }]; len(n) * 100 + len(c) }
fn k_own() -> integer { n: hash<Ek[k]> = [Ek { k: 7 }]; n = [Ek { k: 2 }, Ek { k: 3 }]; len(n) }

fn t_app() -> text { n: text? = "pq"; c = &n; c += "!"; n ?? "<null>" }
fn t_app_null() -> text { n: text? = null; c = &n; c += "!"; n ?? "<null>" }
fn t_annot_app() -> text { n: text? = "pq"; c: &text? = n; c += "!"; n ?? "<null>" }
fn t_set() -> text { n: text? = "pq"; a: text = "a"; c = &n; c = a; n ?? "<null>" }
fn t_set_null() -> text { n: text? = "pq"; c = &n; c = null; n ?? "<null>" }

fn test_a_keyed_or_nullable_text_link_writes_through_on_both_backends() {
  assert(k_lit() == 202, "k_lit {k_lit()}");
  assert(k_var() == 303, "k_var {k_var()}");
  assert(k_empty() == 0, "k_empty {k_empty()}");
  assert(k_keys() == 11, "k_keys {k_keys()}");
  assert(kn_lit() == 2, "kn_lit {kn_lit()}");
  assert(kn_null() == 2, "kn_null {kn_null()}");
  assert(k_sorted() == 932, "k_sorted {k_sorted()}");
  assert(k_index() == 23, "k_index {k_index()}");
  assert(k_loop() == 602, "k_loop {k_loop()}");
  assert(k_copy() == 102, "k_copy {k_copy()}");
  assert(k_own() == 2, "k_own {k_own()}");
  assert(t_app() == "pq!", "t_app {t_app()}");
  assert(t_app_null() == "<null>", "t_app_null {t_app_null()}");
  assert(t_annot_app() == "pq!", "t_annot_app {t_annot_app()}");
  assert(t_set() == "a", "t_set {t_set()}");
  assert(t_set_null() == "<null>", "t_set_null {t_set_null()}");
}

struct S { k: integer }
enum Sh { Ci { r: integer }, Sq { s: integer } }
fn shv(x: Sh?) -> integer { if x == null { return -1; } match x ?? Ci { r: -2 } { Ci { r } => r, Sq { s } => 100 + s } }
fn f_sh(p: &Sh?) { p = Sq { s: 9 }; }
fn f_hash(p: &hash<Ek[k]>?) { p = [Ek { k: 2 }, Ek { k: 3 }]; }
fn f_lit(p: &vector<integer>?) { p = [1, 2, 3]; }
fn f_var(p: &vector<integer>?, a: vector<integer>) { p = a; }
fn f_app(p: &vector<integer>?) { p += [9]; }

fn test_a_link_to_a_nullable_vector_writes_through() {
  a: vector<integer> = [1];
  // The non-null control: the link's write replaces `n`'s contents.
  n0: vector<integer> = [7, 8];
  c0 = &n0;
  c0 = a;
  assert(len(n0) == 1, "non-null {len(n0)}");
  // A local link to a `vector<T>?`, from a local, a literal and an append.
  n1: vector<integer>? = [7, 8];
  c1 = &n1;
  c1 = a;
  assert(len(n1 ?? []) == 1, "local {len(n1 ?? [])}");
  n2: vector<integer>? = [7, 8];
  c2 = &n2;
  c2 = [5, 6, 7];
  assert(len(n2 ?? []) == 3, "literal {len(n2 ?? [])}");
  n3: vector<integer>? = [7, 8];
  c3 = &n3;
  c3 += [9];
  assert(len(n3 ?? []) == 3, "append {len(n3 ?? [])}");
  // Into a source that starts absent: the write gives it the copy.
  b: vector<integer> = [1, 2, 3];
  n4: vector<integer>? = null;
  c4 = &n4;
  c4 = b;
  assert(len(n4 ?? []) == 3, "from null {len(n4 ?? [])}");
  // The annotated spelling of the same link.
  n5: vector<integer>? = [7, 8];
  c5: &vector<integer>? = n5;
  c5 = a;
  assert(len(n5 ?? []) == 1, "annotated {len(n5 ?? [])}");
  // A `&vector<T>?` parameter: a literal, a variable and an append, and a null argument.
  m1: vector<integer>? = [7];
  f_lit(m1);
  assert(len(m1 ?? []) == 3, "param literal {len(m1 ?? [])}");
  m2: vector<integer>? = [7, 8];
  f_var(m2, a);
  assert(len(m2 ?? []) == 1, "param var {len(m2 ?? [])}");
  m3: vector<integer>? = [7];
  f_app(m3);
  assert(len(m3 ?? []) == 2, "param append {len(m3 ?? [])}");
  m4: vector<integer>? = null;
  f_lit(m4);
  assert(len(m4 ?? []) == 3, "param from null {len(m4 ?? [])}");
  // A STRUCT-ENUM link, every form — the local `&` was dropped and the bind copied, `?` or not.
  e0: Sh = Ci { r: 7 };
  ce0 = &e0;
  ce0 = Sq { s: 9 };
  assert(shv(e0) == 109, "enum local {shv(e0)}");
  e1: Sh? = Ci { r: 7 };
  ce1 = &e1;
  ce1 = Sq { s: 9 };
  assert(shv(e1) == 109, "enum? local {shv(e1)}");
  e2: Sh? = Ci { r: 7 };
  ce2: &Sh? = e2;
  ce2 = null;
  assert(shv(e2) == -1, "enum? annotated null {shv(e2)}");
  e3: Sh? = null;
  f_sh(e3);
  assert(shv(e3) == 109, "enum? param from null {shv(e3)}");
  // A `&hash<…>?` parameter given a list literal — refused as a retype before.
  h1: hash<Ek[k]>? = [Ek { k: 1 }];
  f_hash(h1);
  assert(len(h1 ?? []) == 2, "hash? param literal {len(h1 ?? [])}");
  // A struct `S?` link, the record control.
  s1: S? = S { k: 1 };
  cs1 = &s1;
  cs1 = S { k: 9 };
  assert((s1 ?? S { k: -1 }).k == 9, "struct? local");
  // The `text?` control (D-bind-17).
  t: text? = "ab";
  ct = &t;
  ct = "xyz";
  assert(len(t ?? "") == 3, "text {len(t ?? "")}");
  println("nullable vector links write through");
}
