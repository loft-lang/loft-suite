//
// A COMPOUND OF A USER OPERATOR READS ITS PLACE ONCE (`@FR-Op-Compound`, with `@FR-E-Asgn-Compound`):
// `a ⊕= b` for ⊕ in `+ - * / %` is `a = a.m(b)` for ⊕'s `operator` m, on any place — a variable, a
// field's element, a vector element — and the place is read once, so an index that has a side
// effect runs once per compound.  `M` defines `remainder`, `divided_by` and `plus`; `pick` counts
// its calls and answers 1.
//
// Values by hand: v = [17, 29], v[1] %= 5 -> 4; b.ms = [40, 90], b.ms[1] /= 3 -> 30, then
// += M { c: 7 } -> 37; x = 23, x %= 4 -> 3; three compounds through `pick`, so calls = 3.
//
// Axes it MOVES: the operator (`%=`, `/=`, `+=`), the right operand's type (an integer, a record),
//   the place (a local, a vector element, a field's vector element), an index with a side effect.
// Cross-backend; each test reads its own values.
//
// @falsified-at: none — a conformance guard; every value answered as hand-computed, interpret
//   and native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the values and the call count.
// HOLDS: the built-in types' compound place (E-Asgn-Compound's 1825 cell).

struct M { c: integer }
operator remainder(self: M, k: integer) -> M { M { c: self.c % k ?? 0 } }
operator divided_by(self: M, k: integer) -> M { M { c: self.c / k ?? 0 } }
operator plus(self: M, o: M) -> M { M { c: self.c + o.c } }
struct Box { ms: vector<M> }
fn pick(n: &integer) -> integer { n += 1; 1 }

fn test_an_element_with_a_counted_index() {
  calls = 0;
  v = [M { c: 17 }, M { c: 29 }];
  v[pick(calls)] %= 5;
  assert(v[0].c == 17 && v[1].c == 4 && calls == 1, "element: {v[0].c} {v[1].c} calls {calls}");
}

fn test_a_field_element_twice() {
  calls = 0;
  b = Box { ms: [M { c: 40 }, M { c: 90 }] };
  b.ms[pick(calls)] /= 3;
  b.ms[pick(calls)] += M { c: 7 };
  assert(b.ms[0].c == 40 && b.ms[1].c == 37 && calls == 2, "field element: {b.ms[1].c} calls {calls}");
}

fn test_a_local() {
  x = M { c: 23 };
  x %= 4;
  assert(x.c == 3, "local: {x.c}");
}
