//
// EVERY OPERATOR FORM REACHES THE DEFINITION THAT COMPILES (`@FR-Op-Back`, with `@FR-Op-Def`,
// `@FR-Op-Conv`).  Each row of the table of forms — the comparisons, `-x`, `a / b`, `a % b` — on a
// program's type is its `operator` method (`negate`, `divided_by`, `remainder`, …), and a definition
// that compiles backs its form.  Two sections, each with its cells and receipt.
//
// ── every-row-of-the-table-reaches-the-definition-that-compiles ──
//
// EVERY ROW OF THE TABLE REACHES THE DEFINITION THAT COMPILES (`@FR-Op-Back` crossed with
// `@FR-Op-Def` and `@FR-Op-Conv`).  Op-Def: an `operator` definition is checked where it is
// written, "so a definition that compiles backs its form".  Op-Back: the table of forms — `<`,
// `<=`, `>`, `>=` call `compare`, `+ - * / %` call `plus minus times divided_by remainder`,
// unary `-` calls `negate`, `x as T` calls `to_t` (Op-Conv), `for e in x` calls `next`, and
// `"{x}"` calls `to_text`.  The Op-Back cells beside this one measure the arithmetic rows; this
// one defines EVERY row on one type and reaches each through its form, with a right operand of
// another type where the table allows one (`U`), and an answer of another type (`V`).
//
// Axes it MOVES: the row (all eleven forms and the four comparisons), the right operand's type
// (the same type, an integer), the answer's type (the same type, an integer, an Ordering, an
// optional for `next`).  Values hand-computed.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed on 18594597b, interpret and native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the answers.
// HOLDS: the Op-Back cells beside it, the Op-Def refusals.
//
// ── negate-divided-by-and-remainder-are-operator-methods ──
//
// @PLN182 P5b — `-x`, `a / b` and `a % b` on a program's type are its `operator negate`,
// `divided_by` and `remainder` (`@FR-Op-Back`), and the stdlib's interfaces are spelled as the
// definitions that meet them (Q13): a program's type meets `Numeric` with `operator times` and
// `operator negate`, and a user interface written with `operator` members drives the symbols in
// a generic body.  `==` is structural on every type at every depth (@C134) — `Equatable` declares
// nothing and every type meets it — and `!x` stays the presence test.
//
// Every expected value is worked out by hand.
//
// @falsified-at: 23bca8ae1 — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: exit — before P5b `-m`, `/`, `%` found no operator method at a program's type and
//   `Numeric` was not met by `operator times`; the file failed to compile on both backends.
//   HOLDS: every asserted value; leak and panic equal on both trees.

struct ObM { c: integer }
struct ObCnt { at: integer, stop: integer }

operator compare(self: ObM, other: ObM) -> Ordering {
  if self.c < other.c { Less } else if self.c > other.c { Greater } else { Equal }
}
operator plus(self: ObM, other: ObM) -> ObM { ObM { c: self.c + other.c } }
operator minus(self: ObM, other: integer) -> ObM { ObM { c: self.c - other } }
operator times(self: ObM, other: integer) -> ObM { ObM { c: self.c * other } }
operator divided_by(self: ObM, other: integer) -> ObM { ObM { c: self.c / other ?? 0 } }
operator remainder(self: ObM, other: integer) -> integer { self.c % other ?? -1 }
operator negate(self: ObM) -> ObM { ObM { c: -self.c } }
operator to_integer(self: ObM) -> integer { self.c * 100 }
operator to_text(self: ObM) -> text { "M{self.c}" }
operator next(self: ObCnt) -> integer? {
  if self.at >= self.stop { null } else { self.at += 1; self.at }
}

fn test_the_comparison_rows() {
  a = ObM { c: 7 };
  b = ObM { c: 3 };
  s = "{a < b} {a <= b} {a > b} {a >= b} {b < a} {a <= a}";
  assert(s == "false false true true true true", "compare: {s}");
}

fn test_the_arithmetic_rows() {
  a = ObM { c: 7 };
  b = ObM { c: 3 };
  r = a + b;
  m = a - 2;
  t = a * 3;
  d = a / 2;
  q = a % 4;
  n = -a;
  assert(r.c == 10 && m.c == 5 && t.c == 21 && d.c == 3 && q == 3 && n.c == -7, "arithmetic: {r.c} {m.c} {t.c} {d.c} {q} {n.c}");
}

fn test_the_conversion_iteration_and_text_rows() {
  a = ObM { c: 7 };
  i = a as integer;
  tot = 0;
  for e in ObCnt { at: 0, stop: 4 } { tot += e; }
  s = "{a}";
  assert(i == 700 && tot == 10 && s == "M7", "as / for / text: {i} {tot} {s}");
}


value struct M { c: integer }
operator negate(self: M) -> M { M { c: 0 - self.c } }
operator times(self: M, other: M) -> M { M { c: self.c * other.c } }
operator divided_by(self: M, other: M) -> M { M { c: self.c / other.c ?? 0 } }
operator divided_by(self: M, k: integer) -> M { M { c: self.c / k ?? 0 } }
operator remainder(self: M, k: integer) -> M { M { c: self.c % k ?? 0 } }

value struct D { n: integer }
value struct Holds { d: D, k: integer }

interface Scaled {
  operator times(self: Self, other: Self) -> Self
  operator negate(self: Self) -> Self
}
interface Ranked { operator compare(self: Self, other: Self) -> Ordering }
struct R { v: integer }
operator compare(self: R, other: R) -> Ordering { self.v.compare(other.v) }

fn neg_of<T: Numeric>(a: T) -> T { -a }
fn mul_of<T: Numeric>(a: T, b: T) -> T { a * b }
fn same<T: Equatable>(a: T, b: T) -> boolean { a == b }
fn differ<T: Equatable>(a: T, b: T) -> boolean { a != b }
fn scaled<T: Scaled>(a: T, b: T) -> T { -(a * b) }
fn smaller<T: Ranked>(a: T, b: T) -> T { if a < b { a } else { b } }

fn test_negate_divided_by_and_remainder_are_operator_methods() {
  a = M { c: 17 };
  b = M { c: 5 };
  // -17; 17 / 5 = 3; 17 / 2 = 8; 17 % 5 = 2; a method call spells the same.
  assert((-a).c == -17 && (a / b).c == 3 && (a / 2).c == 8 && (a % 5).c == 2, "the forms");
  assert(a.negate().c == -17 && a.divided_by(b).c == 3, "the method spellings");
  // Compound: 17 / 2 = 8, 8 % 3 = 2.
  x = M { c: 17 };
  x /= 2;
  x %= 3;
  assert(x.c == 2, "compound /= and %=: {x.c}");
  // `==` is structural, at every depth: 1 != 11; a held D compares by its field.
  // Two asserts, not one `&&`: loft#1852 (native names an undeclared temporary there).
  assert(D { n: 1 } != D { n: 11 }, "structural !=");
  assert(D { n: 7 } == D { n: 7 }, "structural ==");
  assert(Holds { d: D { n: 3 }, k: 1 } == Holds { d: D { n: 3 }, k: 1 }, "a held field structurally");
  assert(Holds { d: D { n: 3 }, k: 1 } != Holds { d: D { n: 13 }, k: 1 }, "and unequal by that field");
  // Through bounds: Numeric at M — -(4) = -4, 3 * 4 = 12; Equatable is structural.
  assert(neg_of(M { c: 4 }).c == -4 && mul_of(M { c: 3 }, M { c: 4 }).c == 12, "Numeric at a program's type");
  assert(neg_of(4) == -4 && mul_of(3, 4) == 12, "Numeric at integer, unchanged");
  assert(!same(D { n: 2 }, D { n: 42 }) && differ(D { n: 2 }, D { n: 43 }) && same(D { n: 5 }, D { n: 5 }), "Equatable at a program's type");
  assert(same(5, 5) && !same("a", "b"), "Equatable at the built-ins, unchanged");
  // A user interface spelled with `operator` members drives `*`, unary `-` and `<`:
  // -(2 * 3) = -6; smaller of 9 and 4 is 4.
  assert(scaled(M { c: 2 }, M { c: 3 }).c == -6, "operator members drive * and -");
  assert(smaller(R { v: 9 }, R { v: 4 }).v == 4, "an operator compare member drives <");
  // `!x` stays the presence test.
  maybe: M? = null;
  assert(!maybe, "! is presence, not an operator");
  println("ok");
}
