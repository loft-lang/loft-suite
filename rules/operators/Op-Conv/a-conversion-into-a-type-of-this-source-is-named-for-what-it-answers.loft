//
// A CONVERSION INTO A TYPE OF THIS SOURCE IS NAMED FOR WHAT IT ANSWERS AND TAKES ANY SELF
// (`@FR-Op-Conv`).  `as T` reaches the conversion named for `T`, whatever the receiver's type, when `T`
// is declared here.  Two sections, each with its cells and receipt.
//
// ── a-conversion-is-named-for-the-type-it-answers ──
//
// A CONVERSION IS NAMED FOR THE TYPE IT ANSWERS (`@FR-Op-Conv` crossed with `@FR-Op-Back`).
// Op-Back's row `x as T` is the call `x.to_t()`; Op-Conv says how `t` is spelled — T's name in
// snake case, an all-capital run one word (`HTTPRequest` → `http_request`), a digit staying with
// the word before it (`Vec2` → `vec2`) — and that T is a base type or a non-generic struct or
// enum, `x as text` calling `to_text` with an EMPTY spec where only the spec form is defined.
// The Op-Conv cell beside this one measures text and struct sources into one-word structs; this
// one moves the TARGET's spelling (two words, a capital run, a digit) and its kind (a struct, an
// enum, `integer`, `float`, `boolean`, `text` through the spec form).
//
// Axes it MOVES: the target name's shape, the target kind, `as text` against `"{x}"` and
// `"{x:spec}"`.  Values hand-computed from the definitions.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed on 18594597b, interpret and native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the answers.
// HOLDS: `513-first-grade-conversions` beside it; the two refusals beside it.
//
// ── a-conversion-into-a-type-of-this-source-takes-any-self ──
//
// A CONVERSION INTO A TYPE OF THIS SOURCE TAKES ANY SELF (`@FR-Op-Conv` crossed with
// `@FR-Op-Home`).  Op-Home binds an `operator`'s `self` to a type declared in the same source; Op-Conv
// is its one exception: "a conversion INTO a type of this source may take a foreign `self`".  So
// `Dist`'s source defines `as Dist` from ANOTHER LIBRARY's record (`OcPt`), from `integer` and from
// `text` — three members of one `to_dist` set, selected by the operand — and, with its own `self`,
// conversions OUT of `Dist` into the foreign record and into `integer`.  What neither end makes
// "of this source" is the refusal cells beside this one.
//
// Values hand-computed: oc_pt(3,4) as Dist = 7; 21 as Dist = 42; "hello" as Dist = 5;
//   Dist{5} as OcPt = (5, -5); Dist{2} as integer = 200.
//
// Axes it MOVES: the conversion's `self` (another library's record, a built-in scalar, `text`,
//   this source's type), its target (this source's type, another library's record, a built-in),
//   one `to_<t>` with three members.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed, interpret and
//   native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the converted fields.
// HOLDS: `a-conversion-between-two-foreign-types-is-refused` beside it.

use op_conv_fixture_lib::*;

struct DateTime { s: integer }
struct HTTPRequest { n: integer }
struct Vec2 { x: integer, y: integer }
enum OcColour { Red, Green }
struct OcCel { deg: integer }

operator to_date_time(self: OcCel) -> DateTime { DateTime { s: self.deg * 10 } }
operator to_http_request(self: OcCel) -> HTTPRequest { HTTPRequest { n: self.deg + 1 } }
operator to_vec2(self: OcCel) -> Vec2 { Vec2 { x: self.deg, y: -self.deg } }
operator to_oc_colour(self: OcCel) -> OcColour { if self.deg > 10 { OcColour.Green } else { OcColour.Red } }
operator to_integer(self: OcCel) -> integer { self.deg * 3 }
operator to_float(self: OcCel) -> float { self.deg as float + 0.5 }
operator to_boolean(self: OcCel) -> boolean { self.deg != 0 }
operator to_text(self: OcCel, spec: text) -> text { "C<{spec}>{self.deg}" }

fn test_struct_targets_of_every_name_shape() {
  c = OcCel { deg: 4 };
  d = c as DateTime;
  h = c as HTTPRequest;
  v = c as Vec2;
  assert(d.s == 40 && h.n == 5 && v.x == 4 && v.y == -4, "structs: {d.s} {h.n} {v.x} {v.y}");
}

fn test_an_enum_and_the_base_targets() {
  c = OcCel { deg: 4 };
  w = OcCel { deg: 12 };
  k = c as OcColour;
  kw = w as OcColour;
  i = c as integer;
  f = c as float;
  b = c as boolean;
  assert(k == OcColour.Red && kw == OcColour.Green && i == 12 && f == 4.5 && b, "enum and base: {i} {f} {b}");
}

fn test_text_through_the_spec_form() {
  c = OcCel { deg: 4 };
  t = c as text;
  s = "[{c}] [{c:x}]";
  assert(t == "C<>4" && s == "[C<>4] [C<x>4]", "text: {t} {s}");
}



struct Dist { d: integer }

operator to_dist(self: OcPt) -> Dist { Dist { d: self.x + self.y } }
operator to_dist(self: integer) -> Dist { Dist { d: self * 2 } }
operator to_dist(self: text) -> Dist { Dist { d: len(self) } }
operator to_oc_pt(self: Dist) -> OcPt { OcPt { x: self.d, y: -self.d } }
operator to_integer(self: Dist) -> integer { self.d * 100 }

fn test_a_foreign_self_converts_into_this_sources_type() {
  p = oc_pt(3, 4);
  a = p as Dist;
  b = 21 as Dist;
  c = "hello" as Dist;
  assert(a.d == 7 && b.d == 42 && c.d == 5, "into Dist: {a.d} {b.d} {c.d}");
}

fn test_this_sources_type_converts_into_a_foreign_one() {
  q = Dist { d: 5 } as OcPt;
  n = Dist { d: 2 } as integer;
  assert(q.x == 5 && q.y == -5 && n == 200, "out of Dist: {q.x} {q.y} {n}");
}

