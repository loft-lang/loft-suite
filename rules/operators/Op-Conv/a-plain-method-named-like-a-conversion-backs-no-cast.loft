//
// A PLAIN METHOD NAMED LIKE A CONVERSION BACKS NO CAST (`@FR-Op-Conv` crossed with
// `@FR-Op-Back`).  Op-Back's `x as T` row is backed by an `operator` definition; Op-Conv: "A
// plain `fn to_<t>` is an ordinary method; an `as` it would have answered is refused naming it."
//
// @EXPECT_ERROR: reaches only one written with `operator`
//
// @falsified-at: none — a conformance guard; the refusal fires on 18594597b, interpret and native.
// CHANNEL: the compile diagnostic.
// ARMED: no instrument.
// WITNESS: the diagnostic names the method and the operator spelling.
// HOLDS: `a-conversion-is-named-for-the-type-it-answers` beside it.

struct Vec2 { x: integer }
struct OcCel { deg: integer }

fn to_vec2(self: OcCel) -> Vec2 { Vec2 { x: self.deg } }

fn main() {
  c = OcCel { deg: 4 };
  v = c as Vec2;
  assert(v.x == 4, "unreachable");
}
