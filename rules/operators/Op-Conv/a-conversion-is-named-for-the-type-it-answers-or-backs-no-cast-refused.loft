//
// A CONVERSION IS NAMED FOR THE TYPE IT ANSWERS, OR IT BACKS NO CAST (`@FR-Op-Conv`, with `@FR-Op-Mark`).
// A conversion named for another type is refused, and a plain method named like a conversion backs
// no `as`.  Each function is one refusal with its expectation.
//
// ── a-conversion-named-for-another-type-is-refused ──
//
// A CONVERSION NAMED FOR ANOTHER TYPE IS REFUSED (`@FR-Op-Conv` crossed with `@FR-Op-Def`).
// Op-Conv: `x as T` calls `x.to_t()` "and the definition answers exactly T", `t` being T's
// snake-case name — so `Vec2`'s conversion is `to_vec2`.  Op-Def checks a definition where it is
// written; `operator to_vec` answering a `Vec2` names no type it answers and is refused there.
//
// @EXPECT_ERROR: whose conversion is `to_vec2`
//
// @falsified-at: none — a conformance guard; the refusal fires on 18594597b, interpret and native.
// CHANNEL: the compile diagnostic.
// ARMED: no instrument.
// WITNESS: the diagnostic names the right conversion name.
// HOLDS: `a-conversion-into-a-type-of-this-source-is-named-for-what-it-answers` beside it.
//
// ── a-plain-method-named-like-a-conversion-backs-no-cast ──
//
// A PLAIN METHOD NAMED LIKE A CONVERSION BACKS NO CAST (`@FR-Op-Conv` crossed with
// `@FR-Op-Back`).  Op-Back's `x as T` row is backed by an `operator` definition; Op-Conv: "A
// plain `fn to_<t>` is an ordinary method; an `as` it would have answered is refused naming it."
//
// @EXPECT_ERROR: reaches only one written with `operator`
//
// @falsified-at: none — a conformance guard; the refusal fires on 18594597b, interpret and native.
// CHANNEL: the compile diagnostic.
// ARMED: no instrument.
// WITNESS: the diagnostic names the method and the operator spelling.
// HOLDS: `a-conversion-into-a-type-of-this-source-is-named-for-what-it-answers` beside it.

struct Vec2 { x: integer }
struct OcCel { deg: integer }

operator to_vec(self: OcCel) -> Vec2 { Vec2 { x: self.deg } }

fn test_a_conversion_named_for_another_type_is_refused() {
  c = OcCel { deg: 4 };
  assert(c.deg == 4, "unreachable");
}


fn to_vec2(self: OcCel) -> Vec2 { Vec2 { x: self.deg } }

fn test_a_plain_method_named_like_a_conversion_backs_no_cast() {
  c = OcCel { deg: 4 };
  v = c as Vec2;
  assert(v.x == 4, "unreachable");
}
