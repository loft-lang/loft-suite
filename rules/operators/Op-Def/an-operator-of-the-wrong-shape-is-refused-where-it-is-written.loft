//
// AN OPERATOR OF THE WRONG SHAPE IS REFUSED WHERE IT IS WRITTEN (`@FR-Op-Def` crossed with
// `@FR-Op-Back`).  Op-Def: a definition whose name IS a form is still refused unless "its shape
// is the form's (Op-Shape)" — the row of Op-Back it names says `compare(self: τ, other: U) ->
// Ordering`, and this one answers an `integer`.  The refusal is at the definition, with no use
// of `<` anywhere, because a definition that compiles must back its form.
//
// @EXPECT_ERROR: answers an `Ordering`
//
// @falsified-at: none — a conformance guard; the refusal fires on 18594597b, interpret and native.
// CHANNEL: the compile diagnostic.
// ARMED: no instrument.
// WITNESS: the diagnostic names the shape the form needs.
// HOLDS: `an-operator-name-that-is-no-form-is-refused` beside it.

struct OdM { c: integer }

operator compare(self: OdM, other: OdM) -> integer { self.c - other.c }

fn main() {
  m = OdM { c: 1 };
  assert(m.c == 1, "unreachable");
}
