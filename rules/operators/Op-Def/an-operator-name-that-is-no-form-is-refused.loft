//
// AN OPERATOR NAME THAT IS NO FORM IS REFUSED (`@FR-Op-Def` crossed with `@FR-Op-Back`).
// Op-Def: an `operator` definition is refused where it is written "unless its name is a form in
// (Op-Back)".  `frobnicate` is no row of that table, so the definition is refused at once —
// before any use of it — and the diagnostic names the forms and the cure (an ordinary `fn`).
//
// @EXPECT_ERROR: `frobnicate` is not an operator
//
// @falsified-at: none — a conformance guard; the refusal fires on 18594597b, interpret and native.
// CHANNEL: the compile diagnostic.
// ARMED: no instrument.
// WITNESS: the diagnostic names the definition.
// HOLDS: `operators/Op-Back/every-row-of-the-table-reaches-the-definition-that-compiles`.

struct OdM { c: integer }

operator frobnicate(self: OdM) -> OdM { self }

fn main() {
  m = OdM { c: 1 };
  assert(m.c == 1, "unreachable");
}
