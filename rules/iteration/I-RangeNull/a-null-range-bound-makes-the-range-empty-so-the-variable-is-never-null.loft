//
// A NULL RANGE BOUND MAKES THE RANGE EMPTY, SO THE LOOP VARIABLE IS NEVER NULL (`@FR-I-RangeNull`,
// with `@FR-N-Store`, loft#2036).  In every form — `a..b`, `a..=b`, `a..` and each reversed — a bound
// that is null at run time runs the body zero times.  Two sections, each with its cells and receipt.
//
// ── 2036-a-loop-variable-from-a-nullable-start-is-never-null ──
//
// loft#2036 — `@FR-I-RangeNull` crossed with `@FR-N-Store`.  A null bound makes the range
// empty before the first round, so every value the loop variable of `for i in n..5` takes is a
// PRESENT one, and storing it into a non-null slot is not `(N-Store)`'s store of a `τ?`.  The
// variable used to take the START bound's type with its `?`, so each such store warned "a
// nullable `integer?` is stored into …" — the gating tier, on both backends, saying what cannot
// happen.  A null END bound never did it: only the start's type reached the variable.
//
// The narrow cell is the one that can FAIL: at `u8` the same store is (N-Store)'s hard ERROR,
// so the defect refuses the file instead of printing a warning a cell does not fail on.  Every
// range form is crossed with a present and an absent start, values hand-computed.
//
// @falsified-at: 9fb2a2898 with its one line reverted — hand-measured, interpret and native: the
//   control refuses the file (`x: u8 = i` stores a `u8?`, lines 55 and 57).
// CHANNEL: EXIT (the narrow store's refusal); the integer cells' warning is printed only.
// ARMED: no instrument — the narrow store's refusal is on by default.
// HOLDS: the values on both backends, before and after.
//
// ── a-null-bound-makes-the-range-empty ──
//
// `@FR-I-RangeNull` — a range bound that is `null` at run time makes the range EMPTY in every
// form (`a..b`, `a..=b`, `a..`, and each reversed): the body runs zero times, the bound
// tested once before the first round.  Crossed with `@FR-I-For` (the body appends, so a
// round would leave a trace), `@FR-I-Comp` (a comprehension over the range is empty) and
// the `par(…)` clause.  The null END bound is the shape used everywhere below; the null
// START bound is here too, as a counted sum (see `a-loop-variable-from-a-nullable-start-…`
// for the vector-append shape, which carries a spurious warning).
//
// Every function ends with a control: the same loop with the bound PRESENT at run time,
// hand-computed, so the body is shown to run.
//   0..n, 0..=n, rev(0..n), rev(0..=n) with n = null → nothing;  with n = 3 → 0,1,2 / 0..3.
//   n..5, n..=5, n.. with n = null → nothing;  n = 3 → 3+4 = 7 / 3+4+5 = 12.
//
// @falsified-at: none — the rules held when this walk measured them (both backends).
// CHANNEL: assertion values and lengths.
// ARMED: no instrument.
// HOLDS: every cell, interpreter and `--native`.

fn opt(n: integer) -> integer? { if n >= 0 { n } else { null } }
fn opt8(n: integer) -> u8? { if n > 0 { n as u8? } else { null } }

fn test_a_present_start_yields_present_values() {
  out: vector<integer> = [];
  n = opt(2);
  for i in n..5 { out += [i]; }
  s = 0;
  for i in n..4 { x: integer = i; s += x; }
  assert("{out}" == "[2,3,4]" && len(out) == 3 && s == 5, "n = 2: [2,3,4] and 2+3 = 5: got {out} {s}");
}

fn test_every_form_with_a_nullable_start() {
  p = opt(2);
  a = opt(-1);
  e = 0; for i in p..5 { x: integer = i; e += x; }
  assert(e == 9, "2..5: 2+3+4 = 9, got {e}");
  c = 0; for i in p..=5 { x: integer = i; c += x; }
  assert(c == 14, "2..=5: 14, got {c}");
  r = 0; for i in rev(p..5) { x: integer = i; r = r * 10 + x; }
  assert(r == 432, "rev(2..5): 4,3,2, got {r}");
  o = 0; for i in p.. { if i > 4 { break; } x: integer = i; o += x; }
  assert(o == 9, "2.. until 4: 9, got {o}");
  v = [for i in p..4 { i * 10 }];
  assert("{v}" == "[20,30]", "comprehension: {v}");
  z = 0;
  for i in a..5 { x: integer = i; z += 1 + x; }
  for i in a..=5 { x: integer = i; z += 1 + x; }
  for i in rev(a..5) { x: integer = i; z += 1 + x; }
  assert(z == 0 && len([for i in a..4 { i }]) == 0, "an absent start runs no round: {z}");
}

fn test_a_narrow_start_stores_without_a_discharge() {
  n = opt8(2);
  s = 0;
  for i in n..5 { x: u8 = i; s += x as integer; }
  m = opt8(0);
  for i in m..5 { x: u8 = i; s += 100 * (x as integer); }
  assert(s == 9, "u8 2..5: 2+3+4 = 9, the absent start adds nothing: {s}");
}

fn dbl(x: integer) -> integer { x * 2 }

fn test_a_null_end_bound_runs_no_round() {
  out: vector<integer> = [];
  n = opt(-1);
  for i in 0..n { out += [i]; }
  for i in 0..=n { out += [i]; }
  for i in rev(0..n) { out += [i]; }
  for i in rev(0..=n) { out += [i]; }
  assert(len(out) == 0, "a null end bound in each form: zero rounds, got {out}");
  m = opt(3);
  for i in 0..m { out += [i]; }
  for i in rev(0..=m) { out += [i]; }
  assert("{out}" == "[0,1,2,3,2,1,0]" && len(out) == 7, "control m = 3: 0..3 then rev(0..=3): got {out}");
}

fn test_a_null_start_bound_runs_no_round() {
  s = 0;
  rounds = 0;
  n = opt(-1);
  for i in n..5 { s += i; rounds += 1; }
  for i in n..=5 { s += i; rounds += 1; }
  for i in n.. { s += i; rounds += 1; if rounds > 100 { break; } }
  assert(s == 0 && rounds == 0, "a null start in a..b, a..=b, a..: zero rounds, got s={s} rounds={rounds}");
  m = opt(3);
  for i in m..5 { s += i; }
  assert(s == 7, "control m = 3: 3+4 = 7: got {s}");
  for i in m..=5 { s += i; }
  assert(s == 19, "control m..=5 adds 3+4+5 = 12, total 19: got {s}");
}

fn test_a_comprehension_over_a_null_bound_is_empty() {
  n = opt(-1);
  a = [for i in 0..n { i * 10 }];
  b = [for i in 0..=n { i }];
  assert(len(a) == 0 && len(b) == 0, "comprehensions over a null bound: got {a} {b}");
  m = opt(2);
  c = [for i in 0..=m { i * 10 }];
  assert("{c}" == "[0,10,20]" && len(c) == 3, "control: [0,10,20]: got {c}");
}

fn test_a_par_loop_over_a_null_bound_runs_no_round() {
  n = opt(-1);
  s = 0;
  rounds = 0;
  for x in 0..n par(b = dbl(x), 2) { s += b; rounds += 1; }
  assert(s == 0 && rounds == 0, "par over 0..null: zero rounds, got s={s} rounds={rounds}");
  m = opt(4);
  for x in 0..m par(b = dbl(x), 2) { s += b; rounds += 1; }
  assert(s == 12 && rounds == 4, "control: par over 0..4 sums 0+2+4+6 = 12: got s={s} rounds={rounds}");
}
