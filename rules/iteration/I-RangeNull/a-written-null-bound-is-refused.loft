//
// `@FR-I-RangeNull` — a bound WRITTEN as `null` is refused at compile time: that loop can
// never run.  Both ends, and a comprehension's range (`@FR-I-Comp`).
//
// @falsified-at: none — the rule held when this walk measured it (both backends).

fn main() {
  n = 0;
  // @EXPECT_ERROR: a range bound is `null`, so this loop never runs
  for i in 0..null { n += i; }
  // @EXPECT_ERROR: a range bound is `null`, so this loop never runs
  for i in null..3 { n += i; }
  // @EXPECT_ERROR: a range bound is `null`, so this loop never runs
  c = [for i in 0..=null { i }];
  println("{n} {c}");
}
