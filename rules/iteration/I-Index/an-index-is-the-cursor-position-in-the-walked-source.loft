//
// `@FR-I-Index` crossed with `@FR-I-Next` and `@FR-I-Text`: in a `for` body `x#index` is where x
// was read — I-Next's cursor over a vector, the position in v over a slice `v[a..b]` and over
// `rev` of either, so `v[x#index]` reads x whichever part is walked; a filtered loop keeps the
// position of the element it kept.  Over a text, I-Text's cursor is a BYTE offset advanced by
// each codepoint's UTF-8 width, so `c#index` is the codepoint's first byte, `c#next` is
// `c#index` plus its width, and `t[c#index..c#next]` is the character.
//
// Hand-computed: "aé😊b" has bytes a@0 (1), é@1 (2), 😊@3 (4), b@7 (1), size 8.
//
// CHANNEL: the assertions and the leak gate.
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.

struct R { n: integer }

fn test_a_vector_and_its_slices() {
  v = [10, 11, 12, 13, 14, 15];
  s = "";
  for x in v { s += "{x#index}"; }
  t = "";
  ok = 0;
  for x in v[2..5] { t += "{x#index}"; if v[x#index] == x { ok += 1; } }
  u = "";
  for x in rev(v[1..4]) { u += "{x#index}"; if v[x#index] == x { ok += 1; } }
  w = "";
  for x in rev(v) { w += "{x#index}"; }
  assert(s == "012345" && t == "234" && u == "321" && w == "543210" && ok == 6, "{s} {t} {u} {w} {ok}");
}

fn test_a_filtered_walk_and_records() {
  v = [R { n: 3 }, R { n: 8 }, R { n: 5 }, R { n: 9 }];
  s = "";
  for x in v if x.n > 4 { s += "{x#index}:{v[x#index].n},"; }
  assert(s == "1:8,2:5,3:9,", s);
}

fn test_a_text_cursor_is_a_byte_offset() {
  t = "aé😊b";
  s = "";
  ok = 0;
  for c in t {
    s += "{c#index}-{c#next} ";
    if t[c#index..c#next] == "{c}" { ok += 1; }
  }
  assert(s == "0-1 1-3 3-7 7-8 " && ok == 4 && len(t) == 4 && t.size() == 8, "{s} {ok}");
}
