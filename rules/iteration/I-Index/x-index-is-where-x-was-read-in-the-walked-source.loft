//
// `x#index` IS WHERE `x` WAS READ IN THE WALKED SOURCE (`@FR-I-Index`, with `@FR-I-Next`, `@FR-I-Text`).
// I-Next's cursor over a vector, and over a slice `v[a..b]` and its `rev` the position in `v` itself.
// Two sections, each with its cells and receipt.
//
// ── an-index-is-the-cursor-position-in-the-walked-source ──
//
// `@FR-I-Index` crossed with `@FR-I-Next` and `@FR-I-Text`: in a `for` body `x#index` is where x
// was read — I-Next's cursor over a vector, the position in v over a slice `v[a..b]` and over
// `rev` of either, so `v[x#index]` reads x whichever part is walked; a filtered loop keeps the
// position of the element it kept.  Over a text, I-Text's cursor is a BYTE offset advanced by
// each codepoint's UTF-8 width, so `c#index` is the codepoint's first byte, `c#next` is
// `c#index` plus its width, and `t[c#index..c#next]` is the character.
//
// Hand-computed: "aé😊b" has bytes a@0 (1), é@1 (2), 😊@3 (4), b@7 (1), size 8.
//
// CHANNEL: the assertions and the leak gate.
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// ── x-index-of-a-slice-walk-is-the-position-in-the-vector ──
//
// X#INDEX OF A SLICE WALK IS THE POSITION IN THE VECTOR (`@FR-I-Index`).  Over a slice `v[a..b]`,
// and `rev` of one, `x#index` is the position `x` was read at in `v` — as it is over `v` itself
// and `rev(v)` — so `v[x#index]` reads `x`.  A slice walk counted with its own range counter and
// never wrote the loop's `x#index`, so reading it was an internal compiler error (loft#2346).
// Shapes: a slice from either end, a negative bound, `rev` of a slice, a filter, the whole
// vector beside them, and a comprehension.
//
// Values hand-computed from v = [10, 20, 30].
//
// @falsified-at: 0e95172cd — interpret exit 1 -> 0, native exit 101 -> 0 (main stopped on the
//   first slice walk that read `x#index`).
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message lists value@position.
// HOLDS: every cell on both backends.

struct R { n: integer }

fn test_a_vector_and_its_slices() {
  v = [10, 11, 12, 13, 14, 15];
  s = "";
  for x in v { s += "{x#index}"; }
  t = "";
  ok = 0;
  for x in v[2..5] { t += "{x#index}"; if v[x#index] == x { ok += 1; } }
  u = "";
  for x in rev(v[1..4]) { u += "{x#index}"; if v[x#index] == x { ok += 1; } }
  w = "";
  for x in rev(v) { w += "{x#index}"; }
  assert(s == "012345" && t == "234" && u == "321" && w == "543210" && ok == 6, "{s} {t} {u} {w} {ok}");
}

fn test_a_filtered_walk_and_records() {
  v = [R { n: 3 }, R { n: 8 }, R { n: 5 }, R { n: 9 }];
  s = "";
  for x in v if x.n > 4 { s += "{x#index}:{v[x#index].n},"; }
  assert(s == "1:8,2:5,3:9,", s);
}

fn test_a_text_cursor_is_a_byte_offset() {
  t = "aé😊b";
  s = "";
  ok = 0;
  for c in t {
    s += "{c#index}-{c#next} ";
    if t[c#index..c#next] == "{c}" { ok += 1; }
  }
  assert(s == "0-1 1-3 3-7 7-8 " && ok == 4 && len(t) == 4 && t.size() == 8, "{s} {ok}");
}

fn walk_tail(v: vector<integer>) -> text {
  s = "";
  for x in v[1..] { s += "{x}@{x#index}={v[x#index]} "; }
  s
}

fn walk_head(v: vector<integer>) -> text {
  s = "";
  for x in v[..-1] { s += "{x}@{x#index} "; }
  s
}

fn walk_back(v: vector<integer>) -> text {
  s = "";
  for x in rev(v[..-1]) { s += "{x}@{x#index} "; }
  s
}

fn walk_filtered(v: vector<integer>) -> text {
  s = "";
  for x in v[-2..] if x > 20 { s += "{x}@{x#index} "; }
  s
}

fn walk_all(v: vector<integer>) -> text {
  s = "";
  for x in rev(v) { s += "{x}@{x#index} "; }
  s
}

fn test_a_slice_walk_counts_positions_in_the_vector() {
  v = [10, 20, 30];
  assert(walk_tail(v) == "20@1=20 30@2=30 ", "tail: {walk_tail(v)}");
  assert(walk_head(v) == "10@0 20@1 ", "head: {walk_head(v)}");
  assert(walk_back(v) == "20@1 10@0 ", "rev of a slice: {walk_back(v)}");
  assert(walk_filtered(v) == "30@2 ", "a filter over v[-2..]: {walk_filtered(v)}");
  assert(walk_all(v) == "30@2 20@1 10@0 ", "the whole vector: {walk_all(v)}");
  a = [for x in v[1..] { x#index }];
  assert("{a}" == "[1,2]", "a comprehension: {a}");
}
