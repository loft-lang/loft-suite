//
// AN ARGUMENT INSIDE A HOLE TARGETS ITS PARAMETER (`@FR-F-Target-Pos`, crossed with
// `@FR-F-Interp`).  A hole holds an arbitrary expression parsed at full language level
// `(F-Interp)`, so a call written inside a hole meets its parameters exactly as the same call
// does outside one, and a call argument targets, so it targets inside a hole too.
//
// loft#2064: `a = take("x{n}")` built a `Q`, but `"{take("x{n}")}"` was refused "expected Q,
// got text on argument 1 of call to take" on both backends — the gate that keeps the TEMPLATE's
// destination out of a hole also kept out the destination of a call written in that hole.
//
// @falsified-at: 3cae84177 — interpret and native: the hole's call is refused "expected Q, got
//   text on argument 1 of call to take".
// CHANNEL: the asserts (today: a compile refusal).
// ARMED: no instrument.
// WITNESS: the message prints both counts.
// HOLDS: `q: Q = "{"seed"}"` still hands "seed" to `hole_text` as a value.

struct Q { const log: vector<text> }

fn lit(self: Q, s: text) { self.log += ["L({s})"]; }
fn hole_int(self: Q, v: integer) { self.log += ["I({v})"]; }
fn take(q: Q) -> integer { len(q.log) }

fn test_a_call_inside_a_hole() {
  n = 4;
  a = take("x{n}");
  s = "{take("x{n}")}";
  assert(a == 2 && s == "2", "{a} [{s}]");
}
