//
// A VECTOR OF `&` RESULTS COMPARES BY VALUE (`@FR-G-Amp-Infix`, crossed with `@FR-E-Eq` and
// `@FR-C-Int`).  `[a & 4, a & 2, a & 1]` is a vector of `integer` (`@FR-N-Arith` writes no range
// into the type), a `vector<u8>` holds the same values narrow, and `==` compares "a vector or array by length and then element by element in order", each
// element by its own `==` — and integer `==` is by VALUE, whatever the width.  So the vector
// equals the `vector<integer>` literal `[4, 2, 0]`.
//
// loft#2062: `==` between two vectors whose element WIDTHS differ answered by bytes, not by
// value, on both backends — `[a & 4, a & 2, a & 1] == [4, 2, 0]` was false while every element
// compared equal, and `vector<u8> [4, 2, 0] == vector<integer> [4, 0, 0]` was TRUE.
//
// @falsified-at: 05d019607 — hand-measured, interpret and native: the different-widths cells
//   answer false where every element compares equal.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message names the vectors compared.
// HOLDS: same-width comparisons (the first function) keep their answers.

fn test_same_widths_compare_by_value() {
  a = 6;
  w = [a & 4, a & 4];
  x = [a & 4, a & 4];
  assert(w == x && len(w) == 2, "{w} {x}");
  u: vector<u8> = [4, 2, 0];
  v: vector<u8> = [4, 2, 0];
  assert(u == v && !(u != v), "u8 against u8");
}

fn test_different_widths_compare_by_value() {
  a = 6;
  w = [a & 4, a & 2, a & 1];
  assert(w == [4, 2, 0], "an & vector against a literal: {w}");
  u: vector<u8> = [4, 2, 0];
  i: vector<integer> = [4, 2, 0];
  k: vector<integer> = [4, 0, 0];
  n: vector<i32> = [4, 2, 0];
  assert(u == i && i == u && n == i && n == u, "equal contents across widths");
  assert(u != k && !(u == k), "different contents across widths");
}
