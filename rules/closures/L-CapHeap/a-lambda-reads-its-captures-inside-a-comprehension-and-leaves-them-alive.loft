//
// A LAMBDA READS ITS CAPTURES INSIDE A COMPREHENSION AND LEAVES THEM ALIVE (`@FR-L-CapHeap`,
// `@FR-L-CapScalar`).  A captured heap value is shared, never the closure's to free, and a scalar
// is read by its creation-time value — inside a comprehension the lambda's body runs as anywhere
// else: over a capture of every element type, over a top-level constant, and when the body RETURNS
// a comprehension over a captured collection (whose store a pass-1-typed subject temp once freed on
// the first call).  Three sections, each with its cells and receipt.
//
// ── a-capture-of-every-element-type-reads-through-a-comprehension ──
//
// `@FR-L-CapHeap` / `@FR-L-CapScalar` — a lambda reads its captures by value inside a
// comprehension, whatever the captured value is.  The corpus put a capture inside a
// comprehension only as an integer, a collection or a struct (`scripts/matrix_axes.py cross A10
// A7`, `A10 A4`, `A10 A6`, `A1 A10`, `A1 A4`); this file reaches the rest of those pairs: a
// narrow integer, a float, an enum, a nested vector, a text, a tuple and a spatial index, read
// in the comprehension's body, in a `??` subject and default, and as a call argument.  A
// spatial lookup, and a whole spatial index, also stand as a `??` default outside any lambda.  Every value is
// hand-computed, every lambda runs ten times, and `main` runs it all for the leak check.
//
// @falsified-at: none — the rules held when this walk measured them; the guard keeps them held.
// CHANNEL: the VALUE (hand-computed) and the LEAK.
// ARMED: no instrument.  Ordinary assertions on every backend.
// HOLDS: every cell, on every backend.
//
// ── a-lambda-comprehension-over-a-constant-reads-its-captures ──
//
// `@FR-L-CapHeap` / `@FR-L-CapScalar` — a lambda whose body is a COMPREHENSION over a top-level
// CONSTANT reads its captures inside that comprehension: a scalar by its creation-time value,
// a collection, a text and a struct as shared heap values.  The container is a constant (a
// vector of integers, of structs, of texts), never a local or a parameter — the pair
// `global x through-comprehension` no file in the corpus crossed (`scripts/matrix_axes.py
// cross A2 A10`), beside loft#1178's cells, which all build their container locally.
//
// @falsified-at: none — a control: every cell held on main @ 23bc61e4 (--interpret, --native)
//   and on spelcompu-pln204-int32 (all three backends) when the pair was first crossed.  It records that the never-crossed
//   pair works, so a regression there has a cell to fail; corrupt `g6`'s expected sum first if
//   this file ever looks vacuous.
// CHANNEL: the VALUE of each comprehension, hand-computed, and the LEAK (`g6` calls the lambda
//   fifty times, so a per-call leak is fifty stores).
// ARMED: no instrument.  Ordinary assertions on both backends.
// HOLDS: every cell, on the interpreter, --native and --native-c.
//
// ── a-lambda-comprehension-over-a-capture-leaves-the-capture-alive ──
//
// `@FR-L-CapHeap` — a captured heap value is SHARED, never the closure's to free.  A lambda whose
// body RETURNS a comprehension over a captured collection (`fn() { [for x in ys { … }] }`) freed
// that capture's store on its first call: the comprehension's subject temp kept pass 1's type,
// without the `__closure` dep pass 2 gives a capture read, so scope analysis read it as an
// OWNER.  The second call answered `[]`, and every later reader of `ys` — the caller included —
// met a freed store: empty on the interpreter, garbage on native (`44349813112` for a sum of
// three).  A loop, an index read and `len` over the same capture were always right.
//
// Every cell calls the lambda TWICE and then reads the capture, the two reads the bug broke;
// one cell has a second lambda over the same capture.
//
// @falsified-at: 23bc61e4 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   (`main` stops at its first failing cell; under `--tests` seven of the eight cells fail on
//   main, on both backends — the second call answers `[]` or garbage.)
// CHANNEL: the VALUE of both calls and of the capture afterwards, hand-computed, and the LEAK.
// ARMED: no instrument.  Ordinary assertions on both backends.
// HOLDS: every cell, on the interpreter, --native and --native-c.

enum CapCol { Red, Green, Blue }
struct CapP { x: integer, y: integer }
struct CapPt { x: integer, y: integer, n: integer }

fn cap_pick(i: integer) -> integer? { if i % 2 == 0 { i } else { null } }
fn cap_pv(i: integer) -> vector<integer>? { if i % 2 == 0 { [i] } else { null } }
fn cap_g(a: integer, b: integer) -> integer { a * 10 + b }
fn cap_tot(v: vector<integer>) -> integer { t = 0; for x in v { t += x; } t }
fn cap_cn(c: CapCol) -> integer { match c { Red => 1, Green => 2, Blue => 3 } }
fn cap_maybe(i: integer) -> CapPt? { if i == 0 { CapPt { x: 0, y: 0, n: 99 } } else { null } }
fn cap_nsp(i: integer) -> spatial<CapPt[x, y]>? { if i == 0 { [CapPt { x: 9, y: 9, n: 99 }] } else { null } }

fn test_every_capture_type_through_a_comprehension() {
  b: u8 = 7;
  f1 = fn(n: integer) -> vector<integer> { [for i in 0..n { i + b }] };
  fl = 1.5;
  f2 = fn(n: integer) -> vector<float> { [for i in 0..n { fl * (i as float) }] };
  c = CapCol.Blue;
  f3 = fn(n: integer) -> vector<integer> { [for i in 0..n { cap_cn(c) + i }] };
  vv: vector<vector<integer>> = [[1, 2], [30, 40]];
  f4 = fn(n: integer) -> vector<integer> { [for i in 0..n { vv[i % 2][1] ?? -1 }] };
  p = CapP { x: 5, y: 9 };
  f5 = fn(n: integer) -> vector<integer> { [for i in 0..n { p.x * i + p.y }] };
  d = 100;
  f6 = fn(n: integer) -> vector<integer> { [for i in 0..n { cap_pick(i) ?? d }] };
  w = [3, 4];
  f7 = fn(n: integer) -> vector<integer> { [for i in 0..n { cap_tot(cap_pv(i) ?? w) }] };
  k = 6;
  f8 = fn(n: integer) -> vector<integer> { [for i in 0..n { cap_g(k, i) }] };
  t = "ab";
  f9 = fn(n: integer) -> vector<text> { [for i in 0..n { "{t}{i}" }] };
  tp = (10, "t");
  f10 = fn(n: integer) -> vector<integer> { [for i in 0..n { tp.0 + i }] };
  r = "";
  for _ in 0..10 {
    r = "{f1(3)} {f2(3)} {f3(3)} {f4(3)} {f5(3)} {f6(4)} {f7(4)} {f8(3)} {f9(2)} {f10(3)}";
  }
  assert(r == "[7,8,9] [0,1.5,3] [3,4,5] [2,40,2] [9,14,19] [0,100,2,100] [0,7,2,7] [60,61,62] [\"ab0\",\"ab1\"] [10,11,12]", "captures: {r}");
  assert("{b} {fl} {cap_cn(c)} {vv} {p.x},{p.y} {d} {w} {k} {t} {tp.0}" == "7 1.5 3 [[1,2],[30,40]] 5,9 100 [3,4] 6 ab 10", "the captured values are untouched");
}

fn test_a_spatial_capture_and_a_spatial_default() {
  sp: spatial<CapPt[x, y]> = [CapPt { x: 1, y: 2, n: 12 }, CapPt { x: 3, y: 4, n: 34 }, CapPt { x: -5, y: 6, n: 56 }];
  got = "{(cap_maybe(0) ?? sp[1, 2]).n} {(cap_maybe(1) ?? sp[3, 4]).n} {(sp[7, 7] ?? sp[-5, 6]).n} {sp[7, 7].n ?? -1}";
  assert(got == "99 34 56 -1", "spatial as a default: {got}");
  f = fn(k: integer) -> vector<integer> { [for i in 0..k { (sp[2 * i + 1, 2 * i + 2] ?? CapPt { x: 0, y: 0, n: -1 }).n }] };
  r = "";
  for _ in 0..10 { r = "{f(3)}"; }
  assert(r == "[12,34,-1]" && len(sp) == 3, "a captured spatial: {r} len {len(sp)}");
  // A whole spatial as the default: the odd rounds take `sp` (12 + 34 + 56 over 3 records).
  all = "";
  for i in 0..4 {
    s2 = cap_nsp(i % 2) ?? sp;
    t = 0;
    for q in s2 { t += q.n; }
    all += "{len(s2)}:{t},";
  }
  s3 = cap_nsp(1) ?? sp;
  s3 += [CapPt { x: 5, y: 5, n: 55 }];
  assert(all == "1:99,3:102,1:99,3:102," && len(sp) == 3 && len(s3) == 4, "a spatial default: {all} sp {len(sp)} s3 {len(s3)}");
  s4 = cap_nsp(1) ?? cap_nsp(0) ?? sp;
  assert(len(s4) == 1 && (s4[9, 9].n ?? -1) == 99, "a call as the spatial default: {len(s4)}");
}


struct P { a: integer, t: text }
G = [1, 2, 3];
GS = [P { a: 1, t: "x" }, P { a: 2, t: "y" }];
GT = ["u", "vw"];

fn test_g1_scalar() {
  k = 10;
  f = fn() -> vector<integer> { [for x in G { x + k }] };
  v = f();
  assert("{v}" == "[11,12,13]", "g1 {v}");
}
fn test_g2_collection() {
  ys = [100, 200];
  f = fn() -> vector<integer> { [for x in G { x + ys[1] }] };
  v = f();
  assert("{v}" == "[201,202,203]", "g2 {v}");
}
fn test_g3_text() {
  t = "ab";
  f = fn() -> vector<text> { [for x in G { "{t}{x}" }] };
  v = f();
  assert(v.len() == 3 && v[0] == "ab1" && v[2] == "ab3", "g3 {v}");
}
fn test_g4_struct_over_struct_global() {
  p = P { a: 7, t: "z" };
  f = fn() -> vector<integer> { [for q in GS { q.a * p.a }] };
  v = f();
  assert("{v}" == "[7,14]", "g4 {v}");
}
fn test_g5_text_global() {
  k = 3;
  f = fn() -> vector<text> { [for s in GT { "{s}{k}" }] };
  v = f();
  assert(v.len() == 2 && v[0] == "u3" && v[1] == "vw3", "g5 {v}");
}
fn test_g6_many_calls() {
  k = 10;
  f = fn() -> vector<integer> { [for x in G { x + k }] };
  s = 0;
  for _ in 0..50 { v = f(); for x in v { s += x; } }
  assert(s == 50 * 36, "g6 {s}");
}
fn test_g7_filter() {
  k = 1;
  f = fn() -> vector<integer> { [for x in G if x > k { x * 100 }] };
  v = f();
  assert("{v}" == "[200,300]", "g7 {v}");
}
fn test_g8_struct_field_text() {
  sep = "-";
  f = fn() -> vector<text> { [for q in GS { "{q.t}{sep}{q.a}" }] };
  v = f();
  assert(v.len() == 2 && v[0] == "x-1" && v[1] == "y-2", "g8 {v}");
}
fn test_g9_capture_a_struct_field_vector() {
  p = P { a: 2, t: "q" };
  ws = [5, 6];
  f = fn() -> vector<integer> { [for x in G { x * p.a + ws[0] }] };
  v1 = f();
  v2 = f();
  assert("{v1}" == "[7,9,11]" && "{v2}" == "[7,9,11]", "g9 {v1} {v2}");
}

// A `main` that calls every cell, so the leak channel can fire under `--interpret`.


fn test_integers() {
  ys = [5, 6, 7];
  f = fn() -> vector<integer> { [for x in ys { x + 1 }] };
  a = f();
  b = f();
  assert("{a}" == "[6,7,8]" && "{b}" == "[6,7,8]", "calls {a} {b}");
  assert("{ys}" == "[5,6,7]", "the capture {ys}");
}

fn test_narrow_ints() {
  bs: vector<u8> = [250, 5];
  f = fn() -> vector<integer> { [for x in bs { x + 10 }] };
  a = f();
  b = f();
  assert("{a}" == "[260,15]" && "{b}" == "[260,15]", "calls {a} {b}");
  assert(bs.len() == 2 && bs[0] == 250, "the capture {bs}");
}

fn test_floats() {
  fs = [0.5, 1.5];
  f = fn() -> vector<float> { [for x in fs { x * 2.0 }] };
  a = f();
  b = f();
  assert(a.len() == 2 && b.len() == 2 && b[1] == 3.0, "calls {a} {b}");
  assert(fs.len() == 2 && fs[1] == 1.5, "the capture {fs}");
}

fn test_texts() {
  ts = ["ab", "c"];
  f = fn() -> vector<integer> { [for t in ts { len(t) }] };
  a = f();
  b = f();
  assert("{a}" == "[2,1]" && "{b}" == "[2,1]", "calls {a} {b}");
  assert(ts.len() == 2 && ts[0] == "ab", "the capture {ts}");
}

fn test_structs() {
  ps = [P { a: 1, t: "x" }, P { a: 2, t: "yz" }];
  f = fn() -> vector<text> { [for p in ps { "{p.t}{p.a}" }] };
  a = f();
  b = f();
  assert(b.len() == 2 && b[0] == "x1" && b[1] == "yz2", "calls {a} {b}");
  assert(ps.len() == 2 && ps[1].t == "yz", "the capture {ps[1].t}");
}

fn test_nested_vectors() {
  vv = [[1], [2, 3]];
  f = fn() -> vector<integer> { [for v in vv { v.len() * 10 + v[0] }] };
  a = f();
  b = f();
  assert("{a}" == "[11,22]" && "{b}" == "[11,22]", "calls {a} {b}");
  assert("{vv}" == "[[1],[2,3]]", "the capture {vv}");
}

fn test_a_second_lambda_over_the_same_capture() {
  ys = [5, 6, 7];
  f = fn() -> vector<integer> { [for x in ys { x + 1 }] };
  g = fn() -> integer { t = 0; for x in ys { t += x; } t };
  a = f();
  assert("{a}" == "[6,7,8]", "f {a}");
  assert(g() == 18 && g() == 18, "g {g()}");
}

fn test_fifty_calls() {
  ys = [5, 6, 7];
  f = fn() -> vector<integer> { [for x in ys { x + 1 }] };
  t = 0;
  for _ in 0..50 { t += f().len(); }
  assert(t == 150, "50 × 3: {t}");
  assert("{ys}" == "[5,6,7]", "the capture {ys}");
}

// A `main` that calls every cell, so the leak channel can fire under `--interpret`.
