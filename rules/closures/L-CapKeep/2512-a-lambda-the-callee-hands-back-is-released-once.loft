//
// loft#2512, `@FR-L-CapKeep` — a lambda written as a call's argument, which the callee hands back
// (`g = pass(fn(x) {…})`), is released ONCE: the record the argument built and the fn-ref the call
// sets name one store, and which of them releases it is decided by store identity, as for a
// lambda bound to a local first (`g = pass(f)`).  The record was released at the frame's end and
// again by `g`, on both backends.
//
// Every value is computed by hand: each `h(2)` adds 1 to `seen[2]`, `other` hands back a function
// that touches nothing, and `k + x` is 5 + 2.
//
// Axes this file MOVES: how the callee hands it back (directly, one of two parameters, not at
//   all); the lambda inline or bound first; called after the bind or on the spot; one bind or a
//   rebind; what it captures (a vector, an integer).
// Axes it HOLDS FIXED: no loop (the loop is `L-CapOwn/2514-…`).
//
// @falsified-at: 39701d652 — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: the store freed twice, both backends (three of the five tests; the other two hold).
//   ARMED: `LOFT_NO_ARGUMENT_BUILD_SHARE=1` brings it back on this tree.
//   RECORDS: `own_sweep.py --oracle check-records` reads CAUGHT on these shapes with the cure off.
//   HOLDS: leak, panic and expectations are equal on both trees for the two tests that pass
//     on both; every assertion passes on the cured tree.

fn pass2512(f: fn(integer)) -> fn(integer) { f }
fn pick2512(f: fn(integer), g: fn(integer), k: integer) -> fn(integer) { if k > 0 { f } else { g } }
fn nop2512(_x: integer) { }
fn other2512(_f: fn(integer)) -> fn(integer) { nop2512 }

fn test_an_inline_lambda_handed_back() {
  seen = [0, 0, 0];
  g = pass2512(fn(x: integer) { seen[x] += 1; });
  g(2);
  assert(seen[2]! == 1, "inline: {seen[2]!}");
}

fn test_one_of_two_parameters_handed_back() {
  seen = [0, 0, 0];
  g = pick2512(fn(x: integer) { seen[x] += 1; }, nop2512, 1);
  g(2);
  assert(seen[2]! == 1, "pick: {seen[2]!}");
}

fn test_bound_first_and_on_the_spot() {
  seen = [0, 0, 0];
  f = fn(x: integer) { seen[x] += 1; };
  g = pass2512(f);
  g(2);
  pass2512(fn(x: integer) { seen[x] += 1; })(2);
  assert(seen[2]! == 2, "bound and spot: {seen[2]!}");
}

fn test_a_rebind_and_an_integer_capture() {
  seen = [0, 0, 0];
  g = pass2512(fn(x: integer) { seen[x] += 1; });
  g(2);
  g = pass2512(fn(x: integer) { seen[x] += 1; });
  g(2);
  k = 5;
  t = [0];
  h = pass2512(fn(x: integer) { t[0] = k + x; });
  h(2);
  assert("{seen[2]!} {t[0]!}" == "2 7", "rebind and integer: {seen[2]!} {t[0]!}");
}

fn test_a_callee_that_hands_back_another() {
  seen = [0, 0, 0];
  g = other2512(fn(x: integer) { seen[x] += 1; });
  g(2);
  assert(seen[2]! == 0, "other: {seen[2]!}");
}
