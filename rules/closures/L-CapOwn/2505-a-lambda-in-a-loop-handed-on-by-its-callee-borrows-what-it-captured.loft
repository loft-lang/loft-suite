//
// `@FR-L-CapOwn`, loft#2505 — a lambda written as a call's argument inside a loop is released
// with its statement every pass, so it borrows what it captured rather than owning it, when the
// callee can store it nowhere.  loft#2487 admitted a callee that only CALLS the parameter; one
// that also HANDS IT ON — a recursive walk, `walk(a, f)` for each child — was read as one that
// might store it, and the record kept owning the captured vector: the first pass freed it.
//
// The tree `[Leaf 1, Blk [Leaf 2], Leaf 3]` has four nodes (the `Blk` counts), its leaves sum
// to 6, and walking it twice counts eight; every expected value below is worked from that.
//
// @falsified-at: 0b1c81580 — interpret exit 1 -> 0, native exit 1 -> 0.
//   CHANNEL: the run — the control panics on the interpreter (`state[0] is null`) and frees a
//   store twice on the C backend, at the first cell's second pass.
//   HOLDS: leak, panic and free-refusals are clean here on both backends.
//   Score it again with `make falsify GUARD=<this file> REF=0b1c81580`.

enum Nd {
  Leaf { v: integer },
  Blk { items: vector<Nd> },
}

fn walk(n: Nd, f: fn(Nd)) {
  f(n);
  match n {
    Blk { items } => {
      for a in items {
        walk(a, f);
      }
    },
    _ => {},
  }
}

// Hands the lambda to `walk`, which hands it on: still nothing stores it.
fn walk_all(ns: vector<Nd>, f: fn(Nd)) {
  for n in ns {
    walk(n, f);
  }
}

fn tree() -> vector<Nd> {
  [Leaf { v: 1 }, Blk { items: [Leaf { v: 2 }] }, Leaf { v: 3 }]
}

fn test_a_recursive_callee() {
  state = [0];
  for st in tree() {
    walk(st, fn(n: Nd) { state[0] = state[0]! + 1; });
  }
  assert_eq(state[0]!, 4, "every node, once");
}

fn test_two_values_captured() {
  state = [0, 0];
  for st in tree() {
    walk(st, fn(n: Nd) {
      state[0] = state[0]! + 1;
      match n {
        Leaf { v } => { state[1] = state[1]! + v; },
        _ => {},
      }
    });
  }
  assert_eq(state[0]!, 4, "the nodes");
  assert_eq(state[1]!, 6, "the leaves' sum");
}

fn test_a_callee_that_hands_it_to_another() {
  seen = [0];
  for _ in 0..2 {
    walk_all(tree(), fn(n: Nd) { seen[0] = seen[0]! + 1; });
  }
  assert_eq(seen[0]!, 8, "two passes over four nodes");
}

fn test_two_loops_over_one_vector() {
  state = [0, 0];
  for st in tree() {
    walk(st, fn(n: Nd) { state[0] = state[0]! + 1; });
  }
  for st in tree() {
    walk(st, fn(n: Nd) { state[1] = state[1]! + 2; });
  }
  assert_eq(state[0]!, 4, "the first loop");
  assert_eq(state[1]!, 8, "the second, twice as much");
}
