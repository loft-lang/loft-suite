//
// A REBIND RELEASES THE CLOSURE RECORD IT DISPLACES, WHATEVER REPLACES IT (`@FR-L-CapOwn`,
// `@FR-L-CapKeep`).  A closure record that leaves its frame is released by the fn-ref holding it,
// so once a rebind makes that fn-ref name something else — another closure, a lambda that captures
// nothing, a named function — nothing names the old record, and the rebind releases it
// (loft#2155); a branch that re-binds a returned fn-ref to a plain lambda releases the record on
// the run that took that branch.  Two sections, each with its cells and receipt.
//
// ── 2155-a-rebind-releases-the-closure-it-displaces-whatever-replaces-it ──
//
// loft#2155, `@FR-L-CapOwn` / `@FR-L-CapKeep` — A REBIND RELEASES THE CLOSURE IT DISPLACES,
// WHATEVER REPLACES IT.
//
// A closure record that LEAVES its frame is released by the fn-ref holding it (`(L-CapOwn)`),
// and once a rebind makes that fn-ref name something else, nothing names the old record.  The
// rebind released it only when the NEW value was another call's closure; a named function, a
// lambda that captures nothing and a lambda built in the frame each left the displaced record,
// and every store it captured, to nobody.  The answers stayed right and the stores leaked.
//
// The cases vary one axis each: what replaces the closure (a named function, a non-capturing
// lambda, a capturing lambda built here, a non-capturing lambda on one branch, a call — the
// control), what the displaced closure captured (a local struct, a by-value parameter, a `&S`
// parameter, a `&vector` parameter), and how many rebinds follow.  The loop cases keep the
// fn-ref in a local declared outside the loop, so the displaced value is sometimes the frame's
// OWN record from the pass before, which releases through itself and must not be released twice
// (`(L-CapKeep)`).  Every value is worked out by hand.
//
// @falsified-at: b36d0449f — interpret exit 1 -> 0, interpret leaked kt=101 __closure_mk_0×11, kt=100 S×9 ->
//   clean; native INERT (the installed main as the control; native's `--tests` has no per-test leak check)
// CHANNEL: the leak channel, interpreter: under LOFT_LEAK_CHECK=1 a test with a store never freed fails.
// WITNESS: on b36d0449f three of the four tests fail — `2 store(s) not freed at exit: kt=101
//   __closure_mk_0×11, kt=100 S×9`, then `__closure_by_value_0×3, __closure_by_ref_0×3,
//   __closure_by_vec_0×3`, then `S×3, __closure_mk_0×3`; the values are right on both trees.  Native
//   leaks the same records, measured with a `main` under LOFT_NATIVE_LEAK_CHECK=1 (`stores not freed at
//   program exit: … S×3, … __closure_mk_0×3`).
// HOLDS: every assertion passes on both backends here, and no store is reported never freed.
// ARMED: LOFT_LEAK_CHECK=1 (the suite runner sets it for every cell) and LOFT_STRICT_STORES=1.
//
// Held FIXED, so NOT measured here: a fn-ref another local shares (`g = f`), whose rebind
// releases nothing by design.
//
// ── a-closure-rebound-to-a-plain-lambda-releases-the-record-it-displaced ──
//
// `@FR-L-CapOwn` — A CLOSURE RE-BOUND TO A PLAIN LAMBDA RELEASES THE RECORD IT DISPLACED.  A
// fn-ref holds a closure record the frame built, and a branch re-binds it to a lambda that
// captures nothing (or to a named function); the fn-ref is returned.  Its dep list names the
// record, so the frame took the record as leaving with the fn-ref on every run: on the run that
// re-bound it, the record and every store it captured were released by nobody — a leak on both
// backends, and a captured value's drop hook that never ran.  The frame now decides it by store
// identity: the record stands down where the returned fn-ref holds it, and is released on the
// runs that displaced it.
//
// The cases vary one axis each: a captured record with a drop hook, a vector capture, a named
// function as the new value, the record built on one branch only, the re-bind inside a loop,
// two re-binds in a row, and a fn-ref that never leaves.  Values by hand:
//   hooked(false) 1, hooked(true) 5, and `H` 1 dropped once per call (D1 twice in all).
//   named(false) 10, named(true) 9.   one_arm(false) 6, one_arm(true) 20.
//   looped(0) 10, looped(1) 10, looped(2) 7, looped(3) 7.   twice(false) 10, twice(true) 6.
//   stays(false) 10, stays(true) 5.
//
// @ARMED: LOFT_STRICT_STORES=1 LOFT_REFREE_FAILS=1
// @falsified-at: `LOFT_NO_PLAIN_REBIND_KEEP=1` — "not freed at exit" in `hooked`, `named`,
//   `looped` and `twice` on both backends, and the hook trace misses the second D1.
// CHANNEL: the leak check (every cell runs with LOFT_LEAK_CHECK=1), the hook trace, the values.
// HOLDS: `one_arm` and `stays` under the switch.

struct S { v: integer, w: vector<integer> }

fn check(name: text, got: integer, want: integer) { assert(got == want, "{name}: got {got}, want {want}"); }

fn mk(n: integer) -> fn() -> integer { s = S { v: n, w: [1, 0] }; fn() -> integer { s.v * 10 + len(s.w) } }
fn by_value(s: S) -> fn() -> integer { fn() -> integer { s.v * 10 + len(s.w) } }
fn by_ref(s: &S) -> fn() -> integer { s.w += [0]; fn() -> integer { s.v * 10 + len(s.w) } }
fn by_vec(w: &vector<integer>) -> fn() -> integer { w += [7]; fn() -> integer { len(w) } }
fn none() -> fn() -> integer { fn() -> integer { 4 } }
fn plain() -> integer { 5 }

fn test_what_replaces_it() {
  for r in 1..4 {
    f = mk(r);
    check("before, named", f(), r * 10 + 2);
    f = plain;
    check("a named function", f(), 5);
    g = mk(r);
    check("before, literal", g(), r * 10 + 2);
    g = fn() -> integer { 0 };
    check("a non-capturing lambda", g(), 0);
    h = mk(r);
    check("before, capturing", h(), r * 10 + 2);
    t = S { v: 9, w: [] };
    h = fn() -> integer { t.v };
    check("a capturing lambda built here", h(), 9);
    k = mk(r);
    if r > 1 { k = fn() -> integer { 0 }; }
    check("on one branch", k(), if r > 1 { 0 } else { r * 10 + 2 });
    m = mk(r);
    m = none();
    check("a call, the control", m(), 4);
  }
}

fn test_what_it_captured() {
  for r in 1..4 {
    a = S { v: r, w: [1] };
    f = by_value(a);
    check("a by-value parameter", f(), r * 10 + 1);
    f = plain;
    check("the caller's struct after", len(a.w), 1);
    b = S { v: r, w: [1] };
    g = by_ref(b);
    check("a & parameter", g(), r * 10 + 2);
    g = plain;
    check("the caller's struct after the & capture", len(b.w), 2);
    v = [r];
    h = by_vec(v);
    check("a & vector", h(), 2);
    h = plain;
    check("the caller's vector after", len(v), 2);
  }
}

fn test_a_chain() {
  for r in 1..4 {
    f = mk(r);
    f = fn() -> integer { 0 };
    f = mk(r + 10);
    check("three bindings", f(), (r + 10) * 10 + 2);
  }
}

fn test_the_frames_own_record_in_a_loop() {
  f = fn() -> integer { 0 };
  acc = 0;
  for i in 1..4 {
    f = mk(i);
    acc = acc * 100 + f();
    t = S { v: i * 3, w: [] };
    f = fn() -> integer { t.v };
    acc = acc * 100 + f();
  }
  check("a call's closure, then the frame's own", acc, 120322063209);
  g = mk(0);
  acc = 0;
  for i in 1..5 {
    if i % 2 == 0 { g = mk(i); } else { u = S { v: i, w: [] }; g = fn() -> integer { u.v }; }
    acc = acc * 100 + g();
  }
  check("alternating by branch", acc, 1220342);
}

struct H { id: integer }

fn trace_path() -> text { return "loft_plain_rebind_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

fn OpDrop(self: H) { note("D{self.id}"); }
fn mkh(id: integer) -> H { H { id: id } }
fn s2_plain() -> integer { 9 }

fn hooked(q: boolean) -> fn() -> integer {
  e = mkh(1);
  h = fn() -> integer { e.id };
  if q { h = fn() -> integer { 5 }; }
  h
}
fn named(q: boolean) -> fn() -> integer {
  w = [10, 20];
  h = fn() -> integer { w[0] };
  if q { h = s2_plain; }
  h
}
fn one_arm(q: boolean) -> fn() -> integer {
  w = [10, 20];
  h = fn() -> integer { 5 };
  if q { h = fn() -> integer { w[1] }; } else { h = fn() -> integer { 6 }; }
  h
}
fn looped(n: integer) -> fn() -> integer {
  w = [10, 20];
  h = fn() -> integer { w[0] };
  for i in 0..n { if i == 1 { h = fn() -> integer { 7 }; } }
  h
}
fn twice(q: boolean) -> fn() -> integer {
  w = [10, 20];
  h = fn() -> integer { w[0] };
  if q { h = fn() -> integer { 5 }; h = fn() -> integer { 6 }; }
  h
}
fn stays(q: boolean) -> integer {
  w = [10, 20];
  h = fn() -> integer { w[0] };
  if q { h = fn() -> integer { 5 }; }
  h()
}
fn run(f: fn() -> integer) -> integer { f() }
fn hooked_run(q: boolean) -> integer { run(hooked(q)) }

fn test_a_hooked_capture() {
  drain();
  a = hooked_run(false);
  b = hooked_run(true);
  t = drain();
  assert(a == 1 && b == 5, "hooked: {a} {b}");
  assert(t == "D1,D1", "hooked drops: {t}");
}
fn test_a_named_function() { assert(run(named(false)) == 10 && run(named(true)) == 9, "named"); }
fn test_two_rebinds() { assert(run(twice(false)) == 10 && run(twice(true)) == 6, "twice"); }
fn test_in_a_loop() {
  r = "{run(looped(0))} {run(looped(1))} {run(looped(2))} {run(looped(3))}";
  assert(r == "10 10 7 7", "looped: {r}");
}
fn test_one_arm() { assert(run(one_arm(false)) == 6 && run(one_arm(true)) == 20, "one_arm"); }
fn test_a_fn_ref_that_stays() { assert(stays(false) == 10 && stays(true) == 5, "stays"); }
