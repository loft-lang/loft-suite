//
// A CLOSURE CONFINED TO A LOOP PASS BORROWS WHAT IT CAPTURED (`@FR-L-CapOwn`: a captured store is
// freed once, by whichever of the closure and the frame outlives the other).  A closure that dies
// with its pass — a lambda argument a callee can store nowhere, even when the callee hands it on
// down a recursive walk (loft#2505); a closure handed to a function inside the loop (loft#2524);
// a closure a callee hands back to a holder of the pass (loft#2514) — only borrows what it captured
// from outside the loop, and the owner outside releases it once.  Three sections, each with its
// cells and receipt.
//
// ── 2505-a-lambda-in-a-loop-handed-on-by-its-callee-borrows-what-it-captured ──
//
// `@FR-L-CapOwn`, loft#2505 — a lambda written as a call's argument inside a loop is released
// with its statement every pass, so it borrows what it captured rather than owning it, when the
// callee can store it nowhere.  loft#2487 admitted a callee that only CALLS the parameter; one
// that also HANDS IT ON — a recursive walk, `walk(a, f)` for each child — was read as one that
// might store it, and the record kept owning the captured vector: the first pass freed it.
//
// The tree `[Leaf 1, Blk [Leaf 2], Leaf 3]` has four nodes (the `Blk` counts), its leaves sum
// to 6, and walking it twice counts eight; every expected value below is worked from that.
//
// @falsified-at: 0b1c81580 — interpret exit 1 -> 0, native exit 1 -> 0.
//   CHANNEL: the run — the control panics on the interpreter (`state[0] is null`) and frees a
//   store twice on the C backend, at the first cell's second pass.
//   HOLDS: leak, panic and free-refusals are clean here on both backends.
//   Score it again with `make falsify GUARD=<this file> REF=0b1c81580`.
//
// ── 2524-a-closure-built-in-a-loop-borrows-the-outer-store-it-captures ──
//
// A CLOSURE BUILT IN A LOOP BORROWS THE OUTER STORE IT CAPTURES (`@FR-L-CapOwn`: a captured
// store is freed once, by whichever of the two outlives the other).  A closure handed to a
// function inside a loop dies with the pass; the frame's `total` outlives it, so the frame keeps
// the one release.  A loop-local value captured beside `total` — a scalar, captured by value
// (`@FR-L-CapScalar`), or a struct the loop body binds afresh every pass — was read as a capture
// the loop REBINDS, the record took `total` over, and each pass's release freed it under the
// frame: `total[0] is null`, or "a store was freed twice" (loft#2524).
//
// Axes it MOVES: what is captured beside `total` (nothing, a loop-local scalar, a loop-local
// struct from a call, a loop-local struct literal) and where the closure is built (a loop, an
// `if`).  Values hand-computed: `each([10, 20], …)` calls twice; `m.memo` holds `[1]` and `[2, 3]`.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: 704bf3ed0 — interpret exit 1 -> 0, C exit 1 -> 0 (`LOFT_LOOP_LOCAL_CAPTURE_UNCONFINES=1`)
// CHANNEL: the run — a null read (`total[0] is null`) or "a store was freed twice".
// ARMED: no instrument.
// WITNESS: each message prints the total.
// HOLDS: the controls (only `total`, a literal, the `if`) read the same before and after.
//
// ── 2514-a-closure-a-callee-hands-back-in-a-loop-is-released-once ──
//
// loft#2514, `@FR-L-CapOwn` — inside a loop, a closure passed to a callee that hands it back to a
// holder of the pass (`g = pass(f)`, `g = pass(fn(x) {…})`, `pass(fn…)(2)`) is confined to the
// pass: it dies at the pass's end, so it only BORROWS what it captured from outside the loop, and
// the loop's own `seen` is released once, by its owner.  The record adopted it instead, released
// it at the first pass's end, and later passes wrote and freed it again, on both backends.
//
// Every value is computed by hand: each `g(2)` adds 1 to `seen[2]`; three passes add 3, and a
// holder declared before the loop keeps the last pass's closure for one more call.
//
// Axes this file MOVES: the lambda bound first, inline, or called on the spot; the holder declared
//   in the loop or before it (and called after it).
// Axes it HOLDS FIXED: three passes; the capture is one vector from outside the loop.
//
// @falsified-at: 39701d652 — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: the store freed twice, both backends (three of the four tests; the holder that
//     outlives the loop holds).
//   ARMED: `LOFT_NO_RETURNED_CLOSURE_CONFINED=1` brings it back on this tree.
//   RECORDS: `own_sweep.py --oracle check-records` reads CAUGHT on these shapes with the cure off.
//   HOLDS: leak, panic and expectations are equal on both trees for the holder that outlives
//     the loop; every assertion passes on the cured tree.

enum Nd {
  Leaf { v: integer },
  Blk { items: vector<Nd> },
}

fn walk(n: Nd, f: fn(Nd)) {
  f(n);
  match n {
    Blk { items } => {
      for a in items {
        walk(a, f);
      }
    },
    _ => {},
  }
}

// Hands the lambda to `walk`, which hands it on: still nothing stores it.
fn walk_all(ns: vector<Nd>, f: fn(Nd)) {
  for n in ns {
    walk(n, f);
  }
}

fn tree() -> vector<Nd> {
  [Leaf { v: 1 }, Blk { items: [Leaf { v: 2 }] }, Leaf { v: 3 }]
}

fn test_a_recursive_callee() {
  state = [0];
  for st in tree() {
    walk(st, fn(n: Nd) { state[0] = state[0]! + 1; });
  }
  assert_eq(state[0]!, 4, "every node, once");
}

fn test_two_values_captured() {
  state = [0, 0];
  for st in tree() {
    walk(st, fn(n: Nd) {
      state[0] = state[0]! + 1;
      match n {
        Leaf { v } => { state[1] = state[1]! + v; },
        _ => {},
      }
    });
  }
  assert_eq(state[0]!, 4, "the nodes");
  assert_eq(state[1]!, 6, "the leaves' sum");
}

fn test_a_callee_that_hands_it_to_another() {
  seen = [0];
  for _ in 0..2 {
    walk_all(tree(), fn(n: Nd) { seen[0] = seen[0]! + 1; });
  }
  assert_eq(seen[0]!, 8, "two passes over four nodes");
}

fn test_two_loops_over_one_vector() {
  state = [0, 0];
  for st in tree() {
    walk(st, fn(n: Nd) { state[0] = state[0]! + 1; });
  }
  for st in tree() {
    walk(st, fn(n: Nd) { state[1] = state[1]! + 2; });
  }
  assert_eq(state[0]!, 4, "the first loop");
  assert_eq(state[1]!, 8, "the second, twice as much");
}

struct In { items: vector<integer> }
struct Memo { memo: vector<In> }

fn of(m: Memo, d: integer) -> In {
  m.memo[d]!
}

fn each(v: vector<integer>, f: fn(integer)) {
  for x in v {
    f(x);
  }
}

fn test_a_loop_local_scalar_beside_it() {
  total = [0];
  for d in 0..2 {
    x = d + 1;
    each([10, 20], fn(k: integer) { total[0] = total[0]! + x * k; });
  }
  assert(total[0]! == 90, "1 * 30 + 2 * 30: {total[0]!}");
}

fn test_a_loop_local_call_result_beside_it() {
  m = Memo { memo: [In { items: [1] }, In { items: [2, 3] }] };
  total = [0];
  for d in 0..2 {
    fi = of(m, d);
    each([10, 20], fn(k: integer) { total[0] = total[0]! + len(fi.items) * k; });
  }
  assert(total[0]! == 90, "1 * 30 + 2 * 30: {total[0]!}");
  assert(len(m.memo[1]!.items) == 2, "memo[1] is untouched: {len(m.memo[1]!.items)}");
}

fn test_only_the_outer_store() {
  total = [0];
  for d in 0..2 {
    each([10, 20], fn(k: integer) { total[0] = total[0]! + k + d; });
  }
  assert(total[0]! == 62, "30 + 32: {total[0]!}");
}

fn test_a_loop_local_literal_beside_it() {
  total = [0];
  for d in 0..2 {
    fi = In { items: [d, d, d] };
    each([10, 20], fn(k: integer) { total[0] = total[0]! + len(fi.items) * k; });
  }
  assert(total[0]! == 180, "3 * 30 twice: {total[0]!}");
}

fn test_built_in_an_if() {
  total = [0];
  x = 4;
  if x > 0 {
    y = x + 1;
    each([10, 20], fn(k: integer) { total[0] = total[0]! + y * k; });
  }
  assert(total[0]! == 150, "5 * 30: {total[0]!}");
}


fn pass2514(f: fn(integer)) -> fn(integer) { f }

fn test_bound_first_in_a_loop() {
  seen = [0, 0, 0];
  for _ in 0..3 {
    f = fn(x: integer) { seen[x] += 1; };
    g = pass2514(f);
    g(2);
  }
  assert(seen[2]! == 3, "bound: {seen[2]!}");
}

fn test_inline_in_a_loop() {
  seen = [0, 0, 0];
  for _ in 0..3 {
    g = pass2514(fn(x: integer) { seen[x] += 1; });
    g(2);
  }
  assert(seen[2]! == 3, "inline: {seen[2]!}");
}

fn test_on_the_spot_in_a_loop() {
  seen = [0, 0, 0];
  for _ in 0..3 { pass2514(fn(x: integer) { seen[x] += 1; })(2); }
  assert(seen[2]! == 3, "spot: {seen[2]!}");
}

fn test_a_holder_that_outlives_the_loop() {
  seen = [0, 0, 0];
  g = pass2514(fn(x: integer) { seen[x] += 0; });
  for _ in 0..3 {
    g = pass2514(fn(x: integer) { seen[x] += 1; });
    g(2);
  }
  g(2);
  assert(seen[2]! == 4, "kept: {seen[2]!}");
}
