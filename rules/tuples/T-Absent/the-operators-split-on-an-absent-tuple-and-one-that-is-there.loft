//
// THE OPERATORS SPLIT ON THE TYPE ON THE LINE: AN ABSENT TUPLE AND ONE THAT IS THERE (`@FR-T-Absent`).
// Only the in-flight `(τ₁, …, τₙ)?` a missing read produces is absent; every other tuple exists,
// whatever its members hold.  So an element read of a tuple discharges where a held tuple does not,
// and an absent tuple's member carries its null into arithmetic.  Each section keeps its own cases
// and receipt.
//
// ── an-element-read-of-a-tuple-discharges-and-a-held-one-does-not ──
//
// AN ELEMENT READ OF A TUPLE DISCHARGES, AND A HELD ONE DOES NOT NEED TO (`@FR-T-Absent` crossed
// with `@FR-N-Index`).  N-Index: `v[i]` is `τ?` for a plain variable index — out of range there
// is no element — and a CONSTANT index is trusted non-null by contract yet "a genuine overrun
// there faults to null at run time".  T-Absent: the in-flight `(τ₁, …, τₙ)?` such a read
// produces is the one absent tuple; `t?` / `t ?? d` discharge it, `t == null` asks its members
// (all null), and `t.i` on it is `τᵢ?`; "The refusal is on the SUBJECT: (N-Index) trusts a
// CONSTANT index, so `v[0]` is typed without the `?` yet is still an element read that can miss,
// and it discharges like `v[i]`."  A tuple that exists — a loop variable — compares `== null`
// false.  The T-Absent cells beside this one measure generators, arithmetic and declarations;
// this one moves the INDEX (a variable inside and past the end, a constant inside and past it)
// and the reading operator.
//
// Axes it MOVES: the index (variable hit, variable miss, constant hit, constant miss), the read
// (`??`, `?`, `== null`, a member `t.i ?? d`), the members (dense, all-null-able holding nulls).
// Values hand-computed; `?` gives each member's default (0, "").
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed on 18594597b, interpret and native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the answers.
// HOLDS: the T-Absent cells beside it; `a-call-result-tuple-exists-and-refuses-a-discharge` (ignored).
//
// ── an-absent-tuples-member-carries-its-null-into-arithmetic ──
//
// AN ABSENT TUPLE'S MEMBER CARRIES ITS NULL INTO ARITHMETIC (`@FR-T-Absent`, `@FR-N-Prop`,
// `@FR-N-Opt`).  A missed read of a `vector<(integer, text)>` is the in-flight absent tuple; its
// member is `τ?` and `+` carries the null.  Axes moved: the discharge (`??` on the tuple, on
// the member, the sanctioned store into a member-nullable slot), present against absent under
// the same spelling, and a loop reading past the end.
//
// @falsified-at: none — a conformance guard at a rule pairing no guard named together
//   (the documented-pairs measure, 2026-10-17); every cell answered right on both backends.
// CHANNEL: the asserts, and the suite's leak gate.
// HOLDS: every cell on both backends.

fn test_a_variable_index_hit_and_miss() {
  v: vector<(integer, text)> = [(1, "a"), (2, "b")];
  i = 1;
  j = 5;
  a = v[i] ?? (0, "z");
  b = v[j] ?? (0, "z");
  c = v[j]?;
  assert(a.0 == 2 && a.1 == "b" && b.0 == 0 && b.1 == "z", "??: {a.0}{a.1} {b.0}{b.1}");
  assert(c.0 == 0 && c.1 == "", "?: [{c.0}][{c.1}]");
  assert(v[i] != null && v[j] == null, "== null: {v[i] == null} {v[j] == null}");
  assert((v[j].0 ?? -1) == -1 && (v[i].1 ?? "-") == "b", "members: {v[j].0 ?? -1} {v[i].1 ?? "-"}");
}

fn test_a_constant_index_hit_and_miss() {
  v: vector<(integer, text)> = [(1, "a"), (2, "b")];
  d = v[9] ?? (7, "c");
  e = v[0] ?? (7, "c");
  assert(d.0 == 7 && d.1 == "c" && e.0 == 1 && e.1 == "a", "constant: {d.0}{d.1} {e.0}{e.1}");
}

fn test_an_element_holding_only_nulls_reads_as_a_miss() {
  w: vector<(integer?, text?)> = [(null, null), (3, "x")];
  k = 0;
  assert(w[k] == null && w[1] != null && len(w) == 2, "all-null element: {w[k] == null} {w[1] == null}");
}

fn test_a_loop_variable_tuple_exists() {
  v: vector<(integer, text)> = [(1, "a"), (2, "b")];
  t = "";
  for e in v { t += "{e.0}{e == null}"; }
  assert(t == "1false2false", "loop: {t}");
}


fn pairs() -> vector<(integer, text)> { [(3, "c"), (5, "e")] }

fn test_absent_member_into_arith() {
  // T-Absent x N-Prop: a missed tuple read's member is τ?, and `+` carries its null
  v = pairs();
  i = 7;
  t = v[i];
  assert(((t.0 + 1) ?? -1) == -1, "absent member + 1 is null");
  assert(((t.0 * 2 + t.0) ?? -1) == -1, "both operands absent");
  i = 1;
  u = v[i];
  assert(((u.0 + 1) ?? -1) == 6, "present member: 5+1");
  assert((u.1 ?? "?") == "e", "present text member");
}

fn test_absent_tuple_discharge() {
  // T-Absent x N-Opt: `??` discharges an in-flight absent tuple; `?` gives the all-default one
  v = pairs();
  i = 9;
  t = v[i] ?? (0, "none");
  assert(t.0 == 0 && t.1 == "none", "coalesced tuple: {t.0} {t.1}");
  i = 0;
  u = v[i] ?? (0, "none");
  assert(u.0 == 3 && u.1 == "c", "present tuple: {u.0} {u.1}");
  i = 9;
  w = v[i];
  assert(w == null, "an absent tuple reads as null");
  assert(v[0] != null, "a present tuple is not null");
}

fn test_absent_tuple_into_nullable_slot() {
  // the sanctioned move: an in-flight tuple stored into a member-nullable slot
  v = pairs();
  i = 4;
  s: (integer?, text?) = v[i];
  assert(s.0 == null && s.1 == null, "both members null in the stored tuple");
  assert(((s.0 + 10) ?? 77) == 77, "null member through + then discharged");
  i = 1;
  r: (integer?, text?) = v[i];
  assert(((r.0 + 10) ?? 77) == 15, "present: 5+10");
}

fn test_absent_in_loop() {
  // i = 0,1,2,3 over 2 elements: 3 + 5 + miss + miss with miss -> 100: 208
  v = pairs();
  s = 0;
  for i in 0..4 {
    k = i;
    t = v[k];
    s += t.0 ?? 100;
  }
  assert(s == 208, "loop sum {s}");
}
