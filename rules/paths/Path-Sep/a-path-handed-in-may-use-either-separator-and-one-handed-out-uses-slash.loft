//
// A PATH HANDED IN MAY USE EITHER SEPARATOR, AND ONE HANDED OUT USES `/` (`@FR-Path-Sep`).  A path
// a program gives loft may separate with `/` or `\\` on every platform, meaning the same file; a
// path loft gives the program — `temp_dir`, `cache_dir`, a listing's `files()` paths — uses `/`
// only and carries no trailing separator, and `path_sep()` answers '/'.
//
// @falsified-at: none — a conformance guard from the formal text, interpret and native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the path.
// HOLDS: a file written through one separator is read through the other.

fn scratch(tag: text) -> text {
  d = "{temp_dir() ?? "/tmp"}/loft_suite_paths_{tag}_{now()}_{ticks()}";
  mkdir_all(d);
  d
}
fn clean(d: text) {
  for n in list_dir(d) ?? [] { delete("{d}/{n}"); }
  delete(d);
}

fn test_either_separator_names_the_same_file() {
  d = scratch("sep");
  assert(file("{d}\\x.txt").write("via backslash").ok(), "written through a backslash");
  assert((file("{d}/x.txt").content() ?? "") == "via backslash", "read through a slash");
  assert(exists("{d}\\x.txt") && exists("{d}/x.txt"), "both spellings exist");
  clean(d);
}

fn test_a_path_loft_hands_out_uses_slash_and_no_trailing_separator() {
  assert(path_sep() == '/', "path_sep() is {path_sep()}");
  for g in [temp_dir() ?? "", cache_dir() ?? ""] {
    assert(!g.contains("\\") && !g.ends_with("/"), "handed out: {g}");
  }
  d = scratch("listing");
  file("{d}/a.txt").write("a");
  for f in file(d).files() {
    assert(!f.path.contains("\\") && f.path.ends_with("/a.txt"), "listed: {f.path}");
  }
  clean(d);
}
