//
// `@FR-P-Range` × `@FR-P-Alt` — in a pattern `|` separates alternatives, so a range's upper
// bound ends before it: `1..3 | 7` is the range 1..3 (3 excluded) and the alternative 7.  The
// bound was read as a whole expression, `3 | 7` its bitwise or, so the arm matched 1..7 and
// answered wrong with no diagnostic (loft#2324).
//
// Axes this file MOVES:  where the range sits (first, last, between two alternatives); the
//                        range form (`..`, `..=`); a bound that is a constant or a negative
//                        literal; values at each edge, inside, outside and on the alternative.
// Axes it HOLDS FIXED:   an integer subject; no guard.
LO = 10;
HI = 12;

fn first(n: integer) -> integer { match n { 1..3 | 7 => 1, _ => 0 } }
fn last(n: integer) -> integer { match n { 7 | 1..=3 => 1, _ => 0 } }
fn middle(n: integer) -> integer { match n { 0 | LO..HI | 20 => 1, _ => 0 } }
fn negative(n: integer) -> integer { match n { -3..-1 | 5 => 1, _ => 0 } }

fn test_a_range_then_an_alternative() {
  assert(first(1) == 1 && first(2) == 1, "inside");
  assert(first(3) == 0, "3 is outside a half-open 1..3");
  assert(first(7) == 1, "the alternative 7");
  assert(first(4) == 0 && first(6) == 0, "4 and 6 are in neither");
}

fn test_an_alternative_then_an_inclusive_range() {
  assert(last(3) == 1 && last(7) == 1 && last(4) == 0, "7 | 1..=3");
}

fn test_constant_bounds_between_alternatives() {
  assert(middle(0) == 1 && middle(10) == 1 && middle(11) == 1, "0 and LO..HI");
  assert(middle(12) == 0 && middle(20) == 1 && middle(13) == 0, "HI excluded, 20 taken");
}

fn test_negative_bounds() {
  assert(negative(-3) == 1 && negative(-2) == 1 && negative(-1) == 0, "-3..-1");
  assert(negative(5) == 1 && negative(0) == 0, "the alternative 5");
}
