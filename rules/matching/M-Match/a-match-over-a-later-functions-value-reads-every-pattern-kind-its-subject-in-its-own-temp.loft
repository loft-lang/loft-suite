//
// A MATCH OVER A LATER FUNCTION'S VALUE READS EVERY PATTERN KIND, ITS SUBJECT IN A TEMP OF ITS OWN
// (`@FR-M-Match`; declarations in any order).  A subject from a function declared further down is
// evaluated once, into a temp of its own type, and every pattern kind reads it.  Two sections, each
// with its cells and receipt.
//
// ── a-match-over-a-later-function-reads-every-pattern-kind ──
//
// A MATCH OVER A LATER FUNCTION READS EVERY PATTERN KIND (`@FR-M-Match`; LOFT_DECLARATIONS.md
// § File structure: declarations in any order).  A subject that comes from a function declared
// LOWER in the file has no type on the first pass, and that pass read the arms as variant
// patterns only: a literal, a range, a string, a guarded capture or a slice arm was refused with
// `Expect token }` (loft#2522).  The same arms over a function declared above compiled.
//
// Axes it MOVES: the pattern kind (an integer, a negative integer, a range, a capture with a
// guard, a string, a slice with captures), the subject type (integer, text, vector), and a
// match nested in a slice arm.  Values hand-computed: `later_int(3)` is 30, `later_vec(3)` is
// `[8, 3]`, `later_int(8)` is 80, `later_text(3)` is "abc".
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: 821c91179 — interpret exit 1 -> 0, C exit 1 -> 0 (the control is the tree before
//   the cure, `skip_unresolved_pattern`)
// CHANNEL: the compile — the control tree refuses the file.
// ARMED: no instrument.
// WITNESS: each message prints the text the cell produced.
// HOLDS: every assertion passes on both backends on the cure tree.
//
// ── a-match-subject-from-a-later-function-keeps-its-own-temp ──
//
// @catches: LOFT_NO_JOIN_BUFFER_WITNESS — without the join buffer's witness the subject's temp and the buffer the match joins into are both released (`store #2 freed twice` in `nested_late`); this program checks the temp is released once.
//
// A MATCH SUBJECT FROM A LATER FUNCTION KEEPS ITS OWN TEMP (`@FR-M-Match`: the subject is
// evaluated once, into a temp of its own type).  A subject that comes from a function declared
// LOWER in the file has no type on the first pass, so that pass mints no temp for it, and the
// second pass does.  When the temps were numbered by a counter, the second pass's extra temp
// took the next match's first-pass name and type, and every later match moved one name along:
// a struct-enum read into an `integer` temp.  No part of the first match has to run (loft#2520).
// The control (`live_unwrap`) runs its match; its neighbour's temp has the same layout, which
// is why it passed before the cure.
//
// Axes it MOVES: the untyped subject's kind (an unwrapped struct-enum `x!`, a scalar, a plain
// enum), whether its match runs, and where the next match sits (after it, or nested in its arm).
// Values hand-computed: `make_b(3)` is `Pb { name: "bee", n: 21 }`; `later(3)` holds `[3, 4]`.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: c10d11b64 — interpret exit 139 -> 0, C exit 2 -> 0 (the control is the tree before
//   the cure, `Function::match_subject`)
// CHANNEL: the run (interpreter: a crash or a refused free) and the build (C refuses the
//   program: "an integer expected, a Ref found").
// ARMED: no instrument.
// WITNESS: each message prints the text the cell produced.
// HOLDS: the control cell reads the same before and after.

fn literal_arms(k: integer) -> text {
  match later_int(k) { 30 => "thirty", _ => "other" }
}

fn range_and_guard_arms(k: integer) -> text {
  match later_int(k) { -1 => "neg", 1..=29 => "low", n if n > 29 => "big {n}", _ => "?" }
}

fn string_arms(k: integer) -> text {
  match later_text(k) { "abc" => "is abc", _ => "not" }
}

fn slice_arms(k: integer) -> text {
  match later_vec(k) { [x, ..] => "head {x}", [] => "empty" }
}

fn nested_in_a_slice_arm(k: integer) -> text {
  match later_vec(k) {
    [p, q] => match later_int(p) { 80 => "eighty+{q}", _ => "x" },
    _ => "none"
  }
}

fn later_int(k: integer) -> integer { k * 10 }
fn later_vec(k: integer) -> vector<integer> { [k + 5, k] }
fn later_text(k: integer) -> text { "a{k * 0}bc".replace("0", "") }

fn test_a_match_over_a_later_function_reads_every_pattern_kind() {
  a = literal_arms(3);
  assert(a == "thirty", "a literal arm: {a}");
  b = range_and_guard_arms(3);
  assert(b == "big 30", "a range and a guarded capture: {b}");
  c = string_arms(3);
  assert(c == "is abc", "a string arm: {c}");
  d = slice_arms(3);
  assert(d == "head 8", "a slice arm: {d}");
  e = nested_in_a_slice_arm(3);
  assert(e == "eighty+3", "a match nested in a slice arm: {e}");
  println("a match over a later function reads every pattern kind: every cell holds");
}

enum A { Pa { items: vector<integer> }, Qa }
enum B { Pb { name: text, n: integer }, Qb }
enum C { Red, Green, Blue }

fn make_b(k: integer) -> B {
  if k > 0 { Pb { name: "bee", n: k * 7 } } else { Qb }
}

fn dead_unwrap(k: integer) -> text {
  x = later(k);
  if k < 0 {
    match x! { Pa { items } => { println("never {len(items)}"); }, _ => {} }
  }
  s = match make_b(k) { Pb { name, n } => "{name}:{n}", Qb => "qb" };
  t = match k + 1 { 4 => "four", _ => "other" };
  "{s} {t}"
}

fn live_unwrap(k: integer) -> text {
  x = later(k);
  c = 0;
  match x! { Pa { items } => { c = len(items) * 100 + items[1]; }, _ => {} }
  s = match make_b(k) { Pb { name, n } => "{name}:{n}", Qb => "qb" };
  "{c} {s}"
}

fn scalar_late(k: integer) -> text {
  a = match later_int(k) { _ => "any" };
  s = match make_b(k) { Pb { name, n } => "{name}:{n}", Qb => "qb" };
  "{a} {s}"
}

fn plain_late(k: integer) -> text {
  a = match later_c(k) { Red => "red", Green => "green", Blue => "blue" };
  s = match make_b(k) { Pb { name, n } => "{name}:{n}", Qb => "qb" };
  "{a} {s}"
}

fn nested_late(k: integer) -> text {
  r = "";
  match later(k)! {
    Pa { items } => {
      r = match make_b(items[0]) { Pb { name, n } => "{name}:{n}", Qb => "qb" };
    },
    _ => {}
  }
  t = match k * 2 { 6 => "six", _ => "other" };
  "{r} {t}"
}

fn later(k: integer) -> A? { Pa { items: [k, k + 1] } }
fn later_c(k: integer) -> C { if k == 3 { Green } else { Red } }

fn test_a_match_subject_from_a_later_function_keeps_its_own_temp() {
  r1 = dead_unwrap(3);
  assert(r1 == "bee:21 four", "a dead match over `x!`: {r1}");
  r2 = live_unwrap(3);
  assert(r2 == "204 bee:21", "the control, run: {r2}");
  r3 = scalar_late(3);
  assert(r3 == "any bee:21", "a scalar subject: {r3}");
  r5 = plain_late(3);
  assert(r5 == "green bee:21", "a plain-enum subject: {r5}");
  r6 = nested_late(3);
  assert(r6 == "bee:21 six", "a match nested in the arm: {r6}");
  println("a match subject from a later function keeps its own temp: every cell holds");
}
