//
// `@FR-P-Cursor` — the cursor reading belongs to the PATTERNS of the match whose subject is the
// cursor.  A `match` written in one of its arm bodies is a match of its own: a plain vector
// there is matched whole from index 0, and a cursor match there reads (and advances) only its
// own subject — the outer match's later arms keep the cursor reading (loft#2322: both answered
// wrong, with no diagnostic, because the mode was set for the whole outer match and cleared by
// the inner one).
//
// Axes this file MOVES:  what the inner match is over (a plain vector, the same cursor, a second
//                        cursor); which outer arm commits (the one holding the inner match, a
//                        later one); the cursor's start position (0, past a token); the inner
//                        match's own outcome (hit, miss).
// Axes it HOLDS FIXED:   unit and field variants as elements; no guard (a cursor arm takes
//                        none); no sub-rule.
// @falsified-at: 0e95172cd — interpret exit 1 -> 0, interpret 3 assertion failures -> 0, native exit 1 -> 0, native 6 assertion failures -> 0
enum Tok { Num { v: integer }, LP, RP, End }
struct Cur { src: vector<Tok>, pos: integer }

// c1: a plain vector match in a cursor arm body — whole-matched from index 0.
fn plain_inside(c: Cur) -> integer {
  match c {
    [LP] => {
      w = [7, 8, 9];
      match w { [a, b, c3] => a * 100 + b * 10 + c3, _ => -1 }
    },
    [RP] => 2,
    _ => 3
  }
}

// c2: a cursor match on the same cursor in an arm body; the later outer arms stay cursor arms.
fn same_cursor_inside(c: Cur) -> integer {
  match c {
    [LP] => match c { [Num { v }] => v, _ => -1 },
    [RP] => 2,
    _ => 3
  }
}

// c3: a cursor match over a SECOND cursor in an arm body advances that cursor only.
fn other_cursor_inside(c: Cur, d: Cur) -> integer {
  match c {
    [LP] => match d { [Num { v }, Num { v: w }] => v * 10 + w, _ => -1 },
    [RP] => 2,
    _ => 3
  }
}

fn test_a_plain_vector_match_in_an_arm_body_is_matched_whole() {
  c = Cur { src: [End, LP, RP], pos: 1 };
  r = plain_inside(c);
  assert(r == 789 && c.pos == 2, "c1 inner whole match: {r} at {c.pos}");
  r2 = plain_inside(c);
  assert(r2 == 2 && c.pos == 3, "c1 later arm: {r2} at {c.pos}");
}

fn test_a_cursor_match_in_an_arm_body_leaves_the_later_arms_cursor_arms() {
  c = Cur { src: [RP, RP], pos: 0 };
  r = same_cursor_inside(c);
  assert(r == 2 && c.pos == 1, "c2 later arm still prefix-reads: {r} at {c.pos}");
  e = Cur { src: [LP, Num { v: 5 }, End], pos: 0 };
  r2 = same_cursor_inside(e);
  assert(r2 == 5 && e.pos == 2, "c2 inner hit consumes on: {r2} at {e.pos}");
  f = Cur { src: [LP, End], pos: 0 };
  r3 = same_cursor_inside(f);
  assert(r3 == -1 && f.pos == 1, "c2 inner miss leaves the outer advance: {r3} at {f.pos}");
}

fn test_a_second_cursor_in_an_arm_body_is_advanced_alone() {
  c = Cur { src: [LP, RP], pos: 0 };
  d = Cur { src: [End, Num { v: 4 }, Num { v: 6 }], pos: 1 };
  r = other_cursor_inside(c, d);
  assert(r == 46 && c.pos == 1 && d.pos == 3, "c3: {r}, c at {c.pos}, d at {d.pos}");
  r2 = other_cursor_inside(c, d);
  assert(r2 == 2 && c.pos == 2 && d.pos == 3, "c3 later arm: {r2}, c at {c.pos}, d at {d.pos}");
}
