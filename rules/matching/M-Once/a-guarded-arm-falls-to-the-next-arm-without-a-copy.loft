//
// `@FR-M-Once` — a match is lowered once per arm: a guarded arm's guard is part of its own
// condition, and a failed guard reaches the next arm through control flow, never through a copy
// of the arms after it.  `@FR-P-Guard` and `@FR-P-Atomic` are what the values check: a false
// guard moves selection to the next arm, and leaves nothing a later arm can see.  The lowering
// itself (one subject test per arm at every guard count) is pinned by `tests/match_once.rs` in
// the loft repo; these cells say the folded lowering answers what the copying one answered, for
// every kind of binding a guard can read — a scalar, a text payload, a record payload, a
// `..rest` slice — and for an eight-arm match with 0, 3 and 6 guarded arms over every subject.
// Every value is worked out by hand, or (the eight-arm half) by the model written beside it.
//
// @ARMED: LOFT_STRICT_STORES=1
// @falsified-at: b0d867b4e — interpret exit 134 -> 0; native INERT (expected: the slot it
//   names is the interpreter's).  The control is the folded lowering before its bindings were
//   pre-initialised on every path: the last cell (`sub2` then `shared2`) aborts there in a free of
//   a slot the earlier call left a text in.  The other cells are the VALUE half of the change —
//   the copying lowering answers the same values — and `tests/match_once.rs` its SIZE half, which
//   reads 191 subject tests on the copying lowering where it wants 8.
//   CHANNEL: exit — the interpreter's abort; value — every assertion, on both backends.
//   ARMED: `LOFT_STRICT_STORES=1`, because the folded lowering first writes a binding inside a
//   condition, and a binding released before its body reads it shows only there.
//   WITNESS: interpret exit 134 at b0d867b4e.
//   HOLDS: every cell passes here on both backends; leak and panic clean.

enum C { A, B, D, E, F }
enum S { P { x: integer }, Q { y: integer }, R }
enum T { W { s: text }, N { v: integer } }
struct Pt { x: integer, y: integer }
enum H { Bx { p: Pt }, Em }

fn plain(c: C, n: integer) -> integer {
  match c {
    A if n > 5 => 1,
    A | B => 2,
    D => { n += 1; 3 }
    E if n < 0 => 4,
    _ => 5,
  }
}

fn ints(i: integer) -> integer {
  match i {
    0 => 10,
    1 | 2 => 20,
    3 if i > 100 => 30,
    4..=7 => 40,
    _ => 50,
  }
}

fn payload(s: S) -> integer {
  match s {
    P { x } if x > 3 => x,
    P { x: 1 } => 100,
    Q { y } => y,
    _ => 0,
  }
}

fn tw(t: T) -> text {
  match t {
    W { s } if len(s) > 1 => s,
    W { s } => "short:{s}",
    _ => "n",
  }
}

fn texts() -> text {
  out = "";
  for w in ["ab", "c", "xyz"] {
    // Bound first: the same call inline in the value `if` does not compile on `--native`
    // (loft#2225), which is not what this cell measures.
    t = tw(W { s: w });
    out += if out == "" { t } else { " " + t };
  }
  out
}

fn sl(v: vector<integer>) -> integer {
  match v {
    [a, ..r] if len(r) > 1 => len(r) * 10 + a,
    [a, ..r] => a + 100 + len(r) * 0,
    _ => -1,
  }
}

fn slices() -> text {
  out = "";
  for v in [[1, 2, 3], [5, 6], []] {
    out += "{sl(v)} ";
  }
  out
}

fn rec(h: H) -> integer {
  match h {
    Bx { p } if p.x > 0 => p.x + p.y,
    Bx { p } => -p.y,
    _ => 0,
  }
}

fn scal(s: S) -> integer {
  match s {
    P { x } if x > 3 => { y = x * 2; x + y }
    _ => 0,
  }
}

fn stmt(n: integer) -> integer {
  hits = 0;
  for i in 0..n {
    c = if i % 3 == 0 { A } else if i % 3 == 1 { B } else { E };
    match c {
      A if i > 5 => { return i * 1000 + hits; }
      B => { hits += 1; }
      _ => {}
    }
  }
  hits
}

// The hand-computed cells: guards on arms 1 and 4; a guard on a literal, an or-pattern and a
// range; a payload guard then a literal sub-pattern; a text payload read in the body, in a
// loop; a `..rest` slice in a loop; a record payload; a scalar binding beside a body local; a
// guarded arm that returns from inside a loop.
fn test_guarded_arms_answer_what_the_rules_say() {
  assert("{plain(A, 9)} {plain(A, 1)} {plain(D, 1)} {plain(E, -1)} {plain(E, 1)} {plain(B, 0)} {plain(F, 0)}" == "1 2 3 4 5 2 5", "plain");
  assert("{ints(2)} {ints(3)} {ints(6)} {ints(0)} {ints(9)}" == "20 50 40 10 50", "ints");
  assert("{payload(P { x: 5 })} {payload(P { x: 1 })} {payload(P { x: 2 })} {payload(Q { y: 7 })} {payload(R)}" == "5 100 0 7 0", "payload");
  assert(texts() == "ab short:c xyz", "texts: {texts()}");
  assert(slices() == "21 105 -1 ", "slices: {slices()}");
  assert("{rec(Bx { p: Pt { x: 3, y: 4 } })} {rec(Bx { p: Pt { x: -1, y: 6 } })} {rec(Em)}" == "7 -6 0", "rec");
  assert("{scal(P { x: 5 })} {scal(P { x: 2 })}" == "15 0", "scal");
  assert("{stmt(5)} {stmt(9)}" == "2 6002", "stmt");
}

// `@FR-P-Atomic`: a binding that shadows an outer local and fails its guard leaves the later arm
// reading the outer value; a `..rest` materialised by a failed guarded arm leaves the next arm
// binding its own.
fn shadow(s: S) -> integer {
  x = 5;
  match s {
    P { x } if x > 100 => x,
    _ => x,
  }
}

fn rest_len(v: vector<integer>) -> integer {
  match v {
    [a, ..r] if a > 100 => len(r) * 1000,
    [a, ..r] => len(r) + a * 0,
    _ => -1,
  }
}

fn test_a_failed_guard_leaves_nothing_behind() {
  assert(shadow(P { x: 9 }) == 5, "the outer x: {shadow(P { x: 9 })}");
  assert(rest_len([1, 2, 3, 4]) == 3, "the second arm's own rest: {rest_len([1, 2, 3, 4])}");
}

enum E8 { V0, V1, V2, V3, V4, V5, V6, V7 }

fn e0(e: E8, x: integer) -> integer {
  match e {
    V0 => 0,
    V1 => 1,
    V2 => 2,
    V3 => 3,
    V4 => 4,
    V5 => 5,
    V6 => 6,
    V7 => 7,
    _ => 99,
  }
}

fn e3(e: E8, x: integer) -> integer {
  match e {
    V0 if x > 0 => 0,
    V1 if x > 1 => 1,
    V2 if x > 2 => 2,
    V3 => 3,
    V4 => 4,
    V5 => 5,
    V6 => 6,
    V7 => 7,
    V0 | V1 | V2 => 88,
    _ => 99,
  }
}

fn e6(e: E8, x: integer) -> integer {
  match e {
    V0 if x > 0 => 0,
    V1 if x > 1 => 1,
    V2 if x > 2 => 2,
    V3 if x > 3 => 3,
    V4 if x > 4 => 4,
    V5 if x > 5 => 5,
    V6 => 6,
    V7 => 7,
    V0 | V1 | V2 => 88,
    _ => 99,
  }
}

// 0 guarded arms; a failed guard on V0..V2 falls to the shared arm (88), on V3.. to `_` (99).
fn test_eight_arms_with_0_guards() {
  got = "{e0(V0, -1)} {e0(V0, 3)} {e0(V0, 9)} {e0(V1, -1)} {e0(V1, 3)} {e0(V1, 9)} {e0(V2, -1)} {e0(V2, 3)} {e0(V2, 9)} {e0(V3, -1)} {e0(V3, 3)} {e0(V3, 9)} {e0(V4, -1)} {e0(V4, 3)} {e0(V4, 9)} {e0(V5, -1)} {e0(V5, 3)} {e0(V5, 9)} {e0(V6, -1)} {e0(V6, 3)} {e0(V6, 9)} {e0(V7, -1)} {e0(V7, 3)} {e0(V7, 9)}";
  assert(got == "0 0 0 1 1 1 2 2 2 3 3 3 4 4 4 5 5 5 6 6 6 7 7 7", "e0: {got}");
}

// 3 guarded arms; a failed guard on V0..V2 falls to the shared arm (88), on V3.. to `_` (99).
fn test_eight_arms_with_3_guards() {
  got = "{e3(V0, -1)} {e3(V0, 3)} {e3(V0, 9)} {e3(V1, -1)} {e3(V1, 3)} {e3(V1, 9)} {e3(V2, -1)} {e3(V2, 3)} {e3(V2, 9)} {e3(V3, -1)} {e3(V3, 3)} {e3(V3, 9)} {e3(V4, -1)} {e3(V4, 3)} {e3(V4, 9)} {e3(V5, -1)} {e3(V5, 3)} {e3(V5, 9)} {e3(V6, -1)} {e3(V6, 3)} {e3(V6, 9)} {e3(V7, -1)} {e3(V7, 3)} {e3(V7, 9)}";
  assert(got == "88 0 0 88 1 1 88 2 2 3 3 3 4 4 4 5 5 5 6 6 6 7 7 7", "e3: {got}");
}

// 6 guarded arms; a failed guard on V0..V2 falls to the shared arm (88), on V3.. to `_` (99).
fn test_eight_arms_with_6_guards() {
  got = "{e6(V0, -1)} {e6(V0, 3)} {e6(V0, 9)} {e6(V1, -1)} {e6(V1, 3)} {e6(V1, 9)} {e6(V2, -1)} {e6(V2, 3)} {e6(V2, 9)} {e6(V3, -1)} {e6(V3, 3)} {e6(V3, 9)} {e6(V4, -1)} {e6(V4, 3)} {e6(V4, 9)} {e6(V5, -1)} {e6(V5, 3)} {e6(V5, 9)} {e6(V6, -1)} {e6(V6, 3)} {e6(V6, 9)} {e6(V7, -1)} {e6(V7, 3)} {e6(V7, 9)}";
  assert(got == "88 0 0 88 1 1 88 2 2 99 99 3 99 99 4 99 99 5 6 6 6 7 7 7", "e6: {got}");
}

// A multi-pattern arm whose second pattern binds a text through a field sub-pattern, which the
// folded lowering writes inside the arm's condition: the binding's slot must be initialised on
// the first pattern's path too, or the free at the match's end releases whatever an earlier
// call left in that slot.  The earlier call is `sub2`, a match of the same subject type whose
// own bindings occupy those slots.  Values by hand.
enum Sub2 { Sp2 { x: integer }, Sq2 { y: text } }
enum Rec2 { Ra2 { u: integer }, Rs2 { i: Sub2, k: integer }, Ry2 { y: text } }

fn sub2(r: Rec2) -> text { match r { Ra2 { u }, Rs2 { i: Sp2 { x }, k } => "{u ?? -1}:{x ?? -2}:{k ?? -3}", _ => "o" } }
fn shared2(r: Rec2) -> text { match r { Ry2 { y }, Rs2 { i: Sq2 { y } } => "[{y}]", _ => "o" } }

fn test_a_text_bound_in_a_folded_condition_is_initialised_on_every_path() {
  a = "{sub2(Ra2 { u: 3 })}";
  b = "{shared2(Ry2 { y: "a" })}";
  c = "{shared2(Rs2 { i: Sq2 { y: "b" }, k: 0 })} {shared2(Ra2 { u: 1 })}";
  assert("{a} {b} {c}" == "3:-2:-3 [a] [b] o", "got {a} {b} {c}");
}
