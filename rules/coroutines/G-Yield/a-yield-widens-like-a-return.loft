//
// `@FR-G-Yield` crossed with `@FR-C-Int`: a `yield v` is a store of v into the iterator's
// element type, so a narrower integer widens into it exactly as it would into a return type —
// a `u8` local, a `u16` field and an `i8` element into `iterator<integer>`, and a `u8` into
// `iterator<u16>` — and the consumer reads the value unchanged, the sign of a negative `i8`
// included.
//
// CHANNEL: the assertions and the leak gate.
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.

struct P { b: u8, w: u16 }

fn widen(p: P, xs: vector<i8>) -> iterator<integer> {
  l: u8 = 200;
  yield l;
  yield p.w;
  yield p.b;
  for x in xs { yield x; }
}

fn into_u16() -> iterator<u16> {
  q: u8 = 250;
  yield q;
  yield 65535;
}

fn test_a_narrow_integer_widens_into_the_element() {
  s = "";
  n = 0;
  for v in widen(P { b: 7, w: 60000 }, [-5, 127]) { s += "{v} "; n += 1; }
  assert(s == "200 60000 7 -5 127 " && n == 5, "widened: {s} ({n})");
}

fn test_a_narrow_integer_widens_into_a_wider_narrow_element() {
  t = 0;
  for v in into_u16() { t += v; }
  assert(t == 65785, "u8 into u16: {t}");
}

fn test_the_sum_of_widened_negatives() {
  g = widen(P { b: 1, w: 2 }, [-100, -28]);
  total = 0;
  for v in g { total += v; }
  assert(total == 200 + 2 + 1 - 100 - 28, "total: {total}");
}
