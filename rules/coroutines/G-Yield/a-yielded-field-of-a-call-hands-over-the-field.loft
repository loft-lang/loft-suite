//
// A YIELDED FIELD OF A CALL HANDS OVER THE FIELD (`@FR-G-Yield`).  `yield box(c, h).n` reads a
// field of a call's record: the call is lifted ahead of the read, so the yielded value is the
// read wrapped with that preamble.  The interpreter sized the yield by the wrapper, which
// answers nothing, so it handed over no bytes and the value stayed on the generator's stack —
// the next instruction read garbage (SIGSEGV in `OpAppendText`, an abort in `OpFormatInt`).
// A yielded BLOCK that builds a text before its value read as void the same way (its last
// statement is the text's release).  The C backend was right.  Each generator yields such a read: an integer field and a text
// field of a call answering its argument, a field of a fresh record, a whole record, and a
// yield inside a loop.
// Values by hand: gt yields "x" then "e"; gw 4; gl 5 + 6 + 7 = 18; gf 7 + 8 = 15; 37 in all,
// and box runs once per yield: 1 + 1 + 3 + 2 = 7 calls.
// @falsified-by: tests/falsified/a-yielded-field-of-a-call-hands-over-the-field.patch — interpret exit 134 -> 0; native INERT (expected for a
//   backend-divergence guard — only one side can move)
// @falsified-by: tests/falsified/a-yielded-block-that-builds-a-temporary-hands-over-its-value.patch — interpret exit 139 -> 0; native INERT (expected for a
//   backend-divergence guard — only one side can move)
// CHANNEL: the run's exit (the crash) and the assertions.

struct W { n: integer, t: text }
struct Hold { ws: vector<W> }
struct Ctr { calls: integer = 0, log: text = "" }

fn box(c: Ctr, h: Hold) -> W { c.calls += 1; h.ws[0] }
fn mkw(c: Ctr, n: integer) -> W { c.calls += 1; W { n: n, t: "w{n}" } }
fn gt(c: Ctr, h: Hold) -> iterator<text> { yield box(c, h).t; yield "e"; }
fn gw(c: Ctr) -> iterator<W> { yield mkw(c, 4); }
fn gl(c: Ctr, h: Hold) -> iterator<integer> { for k in 0..3 { yield box(c, h).n + k; } }
fn gf(c: Ctr) -> iterator<integer> { yield mkw(c, 7).n; yield mkw(c, 8).n; }
fn gi(c: Ctr, h: Hold) -> iterator<integer> { yield box(c, h).n; }
fn gb(c: Ctr) -> iterator<integer> { yield { c.calls += 1; c.log += "S"; 1 }; yield 3; }

fn test_each_yield_hands_over_the_field() {
  c = Ctr {};
  h = Hold { ws: [W { n: 5, t: "x" }] };
  s = "";
  for t in gt(c, h) { s += t; }
  n = 0;
  for w in gw(c) { n += w.n; }
  for k in gl(c, h) { n += k; }
  for k in gf(c) { n += k; }
  assert(s == "xe" && n == 37 && c.calls == 7, "{s} {n} {c.calls}");
}

fn test_the_only_yield() {
  c = Ctr {};
  h = Hold { ws: [W { n: 5, t: "x" }] };
  n = 0;
  for k in gi(c, h) { n += k; }
  assert(n == 5 && c.calls == 1, "{n} {c.calls}");
}

fn test_a_yielded_block_that_builds_a_text() {
  // The block's last statement is the release of its text temporary; the yield still hands
  // over the integer it computed: 1 then 3.
  c = Ctr {};
  n = 0;
  for k in gb(c) { n += k; }
  assert(n == 4 && c.calls == 1 && c.log == "S", "{n} {c.calls} {c.log}");
}
