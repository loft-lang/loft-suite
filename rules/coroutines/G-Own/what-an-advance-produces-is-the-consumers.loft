//
// WHAT AN ADVANCE PRODUCES IS THE CONSUMER'S (`@FR-G-Own`, with `@FR-L-CapOwn`).  `next(g)` is a call, and
// a call's result is fresh: a yielded record, struct enum or vector is the consumer's (loft#1589); a
// generator hands over a record literal, a call's record, a tuple holding a record and a lambda with
// a capture alike; and a yielded lambda keeps its own copy of every heap value it captured, copied
// into a store its closure record owns at the yield.  Three sections, each with its cells and receipt.
//
// ── 1589-a-yielded-record-is-the-consumers ──
//
// loft#1589, `@FR-G-Own` — WHAT AN ADVANCE PRODUCES IS THE CONSUMER'S.  `next(g)` is a call, and a
// call's result is fresh (`formal/heap.md` `(H-Move)`), so a yielded record, struct-enum or
// vector moves into whatever binds it and the generator keeps no hold on it: a record built in
// place or by a call is handed over, and an existing value — a local, a parameter, a member — is
// copied first, so a later change in the generator does not reach the consumer's value.
//
// A tuple of those hands over each member the same way.
//
// Before, nothing said who owned a yielded record and the backends disagreed.  The interpreter
// released it with the generator, so a record returned past its generator's life read `null`;
// `--native` handed it over and a drained `for` then released nothing, leaking every yield; a
// yielded call result leaked on both; a consumer's value changed when the generator later wrote
// the local it had yielded; and a `match` over a generator ran its records' drop hooks before
// the arm read them (interpreter) or never (native).  A tuple yield of a local was a second
// name for it on both backends, and a tuple `for` ran no member's hook.
//
// Every expected value, trace and drop order is worked out by hand from the rule.  The drop
// hook writes a trace FILE, as `139-drop-cascade.loft` does and for its reason.  A loop-body
// yield and a `yield from` ran EAGERLY on `--native` when this file was written (every value
// made before the first is read), so those two cells assert what the rule fixes — the values,
// and one release per record — rather than the interleaving.  Both are lazy since loft#1798;
// `a-record-yielded-from-a-loop-is-handed-over-lazily` pins a record loop's order.
//
// @falsified-at: 516587d5c — interpret exit 1 -> 0, native exit 1 -> 0, native 1 assertion failures
//   -> 0 (LOFT_STRICT_STORES=1 make falsify …)
// CHANNEL: interpret — the strict-store census stops the run; native — an assertion.
// ARMED: LOFT_STRICT_STORES=1.
// WITNESS: interpret — `USE AFTER FREE (read) store #2 type=main_vector<P>` at c1, the record read
//   after its generator released it; native — `c2 trace: m1,r1,m2,r2,m3,r3, want
//   m1,r1,d1,m2,r2,d2,m3,r3,d3`, a drained `for` that released nothing.
// HOLDS: the tuple cell `c14` is a control, right before and after.
//
// ── a-generator-hands-its-records-and-lambdas-to-the-consumer ──
//
// `@FR-G-Own` — a generator yielding a value the consumer takes over (`formal/coroutines.md`): a
// record literal, a call's record, a vector, a tuple holding a record, a lambda with a capture;
// and one abandoned after its first value.  Each expected value is computed by hand.  The
// surveys of the loft bytecode writer and runner read it too: there the generator must forget
// the temps holding what it hands over, or the consumer's release frees a store twice.
//
// @falsified-at: hand-measured (2026-11-15, f1feb2e4b) — on the loft writer's code
// (`run_image_survey.py --written` reads this file) with `bgen_yield.loft`'s forgetting of the
// handed temps removed, the runner stopped "a store was freed twice"; the Rust build answers
// the same before and after that change, so `falsify.sh` against a Rust ref has no channel here.
//
// ── a-yielded-lambda-keeps-its-copy-of-a-captured-vector ──
//
// A YIELDED LAMBDA KEEPS ITS COPY OF A CAPTURED VECTOR (`@FR-G-Own`, `@FR-L-CapOwn`).  Every heap
// value a yielded lambda captures is copied into a store the closure record owns, at the yield:
// the generator's later growth and element write of the local do not reach the first lambda,
// while the second lambda, yielded after them, copies the changed vector.  Read whether the
// consumer calls them during the drain or holds both and calls them after.
//
// @falsified-at: none — a conformance guard at a rule pairing no guard named together; every cell
//   answered as the rule says on both backends on the tree it landed on.
// CHANNEL: the asserts, and the leak gate for the closure records' stores.
// ARMED: no instrument.
// WITNESS: each message names the two hand-computed answers.
// HOLDS: every cell on both backends, leak-clean.

fn trace_path() -> text { return "loft_1589_yield_trace.tmp"; }

fn note(s: text) {
  f = file(trace_path());
  cur = f.content() ?? "";
  if cur != "" { cur += ","; }
  cur += s;
  bytes: vector<u8> = [];
  for c in cur { bytes += [c as u8 ?? 0]; }
  if !write_bytes(trace_path(), bytes) { println("trace write failed"); }
}

fn drain() -> text {
  f = file(trace_path());
  cur = f.content() ?? "";
  empty: vector<u8> = [];
  if !write_bytes(trace_path(), empty) { println("trace clear failed"); }
  return cur;
}

fn ok(nm: text, got: text, want: text) {
  assert(got == want, "{nm}: {got}, want {want}");
}

struct H { id: integer }
fn OpDrop(self: H) { note("d{self.id}"); }
fn mk(id: integer) -> H { note("m{id}"); return H { id: id }; }

struct P { id: integer }
struct T { id: integer, name: text }
struct S { p: P, k: integer }
enum E { A { h: H }, B }

// 1 — a record returned past its generator's life (the interpreter read `null`).
fn e_gen() -> iterator<E> { yield A { h: H { id: 1 } }; yield A { h: H { id: 2 } }; yield B; }
fn c1_take() -> E {
  g = e_gen();
  first = next(g) ?? B;
  first
}
fn c1() -> text {
  first = c1_take();
  junk = [P { id: 77 }, P { id: 88 }, P { id: 99 }];
  got = match first { A { h } => h.id, B => -1 };
  "{got}{len(junk)}"
}

// 2 — a drained `for` over call results: each record is released when ITS iteration ends.
fn calls() -> iterator<H> { yield mk(1); yield mk(2); yield mk(3); }
fn c2() -> text { n = 0; for e in calls() { note("r{e.id}"); n += 1; } "{n}" }

// 3 — a `break`: what was read is released; nothing is made after it.
fn c3() -> text { for e in calls() { note("r{e.id}"); if e.id == 2 { break; } } "" }

// 4 — a `match` over a generator collects it first: the buffer owns the records, so the hooks
//     run after the arm reads, once each, when the buffer goes.
fn c4_m() -> integer { match e_gen() { [A { h }, ..] => { note("read"); h.id }, _ => 0 } }
fn c4() -> text { "{c4_m()}" }

// 5 — a yielded LOCAL is copied: the generator's later write does not reach the consumer.
fn local_gen() -> iterator<P> { x = P { id: 1 }; yield x; x.id = 5; yield x; }
fn c5() -> text { g = local_gen(); p = next(g) ?? P { id: 0 }; q = next(g) ?? P { id: 0 }; "{p.id}{q.id}" }

// 6 — a yielded MEMBER is copied the same way.
fn member_gen() -> iterator<P> { s = S { p: P { id: 6 }, k: 1 }; yield s.p; s.p.id = 7; yield s.p; }
fn c6() -> text { g = member_gen(); a = next(g) ?? P { id: 0 }; b = next(g) ?? P { id: 0 }; "{a.id}{b.id}" }

// 7 — a yielded PARAMETER is copied: the consumer's write does not reach the caller's value.
fn param_gen(p: P) -> iterator<P> { yield p; yield p; }
fn c7() -> text { h = P { id: 4 }; s = 0; for e in param_gen(h) { s += e.id; e.id = 99; } "{s}{h.id}" }

// 8 — two results live at once, released in reverse order of binding.
fn two() -> iterator<H> { yield mk(1); yield mk(2); }
fn c8_run() { g = two(); a = next(g) ?? H { id: 0 }; b = next(g) ?? H { id: 0 }; note("r{a.id}{b.id}"); }
fn c8() -> text { c8_run(); "" }

// 9 — a loop-body yield: the values, one release each.
fn looped() -> iterator<H> { for i in 1..4 { yield mk(i); } }
fn c9() -> text { s = 0; for e in looped() { s += e.id; } "{s}" }

// 10 — `yield from` hands each of the inner generator's values on.
fn inner() -> iterator<H> { yield mk(21); yield mk(22); }
fn outer() -> iterator<H> { yield mk(20); yield from inner(); yield mk(23); }
fn c10() -> text { s = 0; for e in outer() { s += e.id; } "{s}" }

// 11 — a record holding a TEXT: the copy is deep.
fn text_gen() -> iterator<T> { x = T { id: 1, name: "one" }; yield x; x.name = "uno"; yield x; yield T { id: 3, name: "tres{x.id}" }; }
fn c11() -> text { out = ""; for e in text_gen() { out += "{e.id}{e.name},"; } out }

// 12 — a VECTOR yield: the local is copied, the literal handed over.
fn vec_gen() -> iterator<vector<integer>> { v = [1, 2]; yield v; v += [3]; yield v; yield [7, 8, 9, 10]; }
fn c12() -> text { g = vec_gen(); a = next(g); b = next(g); c = next(g); "{len(a)}{len(b)}{len(c)}{a[0]}{c[3]}" }

// 13 — a stored handle advanced by `next` and then drained by a `for`.
fn c13_run() { g = calls(); a = next(g) ?? H { id: 0 }; for e in g { note("r{e.id}"); } note("a{a.id}"); }
fn c13() -> text { c13_run(); "" }

// 14 — CONTROL: a tuple of a fresh record, right before and after.
fn tuple_gen() -> iterator<(integer, P)> { yield (1, P { id: 10 }); yield (2, P { id: 20 }); }
fn c14() -> text { s = 0; for t in tuple_gen() { s += t.0 + t.1.id; } "{s}" }

// 15 — a TUPLE of a local: its member is copied like the local itself (it read 5 and 5).
fn tuple_local() -> iterator<(integer, P)> { x = P { id: 1 }; yield (1, x); x.id = 5; yield (2, x); }
fn c15() -> text { g = tuple_local(); a = next(g); b = next(g); "{a.1.id}{b.1.id}" }

// 16 — a tuple `for`: each member's hook runs when its iteration ends.
fn tuple_calls() -> iterator<(integer, H)> { yield (1, mk(1)); yield (2, mk(2)); }
fn c16() -> text { for t in tuple_calls() { note("r{t.1.id}"); } "" }

// 17 — a tuple returned past its generator's life.
fn c17_take() -> (integer, P) { g = tuple_gen(); a = next(g); a }
fn c17() -> text { a = c17_take(); junk = [P { id: 77 }, P { id: 88 }]; "{a.1.id}{len(junk)}" }

fn test_a_yielded_record_is_the_consumers() {
  drain();
  ok("c1 returned past the generator", c1(), "13");
  ok("c1 trace      ", drain(), "d1");
  ok("c2 value      ", c2(), "3");
  ok("c2 trace      ", drain(), "m1,r1,d1,m2,r2,d2,m3,r3,d3");
  ok("c3 value      ", c3(), "");
  ok("c3 trace      ", drain(), "m1,r1,d1,m2,r2,d2");
  ok("c4 value      ", c4(), "1");
  ok("c4 trace      ", drain(), "read,d1,d2");
  ok("c5 local copy ", c5(), "15");
  ok("c6 member copy", c6(), "67");
  ok("c7 param copy ", c7(), "84");
  ok("c8 value      ", c8(), "");
  ok("c8 trace      ", drain(), "m1,m2,r12,d2,d1");
  ok("c9 loop yield ", c9(), "6");
  t9 = drain();
  ok("c9 one release", "{len(t9)}", "17");
  ok("c10 yield from", c10(), "86");
  t10 = drain();
  ok("c10 one release", "{len(t10)}", "31");
  ok("c11 text copy ", c11(), "1one,1uno,3tres1,");
  ok("c12 vectors   ", c12(), "234110");
  ok("c13 value     ", c13(), "");
  ok("c13 trace     ", drain(), "m1,m2,r2,d2,m3,r3,d3,a1,d1");
  ok("c14 tuples    ", c14(), "33");
  ok("c15 tuple copy", c15(), "15");
  ok("c16 value     ", c16(), "");
  ok("c16 trace     ", drain(), "m1,r1,d1,m2,r2,d2");
  ok("c17 tuple kept", c17(), "102");
  delete(trace_path());
  println("a yielded record is the consumer's: every cell holds");
}

struct S2P { x: integer, name: text }

fn s2_mk(i: integer) -> S2P { S2P { x: i * 10, name: "m{i}" } }

fn lits(n: integer) -> iterator<S2P> {
  for i in 0..n { yield S2P { x: i, name: "p{i}" }; }
}

fn s2_calls(n: integer) -> iterator<S2P> {
  for i in 0..n { yield s2_mk(i); }
}

fn vecs(n: integer) -> iterator<vector<integer>> {
  for i in 0..n { yield [i, i + 1, i * i]; }
}

fn pairs(n: integer) -> iterator<(integer, S2P)> {
  for i in 0..n { yield (i + 100, s2_mk(i)); }
}

fn adders(n: integer) -> iterator<fn(integer) -> integer> {
  for i in 0..n {
    k = i * 7;
    yield fn(x: integer) -> integer { x + k };
  }
}

fn test_a_generator_hands_its_records_and_lambdas_to_the_consumer() {
  s = "";
  for p in lits(3) { s += "{p.x}:{p.name} "; }
  assert(s == "0:p0 1:p1 2:p2 ", "literals: {s}");
  s = "";
  for p in s2_calls(3) { s += "{p.x}:{p.name} "; }
  assert(s == "0:m0 10:m1 20:m2 ", "s2_calls: {s}");
  s = "";
  for v in vecs(3) { s += "{v} "; }
  assert(s == "[0,1,0] [1,2,1] [2,3,4] ", "vectors: {s}");
  s = "";
  for t in pairs(2) { s += "{t.0}/{t.1.name} "; }
  assert(s == "100/m0 101/m1 ", "tuples: {s}");
  s = "";
  for f in adders(3) { s += "{f(1)} "; }
  assert(s == "1 8 15 ", "lambdas: {s}");
  s = "";
  for p in s2_calls(5) { s += "first {p.name} "; break; }
  assert(s == "first m0 ", "abandoned: {s}");
  println("ok");
}

fn makers() -> iterator<fn() -> integer> {
  v = [1, 2];
  yield fn() -> integer { len(v) * 10 + v[0] };
  v += [3];
  v[0] = 7;
  yield fn() -> integer { len(v) * 10 + v[0] };
  v += [4];
}

fn test_called_during_the_drain() {
  r = "";
  for f in makers() { r += "{f()} "; }
  // [1, 2] -> 2 * 10 + 1 = 21; [7, 2, 3] -> 3 * 10 + 7 = 37.
  assert(r == "21 37 ", "21 37: {r}");
}

fn test_held_and_called_after_the_generator_moved_on() {
  g = makers();
  a = next(g);
  b = next(g);
  // `a` was copied before `v += [3]; v[0] = 7` ran, so it still answers 21.
  assert(a() == 21 && b() == 37, "21 37: {a()} {b()}");
}
