//
// A MOVED GENERATOR IS NOT READ AGAIN, HOWEVER IT WAS MOVED (`@FR-G-Hold`, loft#2043).  A generator
// moved into a holder — a plain bind, a field, a struct literal, a tuple — belongs to that holder;
// reading the moved-from name afterwards is refused at compile time.  Each section is one refusal
// with its expectation and receipt.
//
// ── 2043-a-moved-generator-is-not-read ──
//
// loft#2043 — A MOVED GENERATOR IS NOT READ (`@FR-G-Hold`, `@FR-H-Move`, `@FR-H-Spent`).  A
// generator local given to a field, an element or a tuple member MOVES there (G-Hold), so the
// name is spent and reading it is a compile-time error that names where the value went.  It
// compiled: `next(g)` drove the frame its holder now owned (1, 2), and once the holder released
// it (`v.remove(0)`) answered null, silently, on both backends.  One file per position, since a
// refusal stops the file: this one is the append; the field, literal, tuple and returned
// literal are the sibling files.  The legal half — a refill, a move on one path only, a view, a
// parameter's own hold, a call argument — is in
// `a-generator-held-in-a-field-or-an-element-is-released-once-by-its-holder.loft` and the cells beside it.
//
// @falsified-at: d1bff0fb0 — hand-measured, interpret and native: the control compiles this file
//   and prints `1 2` then `null`.
// CHANNEL: the expected diagnostic.
// ARMED: no instrument — the refusal is on by default.
// WITNESS: the diagnostic names the moved name and the line it moved at — once per reading
//   line, so the read before the `remove` and the one after it are two expected errors.
// HOLDS: the same read of a moved droppable is refused on both trees.
// @EXPECT_ERROR: `g` is read after its value moved
// @EXPECT_ERROR: `g` is read after its value moved
//
// ── 2043-a-moved-generator-is-not-read-field ──
//
// loft#2043 — a moved generator is not read, the field position (`@FR-G-Hold`, `@FR-H-Move`,
// `@FR-H-Spent`): see `2043-a-moved-generator-is-not-read.loft` for the rule and the append.
//
// @falsified-at: d1bff0fb0 — hand-measured, interpret and native: the control compiles this file.
// CHANNEL: the expected diagnostic.
// ARMED: no instrument — the refusal is on by default.
// WITNESS: the diagnostic names the moved name and the line it moved at.
// HOLDS: the same read of a moved droppable is refused on both trees.
// @EXPECT_ERROR: `g` is read after its value moved
//
// ── 2043-a-moved-generator-is-not-read-literal ──
//
// loft#2043 — a moved generator is not read, the literal position (`@FR-G-Hold`, `@FR-H-Move`,
// `@FR-H-Spent`): see `2043-a-moved-generator-is-not-read.loft` for the rule and the append.
//
// @falsified-at: d1bff0fb0 — hand-measured, interpret and native: the control compiles this file.
// CHANNEL: the expected diagnostic.
// ARMED: no instrument — the refusal is on by default.
// WITNESS: the diagnostic names the moved name and the line it moved at.
// HOLDS: the same read of a moved droppable is refused on both trees.
// @EXPECT_ERROR: `g` is read after its value moved
//
// ── 2043-a-moved-generator-is-not-read-tuple ──
//
// loft#2043 — a moved generator is not read, the tuple position (`@FR-G-Hold`, `@FR-H-Move`,
// `@FR-H-Spent`): see `2043-a-moved-generator-is-not-read.loft` for the rule and the append.
//
// @falsified-at: d1bff0fb0 — hand-measured, interpret and native: the control compiles this file.
// CHANNEL: the expected diagnostic.
// ARMED: no instrument — the refusal is on by default.
// WITNESS: the diagnostic names the moved name and the line it moved at.
// HOLDS: the same read of a moved droppable is refused on both trees.
// @EXPECT_ERROR: `g` is read after its value moved

fn counter() -> iterator<integer> { for i in 1..100 { yield i; } }

fn test_a_moved_generator_is_not_read() {
  g = counter();
  v: vector<iterator<integer>> = [];
  v += [g];
  println("{next(g)} {next(g)}");
  v.remove(0);
  println("{next(g)}");
}

struct S { g: iterator<integer>, n: integer }

fn test_a_moved_generator_is_not_read_field() {
  s = S { g: counter(), n: 1 };
  g = counter();
  s.g = g;
  println("{next(g)} {s.n}");
}


fn test_a_moved_generator_is_not_read_literal() {
  g = counter();
  s = S { g: g, n: 1 };
  println("{next(g)} {s.n}");
}


fn test_a_moved_generator_is_not_read_tuple() {
  g = counter();
  t = (g, 1);
  println("{next(g)} {t.1}");
}
