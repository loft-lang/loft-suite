//
// A NULL LITERAL REACHES THE NULLABLE MEMBER (`@FR-Disp-Applicable`: "after (F-Recv)'s
// nullability routing, so a nullable argument reaches the `τ?` member where one is declared";
// `@FR-Disp-Specific` ranks a null into a dense slot LOSSY, N-Store).  `null` is the most nullable
// argument a call can be written with: it fits a `τ?` slot without loss and a dense slot only by
// storing a null where none is declared.  So where a `τ?` member exists it is the selection.
//
// Axes it MOVES: the dense member's type (the same struct, a scalar, text) beside one `ANPt?`
//   member, and the declaration order (nullable first and last).
// Values hand-computed from the routing sentence.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: 18594597b (loft#2081) — interpret and native: "pt null|int null|text null|pt null".
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: the message prints the four answers.
// HOLDS: a present `ANPt` still reaches the dense `an(ANPt)` member.

struct ANPt { x: integer }

fn an(p: ANPt) -> text { "pt {p.x}" }
fn an(p: ANPt?) -> text { if p == null { "pt? null" } else { "pt? {p.x}" } }

fn ai(x: integer) -> text { "int {x}" }
fn ai(p: ANPt?) -> text { if p == null { "pt? null" } else { "pt? {p.x}" } }

fn at(t: text) -> text { "text {t}" }
fn at(p: ANPt?) -> text { if p == null { "pt? null" } else { "pt? {p.x}" } }

fn ar(p: ANPt?) -> text { if p == null { "pt? null" } else { "pt? {p.x}" } }
fn ar(p: ANPt) -> text { "pt {p.x}" }

fn test_a_null_literal_takes_the_nullable_member() {
  s = "{an(null)}|{ai(null)}|{at(null)}|{ar(null)}";
  assert(s == "pt? null|pt? null|pt? null|pt? null", "null literal: {s}");
  t = an(ANPt { x: 3 });
  assert(t == "pt 3", "a present value: {t}");
}

fn main() {
  test_a_null_literal_takes_the_nullable_member();
}
