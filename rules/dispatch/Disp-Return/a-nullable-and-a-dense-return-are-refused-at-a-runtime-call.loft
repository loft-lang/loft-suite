//
// A NULLABLE AND A DENSE RETURN ARE REFUSED AT A RUN-TIME CALL (`@FR-Disp-Return`, crossed with
// `@FR-Disp-Dynamic` and `@FR-Disp-Key`'s "a `τ?`'s nullability included"): `rt(RFire) -> text`
// and `rt(REnt) -> text?` disagree, so a `REnt`-held call that chooses between them is refused
// naming both, never typed as the join `text?`.  One refusal per file.
//
// @falsified-at: none — a conformance guard; the refusal fired as expected on 18594597b,
//   interpret and native.
// CHANNEL: the compile (the expected diagnostic).
// ARMED: no instrument.
// WITNESS: the diagnostic names both members with their returns.
// HOLDS: the static call at `RFire` compiles.
// @EXPECT_ERROR: `rt(REnt)` is decided by the runtime variant, but its definitions return different types — rt(RFire) -> text and rt(REnt) -> text?

enum REnt { RFire { n: integer }, RIce { n: integer } }

fn rt(a: RFire) -> text { "fire {a.n}" }
fn rt(a: REnt) -> text? { "any {a.n}" }

fn main() {
  println(rt(RFire { n: 2 }));
  x: REnt = RFire { n: 1 };
  y = rt(x);
  println(y ?? "none");
}
