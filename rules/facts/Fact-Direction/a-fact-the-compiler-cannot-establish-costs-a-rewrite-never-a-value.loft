//
// A FACT THE COMPILER CANNOT ESTABLISH COSTS A REWRITE, NEVER A VALUE (`@FR-Fact-Direction`, read
// with `@FR-Fact-Engine`).  A MAY fact (what a call may write, mint or make observable) is used
// only to prove an absence, and a MUST fact (this parameter is never null) only to prove a
// presence; where the routine cannot tell — a call through a function value, a write deep in a
// mutual-recursion cycle, an argument that is null at one call site only — it answers toward
// "may write" and "no guarantee", and the program reads what it wrote.  Values by hand:
//   a write through a function value is seen afterwards: 1 then 2 entries, the new one 3;
//   a write two calls deep in a cycle: ra(3) pushes 2, 1, 0;
//   an effectful call is not shared: 1 + 2 = 3, with 2 entries left;
//   `%` keeps null: 10 % 7 = 3, -10 % 7 = -3, null % 7 = null, through a function value too;
//   13 % 5 = 3 four calls deep, and null there stays null.
//
// @falsified-at: none — a conformance guard; every value answered as hand-computed on the tree of
//   the suite pin that adds this cell, interpret and native-c.
//   CHANNEL: the asserts and the leak gate.
//   ARMED: the suite's own LOFT_LEAK_CHECK=1.
//   HOLDS: the analyses' Rust tests under src/opt/.

fn push3(v: &vector<integer>) { v += [3]; }
fn via(v: &vector<integer>, g: fn(&vector<integer>)) { g(v); }

fn test_a_write_through_a_function_value_is_seen() {
  v: vector<integer> = [1];
  n0 = len(v);
  via(v, push3);
  s = "{n0} {len(v)} {v[1]}";
  assert(s == "1 2 3", "through a function value: {s}");
}

fn ra(v: &vector<integer>, n: integer) { if n > 0 { rb(v, n - 1); } }
fn rb(v: &vector<integer>, n: integer) { v += [n]; ra(v, n); }

fn test_a_write_deep_in_a_cycle_is_seen() {
  w: vector<integer> = [];
  ra(w, 3);
  s = "{len(w)} {w[0]} {w[2]}";
  assert(s == "3 2 0", "in a cycle: {s}");
}

fn bump(c: &vector<integer>) -> integer { c += [0]; len(c) }
fn call(c: &vector<integer>, g: fn(&vector<integer>) -> integer) -> integer { g(c) }

fn test_an_effectful_call_is_not_shared() {
  c: vector<integer> = [];
  a = call(c, bump) + call(c, bump);
  s = "{a} {len(c)}";
  assert(s == "3 2", "two calls, two effects: {s}");
}

fn md(x: integer) -> integer { x % 7 }
fn rm(x: integer, n: integer) -> integer { if n == 0 { x % 5 } else { rm(x, n - 1) } }

fn test_a_remainder_keeps_a_null_no_call_site_promised_away() {
  xs: vector<integer> = [1];
  n = xs[9];
  g = md;
  s = "{md(10)} {md(-10)} {md(n) ?? -1} {g(n) ?? -1} {g(24)} {rm(13, 4)} {rm(n, 4) ?? -1}";
  assert(s == "3 -3 -1 -1 3 3 -1", "the remainders: {s}");
}
