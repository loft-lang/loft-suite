struct LBH { e: LBig, f: LBig? }

fn test_the_last_of_254_variants_is_254() {
  h = LBH { e: LBig.V254, f: null };
  v: vector<LBig> = [LBig.V1, LBig.V254];
  s = "{LBig.V1 as integer} {LBig.V254 as integer} {sizeof(LBig)} {sizeof(LBH)} {h.e as integer} {h.f == null} {v[1] as integer} {size(v)}";
  assert(s == "1 254 1 2 254 true 254 2", "254 variants: {s}");
  h.f = LBig.V254;
  assert(h.f == LBig.V254 && h.f != null, "a nullable field holds V254: {h.f as integer?}");
}

fn main() {
  test_the_last_of_254_variants_is_254();
}
