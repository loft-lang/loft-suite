// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A WHOLE-DBREF FIELD PACKS AT ALIGNMENT FOUR AMONG THE OTHER FIELDS (`@FR-L-Struct` crossed with
// `@FR-L-Ref`).  L-Ref makes a stored `reference<T>` field the full 12-byte DbRef with alignment 4,
// a collection field a 4-byte record pointer, and an embedded struct inline; L-Struct packs a
// record's fields by DESCENDING alignment and rounds the total up to the record's alignment.  So a
// reference sits after every 8-aligned field and before every 2- and 1-aligned one, two references
// sit back to back, an inline sub-record of alignment 2 goes after a reference, and a record whose
// widest field is a reference is a multiple of 4, not 8.  Each field is then read and written at
// its packed position: writing one leaves every other as it was.
//
// Sizes hand-computed (offset of each field in packing order):
//   T  { v: integer }                                   v@0                         → 8
//   In { a: i16, c: u8 }                                a@0 c@2 = 3, align 2        → 4
//   A  { b: boolean, r: ref, n: integer, s: i16 }       n@0 r@8 s@20 b@22 = 23, /8  → 24
//   B  { r1: ref, u: u8, r2: ref }                      r1@0 r2@12 u@24 = 25, /4    → 28
//   C  { r: ref, x: vector, b: boolean }                r@0 x@12 b@16 = 17, /4      → 20
//   D  { i: In, r: ref, k: u8 }                         r@0 i@12 k@16 = 17, /4      → 20
//   E  { r: ref, t: text, f: float, c: character, w: u16 }
//                                                       f@0 r@8 t@20 c@24 w@28 = 30, /8 → 32
// Values: A{true, t1, -5, -300} then s=301, b=false, n=7 → "false 11 7 301"; B{t1, 200, t2} then
//   u=9 → "11 9 22"; t1.v = 12 is seen through both references → "12 12".
//
// Axes it MOVES: the reference's neighbours (8-, 4-, 2-, 1-aligned; another reference; an inline
//   record; a collection pointer; a text handle), the record's own alignment (8 or 4), a write to
//   each field after the bind, a write to the referenced record.
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed, interpret and
//   native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the sizes or the fields.
// HOLDS: `a-collection-field-is-a-pointer-and-a-reference-field-a-whole-dbref` (L-Ref) — one
//   reference beside one boolean.

struct T { v: integer }
struct In { a: i16, c: u8 }
struct A { b: boolean, r: reference<T>, n: integer, s: i16 }
struct B { r1: reference<T>, u: u8, r2: reference<T> }
struct C { r: reference<T>, x: vector<integer>, b: boolean }
struct D { i: In, r: reference<T>, k: u8 }
struct E { r: reference<T>, t: text, f: float, c: character, w: u16 }

fn test_a_reference_packs_between_the_eight_and_the_two_aligned() {
  s = "{sizeof(T)} {sizeof(In)} {sizeof(A)} {sizeof(B)} {sizeof(C)} {sizeof(D)} {sizeof(E)}";
  assert(s == "8 4 24 28 20 20 32", "sizes: {s}");
}

fn test_every_field_reads_back_at_its_packed_position() {
  t1 = T { v: 11 };
  t2 = T { v: 22 };
  a = A { b: true, r: t1, n: -5, s: -300 };
  b = B { r1: t1, u: 200, r2: t2 };
  a.s = 301;
  a.b = false;
  a.n = 7;
  b.u = 9;
  s = "{a.b} {a.r.v} {a.n} {a.s} | {b.r1.v} {b.u} {b.r2.v}";
  assert(s == "false 11 7 301 | 11 9 22", "fields: {s}");
  t1.v = 12;
  t = "{a.r.v} {b.r1.v} {b.r2.v}";
  assert(t == "12 12 22", "through the references: {t}");
}

fn test_an_inline_record_and_a_text_beside_a_reference() {
  t1 = T { v: 5 };
  d = D { i: In { a: -2, c: 250 }, r: t1, k: 3 };
  e = E { r: t1, t: "tx", f: 1.5, c: 'q', w: 65535 };
  d.i.a = 1000;
  e.w = 7;
  s = "{d.i.a} {d.i.c} {d.r.v} {d.k} | {e.r.v} {e.t} {e.f} {e.c} {e.w}";
  assert(s == "1000 250 5 3 | 5 tx 1.5 q 7", "inline and text: {s}");
}

fn main() {
  test_a_reference_packs_between_the_eight_and_the_two_aligned();
  test_every_field_reads_back_at_its_packed_position();
  test_an_inline_record_and_a_text_beside_a_reference();
}
