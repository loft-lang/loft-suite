//
// @FR-L-Null-Text, @C171: a text means the same thing wherever it is held — here, a parameter.
// Absent (`null`) is one value; a byte string, empty or holding NUL bytes anywhere, is
// another, so every reader's answer depends on the value alone.  Generated by
// loft `scripts/null_text_matrix.py`, which computes each expected line by hand; edit
// the generator, not this file.
//
// Axes this file MOVES:  the value (null, "", "x", NUL as a literal, a slice and a
//                        byte buffer, two NULs, a trailing NUL) and every reader.
// Axes it HOLDS FIXED:   the place (a parameter).
//
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message names the value, the place and every reader's answer.
// HOLDS: the null, "", "x" and trailing-NUL rows, which answer the same in every place.
// @falsified-at: c138d6feb — interpret exit 1 -> 0, native exit 1 -> 0; each place's four
//   rows holding a lone NUL piece (nul, slice, bytes0, nulnul's first byte) answered null

fn nothing() -> text? { null }

fn zero_byte() -> vector<u8> {
  z: vector<u8> = [];
  z += [0];
  z
}

// The text with each NUL byte written `~0`, read by byte so a NUL never becomes a character.
fn esc(t: text) -> text {
  r = "";
  for i in 0..size(t) {
    if t.byte_at(i) == 0 { r += "~0"; } else { r += t[i..i + 1]; }
  }
  r
}

fn show(t: text?) -> text { if t == null { "N" } else { "'" + esc(t) + "'" } }

// Every reader of a text, as one line.
fn sig(t: text) -> text {
  n = 0;
  for _c in t { n += 1; }
  a = t;
  a += 'x';
  b = t;
  b += "yz";
  p = "<" + t + ">";
  d = "d";
  co = show(t ?? d);
  f = show("[{t}]");
  tr = show(t.trim());
  lo = show(t.to_lowercase());
  q = "q";
  rr = "r";
  re = show(t.replace(q, rr));
  e = "";
  ea = "a";
  sw = t.starts_with(e);
  x = "x";
  fi = "{t.find(x)}";
  i0 = esc("{t[0]}");
  sub = show(t[0..1]);
  sp = len(split(t, ','));
  "isnull={t == null} not={!t} co={co} len={len(t)} size={size(t)} loop={n} cat={show(p)} addc={show(a)} addt={show(b)} eqe={t == e} lta={t < ea} lte={t < e} fmt={f} trim={tr} low={lo} rep={re} split={sp} sw={sw} find={fi} i0={i0} sub={sub}"
}

fn through(t: text) -> text {
  t
}

fn test_null() {
  got = sig(through(nothing()));
  assert(got == "isnull=true not=true co='d' len=0 size=0 loop=0 cat=N addc=N addt=N eqe=false lta=true lte=true fmt='[null]' trim=N low=N rep=N split=0 sw=true find=null i0= sub=N", "null through a parameter: {got}");
}

fn test_empty() {
  got = sig(through(""));
  assert(got == "isnull=false not=false co='' len=0 size=0 loop=0 cat='<>' addc='x' addt='yz' eqe=true lta=true lte=false fmt='[]' trim='' low='' rep='' split=0 sw=true find=null i0= sub=''", "empty through a parameter: {got}");
}

fn test_x() {
  got = sig(through("x"));
  assert(got == "isnull=false not=false co='x' len=1 size=1 loop=1 cat='<x>' addc='xx' addt='xyz' eqe=false lta=false lte=false fmt='[x]' trim='x' low='x' rep='x' split=1 sw=true find=0 i0=x sub='x'", "x through a parameter: {got}");
}

fn test_nul() {
  got = sig(through("\0"));
  assert(got == "isnull=false not=false co='~0' len=1 size=1 loop=1 cat='<~0>' addc='~0x' addt='~0yz' eqe=false lta=true lte=false fmt='[~0]' trim='~0' low='~0' rep='~0' split=1 sw=true find=null i0= sub='~0'", "nul through a parameter: {got}");
}

fn test_slice() {
  got = sig(through("a\0b"[1..2]));
  assert(got == "isnull=false not=false co='~0' len=1 size=1 loop=1 cat='<~0>' addc='~0x' addt='~0yz' eqe=false lta=true lte=false fmt='[~0]' trim='~0' low='~0' rep='~0' split=1 sw=true find=null i0= sub='~0'", "slice through a parameter: {got}");
}

fn test_nulnul() {
  got = sig(through("\0\0"));
  assert(got == "isnull=false not=false co='~0~0' len=2 size=2 loop=2 cat='<~0~0>' addc='~0~0x' addt='~0~0yz' eqe=false lta=true lte=false fmt='[~0~0]' trim='~0~0' low='~0~0' rep='~0~0' split=1 sw=true find=null i0= sub='~0'", "nulnul through a parameter: {got}");
}

fn test_anul() {
  got = sig(through("a\0"));
  assert(got == "isnull=false not=false co='a~0' len=2 size=2 loop=2 cat='<a~0>' addc='a~0x' addt='a~0yz' eqe=false lta=false lte=false fmt='[a~0]' trim='a~0' low='a~0' rep='a~0' split=1 sw=true find=null i0=a sub='a'", "anul through a parameter: {got}");
}

fn test_bytes0() {
  got = sig(through(text_from_bytes(zero_byte())));
  assert(got == "isnull=false not=false co='~0' len=1 size=1 loop=1 cat='<~0>' addc='~0x' addt='~0yz' eqe=false lta=true lte=false fmt='[~0]' trim='~0' low='~0' rep='~0' split=1 sw=true find=null i0= sub='~0'", "bytes0 through a parameter: {got}");
}
