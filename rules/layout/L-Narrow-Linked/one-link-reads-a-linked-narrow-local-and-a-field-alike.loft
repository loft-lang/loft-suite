//
// ONE LINK READS A LINKED NARROW LOCAL AND A FIELD ALIKE (`@FR-L-Narrow-Linked`, with
// `@FR-B-Ref-Uniform` and `@FR-L-Narrow-Decode`): a narrow local whose address a `&` takes holds
// the FIELD encoding (`value - start` in the stored width), so one `&i8` / `&Lim` / `&u8?`
// parameter reaches a local and a struct field through the same code, and every read decodes —
// the bias added back, the null code tested first where the slot reserves one.  The rule's own
// warning is followed: `u8` / `u16` cannot fail this (their bias is zero), so every case carries
// an `i8`, a `limit(1000, 1100)` or a `u8?`.  The B-Ref-Uniform cell crosses the link KINDS; this
// one crosses the SAME callee over a local and a field, and the reflection reader the rule names.
//
// Values hand-computed:
//   i8 -1, -=127 → -128, +=255 → 127;  Lim 1050, +=50 → 1100, then 1000;  u8? null → 254 → null.
//   dec(&i8): local -127 → -128, field 0 → -1;  up(&Lim): local 1099 → 1100, field 1000 → 1001;
//   clear(&u8?): local 9 → null, field 254 → null.  Re-point x=-1, y=-2, r=&x; r=&y; r=-3 →
//   x -1, y -3.  Seams: the linked i8 at -128 copied into an integer is -128, plus 1000 is 872.
//
// Axes it MOVES: the narrow type (signed one byte, biased one byte, nullable one byte), the
//   link kind (bind, argument, re-point), the place the same callee reaches (local, field),
//   the value at both range edges and at null, and the reader (format, arithmetic, copy).
//
// Cross-backend; `main` runs every cell so the leak gate reads the file.
//
// @falsified-at: none — a conformance guard; every cell answered as hand-computed on 18594597b,
//   interpret and native.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message prints the values.
// HOLDS: an unlinked neighbour of each type keeps its value.

type Lim = integer limit(1000, 1100);
struct NHold { f: i8, l: Lim, n: u8? }

fn dec(p: &i8) { p -= 1; }
fn up(p: &Lim) { p += 1; }
fn clear(p: &u8?) { p = null; }

fn test_a_bind_writes_and_reads_through_the_encoding() {
  a: i8 = -1;
  ra = &a;
  s1 = "{ra}";
  ra = -128;
  s2 = "{a}";
  ra = 127;
  s3 = "{a}";
  b: Lim = 1050;
  rb = &b;
  s4 = "{rb}";
  rb = 1100;
  s5 = "{b}";
  rb = 1000;
  s6 = "{b}";
  c: u8? = null;
  rc = &c;
  s7 = "{rc == null}";
  rc = 254;
  s8 = "{c}";
  rc = null;
  s9 = "{c == null}";
  keep: i8 = -7;
  s = "{s1} {s2} {s3}|{s4} {s5} {s6}|{s7} {s8} {s9}|{keep}";
  assert(s == "-1 -128 127|1050 1100 1000|true 254 true|-7", "bind: {s}");
}

fn test_one_callee_reaches_a_local_and_a_field() {
  a: i8 = -127;
  b: Lim = 1099;
  c: u8? = 9;
  h = NHold { f: 0, l: 1000, n: 254 };
  dec(a);
  dec(h.f);
  up(b);
  up(h.l);
  clear(c);
  clear(h.n);
  s = "{a} {h.f}|{b} {h.l}|{c == null} {h.n == null}";
  assert(s == "-128 -1|1100 1001|true true", "local and field: {s}");
}

fn test_a_re_point_and_the_decode_seams() {
  x: i8 = -1;
  y: i8 = -2;
  r = &x;
  r = &y;
  r = -3;
  a: i8 = -128;
  ra = &a;
  n: integer = a;
  m = a + 1000;
  s = "{x} {y}|{n} {m} {ra}";
  assert(s == "-1 -3|-128 872 -128", "re-point and seams: {s}");
}

fn main() {
  test_a_bind_writes_and_reads_through_the_encoding();
  test_one_callee_reaches_a_local_and_a_field();
  test_a_re_point_and_the_decode_seams();
}
