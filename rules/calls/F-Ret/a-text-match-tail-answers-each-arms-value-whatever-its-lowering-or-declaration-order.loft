//
// A TEXT MATCH TAIL ANSWERS EACH ARM'S VALUE, WHATEVER ITS LOWERING OR DECLARATION ORDER (`@FR-F-Ret`).
// A function's text answer reaches its caller whole: arms written one by one into the caller's
// buffer are recognised through whatever wrapper the match's lowering puts around them (a scalar,
// a slice or an enum match), and a match over a type declared lower in the file — first typed on
// the second pass — returns through every caller lowered against the first pass's signature.
// Two sections, each with its cells and receipt.
//
// ── a-text-match-tail-returns-each-arms-value-whatever-its-wrapper ──
//
// `@FR-F-Ret` — a function returning text from a `match` answers each arm's value, whatever
// wrapper the match's lowering puts around its arms.  A text tail whose arms all yield is
// written arm by arm into the caller's buffer (the per-arm accumulator); the pass that decides
// that looked through the scalar and slice matches' wrappers by name, not through the enum
// match's own `match` block (a computed subject's binding) nor the struct match's.  There, a
// tail whose arms return a pattern BINDING and a BUILT local had both promoted onto hidden
// buffers: the interpreter answered the built arm as "" — `c1` and `c4` below — and `--native`
// refused the program.  Every value by hand; c2, c3, c5 and c6 are the shapes that were right.
//
// @falsified-at: ec098768e — interpret exit 139 -> 0, native exit 1 -> 0.
//   CHANNEL: exit — on the interpreter a plain run answers the built arm as "" (`c1` "|k|",
//   `c4` "w||") and this file under the test runner ends in SIGSEGV; on native the compile.
//   WITNESS: interpret exit 139 on main; `--native` stops at E0308/E0597.
//   HOLDS: c2, c3, c5 and c6 pass on both trees.
//
// ── a-text-match-over-types-declared-below-returns-through-every-caller ──
//
// @FR-F-Ret — a function's text answer reaches its caller whole, wherever the types it reads are
// declared.  A function whose tail is a `match` over a value of a type declared LOWER in the file
// (or in a module parsed later) cannot be typed on the parser's first pass; its text arms are
// first seen on the second.  Every caller already lowered against the first pass's signature must
// still be able to call it: the answer is delivered without a parameter the first pass did not
// publish.  Each cell calls such a function from ABOVE it, so a signature grown on the second
// pass alone fails the compile (the H5 two-pass contract), or with that check gone, passes one
// argument too few.
//
// @falsified-at: ae63e2b50 (loft) — every cell: the compiler aborts with "H5 two-pass contract:
//   def `n_show` grew a pass-2-only work buffer `__work_1`", interpret and native.
// CHANNEL: the exit code (a parse panic) and the VALUES (hand-computed).
// ARMED: none — the abort happens before anything runs.
// WITNESS: `parse panic: H5 two-pass contract: def n_show (#876)` on both backends at ae63e2b50.
// HOLDS: every cell passes on both backends once the program compiles.
// Axes this file MOVES:  what the arms build (a format string, a concatenation, a null arm of a
//                        `text?`), who calls (a caller above, the function itself, a function
//                        that is itself called from above), the subject (a field path, a
//                        parameter of the late type).
// Axes it HOLDS FIXED:   the types are declared below every function; the tail is a `match`.

enum Val {
  VInt { value: integer },
  VText { value: text },
  VList { items: vector<Val> },
  VNone,
}
enum K { A, B, C }
struct W { tag: integer, name: text }

fn id(v: Val) -> Val { v }

fn c1(v: Val) -> text {
  match id(v) {
    VText { value } => value,
    VList { items } => { s = ""; for x in items { s += c1(x); } s },
    _ => ""
  }
}

fn c2(v: Val) -> text {
  match id(v) {
    VText { value } => value,
    _ => "z"
  }
}

fn c3(t: text, n: integer, sel: integer) -> text {
  match (sel, t) {
    (0, x) => x,
    (1, _) => { s = ""; for j in 0..n { s += "b"; } s },
    _ => ""
  }
}

fn c4(w: W, n: integer) -> text {
  match w {
    W { tag: 0, name } => name,
    W { tag: 1, name: _ } => { s = ""; for j in 0..n { s += "b"; } s },
    _ => ""
  }
}

fn c5(k: K, n: integer) -> text {
  match k {
    A => "a",
    B => { s = ""; for i in 0..n { s += "b"; } s },
    _ => ""
  }
}

fn c6(v: Val) -> text {
  match v {
    VText { value } => value,
    VList { items } => { s = ""; for x in items { s += c6(x); } s },
    _ => ""
  }
}

fn test_a_computed_subject_returns_a_binding_or_a_built_local() {
  l = VList { items: [VText { value: "hij" }, VInt { value: 42 }] };
  assert("{c1(l)}|{c1(VText { value: "k" })}|" == "hij|k|", "c1: {c1(l)}");
}

fn test_a_computed_subject_returns_a_binding_or_a_literal() {
  assert("{c2(VText { value: "k" })}|{c2(VInt { value: 1 })}|" == "k|z|", "c2");
}

fn test_a_tuple_match_returns_a_capture_or_a_built_local() {
  assert("{c3("t", 2, 0)}|{c3("t", 2, 1)}|" == "t|bb|", "c3");
}

fn test_a_struct_match_returns_a_field_or_a_built_local() {
  assert("{c4(W { tag: 0, name: "w" }, 2)}|{c4(W { tag: 1, name: "w" }, 2)}|" == "w|bb|", "c4: {c4(W { tag: 1, name: "w" }, 2)}");
}

fn test_a_plain_enum_returns_a_literal_or_a_built_local() {
  assert("{c5(A, 2)}|{c5(B, 3)}|" == "a|bbb|", "c5");
}

fn test_a_place_subject_returns_a_binding_or_a_built_local() {
  l = VList { items: [VText { value: "hij" }, VInt { value: 42 }] };
  assert("{c6(l)}|{c6(VText { value: "k" })}|" == "hij|k|", "c6: {c6(l)}");
}

fn show_all(x: X) -> text {
  out = "";
  for d in x.b.types {
    out += "[{d#index}:{show(x, d#index)}]";
  }
  out
}

fn show(x: X, tp: integer) -> text {
  t = x.b.types[tp]!;
  match t.parts[0] {
    PtBase => "base",
    PtShortRaw { start } => "short {start}",
    _ => "other {t.name}",
  }
}

fn joined(x: X, tp: integer) -> text {
  t = x.b.types[tp]!;
  match t.parts[0] {
    PtBase => "base",
    PtShortRaw { start: _ } => "short " + t.name,
    _ => "other " + t.name,
  }
}

fn maybe(x: X, tp: integer) -> text? {
  t = x.b.types[tp]!;
  match t.parts[0] {
    PtBase => null,
    PtShortRaw { start } => "short {start}",
    _ => "other {t.name}",
  }
}

fn nested(x: X, tp: integer) -> text {
  t = x.b.types[tp]!;
  match t.parts[0] {
    PtBase => "base",
    PtShortRaw { start } => "short {start}",
    _ => "other {t.name} of {nested(x, 0)}",
  }
}

fn via(x: X, tp: integer) -> text { kind(x.b.types[tp]!) }

fn kind(t: T) -> text {
  match t.parts[0] {
    PtBase => "base",
    PtShortRaw { start } => "short {start}",
    _ => "other {t.name}",
  }
}

fn sample() -> X {
  X { b: S2B { types: [T { name: "a", parts: [PtBase] }, T { name: "b", parts: [PtShortRaw { start: 7 }] }, T { name: "c", parts: [PtDbRef] }] } }
}

fn test_a_format_arm_reaches_a_caller_above() {
  got = show_all(sample());
  assert(got == "[0:base][1:short 7][2:other c]", got);
}

fn test_a_concatenation_arm() {
  x = sample();
  got = "{joined(x, 0)}|{joined(x, 1)}|{joined(x, 2)}";
  assert(got == "base|short b|other c", got);
}

fn test_a_nullable_text_answer() {
  x = sample();
  got = "{maybe(x, 0) ?? "none"}|{maybe(x, 1) ?? "none"}|{maybe(x, 2) ?? "none"}";
  assert(got == "none|short 7|other c", got);
}

fn test_the_function_calls_itself() {
  x = sample();
  got = "{nested(x, 1)}|{nested(x, 2)}";
  assert(got == "short 7|other c of base", got);
}

fn test_the_subject_is_a_parameter_of_the_late_type() {
  x = sample();
  got = "{via(x, 0)}|{via(x, 1)}|{via(x, 2)}";
  assert(got == "base|short 7|other c", got);
}

enum P { PtBase, PtShortRaw { start: integer }, PtDbRef }
struct T { name: text, parts: vector<P> }
struct S2B { types: vector<T> }
struct X { b: S2B }
