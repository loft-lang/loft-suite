//
// A PART OF A CALL'S RESULT, RETURNED, IS THE CALLER'S OWN COPY (`@FR-F-Ret`: a whole heap value is
// handed out owned and fresh, never a view of a store the frame frees).  A call used as the root
// of a projection is lifted into a temporary the frame frees on the way out, so what is returned
// out of it is copied into the caller's buffer first: a field answered by one arm of a tail
// (loft#2289), a field returned from a call that borrows an argument (loft#2443), and a
// record-enum element read through a call's result, whose container must not be taken for the
// return buffer (loft#2515).  Three sections, each with its cells and receipt.
//
// ── 2289-a-field-of-a-call-temporary-answered-by-an-arm-is-copied ──
//
// A FIELD of an inline call's result, answered by an ARM of a function's tail, is copied
// into the caller's buffer before the call's temporary is freed — whatever the other arm is.
//
// @FR-F-Ret: a returned whole heap value is owned, never a view of a store the frame frees.
// `if n > 0 { decode(n).value } else { CInt { value: 9 } }` lifts `decode(n)` into a frame
// temporary and the arm reads a field of it.  A buffered join is copied arm by arm only
// through the copy leg a non-empty dep list reaches; the lifted temporary publishes no dep,
// so the tail was handed back AS IS and the temporary freed under it: `-1` for the enum
// field on every backend, the stale bytes of a freed store for a struct field (loft#2289).
//
// Axes this file MOVES:  the field's type (a record enum, a struct, a vector element); the
//                        other arm (a literal, a call that mints, the same projection, a
//                        bound local); the join (`if`, `else if`, `match`); which arm runs;
//                        a loop of calls (the freed store re-used under the view).
// Axes it HOLDS FIXED:   a DENSE return with a buffer — the nullable return already copied
//                        per arm (loft#1337), and is the control `nullable`.
//
// Controls: the arm that binds a local first (`d = decode(n); d.value`, copied before the
// fix), the explicit `return`, the nullable return.  Two records are built between each
// call and its read, as the filed program does: they re-use the freed store, so a view of
// it reads their bytes instead of passing on stale ones (the loop is the same channel).
//
// @falsified-at: a0106bd01 — interpret exit 1 -> 0, native exit 1 -> 0; scored by hand
// against a build carrying the defect (the first cell answers -1 on both).
//   HOLDS: the cell is clean on every channel with the fix, `LOFT_STRICT_STORES=1` included.
//
// ── 2443-a-field-of-a-call-result-returned-is-the-callers-copy ──
//
// A FIELD OF A CALL'S RESULT, RETURNED, IS THE CALLER'S COPY (loft#2443, `formal/calls.md`
// @FR-F-Ret: a whole heap value is handed out OWNED, never a view of something the frame
// frees).
//
// A call used as the root of a projection (`def(e, h).bounds`) is lifted into a temporary
// the frame owns and frees on the way out: a result that BORROWS an argument is copied at
// that bind, a fresh one is adopted.  So the field is a view of the temporary, whatever the
// call's return deps say — and a borrowing callee's deps name the ARGUMENT (`["e"]`), which
// read as "this return borrows the caller's own record, hand it up as it is".  Every exit
// below returns such a field: as the tail, bound to a local first and returned at the end,
// returned early beside a tail that borrows the argument or projects another call, and
// beside a literal tail.  Each must deliver a copy into the caller's buffer.
//
// Axes it MOVES: the callee (borrows its argument / builds a fresh record), the spelling
//   (tail projection, view local at the end, view local returned early), the other exit
//   (a call projection, a parameter projection, a view local, a literal, none), and which
//   exit runs.
// Held FIXED: a vector field (a text field and a record field take other legs, measured
//   clean beside these), one projection level.
//
// Every result is read AFTER a filler allocation, so a handed-up view of a freed temporary
// reads the filler's store or a poisoned one; the leak gate reads the file.
//
// @falsified-at: 7ab6b9677 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
// CHANNEL: the asserts.
// WITNESS: each message prints the answers.
// HOLDS: the parameter-view write-through of (B-View) is unchanged (`own = e.defs[1].bounds;
//   own += [99]` still reaches `e`); a call's result written through stays independent.
//
// ── 2515-a-record-enum-element-of-a-calls-result-is-returned-fresh ──
//
// @catches: LOFT_NO_RET_TYPE_MATCH — the call's `D` container is bound as the `T` return buffer, and the caller's store is freed twice
//
// loft#2515 — `@FR-F-Ret`: a function returns a fresh, independent value.  A record-ENUM element
// read through a call's result (`def(e, 0).ts[0]!`) and returned had the call's record container
// bound as the return buffer — the type-match guard asked `Reference` alone, where a record enum
// is the same heap record — so the caller's store was freed twice and every other holder read it
// emptied.  A plain-struct element, a field, a bound read and a call bound first were right.
//
// Axes this file MOVES:  the element kind (record enum, plain struct); the read (an element `!`,
//                        `?? default` with a unit variant, a field); calls (one, two).
// Axes it HOLDS FIXED:   the call answers a record by value; the vector is a field of it.
//
// @falsified-at: pending
//   CHANNEL: the VALUES (hand-computed) and the store fault the run reports.
//   HOLDS: every cell, on every backend.

enum CV { CNull, CInt { value: integer }, CText { value: text } }
struct P { pv: integer }
struct In { a: integer, t: text }
struct Dec { const value: CV, const next: integer, inn: In, items: vector<In> }
fn decode(n: integer) -> Dec {
  Dec { value: CInt { value: n }, next: 1, inn: In { a: n * 10, t: "t{n}" }, items: [In { a: n * 100, t: "e{n}" }] }
}
fn mk(n: integer) -> CV { CInt { value: n + 50 } }
fn v(c: CV) -> integer { match c { CInt { value } => value, _ => -1 } }
fn sp(i: In) -> text { "{i.a}/{i.t}" }
fn lit(n: integer) -> CV { if n > 0 { decode(n).value } else { CInt { value: 9 } } }
fn same(n: integer) -> CV { if n > 0 { decode(n).value } else { decode(n + 7).value } }
fn mint(n: integer) -> CV { if n > 0 { decode(n).value } else { mk(n) } }
fn second(n: integer) -> CV { if n > 0 { CInt { value: 9 } } else { decode(n - 2).value } }
fn matched(n: integer) -> CV { match n { 0 => CInt { value: 9 }, _ => decode(n).value } }
fn mixed(n: integer) -> CV { if n > 0 { d = decode(n); d.value } else { decode(n + 30).value } }
fn bound(n: integer) -> CV { if n > 0 { d = decode(n); d.value } else { CInt { value: 9 } } }
fn early(n: integer) -> CV { if n > 0 { return decode(n).value; } CInt { value: 9 } }
fn nullable(n: integer) -> CV? { if n > 0 { decode(n).value } else { null } }
fn rec(n: integer) -> In { if n > 0 { decode(n).inn } else { In { a: 9, t: "z" } } }
fn elm(n: integer) -> In { if n > 0 { decode(n).items[0] } else { In { a: 9, t: "z" } } }
fn chain(n: integer) -> In {
  if n > 0 { decode(n).inn } else if n < -5 { decode(1).inn } else { In { a: 9, t: "z" } }
}
fn test_a_field_of_a_call_temporary_answered_by_an_arm_is_copied() {
  r1 = lit(3); x1 = P { pv: 100 }; y1 = P { pv: 101 };
  assert(v(r1) == 3 && x1.pv + y1.pv == 201, "a literal other arm, the projecting arm runs: {v(r1)}");
  r2 = lit(0); x2 = P { pv: 200 }; y2 = P { pv: 201 };
  assert(v(r2) == 9 && x2.pv + y2.pv == 401, "a literal other arm, the literal runs: {v(r2)}");
  r3 = same(0); x3 = P { pv: 300 }; y3 = P { pv: 301 };
  assert(v(r3) == 7 && x3.pv + y3.pv == 601, "both arms project: {v(r3)}");
  r4 = mint(4); x4 = P { pv: 400 }; y4 = P { pv: 401 };
  assert(v(r4) == 4 && x4.pv + y4.pv == 801, "the other arm is a minting call: {v(r4)}");
  r5 = second(0); x5 = P { pv: 500 }; y5 = P { pv: 501 };
  assert(v(r5) == -2 && x5.pv + y5.pv == 1001, "the projecting arm is the second: {v(r5)}");
  r6 = matched(5); x6 = P { pv: 600 }; y6 = P { pv: 601 };
  assert(v(r6) == 5 && x6.pv + y6.pv == 1201, "a match arm projects: {v(r6)}");
  r7 = mixed(0); x7 = P { pv: 700 }; y7 = P { pv: 701 };
  assert(v(r7) == 30 && x7.pv + y7.pv == 1401, "the other arm binds a local: {v(r7)}");
  r8 = bound(3); x8 = P { pv: 800 }; y8 = P { pv: 801 };
  assert(v(r8) == 3 && x8.pv + y8.pv == 1601, "control, the arm binds a local first: {v(r8)}");
  r9 = early(3); x9 = P { pv: 900 }; y9 = P { pv: 901 };
  assert(v(r9) == 3 && x9.pv + y9.pv == 1801, "control, an explicit return: {v(r9)}");
  r10 = nullable(3); x10 = P { pv: 1000 }; y10 = P { pv: 1001 };
  assert(v(r10 ?? CNull) == 3 && x10.pv + y10.pv == 2001, "control, the nullable return: {v(r10 ?? CNull)}");
  r11 = rec(6); x11 = P { pv: 1100 }; y11 = P { pv: 1101 };
  assert(sp(r11) == "60/t6" && x11.pv + y11.pv == 2201, "a struct field: {sp(r11)}");
  r12 = elm(2); x12 = P { pv: 1200 }; y12 = P { pv: 1201 };
  assert(sp(r12) == "200/e2" && x12.pv + y12.pv == 2401, "a vector element: {sp(r12)}");
  r13 = chain(-9); x13 = P { pv: 1300 }; y13 = P { pv: 1301 };
  assert(sp(r13) == "10/t1" && x13.pv + y13.pv == 2601, "an else-if arm: {sp(r13)}");
  s = "";
  for i in 0..4 { r = rec(i); s += "{sp(r)},"; }
  assert(s == "9/z,10/t1,20/t2,30/t3,", "a loop of calls reads no re-used store: {s}");
  print("2289 a field of a call temporary answered by an arm ok\n");
}

struct D { name: text, bounds: vector<integer> }
struct E { defs: vector<D> }

fn def(e: E, d: integer) -> D {
  e.defs[d]
}

fn s2_mk(n: integer) -> D {
  D { name: "m{n}", bounds: [n, n + 1, n + 2] }
}

fn filler() -> integer {
  v = [for k in 0..40 { D { name: "c{k}", bounds: [k, k + 1] } }];
  len(v)
}

// The tail is a field of a borrowing call.
fn tail_borrow(e: E, h: integer) -> vector<integer> {
  def(e, h).bounds
}

// The view is bound first and returned at the end.
fn last_return(e: E, h: integer) -> vector<integer> {
  own = def(e, h).bounds;
  return own;
}

// Returned early, beside a tail that projects another borrowing call.
fn early_call_tail(e: E, h: integer) -> vector<integer> {
  own = def(e, h).bounds;
  if len(own) > 0 {
    return own;
  }
  def(e, 0).bounds
}

// Returned early, beside a tail that borrows the parameter itself.
fn early_param_tail(e: E, h: integer) -> vector<integer> {
  own = def(e, h).bounds;
  if len(own) > 0 {
    return own;
  }
  e.defs[0].bounds
}

// The tail exit is the one that runs.
fn tail_taken(e: E, h: integer) -> vector<integer> {
  own = def(e, h).bounds;
  if len(own) == 0 {
    return own;
  }
  def(e, 1).bounds
}

// The bounds-lookup shape the loft front end met: a holder's own list, else the template's.
fn var_bounds(e: E, h: integer, d: integer, first: boolean) -> vector<integer> {
  own = def(e, h).bounds;
  if len(own) > 0 || !first {
    return own;
  }
  def(e, d).bounds
}

// A fresh callee, returned early beside a call-projection tail.
fn fresh_early(n: integer) -> vector<integer> {
  own = s2_mk(n).bounds;
  if len(own) > 0 {
    return own;
  }
  s2_mk(0).bounds
}

fn test_borrowing_callee() {
  e = E { defs: [D { name: "a", bounds: [] }, D { name: "b", bounds: [7, 8, 9] }] };
  t = tail_borrow(e, 1);
  f1 = filler();
  l = last_return(e, 1);
  f2 = filler();
  c = early_call_tail(e, 1);
  f3 = filler();
  p = early_param_tail(e, 1);
  f4 = filler();
  k = tail_taken(e, 1);
  f5 = filler();
  s = "{t}|{l}|{c}|{p}|{k}|{f1 + f2 + f3 + f4 + f5}";
  assert(s == "[7,8,9]|[7,8,9]|[7,8,9]|[7,8,9]|[7,8,9]|200", "borrowing callee: {s}");
}

fn test_bounds_lookup() {
  e = E { defs: [D { name: "a", bounds: [] }, D { name: "b", bounds: [7, 8, 9] }, D { name: "c", bounds: [] }] };
  r1 = var_bounds(e, 1, 0, true);
  f = filler();
  r2 = var_bounds(e, 0, 1, false);
  r3 = var_bounds(e, 0, 1, true);
  s = "{r1}|{r2}|{r3}|{f}";
  assert(s == "[7,8,9]|[]|[7,8,9]|40", "bounds lookup: {s}");
}

fn test_fresh_callee() {
  r = fresh_early(7);
  f = filler();
  s = "{r}|{f}";
  assert(s == "[7,8,9]|40", "fresh callee: {s}");
}

fn test_independence_holds() {
  e = E { defs: [D { name: "a", bounds: [] }, D { name: "b", bounds: [7, 8, 9] }] };
  own = def(e, 1).bounds;
  own += [99];
  through_call = len(e.defs[1].bounds);
  view = e.defs[1].bounds;
  view += [99];
  through_param = len(e.defs[1].bounds);
  s = "{through_call}|{through_param}";
  assert(s == "3|4", "independence: {s}");
}


enum T { TyI { n: integer }, TyV }
struct S3P { n: integer }
struct S3D { ts: vector<T>, ps: vector<S3P>, t: T }
struct S3E { defs: vector<S3D> }

fn s3_def(e: S3E, d: integer) -> S3D { e.defs[d]! }
fn elem(e: S3E) -> T { s3_def(e, 0).ts[0]! }
fn elem_or(e: S3E, i: integer) -> T { s3_def(e, 0).ts[i] ?? TyV }
fn plain(e: S3E) -> S3P { s3_def(e, 0).ps[0]! }
fn field(e: S3E) -> T { s3_def(e, 0).t }
fn n_of(t: T) -> integer { match t { TyI { n } => n, _ => -1 } }

fn s3_mk() -> S3E { S3E { defs: [S3D { ts: [TyI { n: 7 }, TyI { n: 8 }], ps: [S3P { n: 5 }], t: TyI { n: 9 } }] } }

fn test_an_enum_element_of_a_calls_result_is_fresh() {
  e = s3_mk();
  a = elem(e);
  b = elem(e);
  assert(n_of(a) == 7 && n_of(b) == 7, "elements: {n_of(a)} {n_of(b)}");
  assert(len(e.defs) == 1 && len(e.defs[0]!.ts) == 2, "the caller's store: {len(e.defs)}");
}

fn test_a_coalesced_element_and_its_default() {
  e = s3_mk();
  assert(n_of(elem_or(e, 1)) == 8 && n_of(elem_or(e, 5)) == -1, "coalesced: {n_of(elem_or(e, 1))} {n_of(elem_or(e, 5))}");
  assert(len(e.defs[0]!.ts) == 2, "the caller's store after the default: {len(e.defs[0]!.ts)}");
}

fn test_the_struct_element_and_the_field_answer_alike() {
  e = s3_mk();
  assert(plain(e).n == 5 && n_of(field(e)) == 9, "struct {plain(e).n}, field {n_of(field(e))}");
  assert(len(e.defs) == 1, "the caller's store: {len(e.defs)}");
}
