// SPDX-License-Identifier: LGPL-3.0-or-later
// @catches: LOFT_NO_RET_TYPE_MATCH — the call's `D` container is bound as the `T` return buffer, and the caller's store is freed twice
//
// loft#2515 — `@FR-F-Ret`: a function returns a fresh, independent value.  A record-ENUM element
// read through a call's result (`def(e, 0).ts[0]!`) and returned had the call's record container
// bound as the return buffer — the type-match guard asked `Reference` alone, where a record enum
// is the same heap record — so the caller's store was freed twice and every other holder read it
// emptied.  A plain-struct element, a field, a bound read and a call bound first were right.
//
// CHANNEL: the VALUES (hand-computed) and the store fault the run reports.
// HOLDS: every cell, on every backend.
// Axes this file MOVES:  the element kind (record enum, plain struct); the read (an element `!`,
//                        `?? default` with a unit variant, a field); calls (one, two).
// Axes it HOLDS FIXED:   the call answers a record by value; the vector is a field of it.
//
// @falsified-at: pending

enum T { TyI { n: integer }, TyV }
struct P { n: integer }
struct D { ts: vector<T>, ps: vector<P>, t: T }
struct E { defs: vector<D> }

fn def(e: E, d: integer) -> D { e.defs[d]! }
fn elem(e: E) -> T { def(e, 0).ts[0]! }
fn elem_or(e: E, i: integer) -> T { def(e, 0).ts[i] ?? TyV }
fn plain(e: E) -> P { def(e, 0).ps[0]! }
fn field(e: E) -> T { def(e, 0).t }
fn n_of(t: T) -> integer { match t { TyI { n } => n, _ => -1 } }

fn mk() -> E { E { defs: [D { ts: [TyI { n: 7 }, TyI { n: 8 }], ps: [P { n: 5 }], t: TyI { n: 9 } }] } }

fn test_an_enum_element_of_a_calls_result_is_fresh() {
  e = mk();
  a = elem(e);
  b = elem(e);
  assert(n_of(a) == 7 && n_of(b) == 7, "elements: {n_of(a)} {n_of(b)}");
  assert(len(e.defs) == 1 && len(e.defs[0]!.ts) == 2, "the caller's store: {len(e.defs)}");
}

fn test_a_coalesced_element_and_its_default() {
  e = mk();
  assert(n_of(elem_or(e, 1)) == 8 && n_of(elem_or(e, 5)) == -1, "coalesced: {n_of(elem_or(e, 1))} {n_of(elem_or(e, 5))}");
  assert(len(e.defs[0]!.ts) == 2, "the caller's store after the default: {len(e.defs[0]!.ts)}");
}

fn test_the_struct_element_and_the_field_answer_alike() {
  e = mk();
  assert(plain(e).n == 5 && n_of(field(e)) == 9, "struct {plain(e).n}, field {n_of(field(e))}");
  assert(len(e.defs) == 1, "the caller's store: {len(e.defs)}");
}
