//
// @FR-F-Ret — a function's text answer reaches its caller whole, wherever the types it reads are
// declared.  A function whose tail is a `match` over a value of a type declared LOWER in the file
// (or in a module parsed later) cannot be typed on the parser's first pass; its text arms are
// first seen on the second.  Every caller already lowered against the first pass's signature must
// still be able to call it: the answer is delivered without a parameter the first pass did not
// publish.  Each cell calls such a function from ABOVE it, so a signature grown on the second
// pass alone fails the compile (the H5 two-pass contract), or with that check gone, passes one
// argument too few.
//
// @falsified-at: ae63e2b50 (loft) — every cell: the compiler aborts with "H5 two-pass contract:
//   def `n_show` grew a pass-2-only work buffer `__work_1`", interpret and native.
// CHANNEL: the exit code (a parse panic) and the VALUES (hand-computed).
// ARMED: none — the abort happens before anything runs.
// WITNESS: `parse panic: H5 two-pass contract: def n_show (#876)` on both backends at ae63e2b50.
// HOLDS: every cell passes on both backends once the program compiles.
// Axes this file MOVES:  what the arms build (a format string, a concatenation, a null arm of a
//                        `text?`), who calls (a caller above, the function itself, a function
//                        that is itself called from above), the subject (a field path, a
//                        parameter of the late type).
// Axes it HOLDS FIXED:   the types are declared below every function; the tail is a `match`.

fn show_all(x: X) -> text {
  out = "";
  for d in x.b.types {
    out += "[{d#index}:{show(x, d#index)}]";
  }
  out
}

fn show(x: X, tp: integer) -> text {
  t = x.b.types[tp]!;
  match t.parts[0] {
    PtBase => "base",
    PtShortRaw { start } => "short {start}",
    _ => "other {t.name}",
  }
}

fn joined(x: X, tp: integer) -> text {
  t = x.b.types[tp]!;
  match t.parts[0] {
    PtBase => "base",
    PtShortRaw { start: _ } => "short " + t.name,
    _ => "other " + t.name,
  }
}

fn maybe(x: X, tp: integer) -> text? {
  t = x.b.types[tp]!;
  match t.parts[0] {
    PtBase => null,
    PtShortRaw { start } => "short {start}",
    _ => "other {t.name}",
  }
}

fn nested(x: X, tp: integer) -> text {
  t = x.b.types[tp]!;
  match t.parts[0] {
    PtBase => "base",
    PtShortRaw { start } => "short {start}",
    _ => "other {t.name} of {nested(x, 0)}",
  }
}

fn via(x: X, tp: integer) -> text { kind(x.b.types[tp]!) }

fn kind(t: T) -> text {
  match t.parts[0] {
    PtBase => "base",
    PtShortRaw { start } => "short {start}",
    _ => "other {t.name}",
  }
}

fn sample() -> X {
  X { b: B { types: [T { name: "a", parts: [PtBase] }, T { name: "b", parts: [PtShortRaw { start: 7 }] }, T { name: "c", parts: [PtDbRef] }] } }
}

fn test_a_format_arm_reaches_a_caller_above() {
  got = show_all(sample());
  assert(got == "[0:base][1:short 7][2:other c]", got);
}

fn test_a_concatenation_arm() {
  x = sample();
  got = "{joined(x, 0)}|{joined(x, 1)}|{joined(x, 2)}";
  assert(got == "base|short b|other c", got);
}

fn test_a_nullable_text_answer() {
  x = sample();
  got = "{maybe(x, 0) ?? "none"}|{maybe(x, 1) ?? "none"}|{maybe(x, 2) ?? "none"}";
  assert(got == "none|short 7|other c", got);
}

fn test_the_function_calls_itself() {
  x = sample();
  got = "{nested(x, 1)}|{nested(x, 2)}";
  assert(got == "short 7|other c of base", got);
}

fn test_the_subject_is_a_parameter_of_the_late_type() {
  x = sample();
  got = "{via(x, 0)}|{via(x, 1)}|{via(x, 2)}";
  assert(got == "base|short 7|other c", got);
}

enum P { PtBase, PtShortRaw { start: integer }, PtDbRef }
struct T { name: text, parts: vector<P> }
struct B { types: vector<T> }
struct X { b: B }
