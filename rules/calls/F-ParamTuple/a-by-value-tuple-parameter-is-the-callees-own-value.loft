// SPDX-License-Identifier: LGPL-3.0-or-later
// @catches: LOFT_NO_TUPLE_PARAM_COPY — the switch leaves the parameter the caller's tuple, and every write through a heap member reaches the caller
//
// @FR-F-ParamTuple: a by-value tuple parameter is the callee's own value.  A tuple is a value
// (its record form is how it is laid out, `@FR-T-Record`), so a callee that writes through a
// member — a record member's field, a collection member's elements, the member handed to a
// function that writes it — changes its own copy and never the caller's tuple, as a write to
// a scalar or text member already did.  A callee that only reads copies nothing.
//
// CHANNEL: the VALUES (hand-computed) and the LEAK / double-free gate.
// HOLDS: every cell, on every backend.
// Axes this file MOVES:  the member kind (a record, a vector, a hash, a nested tuple's
//                        record); the write (a field, a compound field, an append, an element,
//                        a removal, a callee that writes its parameter, declared above and
//                        below, a local bound from the member, a loop over the member); a text
//                        member written beside a heap one; the shadow, a member and the whole
//                        tuple returned; a loop of calls.
// Axes it HOLDS FIXED:   the caller's tuple is a named local; one parameter per callee.
//
// @falsified-at: none — the switch is the control: under `LOFT_NO_TUPLE_PARAM_COPY=1` all five tests
//   fail on both backends (`50 3 7 2 1 60 61 2`, `5 2 1 70 80 80 hi 1`, `52 5 5 6`, …).

struct P { x: integer }
struct H { k: text, n: integer }

fn g(p: P) { p.x = 60; }
fn c_field(t: (P, integer)) { t.0.x = 50; }
fn c_append(t: (vector<integer>, integer)) { t.0 += [9]; }
fn c_elem(t: (vector<integer>, integer)) { t.0[0] = 7; }
fn c_scalar(t: (P, integer)) { t.1 = 5; }
fn c_rebind(t: (P, integer)) { t.0 = P { x: 9 }; }
fn c_callee(t: (P, integer)) { g(t.0); }
fn c_below(t: (P, integer)) { h(t.0); }
fn c_compound(t: (P, integer)) { t.0.x += 1; }
fn c_nested(t: ((P, integer), integer)) { t.0.0.x = 5; }
fn c_hash(t: (hash<H[k]>, integer)) { t.0 += [H { k: "z", n: 1 }]; }
fn c_remove(t: (vector<integer>, integer)) { t.0.remove(0); }
fn c_alias(t: (P, integer)) { x = t.0; x.x = 70; }
fn c_loop(t: (vector<P>, integer)) { for e in t.0 { e.x = 80; } }
fn c_text(t: (text, P)) { t.0 += "!"; t.1.x = 90; }
fn c_read(t: (P, integer)) -> integer { t.0.x * 10 + t.1 }
fn bump(t: (P, integer)) -> (P, integer) { t.0.x += 1; t }
fn h(p: P) { p.x = 61; }
fn idt(t: (P, integer)) -> (P, integer) { t }
fn pick(t: (P, integer)) -> P { t.0.x += 1; t.0 }

fn test_a_write_through_a_member_stays_in_the_callee() {
  a1 = (P { x: 1 }, 2); c_field(a1);
  a2 = ([1, 2], 3); c_append(a2);
  a3 = ([1, 2], 3); c_elem(a3);
  a4 = (P { x: 1 }, 2); c_scalar(a4);
  a5 = (P { x: 1 }, 2); c_rebind(a5);
  a6 = (P { x: 1 }, 2); c_callee(a6);
  a7 = (P { x: 1 }, 2); c_below(a7);
  a8 = (P { x: 1 }, 2); c_compound(a8);
  got = "{a1.0.x} {len(a2.0)} {a3.0[0]} {a4.1} {a5.0.x} {a6.0.x} {a7.0.x} {a8.0.x}";
  assert(got == "1 2 1 2 1 1 1 1", got);
}

fn test_every_member_kind() {
  a1 = ((P { x: 1 }, 2), 3); c_nested(a1);
  a2: (hash<H[k]>, integer) = ([H { k: "a", n: 1 }], 3); c_hash(a2);
  a3 = ([1, 2], 3); c_remove(a3);
  a4 = (P { x: 1 }, 2); c_alias(a4);
  a5 = ([P { x: 1 }, P { x: 2 }], 3); c_loop(a5);
  a6 = ("hi", P { x: 1 }); c_text(a6);
  got = "{a1.0.0.x} {len(a2.0)} {len(a3.0)} {a4.0.x} {a5.0[0].x} {a5.0[1].x} {a6.0} {a6.1.x}";
  assert(got == "1 1 2 1 1 2 hi 1", got);
}

fn test_a_reader_and_a_returned_copy() {
  a = (P { x: 4 }, 2);
  b = bump(a);
  c = bump(b);
  got = "{c_read(a)} {a.0.x} {b.0.x} {c.0.x}";
  assert(got == "42 4 5 6", got);
}

fn test_a_returned_member_or_tuple() {
  a = (P { x: 5 }, 1);
  b = idt(a); b.0.x = 9;
  s = 0;
  for k in 0..10 { c = pick(a); s += c.x + k - k; }
  assert(a.0.x == 5 && b.0.x == 9 && s == 60, "{a.0.x} {b.0.x} {s}");
}

fn test_a_loop_of_calls() {
  a = (P { x: 3 }, [1, 2]);
  s = 0;
  for k in 0..50 { c_field2(a, k); s += a.0.x + len(a.1); }
  assert(s == 250 && a.0.x == 3 && len(a.1) == 2, "{s}");
}

fn c_field2(t: (P, vector<integer>), k: integer) { t.0.x = k; t.1 += [k]; }

fn main() {
  test_a_write_through_a_member_stays_in_the_callee();
  test_every_member_kind();
  test_a_reader_and_a_returned_copy();
  test_a_returned_member_or_tuple();
  test_a_loop_of_calls();
}
