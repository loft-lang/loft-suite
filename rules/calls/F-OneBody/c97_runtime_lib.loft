// @C97 — a library may define a free function under a standard-library name.  These two are
// names of body-less standard-library natives, whose calls a native build links to the
// runtime's function of that bare name: `vector_sum_int` (what `sum` calls for integers) and
// `env_variable`.  The guard is 2318-a-library-function-under-a-runtime-natives-name-leaves-the-runtimes-call.loft beside it.
pub fn vector_sum_int(a: integer) -> integer { a + 1 }
pub fn env_variable(name: text) -> text { "lib:{name}" }
