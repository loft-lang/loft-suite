//
// A COALESCE RETURN ANSWERS ITS OWN VALUE (`@FR-F-Return`, `@FR-C-Never`, loft#2551).  `x ?? return
// e` is the statement `return e` on the absent path, so the call answers `e` — typed against the
// function's return type and delivered as every return is.  Before, `?? return []` in a
// `-> vector` function answered whatever the caller's buffer last held (the previous call's
// vector on the interpreter, a null vector on C), and a record subject stopped the program.
// Each test calls the function once on the present path and once on the absent one.
//
// Values by hand: half(n) is n / 2, null at 0; open(n) a Dev with id n / 2, null at 0.
//   empty return   : [3] then []   (also in the other order, and after a two-element [3, 4])
//   [7] return     : [3] then [7]
//   text vector    : ["t3"] then []
//   record subject : [3] then []
//   call argument  : wrap(half(n) ?? return []) — [3] then []
//   text / record  : "3" / "none"; 3 / 9
//   bare `?? return` in a value function answers the return type's null: len 0
//
// @falsified-by: tests/falsified/2551-a-coalesce-return-answers-its-own-value.patch — interpret exit 1 -> 0, interpret 3 assertion failures -> 0, native exit 1 -> 0, native 8 assertion failures -> 0
//   CHANNEL: the asserts on both backends (the interpreter also stops on the record subject).
//   ARMED: none.
//   WITNESS: the control answers the previous vector, or null where `[]` is written.
//   HOLDS: text and record returns, and a bare `?? return`, answer alike on both trees.

struct Dev { id: integer }
struct Res { id: integer }
fn half(n: integer) -> integer? { if n == 0 { return null; } n / 2 }
fn open(n: integer) -> Dev? { if n == 0 { return null; } Dev { id: n / 2 } }
fn wrap(h: integer) -> integer { h }
fn sa(n: integer) -> vector<integer> { h = half(n) ?? return []; [h] }
fn sc(n: integer) -> vector<integer> { h = half(n) ?? return [7]; [h] }
fn sd(n: integer) -> vector<integer> { h = half(n) ?? return []; [h, h + 1] }
fn sf(n: integer) -> vector<text> { h = half(n) ?? return []; ["t{h}"] }
fn sh(n: integer) -> vector<integer> { dev = open(n) ?? return []; [dev.id] }
fn sn(n: integer) -> vector<integer> { k = wrap(half(n) ?? return []); [k] }
fn si(n: integer) -> text { h = half(n) ?? return "none"; "{h}" }
fn sj(n: integer) -> Res { h = half(n) ?? return Res { id: 9 }; Res { id: h } }
fn sk(n: integer) -> vector<integer> { h = half(n) ?? return; [h] }
fn show(v: vector<integer>) -> text { "{len(v)}:{v}" }

fn test_an_empty_return_after_a_normal_call() {
  a = sa(6);
  b = sa(0);
  r = "{show(a)} {show(b)}";
  assert(r == "1:[3] 0:[]", "after: {r}");
}

fn test_an_empty_return_first_then_a_normal_call() {
  a = sa(0);
  b = sa(6);
  c = sd(6);
  d = sd(0);
  r = "{show(a)} {show(b)} {show(c)} {show(d)}";
  assert(r == "0:[] 1:[3] 2:[3,4] 0:[]", "before: {r}");
}

fn test_a_valued_return_and_a_text_vector() {
  a = sc(6);
  b = sc(0);
  t = sf(6);
  u = sf(0);
  r = "{show(a)} {show(b)} {len(t)}:{t} {len(u)}:{u}";
  assert(r == "1:[3] 1:[7] 1:[\"t3\"] 0:[]", "valued: {r}");
}

fn test_a_record_subject_and_a_call_argument() {
  a = sh(6);
  b = sh(0);
  c = sn(6);
  d = sn(0);
  r = "{show(a)} {show(b)} {show(c)} {show(d)}";
  assert(r == "1:[3] 0:[] 1:[3] 0:[]", "record and argument: {r}");
}

fn test_text_record_and_bare_returns() {
  j = sj(0);
  k = sk(0);
  r = "{si(6)} {si(0)} {sj(6).id} {j.id} {len(k)}";
  assert(r == "3 none 3 9 0", "others: {r}");
}
