//
// A CALL'S FRAME FREES EXACTLY WHAT IT OWNS (`@FR-F-Call` crossed with `@FR-H-Free`).  The frame
// is dropped at the return and its owned locals are freed — a record a value block made and
// copied a text out of included (loft#1935: a text local owns the bytes it copied, so its dep
// names where they came from, not a store it still views) — and only those: a pinned store's
// free is a no-op, a parameter's store is the caller's, and the returned value leaves with the
// caller.  Two sections, each with its cells and receipt; the leak gate counts what is left.
//
// ── a-text-copied-out-of-a-blocks-record-frees-the-record ──
//
// loft#1935 — a value block whose tail is a text local COPIED out of a record the block owns
// frees that record.  @FR-F-Call: the frame frees the stores it owns.  `s = r.name` types `s`
// as `text["r"]`, and the block's exit read the tail's deps as stores leaving the frame, so
// `r` was never released — one store per evaluation, on both backends, with every value
// right.  A text local owns a `String` the bind copied the bytes into; its dep names where
// they came from, not a store it still views.
//
// Axes this file MOVES:  where the record sits (the block's own local, a field of the block's
//                        record, an outer block around a nested tail block); how the text is
//                        read (a field, a nested field, into a `text?`); where it runs
//                        (straight line, a `for` body, per pass).
// Axes it HOLDS FIXED:   the record holds one text; single-threaded; no closure captures.
//
// The controls were already clean: the tail IS the read (`{ r = …; r.name }`), the same shape
// at function level, and a text copied from a PARAMETER's record (the caller's store).
//
// Every value is hand-computed; the leak is the exit's "stores not freed" report, which the
// corpus leak gate and `make falsify`'s leak channel read.
//
// @falsified-at: 653383a5a — measured by hand on both backends: interpret leaked kt=96 R×12,
//   kt=97 H×6 -> clean, native leaked kt=96 R×12, kt=97 H×6 -> clean
// @falsified-by: tests/falsified/a-text-copied-out-of-a-blocks-record-frees-the-record.patch — interpret leaked kt=96 R×12, kt=97 H×6 -> clean, native leaked kt=96 R×12, kt=97 H×6 -> clean
//   ARMED: nothing — the exit's "stores not freed" report is printed by every `main`-ful run.
//   HOLDS: exit, assertions and panic are clean on both trees and both backends; every value
//   was always right, so the leak column is the only channel that moves.
//
// ── a-dropped-frame-frees-what-it-owns-and-nothing-else ──
//
// `@FR-F-Call` crossed with `@FR-H-Free`: a call's frame is dropped at its return and its OWNED
// locals are freed (H-Free) — and only those: a free of a pinned store (a file-scope constant
// the body read or bound) is a no-op, the store a parameter names is the caller's, and the
// value the body returns leaves the frame with the caller.  Each callee is called hundreds of
// times; the caller reads its arguments and the constant after every call and the returned
// values after the loop, and the leak gate counts what is left.
//
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.
// CHANNEL: the assertions and the leak gate.

struct R { name: text }
struct H { r: R, n: integer }

fn straight(k: integer) -> text { t = { r = R { name: "f{k}" }; s = r.name; s }; "{t}." }
fn per_pass(n: integer) -> text { out = ""; for k in 0..n { out += { r = R { name: "d{k}" }; s = r.name; s } } out }
fn nested(k: integer) -> text { t = { r = R { name: "g{k}" }; { s = r.name; s } }; "{t}." }
fn deep(n: integer) -> text { out = ""; for i in 0..n { out += { h = H { r: R { name: "h{i}" }, n: i }; s = h.r.name; s } } out }
fn nullable(k: integer) -> integer { len(({ r = R { name: "q{k}" }; s: text? = r.name; s }) ?? "zz") }

// Controls.
fn tail_is_read(k: integer) -> text { t = { r = R { name: "a{k}" }; r.name }; "{t}." }
fn fn_level(k: integer) -> text { r = R { name: "b{k}" }; s = r.name; s }
fn param_src(p: R) -> text { t = { s = p.name; s }; "{t}!" }

fn test_a_text_copied_out_of_a_blocks_record_frees_the_record() {
  assert(straight(9) == "f9.", "straight: {straight(9)}");
  assert(per_pass(3) == "d0d1d2", "per pass: {per_pass(3)}");
  assert(nested(1) == "g1.", "nested tail block: {nested(1)}");
  assert(deep(3) == "h0h1h2", "a field of the block's record: {deep(3)}");
  // "q42" is 3 long.
  assert(nullable(42) == 3, "into a text?: {nullable(42)}");
  assert(tail_is_read(1) == "a1.", "control, the tail is the read: {tail_is_read(1)}");
  assert(fn_level(2) == "b2", "control, function level: {fn_level(2)}");
  p = R { name: "p" };
  assert(param_src(p) == "p!", "control, a parameter's record: {param_src(p)}");
}

TABLE = [3, 1, 4, 1, 5];

struct Box { n: integer, tags: vector<integer>, name: text }

fn locals_only(k: integer) -> integer {
  v: vector<integer> = [];
  for i in 0..k { v += [i]; }
  b = Box { n: k, tags: v, name: "b{k}" };
  t = TABLE;
  len(b.tags) + len(b.name) + t[k % 5]
}

fn returns_one(k: integer) -> Box {
  keep = Box { n: k, tags: [k, k + 1], name: "keep" };
  drop = Box { n: -k, tags: [0], name: "drop" };
  if drop.n > 0 { return drop; }
  keep
}

fn reads_param(b: Box) -> integer {
  w = b.tags;
  w += [99];
  len(w) + b.n
}

fn test_owned_locals_and_a_pinned_store() {
  s = 0;
  for i in 0..400 { s += locals_only(i % 9); }
  assert(s == 3411 && TABLE[2] == 4 && len(TABLE) == 5, "locals: {s}");
}

fn test_a_returned_value_and_a_parameters_store() {
  out: vector<Box> = [];
  for i in 1..200 { out += [returns_one(i)]; }
  assert(len(out) == 199 && out[0].n == 1 && out[198].tags[1] == 200 && out[5].name == "keep", "returned: {len(out)}");
  b = Box { n: 7, tags: [1, 2], name: "p" };
  t = 0;
  for _ in 0..300 { t += reads_param(b); }
  assert(t == 3000 && len(b.tags) == 2 && b.name == "p", "a parameter's store: {t} {len(b.tags)}");
}
