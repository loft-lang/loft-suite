//
// A TEXT PARAMETER IS THE ARGUMENT'S VALUE AT THE CALL, AND THE CALLEE'S OWN (`@FR-F-ParamText`,
// with `@FR-B-Ref-Lvalue`).  A `text` argument binds its value, not a view of the bytes it was read
// from: a callee that grows the store the text came out of — by the same vector, a sibling field,
// a deeper call, a forwarded parameter, a closure, a later argument — leaves the parameter as it
// was (loft#2203), and a `&` link to the parameter names the parameter as a place, so reading and
// writing through the link read and write the callee's copy and never the caller's text
// (loft#2422; a local text link handed on to a `&text` parameter is its `--native` half,
// loft#2423).  Two sections, each with its cells and receipt.
//
// ── 2203-a-text-argument-is-its-value-at-the-call ──
//
// A TEXT ARGUMENT IS ITS VALUE AT THE CALL (`@FR-F-ParamText`, loft#2203).  A text read out of
// a record — `f(w, w.rs[0].name)` — was handed to the callee as a VIEW of the store's bytes,
// and a callee that grew that store moved the bytes under it: the interpreter printed garbage
// and native read freed memory.  The store can be grown by any route the callee has to it, so
// the cells vary the ROUTE: the same vector, a sibling field, one call deeper, a parameter
// forwarded on, a closure the callee calls, a closure called directly, and a LATER argument
// of the same call.  Two controls: a read-only callee (the copy is dropped there and the
// answer is unchanged) and a `&text` parameter, which is a place and must still write back.
//
// @ARMED: LOFT_POISON=1
//
// @falsified-at: 6184655a5 — main fails all nine growth cells under the poison (the moved
//   block is scribbled), and two of them without it (a block nobody reuses still reads right).
// CHANNEL: the asserts (value and length).
// ARMED: `LOFT_POISON=1`, so a view of a moved block reads the scribble rather than luck;
//   `LOFT_KEEP_ARG_COPY=1` (every copy kept) answers the same.
// WITNESS: each cell names its route in its text, so a cell that reads another's bytes says so.
// HOLDS: `F-ParamHeap` beside it — the struct argument itself is still shared.
//
// ── 2422-a-link-to-a-text-parameter-names-its-own-copy ──
//
// A `text` parameter is bound to the argument's VALUE (`@FR-F-ParamText`), and a `&` link to
// it names that parameter as a place (`@FR-B-Ref-Lvalue`): reading the link reads the
// parameter, writing through it writes the parameter, and the caller's text is never touched.
//
// Before loft#2422 a write to a text parameter (`t += "!"`) moved it onto an owned local, but
// a LINK did not: `c = &t` named the caller's borrowed view, and the link read its bytes as an
// owned text.  The interpreter answered an empty text silently for a plain read and crashed
// after a write; `--native-c` refused the program.  Both spellings of the link, and the link
// in a lambda and in a generator, took the same route.
//
// loft#2423 is the `--native` half of c9: a local text link handed on to a `&text` parameter
// passed the address of the link (`*mut *mut String`) and did not compile.
//
// The cells that can FAIL:
//   c1  read through the link                   — empty text
//   c2  append through the link, return it      — crash
//   c3  append through the link, return `t`     — crash
//   c4  whole write through the link            — crash
//   c5  the annotated spelling `c: &text = t`   — crash
//   c6  a link in a `for` loop                  — crash
//   c7  two links to one parameter              — crash
//   c8  a lambda's text parameter               — crash
//   c9  the link handed to a `&text` parameter  — crash; `--native` did not compile
//
// The controls, each of which a too-wide fix would move:
//   c10 a direct write `t += "!"`               — the promotion that always worked
//   c11 the caller's text after any of the above — unchanged (`@FR-F-ParamText`)
//   c12 an `integer`, a record and a vector parameter linked the same way
//   c13 a local text link handed to a `&text` parameter (loft#2423 alone)
//
// @falsified-at: 0e95172cd — interpret exit 138 -> 0, native exit 1 -> 0
//   ARMED: no instrument.  Ordinary assertions on every backend.
//   WITNESS: the control's interpreter exits on SIGBUS (138) at c2, after c1 answered an
//   empty text; `--native` does not compile c9 (E0308, `*mut *mut String`).
//   HOLDS: leak and free-refusal are clean on both trees and both backends; the EXIT channel
//   is the whole measurement, and HERE passes every assertion.
//
// CHANNEL: the assertions; on the interpreter also the crash.

struct R2203 { name: text, n: integer }
struct W2203 { rs: vector<R2203>, other: vector<R2203>, title: text, names: vector<text> }

fn pad2203(w: W2203) {
  for i in 0..2000 { w.rs += [R2203 { name: "padding-padding-padding-padding-{i}", n: i }]; }
}

fn world2203(name: text) -> W2203 {
  W2203 { rs: [R2203 { name: name, n: 1 }], other: [], title: name, names: [name] }
}

fn same_vector2203(w: W2203, s: text) -> text { pad2203(w); "{s}|{len(s)}" }

fn sibling2203(w: W2203, s: text) -> text {
  for i in 0..2000 { w.other += [R2203 { name: "padding-padding-padding-padding-{i}", n: i }]; }
  "{s}|{len(s)}"
}

fn forward2203(w: W2203, s: text) -> text { same_vector2203(w, s) }

fn through_closure2203(grow: fn(), s: text) -> text { grow(); "{s}|{len(s)}" }

fn later2203(s: text, n: integer) -> text { "{s}|{len(s)}|{n}" }

fn grown2203(w: W2203) -> integer { pad2203(w); len(w.rs) }

fn method2203(self: W2203, s: text) -> text { pad2203(self); "{s}|{len(s)}" }

fn reads_only2203(w: W2203, s: text) -> text { "{s}|{len(s)}|{len(w.rs)}" }

fn names2203(w: W2203, s: text) -> text {
  for i in 0..2000 { w.names += ["padding-padding-padding-padding-{i}"]; }
  "{s}|{len(s)}"
}

fn overwrite2203(w: W2203, s: text) -> text {
  w.rs[0].name = "x";
  for i in 0..50 { w.rs += [R2203 { name: "zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz{i}", n: i }]; }
  "{s}|{len(s)}"
}

fn set2203(s: &text) { s = "written-back"; }

fn grow_the_same_vector() {
  w = world2203("same-vector");
  r = same_vector2203(w, w.rs[0].name);
  assert(r == "same-vector|11", "same vector: {r}");
}

fn grow_a_sibling_field() {
  w = world2203("sibling-field");
  r = sibling2203(w, w.rs[0].name);
  assert(r == "sibling-field|13", "sibling: {r}");
}

fn grow_one_call_deeper_through_a_forwarded_parameter() {
  w = world2203("forwarded-parameter");
  r = forward2203(w, w.rs[0].name);
  assert(r == "forwarded-parameter|19", "forwarded: {r}");
}

fn grow_through_a_closure_the_callee_calls() {
  w = world2203("closure-in-callee");
  g = fn() { pad2203(w); };
  r = through_closure2203(g, w.rs[0].name);
  assert(r == "closure-in-callee|17", "closure in callee: {r}");
}

fn grow_through_a_closure_called_directly() {
  w = world2203("closure-called");
  h = fn(s: text) -> text { pad2203(w); "{s}|{len(s)}" };
  r = h(w.rs[0].name);
  assert(r == "closure-called|14", "closure called: {r}");
}

fn grow_in_a_later_argument() {
  w = world2203("later-argument");
  r = later2203(w.rs[0].name, grown2203(w));
  assert(r == "later-argument|14|2001", "later argument: {r}");
}

fn grow_under_a_plain_field() {
  w = world2203("plain-field");
  r = same_vector2203(w, w.title);
  assert(r == "plain-field|11", "plain field: {r}");
}

fn grow_under_a_text_element() {
  w = world2203("text-element");
  r = names2203(w, w.names[0]);
  assert(r == "text-element|12", "text element: {r}");
}

fn grow_under_a_method_call() {
  w = world2203("method-call");
  r = w.method2203(w.rs[0].name);
  assert(r == "method-call|11", "method call: {r}");
}

fn overwrite_the_field_then_reuse_its_block() {
  w = world2203("overwrite-then-reuse");
  r = overwrite2203(w, w.rs[0].name);
  assert(r == "overwrite-then-reuse|20", "overwrite: {r}");
  assert(w.rs[0].name == "x", "the callee's write reaches the caller: {w.rs[0].name}");
}

fn a_read_only_callee_reads_the_same() {
  w = world2203("read-only");
  r = reads_only2203(w, w.rs[0].name);
  assert(r == "read-only|9|1", "read only: {r}");
}

fn a_text_place_parameter_still_writes_back() {
  w = world2203("before");
  set2203(w.rs[0].name);
  assert(w.rs[0].name == "written-back", "&text writes back: {w.rs[0].name}");
  assert(len(w.rs[0].name) == 12, "length {len(w.rs[0].name)}");
}

struct B { n: integer }

fn bang(s: &text) { s += "?"; }

fn c1(t: text) -> text { c = &t; c }
fn c2(t: text) -> text { c = &t; c += "!"; c }
fn c3(t: text) -> text { c = &t; c += "!"; t }
fn c4(t: text) -> text { c = &t; c = "zz"; t }
fn c5(t: text) -> text { c: &text = t; c += "!"; t }
fn c6(t: text) -> text { c = &t; for i in 0..3 { c += "{i}"; } t }
fn c7(t: text) -> text { c = &t; d = &t; c += "!"; d += "?"; t }
fn c9(t: text) -> text { c = &t; bang(c); t }
fn c10(t: text) -> text { t += "!"; t }
fn gen(t: text) -> iterator<text> { c = &t; yield c; c += "!"; yield c; }
fn int_link(t: integer) -> integer { c = &t; c += 3; t }
fn rec_link(t: B) -> integer { c = &t; c.n += 3; t.n }
fn vec_link(t: vector<integer>) -> integer { c = &t; c += [3]; len(t) }

fn test_a_link_to_a_text_parameter() {
  assert(c1("hi") == "hi", "c1: [{c1("hi")}]");
  assert(c2("hi") == "hi!", "c2: {c2("hi")}");
  assert(c3("hi") == "hi!", "c3: {c3("hi")}");
  assert(c4("hi") == "zz", "c4: {c4("hi")}");
  assert(c5("hi") == "hi!", "c5: {c5("hi")}");
  assert(c6("a") == "a012", "c6: {c6("a")}");
  assert(c7("hi") == "hi!?", "c7: {c7("hi")}");
  f = fn(t: text) -> text { c = &t; c += "!"; t };
  assert(f("hi") == "hi!", "c8: {f("hi")}");
  assert(c9("hi") == "hi?", "c9: {c9("hi")}");
  r = "";
  for v in gen("hi") { r += "{v} "; }
  assert(r == "hi hi! ", "generator: {r}");
}

fn test_the_controls() {
  assert(c10("hi") == "hi!", "c10: {c10("hi")}");
  s = "hi";
  a = c3(s);
  b = c9(s);
  assert(a == "hi!" && b == "hi?" && s == "hi", "c11: {a} {b} {s}");
  x = 5;
  r = B { n: 5 };
  v = [1, 2];
  assert(int_link(x) == 8 && x == 5, "c12 integer: {int_link(x)} {x}");
  assert(rec_link(r) == 8 && r.n == 8, "c12 record: {r.n}");
  assert(vec_link(v) == 3 && len(v) == 3, "c12 vector: {len(v)}");
  t = "hi";
  l = &t;
  bang(l);
  assert(t == "hi?", "c13: {t}");
}
