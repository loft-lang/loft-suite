//
// A GENERIC AT A TUPLE ANSWERS THE BOXED RECORD ITS TEMPLATE COMPILED, AND ITS CALLBACK IS ITS
// TWIN'S TYPE (`@FR-G-Mono`, `@FR-F-Ret`).  A generic `-> U` at a tuple returns the boxed
// `__tuple<…>` record, and a callback `f: fn(T) -> U` at such a `U` is the function type the concrete
// twin spells.  Two sections, each with its cells and receipt.
//
// ── a-generic-hands-up-its-callbacks-pure-value-tuple ──
//
// `@FR-G-Mono` / `@FR-F-Ret` — a generic `-> U` instantiated at a tuple returns the boxed
// `__tuple<…>` record (the template compiled `U` as a record), while a callback
// `f: fn(T) -> U` at a PURE-VALUE tuple (no text, record or collection member) keeps the bare
// tuple ABI.  So `-> U { f(x) }` hands up a stack tuple where the signature promises the
// record, and the instance's return rewrite (`promote_monomorph_tuple_return`) boxed only the
// stack tuples written as a literal or held in a local — not one a CALL answers.  The
// interpreter panicked (`allocation.rs`: a tuple's bits read as a store reference), or — at
// `(float, boolean)` — answered `null null` without a word; the C refused the program ("a
// reference expected, a Tup(0) found") and rustc-native did not compile it (loft#2361).  The
// bound spelling `r = f(x); r` was right throughout.
//
// The axes moved: the callback (a lambda, a named function, a fn-ref local), where the call
// stands (the body's tail, an early `return`, both arms of a tail `if`), and the tuple (two
// integers, a float and a boolean, three members, a narrow `u8` member), with a tuple holding
// text (the boxed callback, loft#2356) and a plain integer as the controls.  Every value is
// worked out by hand.
//
// @falsified-at: 0e95172cd — interpret exit 1 -> 0 (each test function panics), C exit 1 -> 0
//   (the refusal)
// CHANNEL: the exit, and the asserted values (`null null` at `(float, boolean)` on the control).
// ARMED: no instrument; LOFT_POISON, LOFT_STRICT_STORES and the C under -DLOFT_POISON measured
//   clean on the fixed tree, rustc-native too.
// HOLDS: the integer control answers the same on both trees; the text-tuple control fails on the
//   control tree too, as loft#2356 did there.
//
// ── a-tuple-callback-of-a-generic-answers-the-boxed-record ──
//
// `@FR-G-Mono` / `@FR-F-Ret` — a generic's callback `f: fn(T) -> U` at a `U` that is a tuple
// holding text is the function TYPE its concrete twin spells, `fn(T) -> (integer, text)`, whose
// return is the boxed `__tuple<…>` record (loft#2190).  The instance kept the bare stack tuple
// instead: a short lambda adopted that bare return, and its text member was a `__ret_text_N` the
// callee cannot free and the caller only copies from — one `String` leaked per call on the
// interpreter (loft#2356, the nightly valgrind red of `the-goal-program-of-flexible-generics`).
// A NAMED `fn mk(x) -> (integer, text)` — boxed at its declaration — was refused by the same
// generic ("expected fn(integer) -> (integer, text), got fn(integer) -> (integer, text)").  The
// instance now boxes its fn-typed parameters' tuple returns, unboxes the calls it reads, and a
// lambda boxes the tuple it adopts.
//
// The axes moved: the callback (a lambda, a named function, a fn-ref local holding it), what
// the generic does with the answer (appends it, binds it first, discards it, returns it), and
// `U` (a tuple with text; a tuple of scalars, a struct, a text and a nullable integer as the
// controls — a scalar tuple only where it is not the generic's own return, which is loft
// #2356's sibling noted in its report).  Every value is worked out by hand; `main` runs it all.
//
// @falsified-at: 0e95172cd — interpret exit 1 -> 0, C exit 1 -> 0 (the control refuses the
//   named function); valgrind on the control's interpreter loses one block per lambda call
//   (`definitely lost: 24 bytes in 3 blocks` for `map_v([1, 2, 3], |x| { (x, "n{x}") })`).
// CHANNEL: the exit, and valgrind's definitely-lost count on the interpreter (the leak changes
//   no value).
// ARMED: valgrind --leak-check=full on `--interpret`; LOFT_POISON and LOFT_STRICT_STORES measured
//   clean on the fixed tree, both backends.
// HOLDS: the controls answer the same on both trees.

fn last<T, U>(g: vector<T>, f: fn(T) -> U) -> U { f(g[len(g) - 1]) }
fn early<T, U>(g: vector<T>, f: fn(T) -> U) -> U { if len(g) > 1 { return f(g[1]); } f(g[0]) }
fn pick<T, U>(c: boolean, a: T, b: T, f: fn(T) -> U) -> U { if c { f(a) } else { f(b) } }

fn pair(x: integer) -> (integer, integer) { (x, x * 10) }
fn halves(x: integer) -> (float, boolean) { (x as float / 2.0, x > 2) }
fn narrow(x: integer) -> (integer, u8) { (x, (x * 7) & 255) }

fn test_a_lambda() {
  a = last([1, 2, 3], |x| { (x, x * 10) });
  b = early([4, 5, 6], |x| { (x, x * 10) });
  c = pick(false, 7, 8, |x| { (x, x * 10) });
  d = last([1, 2, 3], |x| { (x, x + 1, x + 2) });
  assert("{a.0} {a.1} {b.0} {b.1} {c.0} {c.1} {d.0} {d.2}" == "3 30 5 50 8 80 3 5", "lambda: {a.1} {b.1} {c.1} {d.2}");
}

fn test_a_named_function() {
  a = last([1, 2, 3], pair);
  b = early([4, 5, 6], halves);
  c = pick(true, 7, 8, narrow);
  e = last([1, 2, 3], halves);
  assert("{a.1} {b.0} {b.1} {c.0} {c.1} {e.0} {e.1}" == "30 2.5 true 7 49 1.5 true", "named: {a.1} {b.0} {b.1} {c.1} {e.0} {e.1}");
}

fn test_a_fn_ref_local() {
  fr = pair;
  hv = halves;
  a = last([4], fr);
  b = pick(false, 1, 3, hv);
  c = early([9, 10], fr);
  assert("{a.0} {a.1} {b.0} {b.1} {c.1}" == "4 40 1.5 true 100", "fn-ref local: {a.1} {b.0} {b.1} {c.1}");
}

fn test_the_controls() {
  t = last([1, 2, 3], |x| { (x, "n{x}") });
  n = pick(true, 4, 5, |x| { x * 10 });
  assert("{t.1} {n}" == "n3 40", "controls: {t.1} {n}");
}

struct S { n: integer, t: text }

fn map_v<T, U>(g: vector<T>, f: fn(T) -> U) -> vector<U> {
  out: vector<U> = [];
  for c in g { out += [f(c)]; }
  out
}
fn bound_v<T, U>(g: vector<T>, f: fn(T) -> U) -> vector<U> {
  out: vector<U> = [];
  for c in g { r = f(c); out += [r]; }
  out
}
fn unread<T, U>(g: vector<T>, f: fn(T) -> U) -> integer {
  n = 0;
  for c in g { f(c); n += 1; }
  n
}

fn named(x: integer) -> (integer, text) { (x, "n{x}") }

fn test_a_lambda_answering_a_text_tuple() {
  a = map_v([1, 2, 3], |x| { (x, "n{x}") });
  assert("{a[0].0} {a[2].1} {len(a)}" == "1 n3 3", "appended: {a[2].1}");
  b = bound_v([1, 2, 3], |x| { (x, "n{x}") });
  assert("{b[1].1} {len(b)}" == "n2 3", "bound: {b[1].1}");
  assert(unread([1, 2, 3], |x| { (x, "n{x}") }) == 3, "discarded");
  z = last([1, 2, 3], |x| { (x, "n{x}") });
  assert("{z.0} {z.1}" == "3 n3", "returned: {z.1}");
}

fn test_a_named_function_and_a_fn_ref_local() {
  a = map_v([1, 2, 3], named);
  b = bound_v([4, 5], named);
  z = last([7], named);
  assert("{a[2].1} {b[0].1} {z.1} {unread([1, 2], named)}" == "n3 n4 n7 2", "named: {a[2].1} {b[0].1} {z.1}");
  fr = named;
  c = map_v([1, 2], fr);
  d = bound_v([3], fr);
  y = last([8, 9], fr);
  assert("{c[1].1} {d[0].1} {y.1} {unread([1, 2, 3], fr)}" == "n2 n3 n9 3", "fn-ref local: {c[1].1} {d[0].1} {y.1}");
}

fn test_s2_the_controls() {
  s = map_v([1, 2, 3], |x| { (x, x * 10) });
  sb = bound_v([1, 2], |x| { (x, x * 10) });
  assert("{s[2].1} {sb[1].1} {unread([1, 2], |x| { (x, x * 10) })}" == "30 20 2", "scalar tuple");
  st = map_v([1, 2, 3], |x| { S { n: x, t: "s{x}" } });
  zs = last([1, 2], |x| { S { n: x, t: "s{x}" } });
  assert("{st[2].t} {zs.t}" == "s3 s2", "struct: {st[2].t} {zs.t}");
  tx = bound_v([1, 2, 3], |x| { "t{x}" });
  zt = last([5], |x| { "t{x}" });
  assert("{tx[0]} {tx[2]} {zt}" == "t1 t3 t5", "text: {tx[0]} {zt}");
  ni = map_v([1, 2, 3], |x| { if x > 1 { x } else { null } });
  assert("{ni[0]} {ni[2]}" == "null 3", "nullable integer: {ni[0]} {ni[2]}");
}

