//
// A PLAIN ENUM IS `Equatable` (`@FR-G-Sat-Eq`, crossed with `@FR-E-Eq` and `@FR-G-Check`).
// "every type satisfies `Equatable`" (DESIGN_DECISIONS @C91); a plain enum compares by its
// variant, as `a == Col.Red` does at a concrete site.  So `same(Col.Red, Col.Red)` is true and
// `same(Col.Red, Col.Green)` false, and a `Col?` bound at the same generic too.
//
// loft#2057: a plain enum at `<T: Equatable>` was refused — `content_comparable` admitted an
// enum only when it is a struct-enum.
//
// @falsified-at: 38a114cb9 — hand-measured, interpret and native: "'Col' does not satisfy
//   interface 'Equatable'".
// CHANNEL: the asserts (today: a compile refusal).
// ARMED: no instrument.
// WITNESS: each message names the comparison's answer.
// HOLDS: the struct-enum and vector cells of `an-equatable-bound-compares-content-in-the-monomorph`.

enum Col { Red, Green }

fn same<T: Equatable>(a: T, b: T) -> boolean { a == b }

fn test_a_plain_enum() {
  assert(same(Col.Red, Col.Red) && !same(Col.Red, Col.Green), "by variant");
  n: Col? = null;
  m: Col? = null;
  assert(same(n, m) && !same(n, Col.Red), "a nullable enum");
}
