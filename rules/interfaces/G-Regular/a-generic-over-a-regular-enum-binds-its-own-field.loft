//
// A GENERIC OVER A REGULAR ENUM BINDS ITS OWN FIELD (`@FR-G-Regular`, crossed with `@FR-G-Type`
// and `@FR-G-Mono`).  `enum Lst<T> { Nil, Cons { h: T, t: vector<Lst<T>> } }` names itself
// regularly, so it is a template with one instance per `T`.  A generic `fn f<T>(l: Lst<T>)`
// sees the OPEN instance `Lst<T>` and "each monomorph reads the instance its bindings close
// it to — its fields, its variants" (`G-Type`), so `match l { Cons { t } => … }` and `if l is
// Cons { t }` bind the variant's `t`.  Hand-computed: the list below has two cells.
//
// loft#2058: the template's own `t: vector<Lst<T>>` minted the open instance `Lst<T>` before
// its `Cons` variant had `t`, so inside a generic both spellings were refused on both backends.
//
// @falsified-at: 38a114cb9 — hand-measured, interpret and native: "variant Cons has no field 't'".
// CHANNEL: the asserts (today: a compile refusal).
// ARMED: no instrument.
// WITNESS: each message names the count read.
// HOLDS: the concrete spelling (`a-template-names-itself-at-its-own-variables.loft`).

enum Lst<T> { Nil, Cons { h: T, t: vector<Lst<T>> } }

fn by_match<T>(l: Lst<T>) -> integer {
  match l {
    Nil => 0,
    Cons { h: _, t } => if len(t) == 0 { 1 } else { 1 + by_match(t[0]) },
  }
}

fn by_is<T>(l: Lst<T>) -> integer {
  if l is Cons { t } { len(t) } else { -1 }
}

fn test_a_generic_binds_the_self_naming_field() {
  l: Lst<text> = Cons { h: "a", t: [Cons { h: "b", t: [] }] };
  n: Lst<integer> = Cons { h: 1, t: [] };
  assert(by_match(l) == 2 && by_match(n) == 1, "{by_match(l)} {by_match(n)}");
  assert(by_is(l) == 1 && by_is(n) == 0, "{by_is(l)} {by_is(n)}");
}
