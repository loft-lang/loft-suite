// @FR-G-Key
//
// The other module `2435-two-modules-private-generics-of-one-name-are-two-templates.loft`
// loads: a private `pick<T>` that answers its SECOND argument, under the name
// `g_key_2435_pick_a_lib` gives one answering its first.  Run on its own it is a cell too.
//
// Values hand-computed: pick(9, 2) is 2; pick("u", "v") is "v".
//
// @falsified-at: none — a conformance guard; the library's own calls answer as hand-computed.
// CHANNEL: the asserts.

fn pick<T>(x: T, y: T) -> T { y }

pub fn picked(a: integer, b: integer, s: text, t: text) -> text { "{pick(a, b)} {pick(s, t)}" }

fn test_the_module_answers_alone() {
  s = picked(9, 2, "u", "v");
  assert(s == "2 v", "pick b alone: {s}");
}
