//
// A TYPE VARIABLE IS A NAME ONLY INSIDE THE DEFINITION IT HEADS (`@FR-G-Gen-Scope`).  It reserves
// nothing outside: a declaration spelled like it — before or after the header, in the user's file
// or beside a default file's `<T>` placeholder — is its own name.  Two sections, each with its cells
// and receipt.
//
// ── a-type-variable-reserves-no-name ──
//
// A generic header's type variable is a name only inside the definition it heads, and
// reserves nothing outside it: a declaration spelled like it — before or after the header,
// of any kind — is neither refused nor mistaken for it (@FR-G-Gen-Scope).
//
// The variable's placeholder is minted under a name the source cannot write (`Q#1`), so
// no spelling is ever occupied; `def_nr_in_scope` is the one route from the spelling to
// the variable, and only inside the header's own definition.  The same declarations in
// the stdlib's own source — a REPL session, the test harness — are guarded by
// `issues::p158_trailing_comma_enum_variant` and
// `issues::a_declaration_spelled_like_a_stdlib_type_variable_compiles_in_source_0`.
//
// @falsified-at: ecd11af3f — interpret exit 134 -> 0, native exit 134 -> 0
// @falsified-by: tests/falsified/a-type-variable-reserves-no-name.patch — interpret exit 1 -> 0, native exit 1 -> 0
//   CHANNEL: exit — the control refuses the program, this tree runs it.  At ecd11af3f the
//     control hung instead (exit 134): its `match Q.Qb` reached the arm-skip loop
//     a-match-on-a-struct-name-cannot-hang-the-parser.loft guards; that loop is fixed.
//   ARMED: nothing.
//   WITNESS: on the control, "enum 'Q' conflicts with a struct of the same name".
//   HOLDS: every cell compiles and runs on both backends.

// ── generic FIRST, the enum after: `Q` means the variable inside, the enum outside ──
//
// ── typevar-placeholder-not-visible ──
//
// A generic `<T>` placeholder from the DEFAULT files does not occupy the name `T` in a
// user file.
//
// `Data::is_type_var_placeholder` already stated the rule: the attribute-less
// self-referential `Struct` the parser registers for a `<T>` type parameter "is an
// INTERNAL construct — it must never resolve as a real type outside the default files that
// declare it".  Nothing enforced it.  The stdlib's own generics (`min_of<T>` and friends)
// left a def named `T` in the flat key space, so a user's `enum T` collided with it and
// `T.N` failed with `Expect token ;` — pointing at a `;` whose syntax is fine.
//
// The rule is what makes SOURCE the right cut rather than the spelling: formal/interfaces.md
// defines a type variable as "a name bound by a generic header", so the binding is per
// header and never a global reservation of the letter.  A user file's OWN `fn f<T>(…)`
// therefore keeps working — its placeholder belongs to that file's source.
//
// Three lookups had to agree, which is why the first two fixes alone did not close it:
// the known-name branch, the forward-reference stub registration, and
// `parse_constant_value` — the last one consumed the `.` of `T.N` on its way to a variant
// that does not exist, which is where the misleading `;` error came from.

fn pick<Q>(a: Q, b: Q) -> Q { if false { b } else { a } }
enum Q { Qa, Qb }

// ── a struct FIRST, then a header spelling it: `K` inside `twice` is the variable ──
struct K { x: integer }
fn twice<K>(a: K) -> vector<K> { [a, a] }

// ── a type alias and a constant spelled like a header's variable ──
type V = integer;
fn same<V>(a: V) -> V { a }
W = 40;
fn keep<W>(a: W) -> W { a }

fn test_a_type_variable_reserves_no_name() {
  assert(pick(7, 8) == 7, "Q the variable, at integer");
  assert(pick("x", "y") == "x", "Q the variable, at text");
  assert(match Q.Qb { Qa => 1, Qb => 2 } == 2, "Q the enum, outside pick");

  v = twice(4);
  w = twice(K { x: 9 });
  assert(len(v) == 2 && v[1] == 4, "K the variable, at integer");
  assert(len(w) == 2 && w[1].x == 9, "K the variable, at the struct K");
  k = K { x: 3 };
  assert(k.x == 3, "K the struct, outside twice");

  n: V = 5;
  assert(same("t") == "t" && n + 1 == 6, "V the variable inside same, the alias outside");
  assert(keep(1.5) == 1.5 && W + 2 == 42, "W the variable inside keep, the constant outside");

  // ── the stdlib's own generics, whose variables are spelled `T` and `K` ──
  ps: vector<K> = [K { x: 3 }, K { x: 1 }, K { x: 2 }];
  ps.sort_by(|p| { p.x });
  assert("{ps[0].x}{ps[1].x}{ps[2].x}" == "123", "sort_by over the program's own K");
  assert(min_of([5, 2, 9]) == 2, "min_of<T>");
  println("ok");
}

fn test_typevar_placeholder_not_visible() {
  // ── a user enum named `T`, declared BELOW its use ────────────────────────────────────
  d = T.N;
  assert(match d { N => 1, S => 2 } == 1, "enum T declared below its use");

  // ── and one declared ABOVE, the direction that already worked ────────────────────────
  assert(match Up.Ya { Ya => 3, Yb => 4 } == 3, "enum declared above");

  // ── a user generic still resolves its own type variable ──────────────────────────────
  assert(s2_pick(3, 4) == 3, "user generic over integer");
  assert(s2_pick("x", "y") == "x", "the same generic over text");
  w = wrap(7);
  assert(len(w) == 1 && w[0] == 7, "a generic returning vector<T>");

  // ── a STDLIB generic still works: its placeholder is visible where it was declared ───
  v = [3, 1, 2];
  assert(min_of(v) == 1, "stdlib generic min_of");

  // ── a user generic whose parameter is spelled like a declaration in the same file is
  //    no conflict either: the header's variable occupies no name (@FR-G-Gen-Scope), and
  //    `tests/scripts/a-type-variable-reserves-no-name.loft` guards both orders.

  // ── other one-letter type names keep working beside `T` ──────────────────────────────
  assert(match U.Ua { Ua => 5, Ub => 6 } == 5, "one-letter enum U");
}

enum Up { Ya, Yb }

fn s2_pick<Elem>(a: Elem, b: Elem) -> Elem { if false { b } else { a } }
fn wrap<Elem>(x: Elem) -> vector<Elem> { [x] }

enum T { N, S }
enum U { Ua, Ub }
