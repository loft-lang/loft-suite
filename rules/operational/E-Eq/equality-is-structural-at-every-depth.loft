//
// `@FR-E-Eq` crossed with `@FR-Op-Eq`: `==` is structural on every type at every depth — a
// struct holding a struct holding a vector and a text, a struct-enum with a payload, a tuple
// with a text member, a vector of structs — and an absent record equals only null.  Every cell
// held on both backends when written; the ledger row is in doc/claude/RULE_CROSSINGS-history.md.
//
// CHANNEL: the assertions.

struct S { v: vector<integer>, t: text }
struct O { s: S, k: integer }
struct P { x: integer, y: integer }
enum E { A { n: integer, t: text }, B }

fn test_structural_at_every_depth() {
  a = O { s: S { v: [1, 2], t: "x" }, k: 1 };
  b = O { s: S { v: [1, 2], t: "x" }, k: 1 };
  c = O { s: S { v: [1, 3], t: "x" }, k: 1 };
  n: O? = null;
  assert("{a == b} {a == c} {a != c} {n == a} {n == null}" == "true false true false true", "records");
  x: E = A { n: 1, t: "p" };
  y: E = A { n: 1, t: "p" };
  z: E = A { n: 1, t: "q" };
  t1 = (1, "a");
  t2 = (1, "b");
  assert("{x == y} {x == z} {t1 == (1, "a")} {t1 == t2}" == "true false true false", "enums and tuples");
  p = [P { x: 1, y: 2 }, P { x: 3, y: 4 }];
  q = [P { x: 1, y: 2 }, P { x: 3, y: 4 }];
  r = [P { x: 1, y: 2 }];
  assert(p == q && p != r, "vectors of structs");
}
