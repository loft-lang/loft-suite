//
// `@FR-E-Seq` crossed with `@FR-F-Block` — F-Block: a `{ … }` block ending in an expression
// YIELDS it "wherever the block stands", and is discarded only where the block itself is a
// statement (a `;`-terminated one, a loop body, a dropped function body).  So inside
// `z = { { 4 } - 1 };` the inner block is not `;`-terminated and is read by `-`: the rule's
// answer is 4 - 1 = 3.
//
// loft#2040 — it was dropped: the parser closed the inner block as a STATEMENT, dropped its 4
// (E-Seq) and read `- 1` as a unary minus, so `z` was -1, silently, on both backends, and
// `{ { 4 } + 1 }` was refused with a message naming an internal operator.  Owner ruling
// 2026-10-18: each block returns its last expression.  A VOID block still ends its statement,
// as an `if` does — the last cell holds that half.
//
// @falsified-at: 7ea99d900 — hand-measured, interpret and native: `z` is -1 and the `+` / `*`
//   cells are refused.
// ARMED: no instrument.
// CHANNEL: the value of `z`.

fn test_the_spellings_that_already_continue() {
  a = { ({ 4 }) - 1 };
  b = { if true { 4 } else { 5 } + 1 };
  assert(a == 3 && b == 5, "parenthesised block 4-1 = 3, an if-expression 4+1 = 5: got {a} {b}");
}

fn test_a_block_before_minus_is_an_operand() {
  z = { { 4 } - 1 };
  assert(z == 3, "F-Block: the inner block yields 4, read by `-`: 4 - 1 = 3; got {z}");
}

fn test_every_operator_and_the_function_tail() {
  a = { { 4 } + 1 };
  b = { { 4 } * 2 };
  c = { { 4 } == 4 };
  n = { { { 2 } * 3 } + 1 };
  t = { { "a" } + "b" };
  assert(a == 5 && b == 8 && c && n == 7 && t == "ab", "4+1, 4*2, true, 2*3+1, ab: {a} {b} {c} {n} {t}");
  assert(tail_minus() == 3 && tail_alone() == 4, "a function tail: {tail_minus()} {tail_alone()}");
}

fn tail_minus() -> integer { { 4 } - 1 }
fn tail_alone() -> integer { { 4 } }

fn test_a_void_block_still_ends_its_statement() {
  x = 1;
  { x = 7; }
  -1;
  y = 2;
  { y = 5; }
  (y, x) = (x, y);
  assert(x == 5 && y == 7, "the `-1;` and `(y, x)` lines are statements of their own: {x} {y}");
}
