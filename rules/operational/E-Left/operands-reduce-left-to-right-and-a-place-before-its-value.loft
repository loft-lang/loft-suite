//
// OPERANDS REDUCE LEFT TO RIGHT, AND A PLACE BEFORE ITS VALUE (`@FR-E-Left`, `@FR-E-Asgn`, loft#2451).
// A record value that writes a variable its place reads lands where the place was when it ran; a
// tuple literal, a format string and a compound assignment reduce each operand in order.  Two
// sections, each with its cells and receipt.
//
// ── 2451-a-record-assigned-into-an-element-lands-where-the-place-was-when-it-ran ──
//
// loft#2451, `@FR-E-Left` / `@FR-E-Asgn` — THE PLACE IS REDUCED BEFORE THE VALUE, for a record too.
//
// A record value that writes a variable its place reads (`v[j] = It { n: bump(j) }`, `bump`
// taking `&integer`) lands in the element the place named when the assignment began, every
// field of it; a literal local copied into an element later (`w = It{…}; m = 1; u[m] = w`)
// lands where the index is when the copy runs.  A scalar element, an index written before the
// build, a compound write inside the value and the assignment in a loop are the other axes.
//
// @falsified-at: loft main dbf8b05ae — e1 "1a 200b 3z " (fields split across two elements),
//   e3 "7z 2b 3c " (built into u[0]); both backends.
// CHANNEL: the assertions and the leak gate.
//
// ── each-operand-of-a-literal-a-format-and-a-compound-is-reduced-left-to-right ──
//
// `@FR-E-Left` crossed with the forms that hold several operands and that no cell cited with
// it: a tuple literal (`@FR-T-Cons`), a format string (`@FR-F-Interp`) and a compound
// assignment, whose place is reduced before its right side and exactly once
// (`@FR-E-Asgn-Compound`) — at an element, a struct field of an element, a nested index and a
// text element.  A counter with an effect makes the order observable; every value is
// hand-computed from the rule.  Every cell held on both backends when written; the ledger row
// is in doc/claude/RULE_CROSSINGS-history.md.
//
// CHANNEL: the assertions.

struct It { n: integer, t: text }
struct O { f: It }
fn bump(i: &integer) -> integer { i += 1; i * 100 }
fn show(v: vector<It>) -> text { s = ""; for e in v { s += "{e.n}{e.t} "; } s }
fn base() -> vector<It> { [It { n: 1, t: "a" }, It { n: 2, t: "b" }, It { n: 3, t: "c" }] }
fn test_a_record_assigned_into_an_element_lands_where_the_place_was_when_it_ra() {
  v = base(); j = 1;
  v[j] = It { n: bump(j), t: "z" };
  assert(show(v) == "1a 200z 3c ", "e1 {show(v)}");
  os = [O { f: It { n: 1, t: "a" } }, O { f: It { n: 2, t: "b" } }]; k = 0;
  os[k].f = It { n: bump(k), t: "z" };
  assert("{os[0].f.n}{os[0].f.t} {os[1].f.n}{os[1].f.t}" == "100z 2b", "e2");
  u = base(); m = 0;
  w = It { n: 7, t: "z" };
  m = 1;
  u[m] = w;
  assert("{show(u)}{m}" == "1a 7z 3c 1", "e3 {show(u)}");
  s = [1, 2, 3]; i = 0;
  s[i] = bump(i);
  assert("{s[0]} {s[1]} {s[2]} {i}" == "100 2 3 1", "e4 {s[0]} {s[1]} {i}");
  u2 = base(); m2 = 1;
  w2 = It { n: 7, t: "z" };
  u2[m2] = w2;
  assert(show(u2) == "1a 7z 3c ", "e5 {show(u2)}");
  v6 = base(); j6 = 1;
  v6[j6] = It { n: { j6 += 1; j6 }, t: "z" };
  assert(show(v6) == "1a 2z 3c " && j6 == 2, "e6 {show(v6)} {j6}");
  v7 = base();
  for ii in 0..3 { kk = ii; v7[kk] = It { n: bump(kk), t: "q" }; }
  assert(show(v7) == "100q 200q 300q ", "e7 {show(v7)}");
  println("e-left ok");
}

struct P { y: integer }

fn tick(c: &integer) -> integer { c += 1; c }

fn test_literals_and_formats_reduce_left_to_right() {
  n = 0;
  t = (tick(n), tick(n), tick(n));
  assert(t.0 == 1 && t.1 == 2 && t.2 == 3 && n == 3, "tuple: {t.0}{t.1}{t.2}");
  m = 0;
  s = "{tick(m)}-{tick(m)}-{tick(m)}";
  assert(s == "1-2-3" && m == 3, "format: {s}");
}

fn test_a_compound_reduces_its_place_first_and_once() {
  v = [10, 20, 30];
  n = 0;
  v[tick(n)] += tick(n) * 100;
  assert(v[0] == 10 && v[1] == 220 && v[2] == 30 && n == 2, "element: {v[1]} {n}");
  w = [P { y: 1 }, P { y: 2 }];
  n = 0;
  w[tick(n)].y += 5;
  assert(w[0].y == 1 && w[1].y == 7 && n == 1, "field: {w[1].y} {n}");
  m = [[0, 0], [0, 5]];
  n = 0;
  m[tick(n)][tick(n) - 1] += 5;
  assert(m[1][1] == 10 && m[0][1] == 0 && n == 2, "nested: {m[1][1]} {n}");
  ts = ["a", "b"];
  n = 0;
  ts[tick(n) - 1] += "x{tick(n)}";
  assert(ts[0] == "ax2" && ts[1] == "b" && n == 2, "text: {ts[0]} {n}");
}
