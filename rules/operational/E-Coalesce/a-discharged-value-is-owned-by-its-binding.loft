//
// A DISCHARGED VALUE IS OWNED BY ITS BINDING (`@FR-E-Coalesce`, `@FR-B-Copy`, loft#2300).  `x ?? mk()`
// binds the call's nested container as the binding's own, and `x ?? panic(…)` on a record local
// consumed in place copies nothing and leaks nothing.  Two sections, each with its cells and
// receipt.
//
// ── a-call-default-of-a-nested-container-is-owned-by-its-binding ──
//
// A CALL DEFAULT OF A NESTED CONTAINER IS OWNED BY ITS BINDING (`@FR-E-Coalesce`, `@FR-B-Copy`).
// `x ?? mk()` where `mk` returns a `vector<vector<integer>>` was the one pairing the axes report
// found no file crossing (`matrix_axes.py cross A6 A7`: call × nested-container, 0 files).  The
// default's store is minted per evaluation and the binding owns whichever arm ran, so the cells
// vary what the axes never met together: the subject (a local null and present, a call, a
// struct field, a parameter), the evaluation count (once, alternating in a loop, kept across
// passes), and what happens after (a write and an append through the binding, a second call).
// Every expected value is worked out by hand in the cell's message; the file runs under the
// corpus's leak gate, which is the channel a wrong owner would fire on.
//
// @falsified-at: none — a conformance guard at a crossing no file reached; every cell answered
//   right on both backends and clean under LOFT_STRICT_STORES on the tree it landed on.
// CHANNEL: the asserts, and the corpus's leak gate for the per-pass default store.
// ARMED: the leak gate by the script corpus runner (wrap.rs).
// WITNESS: the cell's message names the value that moved.
// HOLDS: every cell on both backends.
//
// ── a-discharged-local-consumed-in-place-leaks-no-copy ──
//
// A DISCHARGED LOCAL CONSUMED IN PLACE LEAKS NO COPY (`@FR-E-Coalesce`, loft#2300).  `x ?? panic(…)` answers `x`
// or leaves; on a record or struct-enum LOCAL it bound `x` to a temp typed with no dep, so the
// temp read as an owner and `@FR-B-Copy` copied the record into it.  Bound to a local first,
// the copy became that local's store; consumed in place — a call argument, a comparison
// operand — nothing freed it, one record per discharge.  A plain variable is now tested and
// answered as itself.  Values are hand-computed; the exit leak check is the channel.
//
// @falsified-at: 9e6425727 — interpret leaked kt=100 Own×4, kt=103 Pt×1 -> clean, native exit 1 -> 0, native leaked kt=100 Own×4, kt=103 Pt×1 -> clean
// CHANNEL: the leak — the exit check's `stores not freed` line.
// ARMED: nothing — the interpreter's default exit leak check prints it.
// HOLDS: the values are equal on both trees and both backends.

struct H { g: vector<vector<integer>>? }

fn mk(k: integer) -> vector<vector<integer>> { [[k, k + 1], [k + 2]] }
fn opt(z: boolean) -> vector<vector<integer>>? { if z { null } else { [[8]] } }
fn pick(x: vector<vector<integer>>?) -> integer {
  v = x ?? mk(5);
  if len(v) > 1 { v[1][0] ?? 0 } else { v[0][0] ?? 0 }
}

fn test_a_call_default_of_a_nested_container_is_owned_by_its_binding() {
  x1: vector<vector<integer>>? = null;
  v1 = x1 ?? mk(3);
  assert("{v1}" == "[[3,4],[5]]" && len(v1) == 2, "null subject takes mk(3): {v1}");
  x2: vector<vector<integer>>? = [[9]];
  v2 = x2 ?? mk(3);
  assert("{v2}" == "[[9]]", "present subject: {v2}");
  // i=0 mk(0) -> 0; i=1 [[10]] -> 10; i=2 mk(2) -> 2; i=3 [[30]] -> 30
  s = 0;
  for i in 0..4 {
    x: vector<vector<integer>>? = if i % 2 == 1 { [[i * 10]] } else { null };
    v = x ?? mk(i);
    s += v[0][0] ?? 0;
  }
  assert(s == 42, "alternating in a loop: {s}");
  x4: vector<vector<integer>>? = null;
  v4 = x4 ?? mk(3);
  v4 += [[7]];
  v4[0][0] = 99;
  assert("{v4}" == "[[99,4],[5],[7]]" && "{mk(3)}" == "[[3,4],[5]]", "written after: {v4}");
  a = opt(true) ?? mk(1);
  b = opt(false) ?? mk(1);
  assert("{a}" == "[[1,2],[3]]" && "{b}" == "[[8]]", "a call subject: {a} {b}");
  // lengths 2, 1, 2
  all: vector<vector<vector<integer>>> = [];
  for i in 0..3 {
    x: vector<vector<integer>>? = if i == 1 { [[10]] } else { null };
    kept = x ?? mk(i);
    all += [kept];
  }
  n = 0;
  for e in all { n += len(e); }
  assert(n == 5 && (all[2][0][0] ?? 0) == 2 && len(all) == 3, "kept across passes: {n}");
  h = H { g: null };
  v7 = h.g ?? mk(4);
  h.g = [[1]];
  assert("{v7}" == "[[4,5],[6]]" && "{h.g ?? [[0]]}" == "[[1]]", "a struct field subject: {v7}");
  assert(pick(null) == 7 && pick([[2]]) == 2, "a parameter subject: {pick(null)} {pick([[2]])}");
  println("a call default of a nested container is owned by its binding: every cell holds");
}

enum Own {
  Owned,
  Borrowed { base: integer },
}

struct Pt { x: integer, y: integer }

fn s2_pick(c: integer) -> Own? {
  if c == 0 { null } else { Borrowed { base: c } }
}

fn pt(c: integer) -> Pt? {
  if c == 0 { null } else { Pt { x: c, y: c * 2 } }
}

fn show(o: Own) -> text {
  match o {
    Owned => "Owned",
    Borrowed { base } => "B{base}",
  }
}

fn total(p: Pt) -> integer {
  p.x + p.y
}

fn test_a_discharged_local_consumed_in_place_leaks_no_copy() {
  f = s2_pick(3);
  p = pt(4);
  // A call argument.
  assert(show(f ?? panic("f")) == "B3", "show = {show(f ?? panic("f"))}");
  // A comparison operand, twice.
  assert((f ?? panic("f")) == (f ?? panic("f")), "f equals itself");
  assert((f ?? panic("f")) != Owned, "B3 is not Owned");
  // A plain struct as a call argument: 4 + 8.
  assert(total(p ?? panic("p")) == 12, "total = {total(p ?? panic("p"))}");
  // Bound first: the bind's own copy is the local's, as before.
  h = f ?? panic("f");
  assert(show(h) == "B3", "h = {show(h)}");
  println("discharge in place ok");
}
