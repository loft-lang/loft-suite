//
// `@FR-Slice-Value` — a vector slice is the fresh vector a bind makes of it wherever a vector is
// expected, and that includes the collection a built-in walks and the receiver of an index.
// `map`, `filter`, `reduce` and `par_fold` refused a slice as their first argument ("first
// argument must be a vector"), and an indexed or re-sliced slice (`v[1..][0]`, `v[1..][1..]`)
// was refused as "Indexing a non vector", while `for`, `par`, `len` and a method took it.
// Each case reads a slice of a local and of a call, and asserts the call ran once.
// Values by hand: v = [10, 20, 30, 40]; v[1..3] = [20, 30], v[1..] = [20, 30, 40].
// @falsified-by: tests/falsified/a-slice-is-a-vector-to-the-builtins-that-walk-one-and-to-an-index.patch — interpret exit 1 -> 0, native exit 1 -> 0
// CHANNEL: the assertions — the control build refuses every case at compile time.

struct Ctr { calls: integer = 0 }

fn inc1(x: integer) -> integer { x + 1 }
fn add(a: integer, b: integer) -> integer { a + b }
fn big(x: integer) -> boolean { x > 20 }
fn mkv(c: Ctr) -> vector<integer> { c.calls += 1; [10, 20, 30, 40] }

fn test_the_walking_builtins_take_a_slice() {
  v = [10, 20, 30, 40];
  m = map(v[1..3], inc1);
  f = filter(v[1..], big);
  r = reduce(v[1..3], 0, add);
  p = par_fold(v[1..3], 0, add, 2);
  assert("{m}" == "[21,31]" && "{f}" == "[30,40]" && r == 50 && p == 50, "{m} {f} {r} {p}");
  assert(len(v) == 4 && v[0] == 10, "the source is untouched: {v}");
}

fn test_a_slice_of_a_call_runs_the_call_once() {
  c = Ctr {};
  m = map(mkv(c)[1..3], inc1);
  r = reduce(mkv(c)[2..], 0, add);
  assert("{m}" == "[21,31]" && r == 70 && c.calls == 2, "{m} {r} {c.calls}");
}

fn test_an_indexed_and_a_resliced_slice() {
  v = [10, 20, 30, 40];
  a = v[1..][0];
  b = v[1..][1..];
  c = Ctr {};
  d = mkv(c)[2..][1];
  assert(a == 20 && "{b}" == "[30,40]" && d == 40 && c.calls == 1, "{a} {b} {d} {c.calls}");
}
