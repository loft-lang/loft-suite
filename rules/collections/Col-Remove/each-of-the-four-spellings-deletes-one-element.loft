//
// EACH OF THE FOUR SPELLINGS DELETES ONE ELEMENT (`@FR-Col-Remove`, `@FR-Col-RemoveDense`,
// `@FR-Col-RemoveKeyed`, `@FR-Col-Len`).  `v.remove(i)` shifts every later element down one;
// `x#remove` in a `for` over a vector deletes the current element and the walk goes on; `c[key] =
// null` deletes by key and leaves every other key reachable; `e#remove` in a `for` over a keyed
// collection does the same.  A position past the end and an absent key remove nothing.
//
// @falsified-at: none — a conformance guard for a rule no test named; every cell answered as the
//   rule says on both backends on the tree it landed on.
// CHANNEL: the asserts, and the suite's leak gate for each removed record.
// ARMED: `LOFT_LEAK_CHECK=1` (the suite arms it on every run).
// WITNESS: each message names the collection after the removal.
// HOLDS: every cell on both backends.

struct E { k: integer, v: integer }
fn test_four_spellings() {
  // v.remove(i): dense, shifts
  v = [10, 20, 30, 40];
  v.remove(1);
  assert("{v}" == "[10,30,40]" && len(v) == 3 && v[1] == 30, "remove(1) shifts: {v}");
  // v#remove inside a for: removes the current element
  w = [1, 2, 3, 4, 5, 6];
  for x in w { if x % 2 == 0 { x#remove; } }
  assert("{w}" == "[1,3,5]" && len(w) == 3, "#remove in a for: {w}");
  // c[key] = null: keyed, by key
  h: hash<E[k]> = [E { k: 1, v: 10 }, E { k: 2, v: 20 }, E { k: 3, v: 30 }];
  h[2] = null;
  assert(len(h) == 2 && h[2] == null && (h[3].v ?? -1) == 30 && (h[1].v ?? -1) == 10, "h[2] = null");
  // e#remove on a keyed for
  s: sorted<E[k]> = [E { k: 1, v: 10 }, E { k: 2, v: 20 }, E { k: 3, v: 30 }];
  for e in s { if e.k != 2 { e#remove; } }
  assert(len(s) == 1 && (s[2].v ?? -1) == 20, "e#remove on a sorted: {len(s)}");
}
fn test_remove_out_of_range_and_absent_key() {
  v = [10, 20];
  v.remove(5);
  assert(len(v) == 2, "remove past the end removes nothing: {len(v)}");
  h: hash<E[k]> = [E { k: 1, v: 10 }];
  h[9] = null;
  assert(len(h) == 1, "an absent key removes nothing");
}
