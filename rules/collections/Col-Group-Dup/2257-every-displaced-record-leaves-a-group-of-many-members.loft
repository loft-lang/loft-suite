//
// EVERY DISPLACED RECORD LEAVES A GROUP OF MANY MEMBERS (@FR-Col-Group-Dup, loft#2257).  A
// record entering a linked group displaces, in each keyed member, the record that member held
// under the new record's key; every one of those leaves EVERY keyed member, and with no vector
// member nothing holds it any more.  The C runtime collected the displaced records in a list of
// sixteen, so in a group of more than sixteen keyed members the seventeenth displaced record
// stayed filed in the others: a length of 2 where the interpreter answered 1.
//
// Axes this file MOVES:  the number of keyed members, either side of the old bound (16, 17,
//                        24), and so the number of distinct records one insert displaces.
// Axes it HOLDS FIXED:   hash members only, integer keys, no vector member, one text per record.
//
// Expected values by hand: record j holds key 100 in field j and j*1000 + i + 1 in every
// other field i, so the members hold n records each and no two share a key.  The last record
// holds 100 in every field: in member j it displaces record j, and record j then leaves every
// other member, so every member ends holding the last record alone — length 1, name "x".

struct G16 { k0: integer, k1: integer, k2: integer, k3: integer, k4: integer, k5: integer, k6: integer, k7: integer, k8: integer, k9: integer, k10: integer, k11: integer, k12: integer, k13: integer, k14: integer, k15: integer, nm: text }
struct Grp16 { h0: hash<G16[k0]>, h1: hash<G16[k1]>, h2: hash<G16[k2]>, h3: hash<G16[k3]>, h4: hash<G16[k4]>, h5: hash<G16[k5]>, h6: hash<G16[k6]>, h7: hash<G16[k7]>, h8: hash<G16[k8]>, h9: hash<G16[k9]>, h10: hash<G16[k10]>, h11: hash<G16[k11]>, h12: hash<G16[k12]>, h13: hash<G16[k13]>, h14: hash<G16[k14]>, h15: hash<G16[k15]> }
fn test_group_of_16() {
  g = Grp16 { };
  g.h0 += [G16 { k0: 100, k1: 2, k2: 3, k3: 4, k4: 5, k5: 6, k6: 7, k7: 8, k8: 9, k9: 10, k10: 11, k11: 12, k12: 13, k13: 14, k14: 15, k15: 16, nm: "r0" }];
  g.h0 += [G16 { k0: 1001, k1: 100, k2: 1003, k3: 1004, k4: 1005, k5: 1006, k6: 1007, k7: 1008, k8: 1009, k9: 1010, k10: 1011, k11: 1012, k12: 1013, k13: 1014, k14: 1015, k15: 1016, nm: "r1" }];
  g.h0 += [G16 { k0: 2001, k1: 2002, k2: 100, k3: 2004, k4: 2005, k5: 2006, k6: 2007, k7: 2008, k8: 2009, k9: 2010, k10: 2011, k11: 2012, k12: 2013, k13: 2014, k14: 2015, k15: 2016, nm: "r2" }];
  g.h0 += [G16 { k0: 3001, k1: 3002, k2: 3003, k3: 100, k4: 3005, k5: 3006, k6: 3007, k7: 3008, k8: 3009, k9: 3010, k10: 3011, k11: 3012, k12: 3013, k13: 3014, k14: 3015, k15: 3016, nm: "r3" }];
  g.h0 += [G16 { k0: 4001, k1: 4002, k2: 4003, k3: 4004, k4: 100, k5: 4006, k6: 4007, k7: 4008, k8: 4009, k9: 4010, k10: 4011, k11: 4012, k12: 4013, k13: 4014, k14: 4015, k15: 4016, nm: "r4" }];
  g.h0 += [G16 { k0: 5001, k1: 5002, k2: 5003, k3: 5004, k4: 5005, k5: 100, k6: 5007, k7: 5008, k8: 5009, k9: 5010, k10: 5011, k11: 5012, k12: 5013, k13: 5014, k14: 5015, k15: 5016, nm: "r5" }];
  g.h0 += [G16 { k0: 6001, k1: 6002, k2: 6003, k3: 6004, k4: 6005, k5: 6006, k6: 100, k7: 6008, k8: 6009, k9: 6010, k10: 6011, k11: 6012, k12: 6013, k13: 6014, k14: 6015, k15: 6016, nm: "r6" }];
  g.h0 += [G16 { k0: 7001, k1: 7002, k2: 7003, k3: 7004, k4: 7005, k5: 7006, k6: 7007, k7: 100, k8: 7009, k9: 7010, k10: 7011, k11: 7012, k12: 7013, k13: 7014, k14: 7015, k15: 7016, nm: "r7" }];
  g.h0 += [G16 { k0: 8001, k1: 8002, k2: 8003, k3: 8004, k4: 8005, k5: 8006, k6: 8007, k7: 8008, k8: 100, k9: 8010, k10: 8011, k11: 8012, k12: 8013, k13: 8014, k14: 8015, k15: 8016, nm: "r8" }];
  g.h0 += [G16 { k0: 9001, k1: 9002, k2: 9003, k3: 9004, k4: 9005, k5: 9006, k6: 9007, k7: 9008, k8: 9009, k9: 100, k10: 9011, k11: 9012, k12: 9013, k13: 9014, k14: 9015, k15: 9016, nm: "r9" }];
  g.h0 += [G16 { k0: 10001, k1: 10002, k2: 10003, k3: 10004, k4: 10005, k5: 10006, k6: 10007, k7: 10008, k8: 10009, k9: 10010, k10: 100, k11: 10012, k12: 10013, k13: 10014, k14: 10015, k15: 10016, nm: "r10" }];
  g.h0 += [G16 { k0: 11001, k1: 11002, k2: 11003, k3: 11004, k4: 11005, k5: 11006, k6: 11007, k7: 11008, k8: 11009, k9: 11010, k10: 11011, k11: 100, k12: 11013, k13: 11014, k14: 11015, k15: 11016, nm: "r11" }];
  g.h0 += [G16 { k0: 12001, k1: 12002, k2: 12003, k3: 12004, k4: 12005, k5: 12006, k6: 12007, k7: 12008, k8: 12009, k9: 12010, k10: 12011, k11: 12012, k12: 100, k13: 12014, k14: 12015, k15: 12016, nm: "r12" }];
  g.h0 += [G16 { k0: 13001, k1: 13002, k2: 13003, k3: 13004, k4: 13005, k5: 13006, k6: 13007, k7: 13008, k8: 13009, k9: 13010, k10: 13011, k11: 13012, k12: 13013, k13: 100, k14: 13015, k15: 13016, nm: "r13" }];
  g.h0 += [G16 { k0: 14001, k1: 14002, k2: 14003, k3: 14004, k4: 14005, k5: 14006, k6: 14007, k7: 14008, k8: 14009, k9: 14010, k10: 14011, k11: 14012, k12: 14013, k13: 14014, k14: 100, k15: 14016, nm: "r14" }];
  g.h0 += [G16 { k0: 15001, k1: 15002, k2: 15003, k3: 15004, k4: 15005, k5: 15006, k6: 15007, k7: 15008, k8: 15009, k9: 15010, k10: 15011, k11: 15012, k12: 15013, k13: 15014, k14: 15015, k15: 100, nm: "r15" }];
  assert(len(g.h0) == 16 && len(g.h15) == 16, "filled 16: {len(g.h0)}");
  g.h0 += [G16 { k0: 100, k1: 100, k2: 100, k3: 100, k4: 100, k5: 100, k6: 100, k7: 100, k8: 100, k9: 100, k10: 100, k11: 100, k12: 100, k13: 100, k14: 100, k15: 100, nm: "x" }];
  assert(len(g.h0) == 1 && g.h0[100].nm == "x", "16 members, h0: {len(g.h0)}");
  assert(len(g.h1) == 1 && g.h1[100].nm == "x", "16 members, h1: {len(g.h1)}");
  assert(len(g.h2) == 1 && g.h2[100].nm == "x", "16 members, h2: {len(g.h2)}");
  assert(len(g.h3) == 1 && g.h3[100].nm == "x", "16 members, h3: {len(g.h3)}");
  assert(len(g.h4) == 1 && g.h4[100].nm == "x", "16 members, h4: {len(g.h4)}");
  assert(len(g.h5) == 1 && g.h5[100].nm == "x", "16 members, h5: {len(g.h5)}");
  assert(len(g.h6) == 1 && g.h6[100].nm == "x", "16 members, h6: {len(g.h6)}");
  assert(len(g.h7) == 1 && g.h7[100].nm == "x", "16 members, h7: {len(g.h7)}");
  assert(len(g.h8) == 1 && g.h8[100].nm == "x", "16 members, h8: {len(g.h8)}");
  assert(len(g.h9) == 1 && g.h9[100].nm == "x", "16 members, h9: {len(g.h9)}");
  assert(len(g.h10) == 1 && g.h10[100].nm == "x", "16 members, h10: {len(g.h10)}");
  assert(len(g.h11) == 1 && g.h11[100].nm == "x", "16 members, h11: {len(g.h11)}");
  assert(len(g.h12) == 1 && g.h12[100].nm == "x", "16 members, h12: {len(g.h12)}");
  assert(len(g.h13) == 1 && g.h13[100].nm == "x", "16 members, h13: {len(g.h13)}");
  assert(len(g.h14) == 1 && g.h14[100].nm == "x", "16 members, h14: {len(g.h14)}");
  assert(len(g.h15) == 1 && g.h15[100].nm == "x", "16 members, h15: {len(g.h15)}");
}

struct G17 { k0: integer, k1: integer, k2: integer, k3: integer, k4: integer, k5: integer, k6: integer, k7: integer, k8: integer, k9: integer, k10: integer, k11: integer, k12: integer, k13: integer, k14: integer, k15: integer, k16: integer, nm: text }
struct Grp17 { h0: hash<G17[k0]>, h1: hash<G17[k1]>, h2: hash<G17[k2]>, h3: hash<G17[k3]>, h4: hash<G17[k4]>, h5: hash<G17[k5]>, h6: hash<G17[k6]>, h7: hash<G17[k7]>, h8: hash<G17[k8]>, h9: hash<G17[k9]>, h10: hash<G17[k10]>, h11: hash<G17[k11]>, h12: hash<G17[k12]>, h13: hash<G17[k13]>, h14: hash<G17[k14]>, h15: hash<G17[k15]>, h16: hash<G17[k16]> }
fn test_group_of_17() {
  g = Grp17 { };
  g.h0 += [G17 { k0: 100, k1: 2, k2: 3, k3: 4, k4: 5, k5: 6, k6: 7, k7: 8, k8: 9, k9: 10, k10: 11, k11: 12, k12: 13, k13: 14, k14: 15, k15: 16, k16: 17, nm: "r0" }];
  g.h0 += [G17 { k0: 1001, k1: 100, k2: 1003, k3: 1004, k4: 1005, k5: 1006, k6: 1007, k7: 1008, k8: 1009, k9: 1010, k10: 1011, k11: 1012, k12: 1013, k13: 1014, k14: 1015, k15: 1016, k16: 1017, nm: "r1" }];
  g.h0 += [G17 { k0: 2001, k1: 2002, k2: 100, k3: 2004, k4: 2005, k5: 2006, k6: 2007, k7: 2008, k8: 2009, k9: 2010, k10: 2011, k11: 2012, k12: 2013, k13: 2014, k14: 2015, k15: 2016, k16: 2017, nm: "r2" }];
  g.h0 += [G17 { k0: 3001, k1: 3002, k2: 3003, k3: 100, k4: 3005, k5: 3006, k6: 3007, k7: 3008, k8: 3009, k9: 3010, k10: 3011, k11: 3012, k12: 3013, k13: 3014, k14: 3015, k15: 3016, k16: 3017, nm: "r3" }];
  g.h0 += [G17 { k0: 4001, k1: 4002, k2: 4003, k3: 4004, k4: 100, k5: 4006, k6: 4007, k7: 4008, k8: 4009, k9: 4010, k10: 4011, k11: 4012, k12: 4013, k13: 4014, k14: 4015, k15: 4016, k16: 4017, nm: "r4" }];
  g.h0 += [G17 { k0: 5001, k1: 5002, k2: 5003, k3: 5004, k4: 5005, k5: 100, k6: 5007, k7: 5008, k8: 5009, k9: 5010, k10: 5011, k11: 5012, k12: 5013, k13: 5014, k14: 5015, k15: 5016, k16: 5017, nm: "r5" }];
  g.h0 += [G17 { k0: 6001, k1: 6002, k2: 6003, k3: 6004, k4: 6005, k5: 6006, k6: 100, k7: 6008, k8: 6009, k9: 6010, k10: 6011, k11: 6012, k12: 6013, k13: 6014, k14: 6015, k15: 6016, k16: 6017, nm: "r6" }];
  g.h0 += [G17 { k0: 7001, k1: 7002, k2: 7003, k3: 7004, k4: 7005, k5: 7006, k6: 7007, k7: 100, k8: 7009, k9: 7010, k10: 7011, k11: 7012, k12: 7013, k13: 7014, k14: 7015, k15: 7016, k16: 7017, nm: "r7" }];
  g.h0 += [G17 { k0: 8001, k1: 8002, k2: 8003, k3: 8004, k4: 8005, k5: 8006, k6: 8007, k7: 8008, k8: 100, k9: 8010, k10: 8011, k11: 8012, k12: 8013, k13: 8014, k14: 8015, k15: 8016, k16: 8017, nm: "r8" }];
  g.h0 += [G17 { k0: 9001, k1: 9002, k2: 9003, k3: 9004, k4: 9005, k5: 9006, k6: 9007, k7: 9008, k8: 9009, k9: 100, k10: 9011, k11: 9012, k12: 9013, k13: 9014, k14: 9015, k15: 9016, k16: 9017, nm: "r9" }];
  g.h0 += [G17 { k0: 10001, k1: 10002, k2: 10003, k3: 10004, k4: 10005, k5: 10006, k6: 10007, k7: 10008, k8: 10009, k9: 10010, k10: 100, k11: 10012, k12: 10013, k13: 10014, k14: 10015, k15: 10016, k16: 10017, nm: "r10" }];
  g.h0 += [G17 { k0: 11001, k1: 11002, k2: 11003, k3: 11004, k4: 11005, k5: 11006, k6: 11007, k7: 11008, k8: 11009, k9: 11010, k10: 11011, k11: 100, k12: 11013, k13: 11014, k14: 11015, k15: 11016, k16: 11017, nm: "r11" }];
  g.h0 += [G17 { k0: 12001, k1: 12002, k2: 12003, k3: 12004, k4: 12005, k5: 12006, k6: 12007, k7: 12008, k8: 12009, k9: 12010, k10: 12011, k11: 12012, k12: 100, k13: 12014, k14: 12015, k15: 12016, k16: 12017, nm: "r12" }];
  g.h0 += [G17 { k0: 13001, k1: 13002, k2: 13003, k3: 13004, k4: 13005, k5: 13006, k6: 13007, k7: 13008, k8: 13009, k9: 13010, k10: 13011, k11: 13012, k12: 13013, k13: 100, k14: 13015, k15: 13016, k16: 13017, nm: "r13" }];
  g.h0 += [G17 { k0: 14001, k1: 14002, k2: 14003, k3: 14004, k4: 14005, k5: 14006, k6: 14007, k7: 14008, k8: 14009, k9: 14010, k10: 14011, k11: 14012, k12: 14013, k13: 14014, k14: 100, k15: 14016, k16: 14017, nm: "r14" }];
  g.h0 += [G17 { k0: 15001, k1: 15002, k2: 15003, k3: 15004, k4: 15005, k5: 15006, k6: 15007, k7: 15008, k8: 15009, k9: 15010, k10: 15011, k11: 15012, k12: 15013, k13: 15014, k14: 15015, k15: 100, k16: 15017, nm: "r15" }];
  g.h0 += [G17 { k0: 16001, k1: 16002, k2: 16003, k3: 16004, k4: 16005, k5: 16006, k6: 16007, k7: 16008, k8: 16009, k9: 16010, k10: 16011, k11: 16012, k12: 16013, k13: 16014, k14: 16015, k15: 16016, k16: 100, nm: "r16" }];
  assert(len(g.h0) == 17 && len(g.h16) == 17, "filled 17: {len(g.h0)}");
  g.h0 += [G17 { k0: 100, k1: 100, k2: 100, k3: 100, k4: 100, k5: 100, k6: 100, k7: 100, k8: 100, k9: 100, k10: 100, k11: 100, k12: 100, k13: 100, k14: 100, k15: 100, k16: 100, nm: "x" }];
  assert(len(g.h0) == 1 && g.h0[100].nm == "x", "17 members, h0: {len(g.h0)}");
  assert(len(g.h1) == 1 && g.h1[100].nm == "x", "17 members, h1: {len(g.h1)}");
  assert(len(g.h2) == 1 && g.h2[100].nm == "x", "17 members, h2: {len(g.h2)}");
  assert(len(g.h3) == 1 && g.h3[100].nm == "x", "17 members, h3: {len(g.h3)}");
  assert(len(g.h4) == 1 && g.h4[100].nm == "x", "17 members, h4: {len(g.h4)}");
  assert(len(g.h5) == 1 && g.h5[100].nm == "x", "17 members, h5: {len(g.h5)}");
  assert(len(g.h6) == 1 && g.h6[100].nm == "x", "17 members, h6: {len(g.h6)}");
  assert(len(g.h7) == 1 && g.h7[100].nm == "x", "17 members, h7: {len(g.h7)}");
  assert(len(g.h8) == 1 && g.h8[100].nm == "x", "17 members, h8: {len(g.h8)}");
  assert(len(g.h9) == 1 && g.h9[100].nm == "x", "17 members, h9: {len(g.h9)}");
  assert(len(g.h10) == 1 && g.h10[100].nm == "x", "17 members, h10: {len(g.h10)}");
  assert(len(g.h11) == 1 && g.h11[100].nm == "x", "17 members, h11: {len(g.h11)}");
  assert(len(g.h12) == 1 && g.h12[100].nm == "x", "17 members, h12: {len(g.h12)}");
  assert(len(g.h13) == 1 && g.h13[100].nm == "x", "17 members, h13: {len(g.h13)}");
  assert(len(g.h14) == 1 && g.h14[100].nm == "x", "17 members, h14: {len(g.h14)}");
  assert(len(g.h15) == 1 && g.h15[100].nm == "x", "17 members, h15: {len(g.h15)}");
  assert(len(g.h16) == 1 && g.h16[100].nm == "x", "17 members, h16: {len(g.h16)}");
}

struct G24 { k0: integer, k1: integer, k2: integer, k3: integer, k4: integer, k5: integer, k6: integer, k7: integer, k8: integer, k9: integer, k10: integer, k11: integer, k12: integer, k13: integer, k14: integer, k15: integer, k16: integer, k17: integer, k18: integer, k19: integer, k20: integer, k21: integer, k22: integer, k23: integer, nm: text }
struct Grp24 { h0: hash<G24[k0]>, h1: hash<G24[k1]>, h2: hash<G24[k2]>, h3: hash<G24[k3]>, h4: hash<G24[k4]>, h5: hash<G24[k5]>, h6: hash<G24[k6]>, h7: hash<G24[k7]>, h8: hash<G24[k8]>, h9: hash<G24[k9]>, h10: hash<G24[k10]>, h11: hash<G24[k11]>, h12: hash<G24[k12]>, h13: hash<G24[k13]>, h14: hash<G24[k14]>, h15: hash<G24[k15]>, h16: hash<G24[k16]>, h17: hash<G24[k17]>, h18: hash<G24[k18]>, h19: hash<G24[k19]>, h20: hash<G24[k20]>, h21: hash<G24[k21]>, h22: hash<G24[k22]>, h23: hash<G24[k23]> }
