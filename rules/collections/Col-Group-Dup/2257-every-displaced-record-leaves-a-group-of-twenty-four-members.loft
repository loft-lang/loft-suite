//
// EVERY DISPLACED RECORD LEAVES A GROUP OF TWENTY-FOUR MEMBERS (@FR-Col-Group-Dup, loft#2257).  A
// record entering a linked group displaces, in each keyed member, the record that member held
// under the new record's key; every one of those leaves EVERY keyed member, and with no vector
// member nothing holds it any more.  The C runtime collected the displaced records in a list of
// sixteen, so in a group of more than sixteen keyed members the seventeenth displaced record
// stayed filed in the others: a length of 2 where the interpreter answered 1.
//
// Axes this file MOVES:  the number of keyed members well past the old bound (24), and so
//                        the number of distinct records one insert displaces.  The two
//                        either side of it (16, 17) are 2257-…-many-members.loft.
// Axes it HOLDS FIXED:   hash members only, integer keys, no vector member, one text per record.
//
// Expected values by hand: record j holds key 100 in field j and j*1000 + i + 1 in every
// other field i, so the members hold n records each and no two share a key.  The last record
// holds 100 in every field: in member j it displaces record j, and record j then leaves every
// other member, so every member ends holding the last record alone — length 1, name "x".

struct G24 { k0: integer, k1: integer, k2: integer, k3: integer, k4: integer, k5: integer, k6: integer, k7: integer, k8: integer, k9: integer, k10: integer, k11: integer, k12: integer, k13: integer, k14: integer, k15: integer, k16: integer, k17: integer, k18: integer, k19: integer, k20: integer, k21: integer, k22: integer, k23: integer, nm: text }
struct Grp24 { h0: hash<G24[k0]>, h1: hash<G24[k1]>, h2: hash<G24[k2]>, h3: hash<G24[k3]>, h4: hash<G24[k4]>, h5: hash<G24[k5]>, h6: hash<G24[k6]>, h7: hash<G24[k7]>, h8: hash<G24[k8]>, h9: hash<G24[k9]>, h10: hash<G24[k10]>, h11: hash<G24[k11]>, h12: hash<G24[k12]>, h13: hash<G24[k13]>, h14: hash<G24[k14]>, h15: hash<G24[k15]>, h16: hash<G24[k16]>, h17: hash<G24[k17]>, h18: hash<G24[k18]>, h19: hash<G24[k19]>, h20: hash<G24[k20]>, h21: hash<G24[k21]>, h22: hash<G24[k22]>, h23: hash<G24[k23]> }
// Record j of the group: key 100 in field j and j*1000 + i + 1 in every other field i; j = 24
// is the last record, 100 in every field.  Built by one function rather than as 25 literals:
// a function of 25 inserts of 24 fields each took MSVC past the C sweep's compile limit.
fn key24(j: integer, i: integer) -> integer { if j == 24 || i == j { 100 } else { j * 1000 + i + 1 } }
fn rec24(j: integer) -> G24 { G24 { k0: key24(j, 0), k1: key24(j, 1), k2: key24(j, 2), k3: key24(j, 3), k4: key24(j, 4), k5: key24(j, 5), k6: key24(j, 6), k7: key24(j, 7), k8: key24(j, 8), k9: key24(j, 9), k10: key24(j, 10), k11: key24(j, 11), k12: key24(j, 12), k13: key24(j, 13), k14: key24(j, 14), k15: key24(j, 15), k16: key24(j, 16), k17: key24(j, 17), k18: key24(j, 18), k19: key24(j, 19), k20: key24(j, 20), k21: key24(j, 21), k22: key24(j, 22), k23: key24(j, 23), nm: if j == 24 { "x" } else { "r{j}" } } }

fn members_hold_the_last_alone_a(g: Grp24) {
  assert(len(g.h0) == 1 && g.h0[100].nm == "x", "24 members, h0: {len(g.h0)}");
  assert(len(g.h1) == 1 && g.h1[100].nm == "x", "24 members, h1: {len(g.h1)}");
  assert(len(g.h2) == 1 && g.h2[100].nm == "x", "24 members, h2: {len(g.h2)}");
  assert(len(g.h3) == 1 && g.h3[100].nm == "x", "24 members, h3: {len(g.h3)}");
  assert(len(g.h4) == 1 && g.h4[100].nm == "x", "24 members, h4: {len(g.h4)}");
  assert(len(g.h5) == 1 && g.h5[100].nm == "x", "24 members, h5: {len(g.h5)}");
  assert(len(g.h6) == 1 && g.h6[100].nm == "x", "24 members, h6: {len(g.h6)}");
  assert(len(g.h7) == 1 && g.h7[100].nm == "x", "24 members, h7: {len(g.h7)}");
  assert(len(g.h8) == 1 && g.h8[100].nm == "x", "24 members, h8: {len(g.h8)}");
  assert(len(g.h9) == 1 && g.h9[100].nm == "x", "24 members, h9: {len(g.h9)}");
  assert(len(g.h10) == 1 && g.h10[100].nm == "x", "24 members, h10: {len(g.h10)}");
  assert(len(g.h11) == 1 && g.h11[100].nm == "x", "24 members, h11: {len(g.h11)}");
}

fn members_hold_the_last_alone_b(g: Grp24) {
  assert(len(g.h12) == 1 && g.h12[100].nm == "x", "24 members, h12: {len(g.h12)}");
  assert(len(g.h13) == 1 && g.h13[100].nm == "x", "24 members, h13: {len(g.h13)}");
  assert(len(g.h14) == 1 && g.h14[100].nm == "x", "24 members, h14: {len(g.h14)}");
  assert(len(g.h15) == 1 && g.h15[100].nm == "x", "24 members, h15: {len(g.h15)}");
  assert(len(g.h16) == 1 && g.h16[100].nm == "x", "24 members, h16: {len(g.h16)}");
  assert(len(g.h17) == 1 && g.h17[100].nm == "x", "24 members, h17: {len(g.h17)}");
  assert(len(g.h18) == 1 && g.h18[100].nm == "x", "24 members, h18: {len(g.h18)}");
  assert(len(g.h19) == 1 && g.h19[100].nm == "x", "24 members, h19: {len(g.h19)}");
  assert(len(g.h20) == 1 && g.h20[100].nm == "x", "24 members, h20: {len(g.h20)}");
  assert(len(g.h21) == 1 && g.h21[100].nm == "x", "24 members, h21: {len(g.h21)}");
  assert(len(g.h22) == 1 && g.h22[100].nm == "x", "24 members, h22: {len(g.h22)}");
  assert(len(g.h23) == 1 && g.h23[100].nm == "x", "24 members, h23: {len(g.h23)}");
}

fn test_group_of_24() {
  g = Grp24 { };
  for j in 0..24 { g.h0 += [rec24(j)]; }
  assert(len(g.h0) == 24 && len(g.h23) == 24, "filled 24: {len(g.h0)}");
  g.h0 += [rec24(24)];
  members_hold_the_last_alone_a(g);
  members_hold_the_last_alone_b(g);
}

fn main() {
  test_group_of_24();
  println("ok");
}
