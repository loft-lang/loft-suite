//
// A VECTOR LITERAL COMPILES WHATEVER IT REACHES IS DECLARED BELOW (`@FR-Col-Vec`).  The first pass
// meets a literal before the declarations it depends on and has no type for them yet; the literal
// is the same literal either way: a repeat `[v; n]` whose count comes from a function declared
// further down (loft#2278), and a literal nested in a field literal of a holder whose type comes
// from such a function (loft#2340).  Two sections, each with its cells and receipt.
//
// ── 2278-a-repeat-count-from-a-function-declared-below ──
//
// A repeat literal `[v; n]` takes its count from a function declared further down the file
// (`@FR-Col-Vec`, loft#2278).  The first pass meets the call before the function's declaration
// and has no type for it yet; the count was refused for that ("Expect a number as the object
// multiplier"), so the program's declaration order decided whether it compiled.
//
// Each count comes from a function below: a local bound to the call, the call itself, a narrow
// `i32` result, and a byte element.  Lengths and contents hand-computed.
//
// @falsified-at: the installed loft 2026.10.0, scored by hand (main c3122aa5a's release build
//   refused the same repros before the fix) — interpret, native and C: the control refuses to
//   compile ("Expect a number as the object multiplier") -> exit 0.
//
// ── 2340-a-literal-nested-in-a-field-literal-of-a-forward-holder ──
//
// @FR-Col-Vec
//
// loft#2340 — a vector literal written into a field whose holder's type the first pass does not
// know yet (its value comes from a function declared below), with a literal nested inside it,
// compiles.  The first pass built the outer literal as a value, minting its accumulator
// `_vec_1`; the second built it into the field, minting none, so the nested literal took
// `_vec_1` at another element shape and the program was refused ("cannot change type").
//
// Every value by hand: `with_deps` keeps the variant and replaces its deps; `total` sums.
//
// Axes this file MOVES:  the element (a struct-enum, an integer, a text), the nesting depth,
//                        the holder (a match capture's element, a local from a call), backends.
// Axes it HOLDS FIXED:   the holder's producer declared below its use.
//
// @falsified-at: 0e95172cd — interpret exit 1 -> 0, native exit 1 -> 0
// CHANNEL: the exit — main refused the program at compile time.
//   HOLDS: the leak check and the panic channel are clean on BOTH trees, on the
//   interpreter and the C (measured on main 0e95172cd unarmed, 2026-11-02); only the
//   exit moves.

fn sized_by_a_local() -> vector<integer> {
  k = three();
  [7; k]
}

fn sized_by_the_call() -> vector<integer> {
  [8; three()]
}

fn sized_by_a_narrow() -> vector<integer> {
  [9; four_i32()]
}

fn bytes() -> vector<u8> {
  n = three();
  [0 as u8; n]
}

fn three() -> integer {
  3
}

fn four_i32() -> i32 {
  4
}

fn test_a_repeat_count_from_a_function_declared_below() {
  a = sized_by_a_local();
  assert(len(a) == 3 && a[0] == 7 && a[2] == 7, "a local count: {a}");
  b = sized_by_the_call();
  assert(len(b) == 3 && b[1] == 8, "the call as the count: {b}");
  c = sized_by_a_narrow();
  assert(len(c) == 4 && c[3] == 9, "a narrow count: {c}");
  d = bytes();
  assert(len(d) == 3 && d[0] == 0 as u8, "a byte element: {len(d)}");
}

enum Ty { TInt, TRef { n: integer, dep: vector<integer> } }
struct Bl { name: text, result: vector<Ty>, sums: vector<integer>, names: vector<text> }
enum Nd { NNull, NBlock { block: vector<Bl> } }

fn with_deps(t: Ty, d: vector<integer>) -> Ty { match t { TRef { n } => TRef { n: n, dep: d }, _ => t } }
fn total(v: vector<integer>) -> integer { t = 0; for x in v { t += x; } t }
fn deps_len(t: Ty) -> integer { match t { TRef { dep } => len(dep), _ => -1 } }

fn retype(rb: integer) -> Nd {
  code = make();
  match code {
    NBlock { block } => {
      bl = block[0];
      bl.result = [with_deps(TRef { n: 3, dep: [] }, [rb, rb + 1])];
      bl.sums = [total([rb, total([rb, 1])])];
      bl.names = ["n{total([rb, 2])}"];
      code = NBlock { block: [bl] };
    },
    _ => {}
  }
  code
}
fn make() -> Nd { NBlock { block: [Bl { name: "b", result: [], sums: [], names: [] }] } }

fn test_a_literal_nested_in_a_field_literal_of_a_forward_holder() {
  c = retype(7);
  match c {
    NBlock { block } => {
      b = block[0];
      assert(len(b.result) == 1 && deps_len(b.result[0]) == 2, "result");
      assert(len(b.sums) == 1 && b.sums[0] == 15, "sums {b.sums}");
      assert(len(b.names) == 1 && b.names[0] == "n9", "names {b.names}");
    },
    _ => { assert(false, "variant"); }
  }
}
