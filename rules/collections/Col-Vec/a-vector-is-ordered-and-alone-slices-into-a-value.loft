//
// A VECTOR IS ORDERED AND 0-BASED, AND IT ALONE SLICES INTO A VALUE (`@FR-Col-Vec`, `@FR-Slice-Value`,
// `@FR-Slice-KeyedIter`, `@FR-B-Copy`).  Elements read in insertion order from 0; a slice is a FRESH
// vector, so a write through it leaves the source; a keyed slice is iterated, not bound.
//
// @falsified-at: none — a conformance guard for a rule no test named; every cell answered as the
//   rule says on both backends on the tree it landed on.
// CHANNEL: the asserts.
// ARMED: no instrument.
// WITNESS: each message names the vector read.
// HOLDS: every cell on both backends.

struct E { k: integer }

fn test_ordered_and_zero_based() {
  v = [10, 20, 30, 40];
  o = "";
  for x in v { o += "{x},"; }
  assert(o == "10,20,30,40," && v[0] == 10 && len(v) == 4, "order and the first index: {o}");
}

fn test_a_slice_is_a_fresh_value() {
  v = [10, 20, 30, 40];
  w = v[1..3];
  w[0] = 99;
  assert("{w}" == "[99,30]" && "{v}" == "[10,20,30,40]" && len(w) == 2, "{w} {v}");
}

fn test_a_keyed_range_is_iterated() {
  s: sorted<E[k]> = [E { k: 3 }, E { k: 1 }, E { k: 2 }];
  t = [for e in s[1..3] { e.k }];
  assert("{t}" == "[1,2]" && len(t) == 2, "materialised by a comprehension: {t}");
}
