// loft#2161 — A CALL HANDED A FIELD ELEMENT AND A CONTAINER IT GROWS BY A VECTOR IS REFUSED (`@FR-B-Ref-Reshape`, `@FR-B-Disturb`).  A plain struct parameter aliases the caller's element (`calls.md` F-ParamHeap), so `rd(w.a[0], w)` with `rd` appending a vector to `w.a` reads a moved element; the callee's growth was not collected.
//
// @falsified-at: b36d0449f — interpret exit 1 -> 0, interpret expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/1 -> 0/1 (the suite's verdict, not a count of matches)
// CHANNEL: the expected diagnostic.
// ARMED: no instrument.
// HOLDS: the plain-bind spelling materialises instead —
//   `rules/binding/B-Disturb/2161-a-container-named-through-a-field-or-an-element-ends-its-views.loft`.
// @EXPECT_ERROR: cannot pass both `w` and a reference into it to `rd`

struct S { n: integer }
struct W { tag: integer, a: vector<S> }

fn rd(e: S, w: W) -> integer {
  more: vector<S> = [S { n: 2 }, S { n: 3 }];
  w.a += more;
  e.n
}

fn main() {
  w = W { tag: 1, a: [S { n: 101 }] };
  println("{rd(w.a[0], w)}");
}
