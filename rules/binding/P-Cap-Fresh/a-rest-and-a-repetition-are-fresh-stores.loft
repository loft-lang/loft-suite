//
// `@FR-P-Cap-Fresh` crossed with `@FR-H-Alloc`, `@FR-P-Rest` and `@FR-I-Comp`: a `..rest`
// sub-slice and a repetition `(xs: τ)*` accumulator are FRESH vectors — a new store (H-Alloc),
// independent of the subject both ways: a write through the capture does not reach the subject,
// and a write to the subject after the match does not reach the capture — exactly as a
// comprehension's result is a fresh store (I-Comp), so a comprehension over a rest is a third
// independent vector.  Crossed with integer, text and record elements (a record with a text
// field written through), a field subject, and a rest bound again every round of a loop.
//
// CHANNEL: the assertions and the leak gate.
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.

struct S { n: integer, t: text }
struct O { v: vector<S> }
enum Tk { Num { n: integer }, End { why: text } }

fn test_records_both_ways() {
  w = [S { n: 1, t: "a" }, S { n: 2, t: "b" }, S { n: 3, t: "c" }];
  q = match w { [_, ..t] => t, _ => [] };
  q[0].n = 9;
  q[0].t += "!";
  w[2].t = "W";
  assert(len(q) == 2 && q[0].n == 9 && q[0].t == "b!" && q[1].t == "c", "the rest: {q[0].t} {q[1].t}");
  assert(len(w) == 3 && w[1].n == 2 && w[1].t == "b" && w[2].t == "W", "the subject: {w[1].t} {w[2].t}");
}

fn test_a_field_subject_and_text_elements() {
  o = O { v: [S { n: 4, t: "x" }, S { n: 5, t: "y" }] };
  r = match o.v { [..init, _] => init, _ => [] };
  r += [S { n: 6, t: "z" }];
  assert(len(r) == 2 && len(o.v) == 2 && r[0].t == "x" && r[1].t == "z", "init: {len(r)} {len(o.v)}");
  ts = ["p", "q", "r"];
  m = match ts { [_, ..rest] => rest, _ => [] };
  m[1] = "R";
  assert(ts[2] == "r" && m[1] == "R" && len(m) == 2, "texts: {ts[2]} {m[1]}");
}

fn test_a_repetition_accumulator() {
  v: vector<Tk> = [Num { n: 10 }, Num { n: 20 }, Num { n: 30 }, End { why: "eof" }];
  xs = match v { [(a: Num)*, End] => a, _ => [] };
  v[1] = Num { n: -2 };
  s = "";
  for x in xs { if x is Num { n } { s += "{n},"; } }
  assert(len(xs) == 3 && s == "10,20,30,", "accumulator after the subject's write: {s}");
  xs += [End { why: "more" }];
  t = 0;
  for x in v { if x is Num { n } { t += n; } }
  assert(len(v) == 4 && t == 10 - 2 + 30 && len(xs) == 4, "subject after the accumulator's append: {t}");
}

fn test_a_comprehension_over_a_rest() {
  v = [1, 2, 3, 4];
  rest = match v { [_, ..t] => t, _ => [] };
  d = [for x in rest { x * 10 }];
  d[0] = 0;
  rest[1] = 33;
  assert(len(d) == 3 && d[1] == 30 && d[2] == 40 && rest[1] == 33 && rest[0] == 2 && v[2] == 3, "three stores: {d} {rest} {v}");
}

fn test_in_a_loop() {
  v = [S { n: 1, t: "a" }, S { n: 2, t: "b" }, S { n: 3, t: "c" }];
  s = 0;
  for i in 0..4 {
    t = match v { [_, ..t] => t, _ => [] };
    t[0].n += i;
    s += t[0].n;
  }
  assert(s == 2 + 3 + 4 + 5 && v[1].n == 2, "a fresh rest each round: {s} {v[1].n}");
}
