//
// A REST OR A REPETITION ACCUMULATOR IS A FRESH STORE, AND DEEPLY SO (`@FR-P-Cap-Fresh` crossed
// with `@FR-H-Alloc`, `@FR-P-Rest`, `@FR-I-Comp` and `@FR-B-Copy`).  A `..rest` sub-slice and a
// repetition `(xs: τ)*` accumulator are new vectors, independent of the subject both ways — as a
// comprehension's result is — and a fresh vector is a whole value like any other: a plain bind of
// it is B-Copy's copy, and a rest of records owning a text or a vector holds its own copies of
// them.  Two sections, each with its cells and receipt: freshness against the subject (element
// kinds, a field subject, a loop) and the bind of a rest (a local, a field and a parameter
// subject; straight, in a loop, carried out of its arm).
//
// ── a-rest-and-a-repetition-are-fresh-stores ──
//
// `@FR-P-Cap-Fresh` crossed with `@FR-H-Alloc`, `@FR-P-Rest` and `@FR-I-Comp`: a `..rest`
// sub-slice and a repetition `(xs: τ)*` accumulator are FRESH vectors — a new store (H-Alloc),
// independent of the subject both ways: a write through the capture does not reach the subject,
// and a write to the subject after the match does not reach the capture — exactly as a
// comprehension's result is a fresh store (I-Comp), so a comprehension over a rest is a third
// independent vector.  Crossed with integer, text and record elements (a record with a text
// field written through), a field subject, and a rest bound again every round of a loop.
//
// CHANNEL: the assertions and the leak gate.
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// ── a-rest-is-fresh-and-a-bind-of-it-is-a-copy-of-its-own ──
//
// `@FR-P-Cap-Fresh` crossed with `@FR-B-Copy`: a `..rest` sub-slice and a repetition
// accumulator are FRESH vectors, and a fresh vector is a whole value like any other — so a
// plain bind of it (`w = rest`) is B-Copy's copy, independent of the rest in both directions,
// and the freshness is DEEP: a rest of records that own a text and a vector holds its own
// copies of them, so a write to a rest element's heap field reaches neither the subject nor a
// copy bound from the rest.  The subject is a local, a vector field and a parameter; the
// rest is taken straight, in a `for` loop, and carried out of its arm.
//
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.
// CHANNEL: the assertions and the leak gate.

struct S { n: integer, t: text }
struct O { v: vector<S> }
enum Tk { Num { n: integer }, End { why: text } }

fn test_records_both_ways() {
  w = [S { n: 1, t: "a" }, S { n: 2, t: "b" }, S { n: 3, t: "c" }];
  q = match w { [_, ..t] => t, _ => [] };
  q[0].n = 9;
  q[0].t += "!";
  w[2].t = "W";
  assert(len(q) == 2 && q[0].n == 9 && q[0].t == "b!" && q[1].t == "c", "the rest: {q[0].t} {q[1].t}");
  assert(len(w) == 3 && w[1].n == 2 && w[1].t == "b" && w[2].t == "W", "the subject: {w[1].t} {w[2].t}");
}

fn test_a_field_subject_and_text_elements() {
  o = O { v: [S { n: 4, t: "x" }, S { n: 5, t: "y" }] };
  r = match o.v { [..init, _] => init, _ => [] };
  r += [S { n: 6, t: "z" }];
  assert(len(r) == 2 && len(o.v) == 2 && r[0].t == "x" && r[1].t == "z", "init: {len(r)} {len(o.v)}");
  ts = ["p", "q", "r"];
  m = match ts { [_, ..rest] => rest, _ => [] };
  m[1] = "R";
  assert(ts[2] == "r" && m[1] == "R" && len(m) == 2, "texts: {ts[2]} {m[1]}");
}

fn test_a_repetition_accumulator() {
  v: vector<Tk> = [Num { n: 10 }, Num { n: 20 }, Num { n: 30 }, End { why: "eof" }];
  xs = match v { [(a: Num)*, End] => a, _ => [] };
  v[1] = Num { n: -2 };
  s = "";
  for x in xs { if x is Num { n } { s += "{n},"; } }
  assert(len(xs) == 3 && s == "10,20,30,", "accumulator after the subject's write: {s}");
  xs += [End { why: "more" }];
  t = 0;
  for x in v { if x is Num { n } { t += n; } }
  assert(len(v) == 4 && t == 10 - 2 + 30 && len(xs) == 4, "subject after the accumulator's append: {t}");
}

fn test_a_comprehension_over_a_rest() {
  v = [1, 2, 3, 4];
  rest = match v { [_, ..t] => t, _ => [] };
  d = [for x in rest { x * 10 }];
  d[0] = 0;
  rest[1] = 33;
  assert(len(d) == 3 && d[1] == 30 && d[2] == 40 && rest[1] == 33 && rest[0] == 2 && v[2] == 3, "three stores: {d} {rest} {v}");
}

fn test_in_a_loop() {
  v = [S { n: 1, t: "a" }, S { n: 2, t: "b" }, S { n: 3, t: "c" }];
  s = 0;
  for i in 0..4 {
    t = match v { [_, ..t] => t, _ => [] };
    t[0].n += i;
    s += t[0].n;
  }
  assert(s == 2 + 3 + 4 + 5 && v[1].n == 2, "a fresh rest each round: {s} {v[1].n}");
}

struct Pt { x: integer, tags: vector<integer>, nm: text }
struct Hold { pts: vector<Pt>, k: integer }
enum Tok { S2Num { n: integer }, Op { o: integer } }

fn mk() -> vector<Pt> {
  [Pt { x: 1, tags: [1], nm: "a" }, Pt { x: 2, tags: [2, 2], nm: "bb" }, Pt { x: 3, tags: [], nm: "c" }]
}

fn sum_x(v: vector<Pt>) -> integer { s = 0; for p in v { s = s * 10 + p.x; } s }

fn rest_of_param(v: vector<Pt>) -> integer {
  match v { [_, ..rest] => { w = rest; w[0].x = 70; rest[1].x = 80; sum_x(w) * 1000 + sum_x(rest) }, _ => -1 }
}

fn test_a_bind_of_a_rest_is_a_copy_of_its_own() {
  v = mk();
  a = 0;
  b = 0;
  match v {
    [_, ..rest] => {
      w = rest;
      w[0].x = 20;
      w += [Pt { x: 9, tags: [], nm: "z" }];
      rest[1].x = 30;
      a = sum_x(w);
      b = sum_x(rest);
    },
    _ => {}
  }
  assert(a == 2039 && b == 50 && sum_x(v) == 123 && len(v) == 3, "copy of a rest: {a} {b} {sum_x(v)}");
}

fn test_a_rest_is_fresh_all_the_way_down() {
  h = Hold { pts: mk(), k: 0 };
  t = "";
  match h.pts {
    [_, ..rest] => {
      c = rest;
      rest[0].tags += [7];
      rest[0].nm += "!";
      t = "{len(rest[0].tags)} {rest[0].nm} {len(c[0].tags)} {c[0].nm}";
    },
    _ => {}
  }
  assert(t == "3 bb! 2 bb", "heap fields of a rest: {t}");
  assert(len(h.pts[1].tags) == 2 && h.pts[1].nm == "bb" && len(h.pts) == 3, "the subject: {h.pts[1].nm}");
}

fn test_a_rest_of_a_parameter() {
  v = mk();
  k = rest_of_param(v);
  assert(k == 703100 && sum_x(v) == 123, "a parameter subject: {k} {sum_x(v)}");
}

fn test_a_rest_per_pass_and_out_of_its_arm() {
  v = mk();
  total = 0;
  for i in 0..3 {
    v[0].x = i;
    match v { [_, ..rest] => { rest[0].x += 10 * i; total = total * 100 + sum_x(rest); }, _ => {} }
  }
  assert(total == 242523 && v[1].x == 2, "a fresh rest each pass: {total} {v[1].x}");
  out = match v { [_, ..rest] => rest, _ => [] };
  kept = out;
  v[1].x = 99;
  out[0].x = 55;
  assert(sum_x(out) == 553 && sum_x(kept) == 23 && v[1].x == 99, "out of its arm: {sum_x(out)} {sum_x(kept)}");
}

fn test_a_repetition_accumulator_bound_is_a_copy() {
  tk = [S2Num { n: 5 }, S2Num { n: 6 }, Op { o: 7 }];
  r = "";
  match tk {
    [(x: S2Num)*, ..] => {
      y = x;
      x += [S2Num { n: 8 }];
      y = [S2Num { n: 1 }];
      r = "{len(x)} {len(y)}";
    },
    _ => {}
  }
  assert(r == "3 1" && len(tk) == 3, "a repetition and its copy: {r} {len(tk)}");
}
