//
// `@FR-B-Ref-Lvalue` / `@FR-T-Record` — `&t.i` names member i as `&r.f` names field f, whatever
// the member's type.  A HEAP member — a struct, a struct-enum, a vector — of a tuple LOCAL was
// refused at a `&` argument (`flip(tp.0)`, "a literal or expression") and at a `&` bind
// (`c = &tp.0`, "not a scalar") while the same member of a struct field, a vector element or a
// `&(…)` tuple linked (loft#2263).  The local is now built as its `__tuple<…>` record — the form
// `@FR-T-Ref-Rep` gives a tuple local a `&(…)` names — and the member is that record's field.
// A struct FIELD's tuple member also took no `&` bind (`c = &w.pair.0`, "not addressable") though
// the argument spelling linked; it now links in both spellings.
//
// The axes moved: the member kind (struct, struct-enum, vector; scalar and narrow members as
// controls and beside a heap one), the link spelling (`&` argument, `&` bind), the write (whole
// rebind, field write, append), and the tuple place (a local, a `&(…)` parameter, a vector
// element, a struct field), with the local bound from a literal, a call, a copy of another
// tuple and anew each round of a loop, and read whole afterwards (a copy, a destructure, a push,
// a by-value argument, a return).  Every value is worked out by hand; `main` runs it all for the
// leak gate.
//
// @falsified-at: 0e95172cd — interpret exit 1 -> 0, C exit 1 -> 0 (the control refuses
//   `flipp(tp.0)`, `c = &tp.0` and `c = &w.pair.0`)
// CHANNEL: the exit — the control refuses the file — and the values.
// ARMED: no instrument; LOFT_POISON=1, LOFT_STRICT_STORES=1 and the C under -DLOFT_POISON were
//   measured clean on the fixed tree.
// HOLDS: the controls (a scalar member, a struct field) answer the same on both trees.

struct P { x: integer, s: text }
enum E { A { n: integer }, B { m: text } }
struct W { p: P, pair: (P, integer) }

fn flipp(s: &P) { s = P { x: 7, s: "seven" }; }
fn fieldp(s: &P) { s.x = 8; s.s = "eight"; }
fn flipe(e: &E) { e = B { m: "bee" }; }
fn pushv(v: &vector<integer>) { v += [9]; }
fn flipv(v: &vector<integer>) { v = [5, 6]; }
fn bump(n: &integer) { n += 1; }
fn bump8(n: &u8) { n += 1; }
fn show_e(e: E) -> text { match e { A { n } => "A{n}", B { m } => "B{m}" } }
fn mk(k: integer) -> (P, integer) { (P { x: k, s: "k{k}" }, k * 2) }
fn byv(t: (P, integer)) -> integer { t.0.x + t.1 }
fn ret(t: (P, integer)) -> (P, integer) { t }
fn via_param(t: &(P, integer)) { fieldp(t.0); c = &t.0; c.x = c.x + 2; }

fn test_a_struct_member_of_a_local() {
  a = (P { x: 4, s: "four" }, 5);
  flipp(a.0);
  assert("{a.0.x} {a.0.s} {a.1}" == "7 seven 5", "argument, whole: {a.0.x} {a.0.s}");
  b = (P { x: 4, s: "four" }, 5);
  fieldp(b.0);
  assert("{b.0.x} {b.0.s} {b.1}" == "8 eight 5", "argument, fields: {b.0.x} {b.0.s}");
  c = (P { x: 4, s: "four" }, 5);
  l = &c.0;
  l.x = 8;
  assert("{c.0.x} {c.0.s}" == "8 four", "bind, field: {c.0.x} {c.0.s}");
  l = P { x: 9, s: "nine" };
  assert("{c.0.x} {c.0.s} {c.1}" == "9 nine 5", "bind, whole: {c.0.x} {c.0.s}");
}

fn test_a_struct_enum_member_of_a_local() {
  a: (E, integer) = (A { n: 4 }, 5);
  flipe(a.0);
  assert("{show_e(a.0)} {a.1}" == "Bbee 5", "argument: {show_e(a.0)}");
  b: (E, integer) = (A { n: 4 }, 5);
  l = &b.0;
  l = B { m: "cee" };
  assert("{show_e(b.0)} {b.1}" == "Bcee 5", "bind: {show_e(b.0)}");
}

fn test_a_vector_member_of_a_local() {
  a = ([1, 2], 5);
  pushv(a.0);
  assert("{a.0} {a.1}" == "[1,2,9] 5", "argument, append: {a.0}");
  b = ([1, 2], 5);
  flipv(b.0);
  assert("{b.0} {b.1}" == "[5,6] 5", "argument, whole: {b.0}");
  c = ([1, 2], 5);
  l = &c.0;
  l += [9];
  assert("{c.0}" == "[1,2,9]", "bind, append: {c.0}");
  l = [7];
  assert("{c.0} {c.1}" == "[7] 5", "bind, whole: {c.0}");
}

fn test_heap_scalar_and_narrow_members_together() {
  a = (P { x: 1, s: "a" }, [1], P { x: 2, s: "b" });
  flipp(a.0);
  pushv(a.1);
  fieldp(a.2);
  assert("{a.0.x} {a.1} {a.2.x} {a.2.s}" == "7 [1,9] 8 eight", "three members: {a.0.x} {a.1} {a.2.x}");
  b = (P { x: 1, s: "a" }, 5);
  bump(b.1);
  flipp(b.0);
  l = &b.1;
  l += 10;
  assert("{b.0.x} {b.1}" == "7 16", "scalar beside heap: {b.0.x} {b.1}");
  c: (P, u8) = (P { x: 1, s: "a" }, 250);
  bump8(c.1);
  flipp(c.0);
  assert("{c.0.x} {c.1}" == "7 251", "narrow beside heap: {c.0.x} {c.1}");
}

fn test_the_local_bound_every_way() {
  a = mk(3);
  flipp(a.0);
  assert("{a.0.x} {a.0.s} {a.1}" == "7 seven 6", "from a call: {a.0.x} {a.1}");
  src = (P { x: 4, s: "four" }, 5);
  b = src;
  flipp(b.0);
  assert(b.0.x == 7 && src.0.x == 4, "from a copy: {b.0.x} {src.0.x}");
  s = 0;
  for i in 0..3 {
    t = (P { x: i, s: "p{i}" }, i);
    flipp(t.0);
    fieldp(t.0);
    s += t.0.x + t.1;
  }
  assert(s == 27, "each round: {s}");
  r = (P { x: 1, s: "a" }, 5);
  flipp(r.0);
  r = (P { x: 2, s: "b" }, 6);
  fieldp(r.0);
  assert("{r.0.x} {r.0.s} {r.1}" == "8 eight 6", "rebound: {r.0.x} {r.1}");
}

fn test_the_linked_local_read_whole() {
  tp = (P { x: 1, s: "a" }, 5);
  flipp(tp.0);
  b = tp;
  b.0.x = 100;
  (q, n) = tp;
  v = [tp];
  v += [tp];
  z = ret(tp);
  got = "{byv(tp)} {tp.0.x} {b.0.x} {q.x} {n} {len(v)} {v[1].0.s} {z.0.x}";
  assert(got == "12 7 100 7 5 2 seven 7", "whole reads: {got}");
}

fn test_every_tuple_place() {
  tp = (P { x: 4, s: "four" }, 5);
  via_param(tp);
  assert("{tp.0.x} {tp.0.s} {tp.1}" == "10 eight 5", "a `&(…)` parameter: {tp.0.x} {tp.0.s}");
  v = [(P { x: 4, s: "four" }, 5), (P { x: 1, s: "one" }, 2)];
  flipp(v[1].0);
  e = &v[0].0;
  e.x = 20;
  assert("{v[0].0.x} {v[1].0.x} {v[1].0.s} {v[1].1}" == "20 7 seven 2", "a vector element: {v[0].0.x} {v[1].0.x}");
  vv = [([1], 5), ([2], 6)];
  pushv(vv[1].0);
  assert("{vv[0].0} {vv[1].0}" == "[1] [2,9]", "a vector element's vector: {vv[1].0}");
  w = W { p: P { x: 1, s: "one" }, pair: (P { x: 2, s: "two" }, 3) };
  flipp(w.pair.0);
  assert("{w.pair.0.x} {w.pair.0.s} {w.pair.1}" == "7 seven 3", "a struct field, argument: {w.pair.0.x}");
  f = &w.pair.0;
  f.x = 30;
  k = &w.pair.1;
  k += 1;
  assert("{w.pair.0.x} {w.pair.0.s} {w.pair.1} {w.p.x}" == "30 seven 4 1", "a struct field, bind: {w.pair.0.x} {w.pair.1}");
}

fn test_the_controls() {
  a = (1, 2);
  bump(a.1);
  assert(a.0 == 1 && a.1 == 3, "a scalar member: {a.1}");
  w = W { p: P { x: 1, s: "one" }, pair: (P { x: 2, s: "two" }, 3) };
  flipp(w.p);
  assert("{w.p.x} {w.p.s}" == "7 seven", "a struct field: {w.p.x}");
}

fn main() {
  test_a_struct_member_of_a_local();
  test_a_struct_enum_member_of_a_local();
  test_a_vector_member_of_a_local();
  test_heap_scalar_and_narrow_members_together();
  test_the_local_bound_every_way();
  test_the_linked_local_read_whole();
  test_every_tuple_place();
  test_the_controls();
}
