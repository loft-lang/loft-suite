//
// A TUPLE MEMBER IS A PLACE A LINK NAMES (`@FR-B-Ref-Lvalue`: the linked source is an lvalue, and
// a member of a tuple is one, as `t.0 = 5` assigns it).  `c = &t.0` and a `&` argument `bump(t.0)`
// link the member whatever its type and however the tuple is reached: a wide scalar member of a
// tuple LOCAL (its frame slot at the member's offset), a HEAP member — a struct, a struct-enum, a
// vector — (the local built as its `__tuple<…>` record, the member that record's field), and a
// member of a tuple reached through a `&(…)` link (the link's own reference at the member's
// offset).  Each write reaches the tuple; the untouched members and the field and element
// spellings are the controls.  Three sections, each with its cells and receipt: a scalar member of
// a local (the patch receipt), a heap member (loft#2263), and a member through a `&(…)` link.
//
// ── a-tuple-member-is-a-place-a-link-names ──
//
// `@FR-B-Ref-Lvalue` — the linked source is an lvalue, and a member of a tuple LOCAL is one
// (`t.0 = 5` assigns it).  A `&` bind of it (`c = &t.0`) was refused as "not an addressable
// operand", and a `&` argument (`bump(t.0)`) as "a literal or expression", while the same member
// reached through a field or an element linked.  The link is now the tuple's frame slot at the
// member's offset, and the tuple outlives it like any linked local (`@FR-O-Borrow-Scalar`): the
// later locals in each cell are there to take a slot that was let go too early.
//
// Every wide scalar member type is crossed with a bind, a write through it, a compound write, a
// link to the link, an argument, and a loop.  The field and element spellings are the controls
// and must not move.  Narrow and text members are still refused by name (D-bind-70, loft#1875);
// their pins are in `tests/issues.rs`, since a refusal stops a file.  A `&(…)`-reached member is
// `a-member-of-a-linked-tuple-is-a-place.loft`.
//
// @falsified-at: 22a136711 — interpret exit 1 -> 0, native exit 1 -> 0 (the control refuses
//   `c = &t.0`: "`&` requires an addressable operand").
// @falsified-by: tests/falsified/a-tuple-member-is-a-place-a-link-names.patch — the same channels.  Score it with
//   `scripts/falsify.sh <this file> --patch <that patch>` once 22a136711 is out of reach.
// HOLDS: leak, panic and asserts are clean on both trees and both backends.
//
// ── a-heap-tuple-member-is-a-place-a-link-names ──
//
// `@FR-B-Ref-Lvalue` / `@FR-T-Record` — `&t.i` names member i as `&r.f` names field f, whatever
// the member's type.  A HEAP member — a struct, a struct-enum, a vector — of a tuple LOCAL was
// refused at a `&` argument (`flip(tp.0)`, "a literal or expression") and at a `&` bind
// (`c = &tp.0`, "not a scalar") while the same member of a struct field, a vector element or a
// `&(…)` tuple linked (loft#2263).  The local is now built as its `__tuple<…>` record — the form
// `@FR-T-Ref-Rep` gives a tuple local a `&(…)` names — and the member is that record's field.
// A struct FIELD's tuple member also took no `&` bind (`c = &w.pair.0`, "not addressable") though
// the argument spelling linked; it now links in both spellings.
//
// The axes moved: the member kind (struct, struct-enum, vector; scalar and narrow members as
// controls and beside a heap one), the link spelling (`&` argument, `&` bind), the write (whole
// rebind, field write, append), and the tuple place (a local, a `&(…)` parameter, a vector
// element, a struct field), with the local bound from a literal, a call, a copy of another
// tuple and anew each round of a loop, and read whole afterwards (a copy, a destructure, a push,
// a by-value argument, a return).  Every value is worked out by hand; `main` runs it all for the
// leak gate.
//
// @falsified-at: 0e95172cd — interpret exit 1 -> 0, C exit 1 -> 0 (the control refuses
//   `flipp(tp.0)`, `c = &tp.0` and `c = &w.pair.0`)
// CHANNEL: the exit — the control refuses the file — and the values.
// ARMED: no instrument; LOFT_POISON=1, LOFT_STRICT_STORES=1 and the C under -DLOFT_POISON were
//   measured clean on the fixed tree.
// HOLDS: the controls (a scalar member, a struct field) answer the same on both trees.
//
// ── a-member-of-a-linked-tuple-is-a-place ──
//
// `@FR-B-Ref-Lvalue` — a member of a tuple reached through a `&(…)` link is an lvalue, so it is a
// place a link names, as a member of a tuple LOCAL is.  The link is the `&(…)`'s own reference
// at the member's offset, the address the member READ through the link uses.  It was refused by
// name (D-bind-70, loft#1875).  A `&(…)` parameter and a LOCAL link to a tuple are both crossed
// with a bind, a write through it, a `&` argument, every wide scalar kind, a member past a wider
// one (the offset), a link handed on to another `&` call, and a loop.  Each write must reach the
// CALLER's tuple; the untouched member of each cell must not move.
//
// @falsified-at: 2323bd41e — interpret exit 1 -> 0, native exit 1 -> 0 (the control refuses
//   `c = &p.0`: "the tuple is itself reached through a `&` link").
// No patch receipt: its control is gone since 763fc6179 (loft#1883).  Every `&(…)` is now the
//   `__tuple<…>` record (`@FR-T-Ref-Rep`), so `p.0` on a linked tuple is a FIELD read
//   (`OpGetField`) and its link is a field link; the stack-tuple member path whose refusal the
//   patch planted (`linkable_tuple_member` declining a `&`-reached member) is no longer reached
//   by any cell here.  Measured at 653383a5a: declining every linked member there leaves both
//   backends green.
// HOLDS: leak, panic and refusals are clean on both trees and both backends.

enum Col { Red, Green }

struct H { pair: (integer, integer) }

fn bump(p: &integer) {
  p += 1;
}

fn dbl(p: &float) {
  p = p * 2.0;
}

fn test_a_tuple_member_is_a_place_a_link_names() {
  t = (250, 1);
  c = &t.0;
  u = 7;
  v = 8;
  r = "{c}";
  c = 9;
  assert("{r} {t.0} {t.1} {u}{v}" == "250 9 1 78", "bind, read, write: got {r} {t.0} {t.1}");
  s = (1, 250);
  d = &s.1;
  d += 5;
  assert("{s.0} {s.1}" == "1 255", "a compound write to the second member: got {s.1}");
  f = (3, 1.25);
  g = &f.1;
  g = 9.5;
  dbl(f.1);
  assert("{f.0} {f.1}" == "3 19", "a float member, bound and handed on: got {f.1}");
  bc = (true, 'q', 3);
  b = &bc.0;
  k = &bc.1;
  b = false;
  k = 'z';
  assert("{bc.0} {bc.1} {bc.2}" == "false z 3", "boolean and character members");
  e = (Col.Red, 4);
  ec = &e.0;
  ec = Col.Green;
  assert("{e.0} {e.1}" == "Green 4", "an enum member");
  sg = (1.5f, 2);
  sc = &sg.0;
  sc = 3.5f;
  assert("{sg.0}" == "3.5", "a single member");
  n: (integer?, integer) = (250, 1);
  nc = &n.0;
  nc = null;
  assert("{n.0} {n.1}" == "null 1", "a nullable member set to null through the link");
  ch = (250, 1);
  l1 = &ch.0;
  l2 = &l1;
  w = 7;
  l2 = 9;
  assert("{ch.0} {w}" == "9 7", "a link to the member's link");
  a = (250, 1);
  bump(a.0);
  bump(a.1);
  bump(a.1);
  assert("{a.0} {a.1}" == "251 3", "members as & arguments");
  acc = 0;
  for i in 0..3 {
    lt = (100 + i, 0);
    lc = &lt.0;
    kk = 7;
    lc += 1;
    bump(lt.1);
    acc += lt.0 + lt.1 + kk - kk;
  }
  assert(acc == 309, "a member linked and passed on every loop pass: got {acc}");
  x = a.0;
  bump(x);
  assert(a.0 == 251 && x == 252, "a member bound by value is a copy");
  h = H { pair: (250, 1) };
  bump(h.pair.0);
  hv = [(250, 1)];
  bump(hv[0].0);
  assert(h.pair.0 == 251 && hv[0].0 == 251, "the field and element members still link");
}

struct P { x: integer, s: text }
enum E { A { n: integer }, B { m: text } }
struct W { p: P, pair: (P, integer) }

fn flipp(s: &P) { s = P { x: 7, s: "seven" }; }
fn fieldp(s: &P) { s.x = 8; s.s = "eight"; }
fn flipe(e: &E) { e = B { m: "bee" }; }
fn pushv(v: &vector<integer>) { v += [9]; }
fn flipv(v: &vector<integer>) { v = [5, 6]; }
fn s2_bump(n: &integer) { n += 1; }
fn bump8(n: &u8) { n += 1; }
fn show_e(e: E) -> text { match e { A { n } => "A{n}", B { m } => "B{m}" } }
fn mk(k: integer) -> (P, integer) { (P { x: k, s: "k{k}" }, k * 2) }
fn byv(t: (P, integer)) -> integer { t.0.x + t.1 }
fn ret(t: (P, integer)) -> (P, integer) { t }
fn via_param(t: &(P, integer)) { fieldp(t.0); c = &t.0; c.x = c.x + 2; }

fn test_a_struct_member_of_a_local() {
  a = (P { x: 4, s: "four" }, 5);
  flipp(a.0);
  assert("{a.0.x} {a.0.s} {a.1}" == "7 seven 5", "argument, whole: {a.0.x} {a.0.s}");
  b = (P { x: 4, s: "four" }, 5);
  fieldp(b.0);
  assert("{b.0.x} {b.0.s} {b.1}" == "8 eight 5", "argument, fields: {b.0.x} {b.0.s}");
  c = (P { x: 4, s: "four" }, 5);
  l = &c.0;
  l.x = 8;
  assert("{c.0.x} {c.0.s}" == "8 four", "bind, field: {c.0.x} {c.0.s}");
  l = P { x: 9, s: "nine" };
  assert("{c.0.x} {c.0.s} {c.1}" == "9 nine 5", "bind, whole: {c.0.x} {c.0.s}");
}

fn test_a_struct_enum_member_of_a_local() {
  a: (E, integer) = (A { n: 4 }, 5);
  flipe(a.0);
  assert("{show_e(a.0)} {a.1}" == "Bbee 5", "argument: {show_e(a.0)}");
  b: (E, integer) = (A { n: 4 }, 5);
  l = &b.0;
  l = B { m: "cee" };
  assert("{show_e(b.0)} {b.1}" == "Bcee 5", "bind: {show_e(b.0)}");
}

fn test_a_vector_member_of_a_local() {
  a = ([1, 2], 5);
  pushv(a.0);
  assert("{a.0} {a.1}" == "[1,2,9] 5", "argument, append: {a.0}");
  b = ([1, 2], 5);
  flipv(b.0);
  assert("{b.0} {b.1}" == "[5,6] 5", "argument, whole: {b.0}");
  c = ([1, 2], 5);
  l = &c.0;
  l += [9];
  assert("{c.0}" == "[1,2,9]", "bind, append: {c.0}");
  l = [7];
  assert("{c.0} {c.1}" == "[7] 5", "bind, whole: {c.0}");
}

fn test_heap_scalar_and_narrow_members_together() {
  a = (P { x: 1, s: "a" }, [1], P { x: 2, s: "b" });
  flipp(a.0);
  pushv(a.1);
  fieldp(a.2);
  assert("{a.0.x} {a.1} {a.2.x} {a.2.s}" == "7 [1,9] 8 eight", "three members: {a.0.x} {a.1} {a.2.x}");
  b = (P { x: 1, s: "a" }, 5);
  s2_bump(b.1);
  flipp(b.0);
  l = &b.1;
  l += 10;
  assert("{b.0.x} {b.1}" == "7 16", "scalar beside heap: {b.0.x} {b.1}");
  c: (P, u8) = (P { x: 1, s: "a" }, 250);
  bump8(c.1);
  flipp(c.0);
  assert("{c.0.x} {c.1}" == "7 251", "narrow beside heap: {c.0.x} {c.1}");
}

fn test_the_local_bound_every_way() {
  a = mk(3);
  flipp(a.0);
  assert("{a.0.x} {a.0.s} {a.1}" == "7 seven 6", "from a call: {a.0.x} {a.1}");
  src = (P { x: 4, s: "four" }, 5);
  b = src;
  flipp(b.0);
  assert(b.0.x == 7 && src.0.x == 4, "from a copy: {b.0.x} {src.0.x}");
  s = 0;
  for i in 0..3 {
    t = (P { x: i, s: "p{i}" }, i);
    flipp(t.0);
    fieldp(t.0);
    s += t.0.x + t.1;
  }
  assert(s == 27, "each round: {s}");
  r = (P { x: 1, s: "a" }, 5);
  flipp(r.0);
  r = (P { x: 2, s: "b" }, 6);
  fieldp(r.0);
  assert("{r.0.x} {r.0.s} {r.1}" == "8 eight 6", "rebound: {r.0.x} {r.1}");
}

fn test_the_linked_local_read_whole() {
  tp = (P { x: 1, s: "a" }, 5);
  flipp(tp.0);
  b = tp;
  b.0.x = 100;
  (q, n) = tp;
  v = [tp];
  v += [tp];
  z = ret(tp);
  got = "{byv(tp)} {tp.0.x} {b.0.x} {q.x} {n} {len(v)} {v[1].0.s} {z.0.x}";
  assert(got == "12 7 100 7 5 2 seven 7", "whole reads: {got}");
}

fn test_every_tuple_place() {
  tp = (P { x: 4, s: "four" }, 5);
  via_param(tp);
  assert("{tp.0.x} {tp.0.s} {tp.1}" == "10 eight 5", "a `&(…)` parameter: {tp.0.x} {tp.0.s}");
  v = [(P { x: 4, s: "four" }, 5), (P { x: 1, s: "one" }, 2)];
  flipp(v[1].0);
  e = &v[0].0;
  e.x = 20;
  assert("{v[0].0.x} {v[1].0.x} {v[1].0.s} {v[1].1}" == "20 7 seven 2", "a vector element: {v[0].0.x} {v[1].0.x}");
  vv = [([1], 5), ([2], 6)];
  pushv(vv[1].0);
  assert("{vv[0].0} {vv[1].0}" == "[1] [2,9]", "a vector element's vector: {vv[1].0}");
  w = W { p: P { x: 1, s: "one" }, pair: (P { x: 2, s: "two" }, 3) };
  flipp(w.pair.0);
  assert("{w.pair.0.x} {w.pair.0.s} {w.pair.1}" == "7 seven 3", "a struct field, argument: {w.pair.0.x}");
  f = &w.pair.0;
  f.x = 30;
  k = &w.pair.1;
  k += 1;
  assert("{w.pair.0.x} {w.pair.0.s} {w.pair.1} {w.p.x}" == "30 seven 4 1", "a struct field, bind: {w.pair.0.x} {w.pair.1}");
}

fn test_the_controls() {
  a = (1, 2);
  s2_bump(a.1);
  assert(a.0 == 1 && a.1 == 3, "a scalar member: {a.1}");
  w = W { p: P { x: 1, s: "one" }, pair: (P { x: 2, s: "two" }, 3) };
  flipp(w.p);
  assert("{w.p.x} {w.p.s}" == "7 seven", "a struct field: {w.p.x}");
}


fn s3_bump(p: &integer) {
  p += 1;
}

fn half(p: &float) {
  p += 0.5;
}

fn flip(p: &boolean) {
  p = !p;
}

fn zed(p: &character) {
  p = 'z';
}

fn add_hundred(p: &integer) {
  p += 100;
}

fn bind_through(p: &(integer, integer)) -> integer {
  c = &p.0;
  c += 5;
  p.1
}

fn arg_through(p: &(integer, integer)) -> integer {
  s3_bump(p.1);
  p.1
}

fn every_kind(p: &(float, boolean, character, integer)) {
  half(p.0);
  flip(p.1);
  zed(p.2);
  c = &p.3;
  c += 7;
}

fn past_a_float(p: &(integer, float, integer)) {
  c = &p.2;
  c += 40;
}

fn handed_on(p: &(integer, integer)) {
  c = &p.1;
  add_hundred(c);
  s3_bump(p.0);
}

fn in_a_loop(p: &(integer, integer)) {
  for i in 0..4 {
    c = &p.0;
    c += i;
    s3_bump(p.1);
  }
}

fn test_a_member_of_a_linked_tuple_is_a_place() {
  t1 = (1, 2);
  r1 = bind_through(t1);
  assert(r1 == 2 && t1.0 == 6 && t1.1 == 2, "bind: {r1} {t1.0} {t1.1}");

  t2 = (1, 2);
  r2 = arg_through(t2);
  assert(r2 == 3 && t2.0 == 1 && t2.1 == 3, "argument: {r2} {t2.0} {t2.1}");

  t3 = (1.5, false, 'a', 1);
  every_kind(t3);
  assert(t3.0 == 2.0 && t3.1 && t3.2 == 'z' && t3.3 == 8, "kinds: {t3.0} {t3.1} {t3.2} {t3.3}");

  t4 = (1, 2.5, 3);
  past_a_float(t4);
  assert(t4.0 == 1 && t4.1 == 2.5 && t4.2 == 43, "offset: {t4.0} {t4.1} {t4.2}");

  t5 = (1, 2);
  handed_on(t5);
  assert(t5.0 == 2 && t5.1 == 102, "handed on: {t5.0} {t5.1}");

  t6 = (0, 0);
  in_a_loop(t6);
  assert(t6.0 == 6 && t6.1 == 4, "loop: {t6.0} {t6.1}");

  // A LOCAL link to the tuple, then links to its members.
  t7 = (1, 2);
  q = &t7;
  c7 = &q.0;
  c7 += 5;
  s3_bump(q.1);
  assert(t7.0 == 6 && t7.1 == 3, "local link: {t7.0} {t7.1}");

  println("a member of a linked tuple is a place OK");
}
