//
// A DEFERRED COPY KEEPS THE VALUE IT WAS BOUND TO, WHATEVER THE SOURCE DOES (`@FR-B-Copy`,
// `@FR-B-DeferredCopy`).  `prog = callee` copies the record: a later write to the source must
// not reach `prog`, nor any view taken out of `prog`.  The C takes that copy at the first
// statement that may write the source's store instead of at the bind; these cells write the
// source every way a program can while the copy is live — an overwrite of the very element it
// was copied from (read after through the local and through a view derived from it), a growth
// of its vector, a write by a callee, a clear — and a loop that rebinds by copy every pass while
// a DIFFERENT element is written now and then (the interpreter's shape).
//
// Values hand-computed (mk(i) = P { ops: [Op{i, 1}, Op{i, 2}, Op{i, 3}], k: 10 * i }):
//   overwrite: prog = copy of ps[1] (k 10, ops a 1); ps[1] = mk(7); then prog.k 10, op = prog.ops[2]
//              → op.a 1, op.b 3 (the view was taken BEFORE the write) → 10 * 100 + 1 * 10 + 3 = 1013
//   grow:      prog = copy of ps[2] (k 20); 40 appends; prog.k 20, prog.ops[0].b 1 → 20 * 10 + 1 = 201
//   callee:    prog = copy of ps[0] (k 0); helper sets ps[0].k = 55; prog.k 0, ps[0].k 55 → 55
//   clear:     prog = copy of ps[1]; ps cleared; prog.k 10 + len(prog.ops) 3 → 13
//   walk:      ps = mk(0..2); step 0..5, cur 0: o = prog.ops[step % 3].b; next = (cur + 1) % 3;
//              the first visit of 2 writes ps[2] = mk(9) (k 90); prog = copy of ps[next]; add o + prog.k
//              step 0: o 1, next 1, k 10 → 11;   step 1: o 2, next 2 (written: k 90) → 92;
//              step 2: o 3, next 0, k 0 → 3;     step 3: o 1, next 1, k 10 → 11;
//              step 4: o 2, next 2, k 90 → 92;   → 11 + 92 + 3 + 11 + 92 = 209
struct Op { a: integer, b: integer }
struct P { ops: vector<Op>, k: integer }

fn mk(i: integer) -> P { P { ops: [Op { a: i, b: 1 }, Op { a: i, b: 2 }, Op { a: i, b: 3 }], k: 10 * i } }

fn mks() -> vector<P> { [mk(0), mk(1), mk(2)] }

fn set_k(ps: vector<P>, i: integer, k: integer) {
  ps[i].k = k;
}

fn overwrite(ps: vector<P>) -> integer {
  prog = ps[0] ?? panic("in range");
  callee = ps[1] ?? panic("in range");
  prog = callee;
  op = prog.ops[2] ?? panic("in range");
  ps[1] = mk(7);
  prog.k * 100 + op.a * 10 + op.b
}

fn grow(ps: vector<P>) -> integer {
  prog = ps[0] ?? panic("in range");
  callee = ps[2] ?? panic("in range");
  prog = callee;
  for i in 0..40 { ps += [mk(i)]; }
  op = prog.ops[0] ?? panic("in range");
  prog.k * 10 + op.b
}

fn callee_writes(ps: vector<P>) -> integer {
  prog = ps[1] ?? panic("in range");
  callee = ps[0] ?? panic("in range");
  prog = callee;
  set_k(ps, 0, 55);
  prog.k + (ps[0] ?? panic("in range")).k
}

fn cleared(ps: vector<P>) -> integer {
  prog = ps[0] ?? panic("in range");
  callee = ps[1] ?? panic("in range");
  prog = callee;
  ps.clear();
  prog.k + len(prog.ops)
}

fn walk(ps: vector<P>, n: integer) -> integer {
  written: vector<boolean> = [false, false, false];
  prog = ps[0] ?? panic("in range");
  cur = 0;
  sum = 0;
  for step in 0..n {
    o = prog.ops[step % 3] ?? panic("in range");
    next = (cur + 1) % 3;
    if next == 2 && !(written[2] ?? true) {
      ps[2] = mk(9);
      written[2] = true;
    }
    callee = ps[next] ?? panic("in range");
    prog = callee;
    sum += o.b + prog.k;
    cur = next;
  }
  sum
}

fn test_an_overwrite_of_the_source_element() {
  assert(overwrite(mks()) == 1013, "overwrite {overwrite(mks())}");
}

fn test_a_growth_of_the_source_vector() {
  assert(grow(mks()) == 201, "grow {grow(mks())}");
}

fn test_a_callee_writing_the_source() {
  assert(callee_writes(mks()) == 55, "callee {callee_writes(mks())}");
}

fn test_a_clear_of_the_source_vector() {
  assert(cleared(mks()) == 13, "cleared {cleared(mks())}");
}

fn test_a_loop_rebinding_by_copy_beside_a_rare_write() {
  assert(walk(mks(), 5) == 209, "walk {walk(mks(), 5)}");
}
