// @catches: LOFT_NO_PAYLOAD_VIEW_FRAME — the payload binding's view closes with the arm, the bound element names no root, and the reassignment of the subject leaves it reading a freed store
//
// @FR-B-Disturb: reassigning a base ends the places inside it; a view still read afterwards gets
// its own copy (`(H-Materialise)`).  `bl = match code { NdBlock { block } => block[0], … }` views
// `code` through the payload binding `block`, whose view was owned by the ARM and closed before
// `bl` was bound — so `code = …` freed what `bl` read (main: a fault on the interpreter, a wrong
// answer or a fault in C; the self-hosted elaborator's `vector_return` and `yield_is_fresh`).
//
// CHANNEL: the VALUES (hand-computed) and the strict-store gate.
// HOLDS: every cell, on every backend.
// Axes this file MOVES:  the subject (a local, a parameter rebound first); the new value (an
//                        unrelated variant, a literal copying the view); a loop rebinding the
//                        subject from the view (the elaborator's walk).
// Axes it HOLDS FIXED:   the view is a `match` payload's element.
//
// @ARMED: LOFT_STRICT_STORES=1
// @falsified-at: pending

struct Blk { ops: vector<integer> }
enum Nd { NdBlock { block: vector<Blk> }, NdNull }
struct Op { operators: vector<Tr> }
enum Tr { TrBlock { block: vector<Op> }, TrInt { n: integer }, TrNull }

fn tot(b: Blk) -> integer { t = 0; for o in b.ops { t += o; } t }

fn local_unrelated() -> integer {
  code = Nd::NdBlock { block: [Blk { ops: [7, 8] }] };
  bl = match code { NdBlock { block } => block[0], _ => return 0 };
  code = Nd::NdNull;
  tot(bl) * 100 + len(bl.ops)
}
fn param_rebuilt(code: Nd) -> integer {
  code = Nd::NdBlock { block: [Blk { ops: [7, 8] }] };
  bl = match code { NdBlock { block } => block[0], _ => return 0 };
  code = Nd::NdBlock { block: [bl] };
  tot(bl) * 100 + len(bl.ops)
}
fn unspan(v: Tr) -> Tr { v }
fn depth_of(v: Tr) -> integer {
  tail = unspan(v);
  d = 0;
  while tail is TrBlock {
    ops = match tail { TrBlock { block } => block[0].operators, _ => [] };
    if len(ops) == 0 {
      return -2;
    }
    tail = unspan(ops[-1]);
    d += 1;
  }
  match tail { TrInt { n } => d * 100 + n, _ => -3 }
}

fn test_the_view_outlives_its_subject() {
  t = 0;
  for _ in 0..3 { t += local_unrelated() * 10 + param_rebuilt(Nd::NdNull); }
  assert(t == 49566, "{t}");
}

fn test_a_walk_rebinding_its_subject_from_the_view() {
  inner = Tr::TrBlock { block: [Op { operators: [Tr::TrInt { n: 7 }] }] };
  outer = Tr::TrBlock { block: [Op { operators: [Tr::TrNull, inner] }] };
  empty = Tr::TrBlock { block: [Op { operators: [] }] };
  assert("{depth_of(outer)} {depth_of(empty)} {depth_of(Tr::TrInt { n: 4 })}" == "207 -2 4", "walk");
}
