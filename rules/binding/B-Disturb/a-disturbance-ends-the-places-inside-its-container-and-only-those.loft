// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// A DISTURBANCE ENDS THE PLACES INSIDE ITS CONTAINER, AND ONLY THOSE (`@FR-B-Disturb`, with
// `@FR-B-View-Depth` and `@FR-H-Materialise`).  The events end the place a view names however the
// container is spelled — through a field, a field of a field, an element — so a view live across
// one is copied at its bind and keeps what it named.  An OVERWRITE of a record holding the place
// copies the new value in and releases what the old one owned: the place itself stays (a view OF
// it re-reads the new value), the places inside it end at any depth, and a SIBLING is untouched.
// Three sections, each with its cells, controls and receipt: a container named through a field or
// an element (loft#2161), the places a disturbance does not end (loft#2161's control half), and a
// whole record written into a place (loft#2391).
//
// ── 2161-a-container-named-through-a-field-or-an-element-ends-its-views ──
//
// loft#2161 — A CONTAINER NAMED THROUGH A FIELD OR AN ELEMENT ENDS ITS VIEWS (`@FR-B-Disturb`,
// `@FR-H-Materialise`).  The four events end the place a view names however the container is
// spelled, so a view live across one is copied out at the bind: it keeps the element it named,
// the container reads its own value, and a write through the view stays in the view.  The scope
// pass named a grown container by its own match on the op's first argument, and took a field
// only for `+= [x]`; `+= vector`, `insert`, a field of a field and a container inside an element
// moved the elements under a live view, which then read the freed block (`0`, `2147483648`) or
// the element that shifted in, on both backends and in silence.  A field REBUILT whole
// (`w.a = …`) was subtracted as an overwrite, which spares the view OF the field but also
// spared the views INTO its elements.
//
// Every cell grows past the first allocation (200 elements) with a record allocated after the
// container, so a stale view reads a moved block rather than a coincidence.  Hand values: each
// view names the element whose `n` is 101; the write through it is 7.
// @falsified-at: b36d0449f — interpret exit 1 -> 0, interpret 7 assertion failures -> 0, native exit 1 -> 0, native 14 assertion failures -> 0
// CHANNEL: the asserts; the suite's leak gate for every copied-out view.
// ARMED: LOFT_LEAK_CHECK, LOFT_STRICT_STORES, LOFT_POISON for the control run.
// HOLDS: every cell on both backends, under LOFT_STRICT_STORES and LOFT_POISON.
//
// Axes moved: the event (append, append-a-vector, insert, removal, rebuild from a literal or a
// call, rebuild then grow), how the container is named (field, field of a field, through a struct
// view, element, field of an element), where (inline, one call down, two calls down, a
// parameter's own field), the statement (straight-line, an `if` arm, a loop's back edge) and
// the view (plain, a `??` discharge).
// @observes: LOFT_NO_CALLEE_DISTURB — the switch stops a callee's growth ending the caller's views, so the `view-copied` advice for the call sites leaves its output.
//
// ── 2161-a-disturbance-ends-only-the-places-inside-its-container ──
//
// loft#2161 — A DISTURBANCE ENDS ONLY THE PLACES INSIDE ITS CONTAINER (`@FR-B-Disturb`,
// `@FR-B-View-Depth`).  The control half of the field-and-element cells beside it: every view
// here names a place the event does NOT end, so it stays an alias and a write through it lands
// in the container.  A place was the root variable and the field nearest it, so a removal from
// `o.inner.a` also ended a view into `o.inner.b`, and a view of the struct `o.inner` itself,
// and the write through each was lost.  Field runs now add (`o.inner.b` is its own slot), and
// a container one element read deep ends only views deeper than it.
//
// @falsified-at: b36d0449f — interpret exit 1 -> 0, interpret 3 assertion failures -> 0, native exit 1 -> 0, native 6 assertion failures -> 0
// HOLDS: leak, panic and free-refusal are equal on both trees, on both backends (falsify reports only the channels that move).
//
// Axes moved: the sibling's level (first field, field of a field), the event (removal, growth,
// rebuild), what the view names (an element of a sibling, the struct around the container, the
// element slot holding the container, another element at a literal index).
//
// ── 2391-a-whole-record-written-into-a-place-ends-the-views-into-what-it-owned ──
//
// loft#2391 (`@FR-B-Disturb`, `@FR-B-View`) — `(B-Disturb)`'s OVERWRITE event: a whole record
// written into a place copies the new value in and releases what the OLD value owned — its
// vectors, its children, their elements.  The place itself stays, so a view OF it re-reads the
// new value; a view INTO what the old value owned ends, and a plain one live across the write
// is copied at its bind (the author is told: `view-copied`).
//
// Ended, copied: a2 a `match` unwrap written back over its own source (the filed shape), b2 an
// element of a field's vector across the field's overwrite, c2 the same through a vector
// element, j2 a write in a loop, m2 a grandchild across its parent's overwrite by a literal,
// s2 a view deeper than an element across `sort_by` (which writes each element whole).
//
// Controls, unchanged: d2 an element written back with its own view (no copy, the write
// lands), e2 a view OF the overwritten place re-reads it, g2 a view dead before the write,
// i2 a sibling field overwritten (the view keeps writing through), k2 a text read out before
// the write is a value, l2 a whole local written in (nothing viewed inside the old value).
//
// @falsified-at: f6ee9b1a9 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0, native exit 1 -> 0, native 1 assertion failures -> 0
//   HOLDS: every channel the line above does not name is equal on BOTH trees — `falsify`
//   reports only what moved.
// @observes: LOFT_NO_CALLEE_DISTURB — the switch stops `sort_by` ending the view into what it rewrites, so its `view-copied` advice leaves the output.

struct S { n: integer }
struct W { tag: integer, a: vector<S> }
struct In { a: vector<S> }
struct O { x: integer, inner: In }

fn big(b: integer) -> vector<S> {
  r: vector<S> = [];
  for i in 0..200 { r += [S { n: b + i }]; }
  r
}

fn test_a_field_grown_by_a_vector() {
  w = W { tag: 1, a: [S { n: 101 }, S { n: 102 }] };
  d = w.a[0];
  pad = W { tag: 2, a: [S { n: 9 }] };
  w.a += big(5000);
  assert(d.n == 101, "the view keeps the element it named: {d.n}");
  d.n = 7;
  assert(w.a[0].n == 101 && len(w.a) == 202 && pad.tag == 2, "the field keeps its own: {w.a[0].n} {len(w.a)}");
}

fn test_a_field_insert() {
  w = W { tag: 1, a: [S { n: 101 }, S { n: 102 }] };
  d = w.a[0];
  for i in 0..200 { w.a.insert(0, S { n: i }); }
  assert(d.n == 101, "not the element that shifted in: {d.n}");
  d.n = 7;
  assert(w.a[200].n == 101 && len(w.a) == 202, "{w.a[200].n} {len(w.a)}");
}

fn test_a_field_of_a_field() {
  o = O { x: 1, inner: In { a: [S { n: 101 }, S { n: 102 }] } };
  d = o.inner.a[0];
  pad = W { tag: 2, a: [S { n: 9 }] };
  for i in 0..200 { o.inner.a += [S { n: i }]; }
  assert(d.n == 101, "{d.n}");
  d.n = 7;
  assert(o.inner.a[0].n == 101 && len(o.inner.a) == 202 && pad.tag == 2, "{o.inner.a[0].n}");
  // the same place spelled through a view of the struct
  o2 = O { x: 1, inner: In { a: [S { n: 101 }] } };
  t = o2.inner;
  e = t.a[0];
  o2.inner.a += big(5000);
  assert(e.n == 101, "through a struct view: {e.n}");
  e.n = 7;
  assert(o2.inner.a[0].n == 101 && len(o2.inner.a) == 201, "{o2.inner.a[0].n}");
}

fn test_a_container_inside_an_element() {
  vv: vector<vector<S>> = [[S { n: 101 }, S { n: 102 }], [S { n: 201 }]];
  d = vv[0][0];
  for i in 0..200 { vv[0] += [S { n: i }]; }
  assert(d.n == 101, "{d.n}");
  d.n = 7;
  assert(vv[0][0].n == 101 && len(vv[0]) == 202 && vv[1][0].n == 201, "{vv[0][0].n}");
  // a field of an element, and the element reached through a row view
  v = [W { tag: 1, a: [S { n: 101 }] }, W { tag: 2, a: [S { n: 201 }] }];
  f = v[0].a[0];
  for i in 0..200 { v[0].a += [S { n: i }]; }
  assert(f.n == 101 && v[0].a[0].n == 101 && len(v[0].a) == 201, "field of an element: {f.n}");
  ww: vector<vector<S>> = [[S { n: 101 }], [S { n: 201 }]];
  row = ww[0];
  g = row[0];
  for i in 0..200 { ww[0] += [S { n: i }]; }
  assert(g.n == 101 && ww[0][0].n == 101, "through a row view: {g.n}");
  // a removal from the container inside the element renumbers it
  xs: vector<vector<S>> = [[S { n: 1 }, S { n: 101 }], [S { n: 201 }]];
  h = xs[0][1];
  xs[0].remove(0);
  assert(h.n == 101, "not the element that shifted down: {h.n}");
  h.n = 7;
  assert(xs[0][0].n == 101 && len(xs[0]) == 1, "{xs[0][0].n}");
}

fn test_a_rebuilt_field() {
  w = W { tag: 1, a: [S { n: 101 }, S { n: 102 }] };
  d = w.a[0];
  w.a = [S { n: 901 }];
  assert(d.n == 101, "not the new vector's element: {d.n}");
  d.n = 7;
  assert(w.a[0].n == 901 && len(w.a) == 1, "the write stays out of the new vector: {w.a[0].n}");
  w2 = W { tag: 1, a: [S { n: 101 }, S { n: 102 }] };
  e = w2.a[0];
  w2.a = big(900);
  assert(e.n == 101 && w2.a[0].n == 900 && len(w2.a) == 200, "rebuilt from a call: {e.n}");
  // rebuilt first, viewed, then grown in earnest
  w3 = W { tag: 1, a: [S { n: 1 }] };
  w3.a = [S { n: 101 }, S { n: 102 }];
  g = w3.a[0];
  pad = W { tag: 2, a: [S { n: 9 }] };
  for i in 0..200 { w3.a += [S { n: i }]; }
  assert(g.n == 101 && w3.a[0].n == 101 && len(w3.a) == 202 && pad.tag == 2, "rebuilt then grown: {g.n}");
}

fn grow_a(w: W) { w.a += big(50); }
fn grow_a2(w: W) { grow_a(w); }
fn ins_a(w: W) { for i in 0..200 { w.a.insert(0, S { n: i }); } }
fn grow_in(i: In) { for k in 0..200 { i.a += [S { n: k }]; } }

fn test_one_and_two_calls_down() {
  w = W { tag: 1, a: [S { n: 101 }, S { n: 102 }] };
  d = w.a[0];
  pad = W { tag: 2, a: [S { n: 9 }] };
  grow_a2(w);
  assert(d.n == 101 && w.a[0].n == 101 && len(w.a) == 202 && pad.tag == 2, "two calls down: {d.n}");
  w2 = W { tag: 1, a: [S { n: 101 }, S { n: 102 }] };
  e = w2.a[0];
  ins_a(w2);
  assert(e.n == 101 && w2.a[200].n == 101, "an insert one call down: {e.n}");
  o = O { x: 1, inner: In { a: [S { n: 101 }, S { n: 102 }] } };
  f = o.inner.a[0];
  grow_in(o.inner);
  f.n = 7;
  assert(o.inner.a[0].n == 101 && len(o.inner.a) == 202, "a field of a field one call down: {o.inner.a[0].n}");
}

fn grown_through_a_parameter(w: W) -> integer {
  d = w.a[0];
  pad = W { tag: 2, a: [S { n: 9 }] };
  w.a += big(5000);
  r = d.n;
  d.n = 7;
  r * 1000 + w.a[0].n + pad.tag - 2
}

fn test_the_statement_and_the_spelling_of_the_view() {
  w = W { tag: 1, a: [S { n: 101 }] };
  d = w.a[0] ?? S { n: 0 };
  pad = W { tag: 2, a: [S { n: 9 }] };
  w.a += big(5000);
  assert(d.n == 101, "a discharged view: {d.n}");
  d.n = 7;
  assert(w.a[0].n == 101 && pad.tag == 2, "{w.a[0].n}");
  w2 = W { tag: 1, a: [S { n: 101 }] };
  e = w2.a[0];
  if pad.tag > 0 { w2.a += big(5000); }
  assert(e.n == 101, "grown in an if arm: {e.n}");
  w3 = W { tag: 1, a: [S { n: 101 }] };
  f = w3.a[0];
  if pad.tag > 0 { w3.a = [S { n: 901 }]; }
  assert(f.n == 101 && w3.a[0].n == 901, "rebuilt in an if arm: {f.n}");
  // bound before the loop, grown at the bottom of the body: the next pass reads it
  w4 = W { tag: 1, a: [S { n: 101 }] };
  g = w4.a[0];
  t = 0;
  for i in 0..3 { t += g.n; w4.a += big(i); }
  assert(t == 303 && w4.a[0].n == 101 && len(w4.a) == 601, "the back edge: {t}");
  assert(grown_through_a_parameter(W { tag: 1, a: [S { n: 101 }] }) == 101101, "a parameter's field");
}

struct S2S { n: integer }
struct S2W { tag: integer, a: vector<S2S> }
struct In2 { a: vector<S2S>, b: vector<S2S> }
struct O2 { x: integer, inner: In2 }

fn test_a_nested_sibling_is_not_disturbed() {
  o = O2 { x: 1, inner: In2 { a: [S2S { n: 1 }, S2S { n: 2 }], b: [S2S { n: 301 }, S2S { n: 302 }] } };
  d = o.inner.b[0];
  o.inner.a.remove(0);
  d.n = 7;
  assert(o.inner.b[0].n == 7 && len(o.inner.a) == 1, "a removal from a sibling: {o.inner.b[0].n}");
  p = O2 { x: 1, inner: In2 { a: [S2S { n: 1 }], b: [S2S { n: 301 }] } };
  e = p.inner.b[0];
  for i in 0..200 { p.inner.a += [S2S { n: i }]; }
  e.n = 7;
  assert(p.inner.b[0].n == 7, "a growth of a sibling: {p.inner.b[0].n}");
  q = In2 { a: [S2S { n: 1 }], b: [S2S { n: 301 }] };
  f = q.b[0];
  for i in 0..200 { q.a += [S2S { n: i }]; }
  f.n = 7;
  assert(q.b[0].n == 7, "a first-level sibling: {q.b[0].n}");
}

fn test_a_view_of_the_struct_around_the_container() {
  // `a` is the FIRST member, so `o.inner.a` and `o.inner` share one address
  o = O2 { x: 1, inner: In2 { a: [S2S { n: 1 }], b: [S2S { n: 301 }] } };
  x = o.inner;
  for i in 0..200 { o.inner.a += [S2S { n: i }]; }
  x.a[0].n = 7;
  assert(len(x.a) == 201 && o.inner.a[0].n == 7, "growth of its first member: {len(x.a)} {o.inner.a[0].n}");
  p = O2 { x: 1, inner: In2 { a: [S2S { n: 1 }, S2S { n: 2 }], b: [S2S { n: 301 }] } };
  y = p.inner;
  p.inner.a.remove(0);
  y.b[0].n = 7;
  assert(len(y.a) == 1 && p.inner.b[0].n == 7, "removal from its first member: {len(y.a)}");
}

fn test_an_element_slot_and_another_element() {
  // `(B-View-Depth)` cell A: the slot re-reads the repointed handle
  vv: vector<vector<integer>> = [[1, 2], [3]];
  a = vv[0];
  vv[0] += [9];
  a[0] = 5;
  assert(len(a) == 3 && vv[0][0] == 5 && len(vv[0]) == 3, "the element slot: {len(a)} {vv[0][0]}");
  ww: vector<vector<S2S>> = [[S2S { n: 101 }], [S2S { n: 201 }]];
  e = ww[1][0];
  for i in 0..200 { ww[0] += [S2S { n: i }]; }
  e.n = 7;
  assert(ww[1][0].n == 7, "another element at a literal index: {ww[1][0].n}");
  xs: vector<vector<S2S>> = [[S2S { n: 101 }], [S2S { n: 201 }]];
  row = xs[1];
  f = row[0];
  for i in 0..200 { xs[0] += [S2S { n: i }]; }
  f.n = 7;
  assert(xs[1][0].n == 7, "another element through a row view: {xs[1][0].n}");
}

fn test_a_removal_from_a_container_inside_an_element() {
  vv: vector<vector<S2S>> = [[S2S { n: 1 }, S2S { n: 2 }], [S2S { n: 201 }]];
  a = vv[1];
  vv[0].remove(0);
  a[0].n = 7;
  assert(vv[1][0].n == 7 && len(vv[0]) == 1, "another element's slot: {vv[1][0].n}");
  ww: vector<vector<S2S>> = [[S2S { n: 1 }, S2S { n: 2 }], [S2S { n: 201 }]];
  b = ww[0];
  ww[0].remove(0);
  b[0].n = 7;
  assert(ww[0][0].n == 7 && len(b) == 1, "the slot re-reads the shorter vector: {ww[0][0].n} {len(b)}");
  xs: vector<vector<S2S>> = [[S2S { n: 1 }, S2S { n: 2 }], [S2S { n: 201 }]];
  e = xs[1][0];
  xs[0].remove(0);
  e.n = 7;
  assert(xs[1][0].n == 7, "another element at a literal index: {xs[1][0].n}");
}

fn view_of_a_rebuilt_field(ws: vector<S2W>) -> integer {
  r = 0;
  for b in ws {
    c = b.a;
    b.a = [S2S { n: 9 }, S2S { n: 8 }];
    r += len(c) * 100 + c[0].n;
  }
  r
}

fn test_the_view_of_a_rebuilt_field_follows_it() {
  // overwriting a place is not disturbing it: the view OF the field sees the new value
  assert(view_of_a_rebuilt_field([S2W { tag: 1, a: [S2S { n: 1 }] }]) == 209, "a view of the field");
}

enum Ty { Opt { inner: Ty }, Int { bits: integer } }
struct Cell { tp: Ty }
struct S3S { n: integer }
struct S3In { v: vector<S3S>, tag: integer }
struct S3O { inner: S3In, z: integer }
struct E { v: vector<S3S> }
struct T { k: integer, left: T? }
struct P { k: integer, names: vector<S3S> }
struct D { n: integer, w: vector<integer> }
struct B { n: integer, w: vector<integer> }
struct OB { inner: B }
struct Two { a: S3In, b: S3In }
struct Named { name: text, v: vector<integer> }
struct ON { inner: Named }

fn a2() -> integer {
  c = Cell { tp: Opt { inner: Int { bits: 32 } } };
  y = match c.tp { Opt { inner } => inner, _ => c.tp };
  c.tp = y;
  match c.tp { Int { bits } => bits, _ => -1 }
}

fn b2() -> integer {
  o = S3O { inner: S3In { v: [S3S { n: 701 }, S3S { n: 702 }], tag: 1 }, z: 5 };
  other = S3In { v: [S3S { n: 901 }], tag: 2 };
  x = o.inner.v[0];
  o.inner = other;
  x.n * 10000 + o.inner.v[0].n * 10 + len(o.inner.v)
}

fn c2() -> integer {
  v = [E { v: [S3S { n: 11 }, S3S { n: 12 }] }, E { v: [S3S { n: 21 }] }];
  r = E { v: [S3S { n: 31 }] };
  x = v[0].v[1];
  v[0] = r;
  x.n * 1000 + v[0].v[0].n * 10 + len(v[0].v)
}

fn j2() -> integer {
  o = S3O { inner: S3In { v: [S3S { n: 5 }], tag: 0 }, z: 0 };
  x = o.inner.v[0];
  t = 0;
  for i in 0..3 {
    t += x.n;
    o.inner = S3In { v: [S3S { n: 100 + i }], tag: i };
  }
  t * 1000 + o.inner.v[0].n
}

fn m2() -> integer {
  t = T { k: 1, left: T { k: 2, left: T { k: 3, left: null } } };
  g = t.left.left;
  t.left = T { k: 20, left: null };
  l = t.left;
  if g == null || l == null { return -1; }
  g.k * 100 + l.k
}

fn s2() -> integer {
  v = [P { k: 3, names: [S3S { n: 31 }, S3S { n: 32 }, S3S { n: 33 }] }, P { k: 1, names: [S3S { n: 11 }, S3S { n: 12 }] }];
  x = v[0].names[1];
  e = v[0];
  v.sort_by(fn(p: P) -> integer { p.k });
  x.n * 10000 + e.k * 1000 + v[0].names[1].n * 10 + len(v[1].names)
}

fn d2() -> integer {
  v = [D { n: 1, w: [4, 5] }, D { n: 2, w: [6] }];
  e = v[0];
  e.n = 41;
  v[0] = e;
  v[0].n * 10 + v[0].w[1]
}

fn e2() -> integer {
  o = OB { inner: B { n: 1, w: [7] } };
  b = B { n: 2, w: [8, 9] };
  a = o.inner;
  o.inner = b;
  a.n * 10 + a.w[1]
}

fn g2() -> integer {
  o = S3O { inner: S3In { v: [S3S { n: 5 }], tag: 0 }, z: 0 };
  x = o.inner.v[0];
  before = x.n;
  o.inner = S3In { v: [S3S { n: 6 }], tag: 1 };
  before * 10 + o.inner.v[0].n
}

fn i2() -> integer {
  o = Two { a: S3In { v: [S3S { n: 5 }], tag: 0 }, b: S3In { v: [S3S { n: 7 }], tag: 0 } };
  nb = S3In { v: [S3S { n: 8 }], tag: 1 };
  x = o.a.v[0];
  o.b = nb;
  x.n = 55;
  o.a.v[0].n * 10 + o.b.v[0].n
}

fn k2() -> text {
  o = ON { inner: Named { name: "first", v: [1] } };
  t = o.inner.name;
  o.inner = Named { name: "second", v: [2] };
  "{t}/{o.inner.name}"
}

fn l2() -> integer {
  c = Cell { tp: Opt { inner: Int { bits: 32 } } };
  y = Int { bits: 64 };
  c.tp = y;
  match c.tp { Int { bits } => bits, _ => -1 }
}

fn test_a_whole_record_written_into_a_place_ends_the_views_into_what_it_owned() {
  assert(a2() == 32, "a2: the unwrapped payload survives being written over its source: {a2()}");
  assert(b2() == 7019011, "b2: x keeps 701, the field holds the new vector: {b2()}");
  assert(c2() == 12311, "c2: x keeps 12, the element holds the new vector: {c2()}");
  assert(j2() == 15102, "j2: every turn reads the 5 bound before the loop: {j2()}");
  assert(m2() == 320, "m2: the grandchild keeps 3, the child is the literal: {m2()}");
  assert(s2() == 321123, "s2: x keeps 32, e is the sorted first element: {s2()}");
  assert(d2() == 415, "d2: an element written back with its own view: {d2()}");
  assert(e2() == 29, "e2: a view of the place reads the new value: {e2()}");
  assert(g2() == 56, "g2: a view dead before the write: {g2()}");
  assert(i2() == 558, "i2: a sibling's overwrite keeps the write-through: {i2()}");
  assert(k2() == "first/second", "k2: a text read out is a value: {k2()}");
  assert(l2() == 64, "l2: a whole local written in: {l2()}");
}
