//
// loft#2267 — `@FR-B-Disturb`: a clear REMOVES every element, and a method that grows, removes
// from or reassigns its container disturbs it as a free function does.  A plain struct view
// bound before such a call is copied out at the bind (`@FR-B-View`), so it answers the element
// it named.  The disturbance summary read only `n_` functions, so `v.clear()` and every method
// went unseen: the view read what the cleared or shifted storage held (C read `0 null` for a
// cleared element, every backend the shifted element after a method's removal).
// A SORT overwrites the places it has and disturbs nothing: a view and a `&` link into the
// vector name the same places after it, now holding the sorted elements.
//
// @falsified-at: 23bc61e47 — interpret exit 1 -> 0, interpret 1 assertion failures -> 0,
//   native exit 1 -> 0, native 2 assertion failures -> 0.
//   WITNESS: on main every backend answers `2b 2b 1` for the method removal (the view reads
//   the element that moved in), and C answers `0 0 null` for the clear.
// CHANNEL: the VALUE of the view after the call, hand-computed, and the LEAK.
// ARMED: no instrument.
// HOLDS: every cell, on every backend.

struct S { n: integer, s: text }
struct Bag { items: vector<S> }

operator compare(self: S, other: S) -> Ordering { self.n.compare(other.n) }

fn drop_first(self: Bag) { self.items.remove(0); }
fn add(self: Bag, e: S) { self.items += [e]; }
fn reset(self: &Bag) { self = Bag { items: [S { n: 7, s: "seven" }, S { n: 8, s: "eight" }] }; }

fn across_clear() -> text {
  v = [S { n: 1, s: "one" }, S { n: 2, s: "two" }];
  e = v[0];
  v.clear();
  "{len(v)} {e.n} {e.s}"
}

fn across_method_removal() -> text {
  b = Bag { items: [S { n: 1, s: "a" }, S { n: 2, s: "b" }] };
  e = b.items[0];
  b.drop_first();
  "{e.n}{e.s} {b.items[0].n}{b.items[0].s} {len(b.items)}"
}

fn across_method_growth() -> text {
  b = Bag { items: [S { n: 1, s: "a" }] };
  e = b.items[0];
  for i in 0..20 { b.add(S { n: i + 10, s: "g" }); }
  "{e.n}{e.s} {len(b.items)}"
}

fn across_method_reset() -> text {
  b = Bag { items: [S { n: 1, s: "a" }] };
  e = b.items[0];
  b.reset();
  "{e.n}{e.s} {b.items[0].n}"
}

// A sort overwrites places: the view names v[0], which now holds the smallest.
fn view_across_sort() -> text {
  v = [S { n: 3, s: "c" }, S { n: 1, s: "a" }, S { n: 2, s: "b" }];
  e = v[0];
  v.sort();
  "{e.n}{e.s} {v[0].n}{v[0].s}"
}

fn link_across_sort() -> text {
  v = [S { n: 3, s: "c" }, S { n: 1, s: "a" }, S { n: 2, s: "b" }];
  c = &v[0];
  v.sort();
  c.n = 9;
  "{v[0].n}{v[0].s} {v[1].n}{v[1].s} {v[2].n}{v[2].s}"
}

fn test_a_clear_copies_the_view_out() {
  assert(across_clear() == "0 1 one", "clear: {across_clear()}");
}

fn test_a_method_that_disturbs_copies_the_view_out() {
  assert(across_method_removal() == "1a 2b 1", "removal: {across_method_removal()}");
  assert(across_method_growth() == "1a 21", "growth: {across_method_growth()}");
  assert(across_method_reset() == "1a 7", "reset: {across_method_reset()}");
}

fn test_a_sort_overwrites_the_places_it_has() {
  assert(view_across_sort() == "1a 1a", "view: {view_across_sort()}");
  assert(link_across_sort() == "9a 2b 3c", "link: {link_across_sort()}");
}
