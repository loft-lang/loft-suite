//
// A STRUCT VIEW OF FOREIGN DATA REFUSES A WRITE (`@FR-Const-Foreign` crossed with `@FR-B-View`).
// A `-> const T` producer's value is foreign data and value-const; a struct-typed projection
// of it (`s = b.inner`) is a VIEW by B-View — it aliases without `&` — and Const-Foreign makes
// that view read-only like the value: the write through it is refused at compile time, never
// checked at run time.  The cells beside this rule hold the producer to a `vector<u8>`; this
// one moves it to a RECORD and the write to a view of a member record.
//
// @EXPECT_ERROR: Cannot modify 's'
//
// @falsified-at: none — a conformance guard; the refusal fires on 18594597b, interpret and native.
// CHANNEL: the compile diagnostic.
// ARMED: no instrument.
// WITNESS: the diagnostic names the view `s`.
// HOLDS: `a-view-of-foreign-data-reads-in-place-and-its-copies-are-the-readers-own` beside
//   it, where the same view is read and its copy written.

struct CfIn { v: integer }
struct CfBox { inner: CfIn, xs: vector<integer> }

fn cf_mk() -> const CfBox { CfBox { inner: CfIn { v: 1 }, xs: [1, 2] } }

fn main() {
  b = cf_mk();
  s = b.inner;
  s.v = 9;
  assert(b.inner.v == 1, "unreachable");
}
