//
// `@FR-Const-Value` crossed with `@FR-B-Ref-Alias`, `@FR-B-View` and `@FR-E-Asgn-Discharge` — the
// legal half of `a-link-a-view-and-a-discharge-of-a-const-value-are-read-only-refused.loft`.
// A link, a member view, an element view and a loop variable over a value-const parameter
// READ the value; a scalar read out of one is the reader's own copy.  A discharge target
// (`place? op= e`) on a writable binding writes `place`: a null place starts from the type's
// default, a present one from its value, and `place? = e` is `place = e`; a binding-const
// local (`const c = …`) keeps its contents writable, so the same discharge writes there too.
//
// Every cell held on both backends when written; the ledger rows are in
// doc/claude/RULE_CROSSINGS-history.md.
//
// @falsified-at: none — the walk found no defect, so no earlier build answers wrong.
// CHANNEL: the assertions and the leak gate.

struct In { k: integer, n: integer? }
struct S { inner: In, items: vector<In>, v: vector<integer>, m: integer? }

fn mk() -> S { S { inner: In { k: 3 }, items: [In { k: 1 }, In { k: 2, n: 7 }], v: [1, 2, 4] } }

fn read_all(p: const S) -> integer {
  d = &p.v;
  s = 0;
  for x in d { s += x; }
  e = p.inner;
  f = p.items[1];
  t = 0;
  for it in p.items { t += it.k; }
  s * 1000 + e.k * 100 + (f.n ?? 0) * 10 + t
}

fn copy_out(p: const S) -> integer { k = p.inner.k; k += 10; k * 10 + p.inner.k }

fn test_reads_through_a_link_and_views_of_a_const() {
  s = mk();
  assert(read_all(s) == 7373, "read_all: {read_all(s)}");
  assert(copy_out(s) == 133 && s.inner.k == 3, "copy_out: {copy_out(s)} {s.inner.k}");
}

fn test_a_discharge_target_writes_the_place() {
  s = mk();
  s.m? += 1;
  assert(s.m == 1, "a null place starts from the default: {s.m ?? -1}");
  s.m? += 1;
  assert(s.m == 2, "a present place from its value: {s.m ?? -1}");
  s.m? = 5;
  assert(s.m == 5, "a plain discharge assignment: {s.m ?? -1}");
  s.inner.n? += 2;
  s.items[1].n? *= 3;
  assert(s.inner.n == 2 && s.items[1].n == 21 && s.items[0].n == null,
         "nested: {s.inner.n ?? -1} {s.items[1].n ?? -1}");
  e = s.items[0];
  e.n? += 4;
  assert(s.items[0].n == 4, "through a view: {s.items[0].n ?? -1}");
  const c = mk();
  c.m? += 3;
  assert(c.m == 3, "a binding-const local's contents: {c.m ?? -1}");
}
