//
// The field-ASSIGNMENT cell of `a-cast-cure-refusals-name-the-written-type.loft`, apart because
// beside the other cells it was not reported.  `s.a = f` into a `u8?` field is refused once, at
// loft#893's chokepoint, naming `as u8?` — it was refused twice at one position, both times
// naming `as integer(0, 255)?`, which does not parse.
//
// @falsified-at: 726b9665e — interpret exit 1 -> 0, interpret expectations FAIL/1 -> 1/1 (the
//   suite's verdict, not a count of matches), native exit 1 -> 0, native expectations FAIL/1
//   -> 1/1.
// @falsified-by: none at HEAD — reverting the fix no longer reproduces this cell: loft#1938
//   spells every integer by its alias in Type::source_name (u8?), and diagnostics dedupe by
//   position, so neither the misnamed cure nor the second report shows.  The receipt is the
//   control above (726b9665e — reachable only from a PR ref, not a branch).
// HOLDS: nothing runs on either tree (a refusal file).

fn main() {
  println("{field(2.5)}");
}

struct S { a: u8?, b: integer }

// @EXPECT_ERROR: Cannot assign float to a field of type u8? — use 'as u8?' to cast explicitly
fn field(f: float) -> integer {
  s = S { b: 1 };
  s.a = f;
  s.b
}
